@page
@model LoginModel

@{
    Layout = null;
    ViewData["Title"] = "تسجيل الدخول - الديوان";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="تسجيل الدخول إلى بوابة إدارة المطعم.">
    
    <title>بوابة الإدارة || تسجيل الدخول</title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/assets/images/q.png">
    
    <!-- Google Fonts & Bootstrap Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800&family=Cairo:wght@400;600;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        :root {
            --primary-gold: #c59b27;
            --primary-gold-hover: #a37c1d;
            --bg-light: #f8fafc;
            --card-bg: #ffffff;
            --border-color: #e2e8f0;
            --text-dark: #0f172a;
            --text-muted: #64748b;
            --input-bg: #f8fafc;
            --error-red: #ef4444;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Cairo', 'Outfit', sans-serif;
            background-color: var(--bg-light);
            color: var(--text-dark);
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 1.5rem;
            position: relative;
            overflow-x: hidden;
        }

        /* Ambient glow for light mode - subtle and elegant */
        .bg-ambient {
            position: absolute;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(197, 155, 39, 0.04) 0%, rgba(248, 250, 252, 0) 70%);
            z-index: 1;
            pointer-events: none;
        }

        .login-container {
            width: 100%;
            max-width: 440px;
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 24px;
            padding: 2.5rem 2.25rem;
            box-shadow: 0 20px 25px -5px rgba(15, 23, 42, 0.04), 0 10px 10px -5px rgba(15, 23, 42, 0.02);
            z-index: 10;
            text-align: center;
        }

        .brand-header {
            margin-bottom: 2.25rem;
        }

        .brand-logo {
            height: 60px;
            margin-bottom: 1rem;
            filter: drop-shadow(0 4px 6px rgba(197, 155, 39, 0.1));
        }

        .brand-title {
            font-size: 1.6rem;
            font-weight: 800;
            color: var(--text-dark);
            margin-bottom: 0.35rem;
        }

        .brand-title span {
            color: var(--primary-gold);
        }

        .brand-subtitle {
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        /* Form Controls */
        .form-group {
            position: relative;
            margin-bottom: 1.25rem;
            text-align: right;
        }

        .form-label {
            display: block;
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--text-muted);
            margin-bottom: 0.5rem;
        }

        .input-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }

        .form-input {
            width: 100%;
            background-color: var(--input-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 13px 44px 13px 14px; /* Right padding for icon in RTL */
            color: var(--text-dark);
            font-family: inherit;
            font-size: 0.9rem;
            transition: all 0.2s ease;
            text-align: right;
            direction: ltr; /* English chars for email/pwd */
        }

        .form-input:focus {
            border-color: var(--primary-gold);
            box-shadow: 0 0 0 3px rgba(197, 155, 39, 0.12);
            outline: none;
            background-color: var(--card-bg);
        }

        .input-icon {
            position: absolute;
            right: 15px;
            color: var(--text-muted);
            font-size: 1.1rem;
            pointer-events: none;
            display: flex;
            align-items: center;
        }

        .password-toggle {
            position: absolute;
            left: 15px;
            background: none;
            border: none;
            color: var(--text-muted);
            cursor: pointer;
            font-size: 1.1rem;
            display: flex;
            align-items: center;
            padding: 5px;
        }

        .password-toggle:hover {
            color: var(--text-dark);
        }

        /* Actions Row */
        .actions-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            font-size: 0.85rem;
        }

        .remember-me {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            user-select: none;
            color: var(--text-muted);
        }

        .remember-me input {
            width: 16px;
            height: 16px;
            accent-color: var(--primary-gold);
            cursor: pointer;
        }

        .forgot-link {
            color: var(--primary-gold);
            text-decoration: none;
            font-weight: 600;
            transition: color 0.2s ease;
        }

        .forgot-link:hover {
            color: var(--primary-gold-hover);
        }

        /* Submit Button */
        .submit-btn {
            width: 100%;
            background: linear-gradient(135deg, var(--primary-gold) 0%, var(--primary-gold-hover) 100%);
            border: none;
            border-radius: 12px;
            padding: 14px;
            color: white;
            font-weight: 700;
            font-size: 1rem;
            font-family: inherit;
            cursor: pointer;
            box-shadow: 0 10px 15px -3px rgba(197, 155, 39, 0.15);
            transition: all 0.2s ease;
        }

        .submit-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 12px 20px -3px rgba(197, 155, 39, 0.25);
        }

        .submit-btn:active {
            transform: translateY(0);
        }

        /* Errors and Validation Summary */
        .error-summary {
            background-color: rgba(239, 68, 68, 0.04);
            border: 1px solid rgba(239, 68, 68, 0.15);
            border-radius: 12px;
            padding: 12px;
            margin-bottom: 1.5rem;
            text-align: right;
            font-size: 0.85rem;
            color: var(--error-red);
        }

        .error-summary ul {
            list-style: none;
            margin-right: 5px;
        }

        .field-error {
            color: var(--error-red);
            font-size: 0.75rem;
            margin-top: 0.35rem;
            display: block;
        }
    </style>
</head>

<body>
    <div class="bg-ambient"></div>

    <div class="login-container">
        <div class="brand-header">
            <img src="~/assets/images/Qore.png" alt="ديوان" class="brand-logo" onerror="this.src='/assets/images/logo-abbr.png'">
            <h1 class="brand-title">بوابة <span>الديوان</span></h1>
            <p class="brand-subtitle">الرجاء إدخال بيانات الاعتماد للوصول للوحة التحكم</p>
        </div>

        <form id="account" method="post">
            <!-- Validation Summary -->
            <div asp-validation-summary="ModelOnly" class="error-summary text-danger" role="alert"></div>

            <!-- Username / Email Input -->
            <div class="form-group">
                <label asp-for="Input.Email" class="form-label">البريد الإلكتروني أو اسم المستخدم</label>
                <div class="input-wrapper">
                    <input asp-for="Input.Email" class="form-input" placeholder="example@domain.com" autocomplete="username" aria-required="true" />
                    <span class="input-icon"><i class="bi bi-envelope"></i></span>
                </div>
                <span asp-validation-for="Input.Email" class="field-error"></span>
            </div>

            <!-- Password Input -->
            <div class="form-group">
                <label asp-for="Input.Password" class="form-label">كلمة المرور</label>
                <div class="input-wrapper">
                    <input asp-for="Input.Password" type="password" class="form-input" id="loginPassword" placeholder="••••••••" autocomplete="current-password" aria-required="true" />
                    <span class="input-icon"><i class="bi bi-lock"></i></span>
                    <button type="button" class="password-toggle" id="togglePasswordBtn" tabindex="-1" aria-label="عرض كلمة المرور">
                        <i class="bi bi-eye" id="togglePasswordIcon"></i>
                    </button>
                </div>
                <span asp-validation-for="Input.Password" class="field-error"></span>
            </div>

            <!-- Remember Me & Forgot Password -->
            <div class="actions-row">
                <label class="remember-me">
                    <input type="checkbox" asp-for="Input.RememberMe">
                    <span>تذكرني على هذا الجهاز</span>
                </label>
                <a id="forgot-password" asp-page="./ForgotPassword" class="forgot-link">نسيت كلمة المرور؟</a>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="submit-btn">تسجيل الدخول</button>
        </form>
    </div>

    <!-- Lightweight Password Toggler (Vanilla JS, 0 dependencies) -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const toggleBtn = document.getElementById("togglePasswordBtn");
            const passwordInput = document.getElementById("loginPassword");
            const icon = document.getElementById("togglePasswordIcon");

            if (toggleBtn && passwordInput && icon) {
                toggleBtn.addEventListener("click", function () {
                    const type = passwordInput.getAttribute("type") === "password" ? "text" : "password";
                    passwordInput.setAttribute("type", type);
                    
                    if (type === "text") {
                        icon.classList.remove("bi-eye");
                        icon.classList.add("bi-eye-slash");
                    } else {
                        icon.classList.remove("bi-eye-slash");
                        icon.classList.add("bi-eye");
                    }
                });
            }
        });
    </script>
</body>

</html>
