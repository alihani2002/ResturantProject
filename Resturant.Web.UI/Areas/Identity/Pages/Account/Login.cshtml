@page
@model LoginModel

@{
    Layout = null;
    ViewData["Title"] = "Log in";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Access your TestResturant Portal and manage your experience.">
    <meta name="keyword" content="Restaurant, Login, Admin, Dashboard">
    <meta name="author" content="Qore">
    
    <title>Qore || Login</title>
    
    <!--! BEGIN: Favicon-->
    <link rel="icon" type="image/png" href="~/assets/images/q.png">
    
    <!--! BEGIN: Bootstrap CSS-->
    <link rel="stylesheet" type="text/css" href="~/assets/css/bootstrap.min.css">
    <!--! END: Bootstrap CSS-->
    
    <!--! BEGIN: Vendors CSS-->
    <link rel="stylesheet" type="text/css" href="~/assets/vendors/css/vendors.min.css">
    <!--! END: Vendors CSS-->
    
    <!--! BEGIN: Custom CSS-->
    <link rel="stylesheet" type="text/css" href="~/assets/css/theme.min.css">
    <!--! END: Custom CSS-->
    
    <!--! BEGIN: Google Fonts & Bootstrap Icons-->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <!--! END: Google Fonts & Bootstrap Icons-->

    <style>
            :root {
                --gold-primary: #d4a017;
                --gold-secondary: #b8860b;
                --gold-light: #f7e7b6;
                --gold-glow: rgba(212, 160, 23, 0.15);
                --bg-main: #f5f7fb;
                --glass-bg: rgba(255, 255, 255, 0.72);
                --glass-border: rgba(15, 23, 42, 0.06);
                --input-bg: #ffffff;
                --input-border: rgba(15, 23, 42, 0.08);
                --text-main: #0f172a;
                --text-muted: #64748b;
            }

            * {
                box-sizing: border-box;
            }

            body {
                font-family: 'Outfit', sans-serif;
                background: radial-gradient(circle at top left, rgba(212,160,23,0.08), transparent 30%), radial-gradient(circle at bottom right, rgba(212,160,23,0.06), transparent 30%), var(--bg-main);
                color: var(--text-main);
                overflow-x: hidden;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                position: relative;
                margin: 0;
                padding: 0;
            }

            /* BACKGROUND ORBS */

            .bg-glow-orb {
                position: absolute;
                width: 600px;
                height: 600px;
                border-radius: 50%;
                background: radial-gradient(circle, rgba(212,160,23,0.12) 0%, rgba(212,160,23,0) 70%);
                filter: blur(80px);
                z-index: -1;
                pointer-events: none;
                animation: floatOrb 25s infinite alternate ease-in-out;
            }

            .orb-1 {
                top: -15%;
                left: -15%;
            }

            .orb-2 {
                bottom: -15%;
                right: -15%;
                animation-delay: -12s;
            }

            @@keyframes floatOrb {
                0% {
                    transform: translate(0, 0) scale(1);
                }

                100% {
                    transform: translate(80px, 60px) scale(1.15);
                }
            }

            /* WRAPPER */

            .auth-container-wrapper {
                display: flex;
                align-items: center;
                justify-content: center;
                width: 100%;
                padding: 2rem;
                z-index: 10;
            }

            /* MAIN CARD */

            .auth-container {
                width: 100%;
                max-width: 1140px;
                min-height: 660px;
                border-radius: 32px;
                overflow: hidden;
                background: var(--glass-bg);
                border: 1px solid rgba(255,255,255,0.4);
                backdrop-filter: blur(20px);
                -webkit-backdrop-filter: blur(20px);
                box-shadow: 0 20px 60px rgba(15, 23, 42, 0.08), 0 8px 24px rgba(15, 23, 42, 0.04);
                display: flex;
                position: relative;
            }

            /* LEFT SIDE */

            .brand-panel {
                flex: 1.1;
                background: linear-gradient( 135deg, rgba(255,255,255,0.94) 0%, rgba(248,250,252,0.92) 100% ), url('/assets/images/auth/auth-cover-login-bg.svg');
                background-size: cover;
                background-position: center;
                position: relative;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                padding: 4.5rem;
                border-right: 1px solid rgba(15,23,42,0.06);
                overflow: hidden;
            }

                .brand-panel::before {
                    content: '';
                    position: absolute;
                    inset: 0;
                    background: radial-gradient(circle at 20% 30%, rgba(212,160,23,0.08) 0%, transparent 60%);
                    pointer-events: none;
                }

            .brand-header {
                z-index: 2;
                display: flex;
                align-items: center;
                gap: 14px;
            }

            .brand-logo-img {
                height: 46px;
                filter: drop-shadow(0 0 12px rgba(212,160,23,0.25));
                transition: transform 0.4s ease;
            }

                .brand-logo-img:hover {
                    transform: scale(1.08);
                }

            .brand-name {
                font-size: 1.45rem;
                font-weight: 800;
                letter-spacing: 2px;
                color: var(--text-main);
                text-transform: uppercase;
                margin: 0;
            }

                .brand-name span {
                    color: var(--gold-primary);
                }

            .brand-body {
                z-index: 2;
                margin: auto 0;
            }

            .brand-badge {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                background: rgba(212,160,23,0.08);
                border: 1px solid rgba(212,160,23,0.16);
                color: var(--gold-primary);
                padding: 6px 14px;
                border-radius: 30px;
                font-size: 0.8rem;
                font-weight: 600;
                margin-bottom: 1.5rem;
            }

            .brand-title {
                font-family: 'Playfair Display', serif;
                font-size: 3.2rem;
                font-weight: 700;
                line-height: 1.2;
                margin-bottom: 1.25rem;
                color: var(--text-main);
            }

                .brand-title span {
                    display: block;
                    color: var(--gold-primary);
                    font-style: italic;
                    font-weight: 500;
                }

            .brand-desc {
                font-size: 1rem;
                color: var(--text-muted);
                line-height: 1.8;
                max-width: 460px;
            }

            .brand-footer {
                z-index: 2;
                display: flex;
                justify-content: space-between;
                align-items: center;
                border-top: 1px solid rgba(15,23,42,0.06);
                padding-top: 1.5rem;
            }

            .brand-footer-text {
                font-size: 0.82rem;
                color: var(--text-muted);
            }

            /* RIGHT SIDE */

            .form-panel {
                flex: 0.9;
                display: flex;
                flex-direction: column;
                justify-content: center;
                padding: 4.5rem;
                background: rgba(255,255,255,0.45);
                position: relative;
            }

            .form-header {
                margin-bottom: 2.25rem;
            }

            .form-title {
                font-size: 2.2rem;
                font-weight: 700;
                color: var(--text-main);
                margin-bottom: 0.5rem;
            }

            .form-subtitle {
                color: var(--text-muted);
                font-size: 0.95rem;
            }

            /* FORM */

            .form-group-custom {
                position: relative;
                margin-bottom: 1.5rem;
            }

            .form-control-custom {
                width: 100%;
                background-color: var(--input-bg) !important;
                border: 1px solid var(--input-border) !important;
                border-radius: 18px !important;
                padding: 15px 16px 15px 50px !important;
                color: var(--text-main) !important;
                font-size: 0.95rem !important;
                transition: all 0.3s ease !important;
                box-shadow: none !important;
            }

                .form-control-custom::placeholder {
                    color: rgba(15,23,42,0.4);
                }

                .form-control-custom:focus {
                    border-color: var(--gold-primary) !important;
                    background-color: #ffffff !important;
                    box-shadow: 0 0 0 4px rgba(212,160,23,0.12) !important;
                    outline: none !important;
                }

            .form-icon-custom {
                position: absolute;
                left: 18px;
                top: 50%;
                transform: translateY(-50%);
                color: rgba(15,23,42,0.35);
                font-size: 1.1rem;
                display: flex;
                align-items: center;
            }

            .password-toggle-btn {
                position: absolute;
                right: 18px;
                top: 50%;
                transform: translateY(-50%);
                background: none;
                border: none;
                color: rgba(15,23,42,0.45);
                cursor: pointer;
                font-size: 1.1rem;
            }

            /* CHECKBOX */

            .checkbox-container-custom {
                display: flex;
                align-items: center;
                cursor: pointer;
            }

                .checkbox-container-custom input {
                    display: none;
                }

            .checkmark-custom {
                width: 20px;
                height: 20px;
                border-radius: 6px;
                background: white;
                border: 1px solid rgba(15,23,42,0.1);
                margin-right: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                transition: all 0.3s ease;
            }

            .checkbox-container-custom input:checked ~ .checkmark-custom {
                background: var(--gold-primary);
                border-color: var(--gold-primary);
                box-shadow: 0 0 10px rgba(212,160,23,0.25);
            }

            .checkmark-custom::after {
                content: "\F26E";
                font-family: "bootstrap-icons";
                font-size: 0.75rem;
                color: #ffffff;
                display: none;
            }

            .checkbox-container-custom input:checked ~ .checkmark-custom::after {
                display: block;
            }

            .checkbox-label-text {
                color: var(--text-muted);
                font-size: 0.9rem;
            }

            /* LINKS */

            .link-gold {
                color: var(--gold-primary);
                font-size: 0.9rem;
                font-weight: 500;
                text-decoration: none;
                transition: 0.3s ease;
            }

                .link-gold:hover {
                    color: var(--gold-secondary);
                }

            /* BUTTON */

            .btn-gold-gradient {
                width: 100%;
                background: linear-gradient( 135deg, var(--gold-primary) 0%, var(--gold-secondary) 100% ) !important;
                border: none !important;
                border-radius: 18px !important;
                padding: 15px 20px !important;
                color: white !important;
                font-weight: 700 !important;
                font-size: 1rem !important;
                letter-spacing: 0.5px !important;
                box-shadow: 0 12px 30px rgba(212,160,23,0.22) !important;
                transition: all 0.3s ease !important;
            }

                .btn-gold-gradient:hover {
                    transform: translateY(-2px) !important;
                    box-shadow: 0 16px 40px rgba(212,160,23,0.35) !important;
                }

            /* VALIDATION */

            .validation-summary-custom {
                background: rgba(239, 68, 68, 0.06);
                border: 1px solid rgba(239, 68, 68, 0.15);
                border-radius: 14px;
                padding: 12px 16px;
                margin-bottom: 1.5rem;
            }

                .validation-summary-custom ul {
                    margin: 0;
                    padding-left: 1rem;
                    color: #ef4444;
                }

            .validation-field-error-custom {
                color: #ef4444;
                font-size: 0.8rem;
                margin-top: 0.4rem;
                display: block;
            }

            /* RESPONSIVE */

            @@media (max-width: 991.98px) {

                .auth-container {
                    flex-direction: column;
                }

                .brand-panel {
                    border-right: none;
                    border-bottom: 1px solid rgba(15,23,42,0.06);
                }
            }

            @@media (max-width: 575.98px) {

                .auth-container-wrapper {
                    padding: 1rem;
                }

                .brand-panel {
                    display: none;
                }

                .auth-container {
                    background: transparent;
                    border: none;
                    box-shadow: none;
                    backdrop-filter: none;
                }

                .form-panel {
                    border-radius: 28px;
                    background: rgba(255,255,255,0.92);
                    box-shadow: 0 20px 50px rgba(15,23,42,0.08);
                    padding: 3rem 1.75rem;
                }
            }
    </style>
</head>

<body>
    <!-- Atmospheric glowing backgrounds -->
    <div class="bg-glow-orb orb-1"></div>
    <div class="bg-glow-orb orb-2"></div>

    <main class="auth-container-wrapper">
        <div class="auth-container">
            
            <!-- Left Branding Panel (Desktop Only) -->
            <div class="brand-panel">
                <div class="brand-header">
                    <img src="~/assets/images/Qore.png" alt="Qore Logo" class="brand-logo-img" onerror="this.src='/assets/images/logo-abbr.png'">
                    <h1 class="brand-name"><span>ELDIWAN</span></h1>
                </div>
                
                <div class="brand-body">
                    <div class="brand-badge">
                        <i class="bi bi-patch-check"></i> Enterprise Certified Portal
                    </div>
                    <h2 class="brand-title">
                        Savor the <span>Masterpiece</span> of Culinary Analytics
                    </h2>
                    <p class="brand-desc">
                        Welcome back to your high-performance command center. Access real-time intelligence, coordinate services, and deliver unparalleled gastronomic experiences.
                    </p>
                </div>
                
                <div class="brand-footer">
                    <div class="brand-footer-text">
                        © 2026 QORE — Powered by CORVENT
                    </div>
                    <div class="brand-footer-text">
                        
                    </div>
                </div>
            </div>

            <!-- Right Login Form Panel -->
            <div class="form-panel">
                <div class="form-header">
                    <h2 class="form-title">Portal Sign In</h2>
                    <p class="form-subtitle">Enter your credential to access your dashboard</p>
                </div>

                <form id="account" method="post">
                    <!-- Validation Summary -->
                    <div asp-validation-summary="ModelOnly" class="validation-summary-custom text-danger" role="alert"></div>

                    <!-- Email / Username Input -->
                    <div class="form-group-custom">
                        <input asp-for="Input.Email" class="form-control-custom" placeholder="Email or Username" autocomplete="username" aria-required="true" />
                        <span class="form-icon-custom"><i class="bi bi-envelope"></i></span>
                        <span asp-validation-for="Input.Email" class="validation-field-error-custom"></span>
                    </div>

                    <!-- Password Input -->
                    <div class="form-group-custom">
                        <input asp-for="Input.Password" class="form-control-custom" id="loginPassword" placeholder="Password" autocomplete="current-password" aria-required="true" />
                        <span class="form-icon-custom"><i class="bi bi-lock"></i></span>
                        <button type="button" class="password-toggle-btn" id="togglePasswordBtn" tabindex="-1" aria-label="Toggle Password Visibility">
                            <i class="bi bi-eye" id="togglePasswordIcon"></i>
                        </button>
                        <span asp-validation-for="Input.Password" class="validation-field-error-custom"></span>
                    </div>

                    <!-- Options Flex (Remember Me & Forgot Password) -->
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <label class="checkbox-container-custom">
                            <input type="checkbox" id="rememberMe" asp-for="Input.RememberMe">
                            <span class="checkmark-custom"></span>
                            <span class="checkbox-label-text">@Html.DisplayNameFor(m => m.Input.RememberMe)</span>
                        </label>
                        <div>
                            <a id="forgot-password" asp-page="./ForgotPassword" class="link-gold">Forgot password?</a>
                        </div>
                    </div>

                    <!-- Sign In Submit Button -->
                    <div class="mt-4 pt-1">
                        <button type="submit" class="btn btn-gold-gradient">Login to Portal</button>
                    </div>
                </form>

               
            </div>

        </div>
    </main>

    <!--! ================================================================ !-->
    <!--! BEGIN: Theme Customizer !-->
    <!--! ================================================================ !-->
    <div class="theme-customizer d-none">
        <div class="customizer-handle">
            <a href="javascript:void(0);" class="cutomizer-open-trigger bg-primary">
                <i class="feather-settings"></i>
            </a>
        </div>
        <div class="customizer-sidebar-wrapper">
            <div class="customizer-sidebar-header px-4 ht-80 border-bottom d-flex align-items-center justify-content-between">
                <h5 class="mb-0">Theme Settings</h5>
                <a href="javascript:void(0);" class="cutomizer-close-trigger d-flex">
                    <i class="feather-x"></i>
                </a>
            </div>
            <div class="customizer-sidebar-body position-relative p-4" data-scrollbar-target="#psScrollbarInit">
                <div class="position-relative px-3 pb-3 pt-4 mt-3 mb-5 border border-gray-2 theme-options-set">
                    <label class="py-1 px-2 fs-8 fw-bold text-uppercase text-muted text-spacing-2 bg-white border border-gray-2 position-absolute rounded-2 options-label" style="top: -12px">Skins</label>
                    <div class="row g-2 theme-options-items app-skin" id="appSkinList">
                        <div class="col-6 text-center position-relative single-option light-button active">
                            <input type="radio" class="btn-check" id="app-skin-light" name="app-skin" value="1" data-app-skin="app-skin-light">
                            <label class="py-2 fs-9 fw-bold text-dark text-uppercase text-spacing-1 border border-gray-2 w-100 h-100 c-pointer position-relative options-label" for="app-skin-light">Light</label>
                        </div>
                        <div class="col-6 text-center position-relative single-option dark-button">
                            <input type="radio" class="btn-check" id="app-skin-dark" name="app-skin" value="2" data-app-skin="app-skin-dark">
                            <label class="py-2 fs-9 fw-bold text-dark text-uppercase text-spacing-1 border border-gray-2 w-100 h-100 c-pointer position-relative options-label" for="app-skin-dark">Dark</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="customizer-sidebar-footer px-4 ht-60 border-top d-flex align-items-center gap-2">
                <div class="flex-fill w-50">
                    <a href="javascript:void(0);" class="btn btn-danger" data-style="reset-all-common-style">Reset</a>
                </div>
            </div>
        </div>
    </div>
    <!--! ================================================================ !-->
    <!--! [End] Theme Customizer !-->
    <!--! ================================================================ !-->

    <!--! ================================================================ !-->
    <!--! Footer Script !-->
    <!--! ================================================================ !-->
    <!--! BEGIN: Vendors JS !-->
    <script src="~/assets/vendors/js/vendors.min.js"></script>
    <!-- vendors.min.js {always must need to be top} -->
    <!--! END: Vendors JS !-->
    <!--! BEGIN: Apps Init !-->
    <script src="~/assets/js/common-init.min.js"></script>
    <!--! END: Apps Init !-->
    <!--! BEGIN: Theme Customizer !-->
    <script src="~/assets/js/theme-customizer-init.min.js"></script>
    <!--! END: Theme Customizer !-->

    <!-- Custom password toggler logic -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const toggleBtn = document.getElementById("togglePasswordBtn");
            const passwordInput = document.getElementById("loginPassword");
            const icon = document.getElementById("togglePasswordIcon");

            if (toggleBtn && passwordInput && icon) {
                toggleBtn.addEventListener("click", function () {
                    const type = passwordInput.getAttribute("type") === "password" ? "text" : "password";
                    passwordInput.setAttribute("type", type);
                    
                    if (type === "text") {
                        icon.classList.remove("bi-eye");
                        icon.classList.add("bi-eye-slash");
                    } else {
                        icon.classList.remove("bi-eye-slash");
                        icon.classList.add("bi-eye");
                    }
                });
            }
        });
    </script>
</body>

</html>
