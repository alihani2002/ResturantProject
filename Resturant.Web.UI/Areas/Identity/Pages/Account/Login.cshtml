@page
@model LoginModel

@{
    Layout = null;
    ViewData["Title"] = "Log in";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Access your TestResturant Portal and manage your experience.">
    <meta name="keyword" content="Restaurant, Login, Admin, Dashboard">
    <meta name="author" content="Qore">
    
    <title>Qore || Login</title>
    
    <!--! BEGIN: Favicon-->
    <link rel="shortcut icon" type="image/x-icon" href="~/assets/images/favicon.ico">
    <!--! END: Favicon-->
    
    <!--! BEGIN: Bootstrap CSS-->
    <link rel="stylesheet" type="text/css" href="~/assets/css/bootstrap.min.css">
    <!--! END: Bootstrap CSS-->
    
    <!--! BEGIN: Vendors CSS-->
    <link rel="stylesheet" type="text/css" href="~/assets/vendors/css/vendors.min.css">
    <!--! END: Vendors CSS-->
    
    <!--! BEGIN: Custom CSS-->
    <link rel="stylesheet" type="text/css" href="~/assets/css/theme.min.css">
    <!--! END: Custom CSS-->
    
    <!--! BEGIN: Google Fonts & Bootstrap Icons-->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <!--! END: Google Fonts & Bootstrap Icons-->

    <style>
        :root {
            --gold-primary: #d4af37;
            --gold-secondary: #aa7c11;
            --gold-light: #f3e5ab;
            --gold-glow: rgba(212, 175, 55, 0.2);
            --dark-bg: #070708;
            --dark-card: rgba(18, 18, 20, 0.6);
            --dark-card-border: rgba(212, 175, 55, 0.15);
            --input-bg: rgba(20, 20, 22, 0.8);
            --input-border: rgba(255, 255, 255, 0.08);
            --text-main: #f4f4f5;
            --text-muted: #9ea0a5;
        }

        body {
            font-family: 'Outfit', sans-serif;
            background-color: var(--dark-bg);
            color: var(--text-main);
            overflow-x: hidden;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            margin: 0;
            padding: 0;
        }

        /* Animated glowing atmospheric background orbs */
        .bg-glow-orb {
            position: absolute;
            width: 600px;
            height: 600px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(212, 175, 55, 0.08) 0%, rgba(212, 175, 55, 0) 70%);
            filter: blur(80px);
            z-index: -1;
            pointer-events: none;
            animation: floatOrb 25s infinite alternate ease-in-out;
        }

        .orb-1 {
            top: -15%;
            left: -15%;
        }

        .orb-2 {
            bottom: -15%;
            right: -15%;
            animation-delay: -12s;
        }

        @@keyframes floatOrb {
            0% {
                transform: translate(0, 0) scale(1);
            }
            100% {
                transform: translate(80px, 60px) scale(1.15);
            }
        }

        /* Main Wrapper container */
        .auth-container-wrapper {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            padding: 2rem;
            z-index: 10;
        }

        .auth-container {
            width: 100%;
            max-width: 1140px;
            min-height: 660px;
            border-radius: 28px;
            overflow: hidden;
            box-shadow: 0 30px 80px rgba(0, 0, 0, 0.85);
            background: rgba(14, 14, 16, 0.45);
            border: 1px solid var(--dark-card-border);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            display: flex;
            position: relative;
        }

        /* Left Panel - Brand / Graphic Column */
        .brand-panel {
            flex: 1.1;
            background: linear-gradient(135deg, rgba(7, 7, 8, 0.94) 0%, rgba(15, 15, 18, 0.88) 100%), 
                        url('/assets/images/auth/auth-cover-login-bg.svg');
            background-size: cover;
            background-position: center;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 4.5rem;
            border-right: 1px solid var(--dark-card-border);
            overflow: hidden;
        }

        .brand-panel::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 20% 30%, rgba(212, 175, 55, 0.12) 0%, transparent 60%);
            pointer-events: none;
        }

        .brand-header {
            z-index: 2;
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .brand-logo-img {
            height: 46px;
            filter: drop-shadow(0 0 12px rgba(212, 175, 55, 0.35));
            transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .brand-logo-img:hover {
            transform: scale(1.15) rotate(5deg);
        }

        .brand-name {
            font-size: 1.45rem;
            font-weight: 800;
            letter-spacing: 2.5px;
            color: #ffffff;
            text-transform: uppercase;
            margin: 0;
        }

        .brand-name span {
            color: var(--gold-primary);
        }

        .brand-body {
            z-index: 2;
            margin: auto 0;
        }

        .brand-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(212, 175, 55, 0.1);
            border: 1px solid rgba(212, 175, 55, 0.2);
            color: var(--gold-primary);
            padding: 6px 14px;
            border-radius: 30px;
            font-size: 0.8rem;
            font-weight: 600;
            letter-spacing: 0.5px;
            margin-bottom: 1.5rem;
        }

        .brand-title {
            font-family: 'Playfair Display', serif;
            font-size: 3.25rem;
            font-weight: 700;
            line-height: 1.2;
            margin-bottom: 1.25rem;
            color: #ffffff;
        }

        .brand-title span {
            display: block;
            color: var(--gold-primary);
            font-style: italic;
            font-weight: 400;
            font-family: 'Playfair Display', serif;
        }

        .brand-desc {
            font-size: 1.05rem;
            color: var(--text-muted);
            line-height: 1.7;
            max-width: 460px;
            margin-bottom: 0;
        }

        .brand-footer {
            z-index: 2;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            padding-top: 1.75rem;
            margin-top: 2rem;
        }

        .brand-footer-text {
            font-size: 0.82rem;
            color: var(--text-muted);
            letter-spacing: 0.5px;
        }

        /* Right Panel - Form Column */
        .form-panel {
            flex: 0.9;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 4.5rem;
            background: var(--dark-card);
            position: relative;
        }

        .form-header {
            margin-bottom: 2.25rem;
        }

        .form-title {
            font-size: 2.1rem;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 0.5rem;
            letter-spacing: -0.5px;
        }

        .form-subtitle {
            color: var(--text-muted);
            font-size: 0.95rem;
        }

        .form-group-custom {
            position: relative;
            margin-bottom: 1.5rem;
        }

        .form-control-custom {
            width: 100%;
            background-color: var(--input-bg) !important;
            border: 1px solid var(--input-border) !important;
            border-radius: 14px !important;
            padding: 15px 16px 15px 48px !important;
            color: #ffffff !important;
            font-size: 0.95rem !important;
            transition: all 0.3s cubic-bezier(0.2, 0, 0, 1) !important;
            box-shadow: none !important;
        }

        .form-control-custom::placeholder {
            color: rgba(255, 255, 255, 0.35);
        }

        .form-control-custom:focus {
            border-color: var(--gold-primary) !important;
            background-color: rgba(20, 20, 22, 0.95) !important;
            box-shadow: 0 0 0 4px var(--gold-glow) !important;
            outline: none !important;
        }

        .form-icon-custom {
            position: absolute;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: rgba(255, 255, 255, 0.35);
            font-size: 1.15rem;
            transition: color 0.3s ease;
            pointer-events: none;
            display: flex;
            align-items: center;
        }

        .form-control-custom:focus + .form-icon-custom {
            color: var(--gold-primary);
        }

        /* Password Toggle */
        .password-toggle-btn {
            position: absolute;
            right: 18px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: rgba(255, 255, 255, 0.35);
            cursor: pointer;
            font-size: 1.15rem;
            padding: 0;
            transition: color 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 10;
        }

        .password-toggle-btn:hover {
            color: var(--gold-primary);
        }

        /* Custom Checkbox */
        .checkbox-container-custom {
            display: flex;
            align-items: center;
            cursor: pointer;
            user-select: none;
        }

        .checkbox-container-custom input {
            position: absolute;
            opacity: 0;
            cursor: pointer;
            height: 0;
            width: 0;
        }

        .checkmark-custom {
            height: 20px;
            width: 20px;
            background-color: var(--input-bg);
            border: 1px solid var(--input-border);
            border-radius: 6px;
            margin-right: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.25s ease;
        }

        .checkbox-container-custom:hover input ~ .checkmark-custom {
            border-color: rgba(212, 175, 55, 0.4);
        }

        .checkbox-container-custom input:checked ~ .checkmark-custom {
            background-color: var(--gold-primary);
            border-color: var(--gold-primary);
            box-shadow: 0 0 10px var(--gold-glow);
        }

        .checkmark-custom::after {
            content: "\F26E";
            font-family: "bootstrap-icons";
            font-size: 0.8rem;
            color: #000000;
            font-weight: 800;
            display: none;
        }

        .checkbox-container-custom input:checked ~ .checkmark-custom::after {
            display: block;
        }

        .checkbox-label-text {
            color: var(--text-muted);
            font-size: 0.9rem;
            margin: 0;
        }

        /* Links */
        .link-gold {
            color: var(--gold-primary);
            font-size: 0.9rem;
            font-weight: 500;
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .link-gold:hover {
            color: var(--gold-light);
            text-shadow: 0 0 8px rgba(212, 175, 55, 0.35);
        }

        /* Gold Gradient Button */
        .btn-gold-gradient {
            width: 100%;
            background: linear-gradient(135deg, var(--gold-primary) 0%, var(--gold-secondary) 100%) !important;
            border: none !important;
            border-radius: 14px !important;
            padding: 15px 20px !important;
            color: #000000 !important;
            font-weight: 700 !important;
            font-size: 1rem !important;
            letter-spacing: 0.75px !important;
            text-transform: uppercase !important;
            box-shadow: 0 8px 24px rgba(212, 175, 55, 0.25) !important;
            transition: all 0.3s cubic-bezier(0.2, 0, 0, 1) !important;
            cursor: pointer !important;
        }

        .btn-gold-gradient:hover {
            transform: translateY(-2px) !important;
            box-shadow: 0 12px 30px rgba(212, 175, 55, 0.45) !important;
        }

        .btn-gold-gradient:active {
            transform: translateY(1px) !important;
        }

        /* Social Divider */
        .divider-custom {
            position: relative;
            text-align: center;
            margin: 2.25rem 0;
        }

        .divider-custom::before {
            content: '';
            position: absolute;
            left: 0;
            top: 50%;
            width: 100%;
            height: 1px;
            background: rgba(255, 255, 255, 0.08);
            z-index: 1;
        }

        .divider-custom span {
            position: relative;
            background-color: #121214;
            padding: 0 16px;
            color: var(--text-muted);
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            z-index: 2;
        }

        .social-flex {
            display: flex;
            gap: 12px;
        }

        .btn-social-custom {
            flex: 1;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid var(--input-border);
            border-radius: 14px;
            padding: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-main);
            font-size: 1.25rem;
            transition: all 0.3s ease;
            text-decoration: none;
        }

        .btn-social-custom:hover {
            background: rgba(212, 175, 55, 0.06);
            border-color: rgba(212, 175, 55, 0.3);
            color: var(--gold-primary);
            transform: translateY(-2px);
        }

        /* Validation UI styling */
        .validation-summary-custom {
            background: rgba(239, 68, 68, 0.07);
            border: 1px solid rgba(239, 68, 68, 0.2);
            border-radius: 12px;
            padding: 12px 16px;
            margin-bottom: 1.5rem;
        }

        .validation-summary-custom ul {
            margin: 0;
            padding-left: 1.2rem;
            color: #f87171;
            font-size: 0.88rem;
        }

        .validation-field-error-custom {
            color: #f87171;
            font-size: 0.8rem;
            margin-top: 0.4rem;
            display: block;
        }

        /* Responsive Layouts */
        @@media (max-width: 991.98px) {
            .auth-container {
                flex-direction: column;
                margin: 1rem;
                min-height: auto;
            }

            .brand-panel {
                padding: 3.5rem 2.5rem;
                border-right: none;
                border-bottom: 1px solid var(--dark-card-border);
            }

            .brand-title {
                font-size: 2.6rem;
            }

            .form-panel {
                padding: 3.5rem 2.5rem;
            }
        }

        @@media (max-width: 575.98px) {
            .auth-container-wrapper {
                padding: 1rem;
            }

            .brand-panel {
                display: none; /* Focus strictly on login card on mobile devices */
            }

            .auth-container {
                background: transparent;
                border: none;
                box-shadow: none;
                backdrop-filter: none;
                -webkit-backdrop-filter: none;
            }

            .form-panel {
                background: rgba(18, 18, 20, 0.95);
                border: 1px solid var(--dark-card-border);
                border-radius: 24px;
                padding: 3rem 1.75rem;
                box-shadow: 0 25px 60px rgba(0, 0, 0, 0.7);
            }
        }
    </style>
</head>

<body>
    <!-- Atmospheric glowing backgrounds -->
    <div class="bg-glow-orb orb-1"></div>
    <div class="bg-glow-orb orb-2"></div>

    <main class="auth-container-wrapper">
        <div class="auth-container">
            
            <!-- Left Branding Panel (Desktop Only) -->
            <div class="brand-panel">
                <div class="brand-header">
                    <img src="~/assets/images/QORELogo.png" alt="Qore Logo" class="brand-logo-img" onerror="this.src='/assets/images/logo-abbr.png'">
                    <h1 class="brand-name">QORE<span>Resturant</span></h1>
                </div>
                
                <div class="brand-body">
                    <div class="brand-badge">
                        <i class="bi bi-patch-check"></i> Enterprise Certified Portal
                    </div>
                    <h2 class="brand-title">
                        Savor the <span>Masterpiece</span> of Culinary Analytics
                    </h2>
                    <p class="brand-desc">
                        Welcome back to your high-performance command center. Access real-time intelligence, coordinate services, and deliver unparalleled gastronomic experiences.
                    </p>
                </div>
                
                <div class="brand-footer">
                    <div class="brand-footer-text">
                        © 2026 QORE Resturant Group
                    </div>
                    <div class="brand-footer-text">
                        v2.4.0
                    </div>
                </div>
            </div>

            <!-- Right Login Form Panel -->
            <div class="form-panel">
                <div class="form-header">
                    <h2 class="form-title">Portal Sign In</h2>
                    <p class="form-subtitle">Enter your credential to access your dashboard</p>
                </div>

                <form id="account" method="post">
                    <!-- Validation Summary -->
                    <div asp-validation-summary="ModelOnly" class="validation-summary-custom text-danger" role="alert"></div>

                    <!-- Email / Username Input -->
                    <div class="form-group-custom">
                        <input asp-for="Input.Email" class="form-control-custom" placeholder="Email or Username" autocomplete="username" aria-required="true" />
                        <span class="form-icon-custom"><i class="bi bi-envelope"></i></span>
                        <span asp-validation-for="Input.Email" class="validation-field-error-custom"></span>
                    </div>

                    <!-- Password Input -->
                    <div class="form-group-custom">
                        <input asp-for="Input.Password" class="form-control-custom" id="loginPassword" placeholder="Password" autocomplete="current-password" aria-required="true" />
                        <span class="form-icon-custom"><i class="bi bi-lock"></i></span>
                        <button type="button" class="password-toggle-btn" id="togglePasswordBtn" tabindex="-1" aria-label="Toggle Password Visibility">
                            <i class="bi bi-eye" id="togglePasswordIcon"></i>
                        </button>
                        <span asp-validation-for="Input.Password" class="validation-field-error-custom"></span>
                    </div>

                    <!-- Options Flex (Remember Me & Forgot Password) -->
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <label class="checkbox-container-custom">
                            <input type="checkbox" id="rememberMe" asp-for="Input.RememberMe">
                            <span class="checkmark-custom"></span>
                            <span class="checkbox-label-text">@Html.DisplayNameFor(m => m.Input.RememberMe)</span>
                        </label>
                        <div>
                            <a id="forgot-password" asp-page="./ForgotPassword" class="link-gold">Forgot password?</a>
                        </div>
                    </div>

                    <!-- Sign In Submit Button -->
                    <div class="mt-4 pt-1">
                        <button type="submit" class="btn btn-gold-gradient">Login to Portal</button>
                    </div>
                </form>

               
            </div>

        </div>
    </main>

    <!--! ================================================================ !-->
    <!--! BEGIN: Theme Customizer !-->
    <!--! ================================================================ !-->
    <div class="theme-customizer d-none">
        <div class="customizer-handle">
            <a href="javascript:void(0);" class="cutomizer-open-trigger bg-primary">
                <i class="feather-settings"></i>
            </a>
        </div>
        <div class="customizer-sidebar-wrapper">
            <div class="customizer-sidebar-header px-4 ht-80 border-bottom d-flex align-items-center justify-content-between">
                <h5 class="mb-0">Theme Settings</h5>
                <a href="javascript:void(0);" class="cutomizer-close-trigger d-flex">
                    <i class="feather-x"></i>
                </a>
            </div>
            <div class="customizer-sidebar-body position-relative p-4" data-scrollbar-target="#psScrollbarInit">
                <div class="position-relative px-3 pb-3 pt-4 mt-3 mb-5 border border-gray-2 theme-options-set">
                    <label class="py-1 px-2 fs-8 fw-bold text-uppercase text-muted text-spacing-2 bg-white border border-gray-2 position-absolute rounded-2 options-label" style="top: -12px">Skins</label>
                    <div class="row g-2 theme-options-items app-skin" id="appSkinList">
                        <div class="col-6 text-center position-relative single-option light-button active">
                            <input type="radio" class="btn-check" id="app-skin-light" name="app-skin" value="1" data-app-skin="app-skin-light">
                            <label class="py-2 fs-9 fw-bold text-dark text-uppercase text-spacing-1 border border-gray-2 w-100 h-100 c-pointer position-relative options-label" for="app-skin-light">Light</label>
                        </div>
                        <div class="col-6 text-center position-relative single-option dark-button">
                            <input type="radio" class="btn-check" id="app-skin-dark" name="app-skin" value="2" data-app-skin="app-skin-dark">
                            <label class="py-2 fs-9 fw-bold text-dark text-uppercase text-spacing-1 border border-gray-2 w-100 h-100 c-pointer position-relative options-label" for="app-skin-dark">Dark</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="customizer-sidebar-footer px-4 ht-60 border-top d-flex align-items-center gap-2">
                <div class="flex-fill w-50">
                    <a href="javascript:void(0);" class="btn btn-danger" data-style="reset-all-common-style">Reset</a>
                </div>
            </div>
        </div>
    </div>
    <!--! ================================================================ !-->
    <!--! [End] Theme Customizer !-->
    <!--! ================================================================ !-->

    <!--! ================================================================ !-->
    <!--! Footer Script !-->
    <!--! ================================================================ !-->
    <!--! BEGIN: Vendors JS !-->
    <script src="~/assets/vendors/js/vendors.min.js"></script>
    <!-- vendors.min.js {always must need to be top} -->
    <!--! END: Vendors JS !-->
    <!--! BEGIN: Apps Init !-->
    <script src="~/assets/js/common-init.min.js"></script>
    <!--! END: Apps Init !-->
    <!--! BEGIN: Theme Customizer !-->
    <script src="~/assets/js/theme-customizer-init.min.js"></script>
    <!--! END: Theme Customizer !-->

    <!-- Custom password toggler logic -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const toggleBtn = document.getElementById("togglePasswordBtn");
            const passwordInput = document.getElementById("loginPassword");
            const icon = document.getElementById("togglePasswordIcon");

            if (toggleBtn && passwordInput && icon) {
                toggleBtn.addEventListener("click", function () {
                    const type = passwordInput.getAttribute("type") === "password" ? "text" : "password";
                    passwordInput.setAttribute("type", type);
                    
                    if (type === "text") {
                        icon.classList.remove("bi-eye");
                        icon.classList.add("bi-eye-slash");
                    } else {
                        icon.classList.remove("bi-eye-slash");
                        icon.classList.add("bi-eye");
                    }
                });
            }
        });
    </script>
</body>

</html>
