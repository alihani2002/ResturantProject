        // Products Ledger State Variables
        let prodSearchTerm = '';
        let prodCategoryFilter = '';
        let prodSortField = 'salesCount';
        let prodSortAsc = false;
        let prodPage = 1;
        const prodPageSize = 8;
        let globalAllProducts = [];

        function filterProductsLedger() {
            prodSearchTerm = document.getElementById('prod-search').value.toLowerCase();
            prodCategoryFilter = document.getElementById('prod-filter-category').value;
            prodPage = 1;
            renderProductsLedgerTable();
        }

        function sortProductsLedger(field) {
            if (prodSortField === field) {
                prodSortAsc = !prodSortAsc;
            } else {
                prodSortField = field;
                prodSortAsc = true;
            }
            renderProductsLedgerTable();
        }

        function paginateProducts(direction) {
            if (direction === 'prev' && prodPage > 1) {
                prodPage--;
            } else if (direction === 'next' && prodPage * prodPageSize < getFilteredProductsCount()) {
                prodPage++;
            }
            renderProductsLedgerTable();
        }

        function getFilteredProductsCount() {
            return globalAllProducts.filter(p => {
                const matchSearch = (p.productName || '').toLowerCase().includes(prodSearchTerm);
                const matchCategory = !prodCategoryFilter || p.categoryName === prodCategoryFilter;
                return matchSearch && matchCategory;
            }).length;
        }

        function renderProductsLedgerTable() {
            const tbody = document.querySelector('#table-products-ledger tbody');
            if (!tbody) return;
            tbody.innerHTML = '';

            let filtered = globalAllProducts.filter(p => {
                const matchSearch = (p.productName || '').toLowerCase().includes(prodSearchTerm);
                const matchCategory = !prodCategoryFilter || p.categoryName === prodCategoryFilter;
                return matchSearch && matchCategory;
            });

            // Sort
            filtered.sort((a, b) => {
                let valA = a[prodSortField];
                let valB = b[prodSortField];

                if (typeof valA === 'string') {
                    valA = valA.toLowerCase();
                    valB = (valB || '').toLowerCase();
                }

                if (valA < valB) return prodSortAsc ? -1 : 1;
                if (valA > valB) return prodSortAsc ? 1 : -1;
                return 0;
            });

            const totalCount = filtered.length;
            const startIdx = (prodPage - 1) * prodPageSize;
            const endIdx = Math.min(startIdx + prodPageSize, totalCount);

            document.getElementById('prod-pagination-info').textContent = 
                `Showing ${totalCount > 0 ? startIdx + 1 : 0} to ${endIdx} of ${totalCount} products`;

            document.querySelector("button[onclick=\"paginateProducts('prev')\"]").disabled = (prodPage === 1);
            document.querySelector("button[onclick=\"paginateProducts('next')\"]").disabled = (endIdx >= totalCount);

            const pageSlice = filtered.slice(startIdx, endIdx);
            if (pageSlice.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="py-6 text-center text-slate-400">No menu items found matching current parameters.</td></tr>`;
                return;
            }

            pageSlice.forEach(p => {
                const tr = `
                    <tr class="border-b border-slate-100 dark:border-darkBorder hover:bg-slate-50 dark:hover:bg-slate-900 transition-colors">
                        <td class="py-3 font-semibold text-slate-800 dark:text-slate-100">${p.productName}</td>
                        <td class="py-3 font-medium text-slate-450 dark:text-slate-400">${p.categoryName}</td>
                        <td class="py-3 text-center font-bold">${p.salesCount} sold</td>
                        <td class="py-3 text-right font-semibold">${(p.price ?? 0).toFixed(2)} L.E.</td>
                        <td class="py-3 text-right font-extrabold text-slate-900 dark:text-white">${p.revenue.toFixed(2)} L.E.</td>
                        <td class="py-3 text-right font-bold text-emerald-500">${p.profit.toFixed(2)} L.E.</td>
                        <td class="py-3 text-right">
                            <button onclick="openProductAnalyticsModal('${p.productId}')" class="px-2.5 py-1 bg-brand-500/10 hover:bg-brand-500 hover:text-white text-brand-600 dark:text-brand-400 rounded-lg font-bold text-[10px] transition-all border border-brand-500/20">
                                <i class="bi bi-graph-up mr-0.5"></i> Yield
                            </button>
                        </td>
                    </tr>
                `;
                tbody.insertAdjacentHTML('beforeend', tr);
            });
        }

