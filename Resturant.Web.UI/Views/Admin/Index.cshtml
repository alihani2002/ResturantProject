        // Render TAB 3: PRODUCT PROFITS
        function renderProductsReport(data) {
            // Badges
            if (data.bestSellers && data.bestSellers.length > 0) {
                document.getElementById('badge-best-seller').textContent = data.bestSellers[0].productName;
                document.getElementById('badge-best-seller-stats').textContent = `${data.bestSellers[0].salesCount} portions sold (${data.bestSellers[0].revenue.toFixed(2)} L.E.)`;
            }
            if (data.trendingProducts && data.trendingProducts.length > 0) {
                document.getElementById('badge-trending').textContent = data.trendingProducts[0].productName;
                document.getElementById('badge-trending-stats').textContent = `Popularity score index: ${data.trendingProducts[0].popularityScore}`;
            }
            if (data.bestSellers && data.bestSellers.length > 1) {
                document.getElementById('badge-recommended').textContent = data.bestSellers[1].productName;
            }

            const upsellRate = (data.upsellPerformanceRate ?? 0).toFixed(1);
            const upsellSpan = document.getElementById('badge-upsell-rate');
            if (upsellSpan) upsellSpan.textContent = `${upsellRate}%`;
            const upsellDesc = document.getElementById('badge-upsell-rate-desc');
            if (upsellDesc) upsellDesc.textContent = `System successfully upsold add-ons and extra ingredients on ${upsellRate}% of order baskets.`;

            const recommendationRate = (data.recommendationConversionRate ?? 0).toFixed(1);
            const recStats = document.getElementById('badge-recommended-stats');
            if (recStats) recStats.textContent = `Cross-selling conversion rate ${recommendationRate}%`;

            // Bind Product Database
            globalAllProducts = data.bestSellers || [];
            
            // Populate category filter dropdown
            const catSelect = document.getElementById('prod-filter-category');
            catSelect.innerHTML = '<option value="">All Categories</option>';
            const uniqueCats = [...new Set(globalAllProducts.map(p => p.categoryName))];
