                                    </td>
                                    <td class="py-3 text-right">
                                        <button onclick="deleteTable(${t.id})" class="px-2.5 py-1.5 rounded-lg bg-red-50 hover:bg-red-100 text-red-600 dark:bg-red-950/20 dark:hover:bg-red-950/30 dark:text-red-400 font-bold transition-all text-[10px] flex items-center gap-1 ml-auto"><i class="bi bi-trash"></i> حذف</button>
                                    </td>
                                </tr>
                            `).join('');
                        }
                    }
                }
            } catch (err) {
                console.error("Error loading tables:", err);
