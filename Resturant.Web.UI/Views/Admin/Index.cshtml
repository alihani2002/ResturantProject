            document.getElementById('prod-modal-name').textContent = product.productName;
            document.getElementById('prod-modal-category').textContent = product.categoryName;
            document.getElementById('prod-modal-price').textContent = `${(product.price ?? 0).toFixed(2)} ج.م`;
            document.getElementById('prod-modal-status').className = `px-2 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider ${
                product.isAvailable ? 'bg-emerald-100 text-emerald-800' : 'bg-red-100 text-red-800'
            }`;
            document.getElementById('prod-modal-status').textContent = product.isAvailable ? 'متاح' : 'نفذت الكمية';

            // Sales Metrics
            document.getElementById('prod-modal-qty').textContent = product.salesCount;
            document.getElementById('prod-modal-revenue').textContent = `${product.revenue.toFixed(2)} ج.م`;
