            const price = document.getElementById('edit-menu-price').value;
            const catId = document.getElementById('edit-menu-cat-id').value;
            
            const isAvail = document.getElementById('edit-menu-available') ? document.getElementById('edit-menu-available').checked : true;
            const isPop = document.getElementById('edit-menu-popular') ? document.getElementById('edit-menu-popular').checked : false;
            const isTrend = document.getElementById('edit-menu-trending') ? document.getElementById('edit-menu-trending').checked : false;
            const isRec = document.getElementById('edit-menu-recommended') ? document.getElementById('edit-menu-recommended').checked : false;

            const fileInput = document.getElementById('edit-menu-image');

            if (!name || !price || !catId) {
                showToastAlert("Please fill in all required fields.", "warning");
                return;
            }

            // Serialize sizes into description
            const desc = serializeSizes('edit-menu-sizes-list', 'edit-menu-has-sizes', rawDesc);

            const formData = new FormData();
            formData.append('name', name);
            formData.append('description', desc);
            formData.append('price', price);
            formData.append('menuCategoryId', catId);
            formData.append('isAvailable', isAvail);
            formData.append('isPopular', isPop);
            formData.append('isTrending', isTrend);
            formData.append('isRecommended', isRec);
            const orderNumInput = document.getElementById('edit-menu-order-number');
            formData.append('orderNumber', orderNumInput ? orderNumInput.value : 0);
            if (fileInput.files.length > 0) {
                formData.append('imageFile', fileInput.files[0]);
            }

            // Build addons JSON
            const addonContainer = document.getElementById('edit-menu-addons-container');
            const addonRows = addonContainer.querySelectorAll('.flex');
            const addons = [];
            addonRows.forEach(row => {
                const inputs = row.querySelectorAll('input');
                if (inputs.length >= 2) {
                    const extraName = inputs[0].value.trim();
                    const extraPrice = parseFloat(inputs[1].value) || 0;
                    if (extraName) {
                        addons.push({ name: extraName, extraPrice: extraPrice });
                    }
                }
            });
            formData.append('addonsJson', JSON.stringify(addons));

            // Build recommendations JSON
            const recContainer = document.getElementById('edit-menu-recommendations-list');
            const checkedCheckboxes = recContainer.querySelectorAll('input[type="checkbox"]:checked');
            const recIds = [];
            checkedCheckboxes.forEach(cb => {
                recIds.push(parseInt(cb.value));
            });
            formData.append('recommendationsJson', JSON.stringify(recIds));

            showLoader();
            try {
                const response = await fetch(`/api/analytics/menu/edit/${id}`, {
                    method: 'POST',
                    body: formData
                });
                if (response.ok) {
                    showToastAlert("Menu Item updated successfully!", "success");
                    closeEditMenuItemModal();
                    document.getElementById('form-edit-menuitem').reset();
                    loadMenuItemsList();
                } else {
                    let errMsg = "Failed to update menu item.";
                    const text = await response.text();
                    try {
                        const err = JSON.parse(text);
                        errMsg = err.message || err.Message || errMsg;
                        if (err.details || err.Details) {
                            errMsg += " Details: " + (err.details || err.Details);
                        }
                    } catch (e) {
                        console.error("Server HTML error:", text);
                        errMsg = "Server Error: " + text.substring(0, 200);
                    }
                    showToastAlert(errMsg, "error");
                }
            } catch (err) {
                showToastAlert("Error connecting to server: " + err.message, "error");
            } finally {
                hideLoader();
            }
        }

        // PAGE ON LOAD INITIALIZATION
        // ==============================================
        $(document).ready(function() {
            // Load dropdown lists and first dashboard tab
            fetchWaiters();
            switchTab('dashboard');
        });
    </script>

