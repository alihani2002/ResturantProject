@{
    Layout = null;
    ViewData["Title"] = "Qore ERP - Reports & Analytics";
}
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Google Fonts Outfit & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        outfit: ['Outfit', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#fffbeb',
                            100: '#fef3c7',
                            200: '#fde68a',
                            300: '#fcd34d',
                            400: '#fbbf24',
                            500: '#f59e0b', // primary amber
                            600: '#d97706',
                            700: '#b45309',
                            800: '#92400e',
                            900: '#78350f',
                        },
                        darkBg: '#0f172a',
                        darkCard: '#1e293b',
                        darkBorder: '#334155',
                    }
                }
            }
        }
    </script>
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- ApexCharts CDN -->
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    
    <!-- SheetJS (xlsx) for Excel Exports -->
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    
    <!-- jsPDF & autoTable for PDF Exports -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.29/jspdf.plugin.autotable.min.js"></script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        .outfit-font {
            font-family: 'Outfit', sans-serif;
        }
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        .dark ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
    </style>
</head>
<body class="h-full bg-slate-50 text-slate-800 dark:bg-darkBg dark:text-slate-200 transition-colors duration-200 overflow-hidden flex">

    <!-- SIDEBAR -->
    <aside class="w-64 bg-white dark:bg-darkCard border-r border-slate-200 dark:border-darkBorder flex flex-col h-full z-20 transition-all duration-300 shrink-0">
        <!-- Sidebar Brand Logo -->
        <div class="h-16 flex items-center justify-between px-6 border-b border-slate-100 dark:border-darkBorder">
            <div class="flex items-center gap-3">
                <div class="p-1 rounded-xl">
                    <img src="/assets/images/Qore.png" alt="Qore" class="h-8 w-auto">
                </div>
                <div>
                    <h1 class="outfit-font font-black text-lg leading-tight tracking-wide text-slate-900 dark:text-white uppercase">QORE ERP</h1>
                    <p class="text-[10px] text-slate-400 font-semibold tracking-widest uppercase">Admin Operations</p>
                </div>
            </div>
        </div>

        <!-- Sidebar Navigation Tabs -->
        <nav class="flex-1 px-4 py-4 space-y-1 overflow-y-auto">
            <button onclick="switchTab('dashboard')" id="btn-tab-dashboard" class="w-full flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-xl transition-all duration-200 bg-brand-500 text-white shadow-md shadow-brand-500/10">
                <i class="bi bi-speedometer2 text-base"></i>
                <span>Live Summary</span>
                <span class="ml-auto w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
            </button>

            <div class="pt-4 pb-2 px-4">
                <p class="text-[10px] font-bold tracking-widest text-slate-400 dark:text-slate-500 uppercase">Analytical Reports</p>
            </div>

            <button onclick="switchTab('sales')" id="btn-tab-sales" class="w-full flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
                <i class="bi bi-cash-coin text-base text-green-500"></i>
                <span>Sales Ledger</span>
            </button>

            <button onclick="switchTab('orders')" id="btn-tab-orders" class="w-full flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
                <i class="bi bi-receipt text-base text-blue-500"></i>
                <span>Orders Analysis</span>
            </button>

            <button onclick="switchTab('products')" id="btn-tab-products" class="w-full flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
                <i class="bi bi-grid-3x3-gap text-base text-amber-500"></i>
                <span>Product Profits</span>
            </button>

            <button onclick="switchTab('customers')" id="btn-tab-customers" class="w-full flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
                <i class="bi bi-people text-base text-purple-500"></i>
                <span>Loyal Customers</span>
            </button>

            <button onclick="switchTab('staff')" id="btn-tab-staff" class="w-full flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
                <i class="bi bi-person-badge text-base text-indigo-500"></i>
                <span>Staff & Waiters</span>
            </button>

            <button onclick="switchTab('kitchen')" id="btn-tab-kitchen" class="w-full flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
                <i class="bi bi-fire text-base text-red-500"></i>
                <span>Kitchen Efficiency</span>
            </button>

            <div class="pt-4 pb-2 px-4">
                <p class="text-[10px] font-bold tracking-widest text-slate-400 dark:text-slate-500 uppercase">Financials & Inventory</p>
            </div>

            <button onclick="switchTab('financials')" id="btn-tab-financials" class="w-full flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
                <i class="bi bi-calculator text-base text-emerald-500"></i>
                <span>Profit & Loss</span>
            </button>

            <button onclick="switchTab('inventory')" id="btn-tab-inventory" class="w-full flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
                <i class="bi bi-boxes text-base text-teal-500"></i>
                <span>Inventory & Food Cost</span>
            </button>

            <div class="pt-4 pb-2 px-4">
                <p class="text-[10px] font-bold tracking-widest text-slate-400 dark:text-slate-500 uppercase">ERP Setup & Config</p>
            </div>

            <button onclick="switchTab('menu-mgmt')" id="btn-tab-menu-mgmt" class="w-full flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
                <i class="bi bi-journal-plus text-base text-rose-500"></i>
                <span>Add / Manage Menu</span>
            </button>

            <button onclick="switchTab('category-mgmt')" id="btn-tab-category-mgmt" class="w-full flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
                <i class="bi bi-tags text-base text-cyan-500"></i>
                <span>Add / Manage Categories</span>
            </button>

            <button onclick="switchTab('table-mgmt')" id="btn-tab-table-mgmt" class="w-full flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
                <i class="bi bi-grid text-base text-orange-500"></i>
                <span>Add / Manage Tables</span>
            </button>
        </nav>

        <!-- Footer Operations Link -->
        <div class="p-4 border-t border-slate-100 dark:border-darkBorder bg-slate-50/50 dark:bg-darkCard space-y-2">
            <a href="/Waiter" target="_blank" class="flex items-center gap-3 px-4 py-2 text-xs font-semibold rounded-lg border border-indigo-200 dark:border-indigo-900/50 text-indigo-600 dark:text-indigo-400 hover:bg-indigo-50 dark:hover:bg-indigo-900/20 transition-all justify-center">
                <i class="bi bi-person-badge"></i>
                <span>Waiter Terminal</span>
            </a>
            <a href="/Cashier" target="_blank" class="flex items-center gap-3 px-4 py-2 text-xs font-semibold rounded-lg border border-emerald-200 dark:border-emerald-900/50 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-900/20 transition-all justify-center">
                <i class="bi bi-pc-display-horizontal"></i>
                <span>Cashier POS</span>
            </a>
            <a href="/Chef" target="_blank" class="flex items-center gap-3 px-4 py-2 text-xs font-semibold rounded-lg border border-rose-200 dark:border-rose-900/50 text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-900/20 transition-all justify-center">
                <i class="bi bi-fire"></i>
                <span>Kitchen Display</span>
            </a>
            <hr class="border-slate-200 dark:border-slate-700 my-2">
            <button onclick="switchTab('user-mgmt')" id="btn-tab-user-mgmt" class="w-full flex items-center gap-3 px-4 py-2 text-xs font-semibold rounded-lg border border-sky-200 dark:border-sky-900/50 text-sky-600 dark:text-sky-400 hover:bg-sky-50 dark:hover:bg-sky-900/20 transition-all justify-center">
                <i class="bi bi-people-fill"></i>
                <span>Manage Users & Roles</span>
            </button>
           
            <form action="/Identity/Account/Logout?returnUrl=%2F" method="post" id="logoutForm" class="w-full m-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="w-full flex items-center gap-3 px-4 py-2.5 text-xs font-bold rounded-lg bg-red-50 hover:bg-red-100 text-red-600 dark:bg-red-950/20 dark:hover:bg-red-950/30 dark:text-red-400 transition-all justify-center">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Log Out</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- MAIN APP WRAPPER -->
    <div class="flex-1 flex flex-col h-full overflow-hidden min-w-0">
        
        <!-- HEADER -->
        <header class="h-16 bg-white dark:bg-darkCard border-b border-slate-200 dark:border-darkBorder flex items-center justify-between px-8 z-10 shrink-0">
            <!-- Breadcrumbs / Active Tab Title -->
            <div class="flex items-center gap-2">
                <span class="text-slate-400 text-xs font-medium uppercase tracking-widest">Analytics</span>
                <span class="text-slate-300 dark:text-slate-600">/</span>
                <h2 id="active-tab-title" class="outfit-font text-slate-800 dark:text-white font-bold text-lg">Live Summary Overview</h2>
            </div>

            <!-- Header Actions -->
            <div class="flex items-center gap-4">
                <!-- Live Hub Status -->
                <span id="connection-status" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 dark:bg-emerald-950/30 dark:text-emerald-400">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping"></span>
                    <i class="bi bi-broadcast"></i> Live Updates Active
                </span>

                <!-- Dark Mode Toggle -->
                <button onclick="toggleDarkMode()" class="p-2.5 rounded-xl border border-slate-200 dark:border-darkBorder text-slate-500 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-all">
                    <i id="theme-toggle-icon" class="bi bi-moon-fill text-sm"></i>
                </button>
            </div>
        </header>

        <!-- SUB HEADER FILTER BAR -->
        <section class="bg-white dark:bg-darkCard border-b border-slate-200 dark:border-darkBorder px-8 py-3 flex flex-wrap items-center gap-4 justify-between z-10 shrink-0">
            <!-- Filter Actions -->
            <div class="flex flex-wrap items-center gap-3">
                <!-- Date Range Filters -->
                <div class="flex items-center gap-2">
                    <span class="text-xs font-semibold text-slate-400 uppercase">Period:</span>
                    <input type="date" id="filter-start-date" class="px-3 py-1.5 text-xs border rounded-lg dark:bg-slate-800 dark:border-darkBorder dark:text-white font-medium focus:ring-1 focus:ring-brand-500 focus:outline-none">
                    <span class="text-xs text-slate-400 font-bold">to</span>
                    <input type="date" id="filter-end-date" class="px-3 py-1.5 text-xs border rounded-lg dark:bg-slate-800 dark:border-darkBorder dark:text-white font-medium focus:ring-1 focus:ring-brand-500 focus:outline-none">
                </div>

                <!-- Table Filter -->
                <div class="flex items-center gap-2">
                    <span class="text-xs font-semibold text-slate-400 uppercase">Table:</span>
                    <select id="filter-table" class="px-3 py-1.5 text-xs border rounded-lg dark:bg-slate-800 dark:border-darkBorder dark:text-white font-medium focus:outline-none">
                        <option value="">All Tables</option>
                        @for (int i = 1; i <= 15; i++)
                        {
                            <option value="@i">Table @i</option>
                        }
                    </select>
                </div>

                <!-- Waiter Filter -->
                <div class="flex items-center gap-2">
                    <span class="text-xs font-semibold text-slate-400 uppercase">Waiter:</span>
                    <select id="filter-waiter" class="px-3 py-1.5 text-xs border rounded-lg dark:bg-slate-800 dark:border-darkBorder dark:text-white font-medium focus:outline-none">
                        <option value="">All Waiters</option>
                        <!-- Filled dynamically -->
                    </select>
                </div>
            </div>

            <!-- Apply and Export Actions -->
            <div class="flex items-center gap-2">
                <button onclick="applyFilters()" class="px-4 py-1.5 bg-brand-500 text-white rounded-lg text-xs font-bold hover:bg-brand-600 transition-all flex items-center gap-1.5">
                    <i class="bi bi-filter"></i> Apply Filters
                </button>
                <button onclick="resetFilters()" class="px-4 py-1.5 border border-slate-200 dark:border-darkBorder rounded-lg text-xs font-bold hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
                    Reset
                </button>
                <div class="w-px h-6 bg-slate-200 dark:bg-darkBorder mx-1"></div>
                <!-- Exports menu -->
                <button onclick="exportReport('excel')" class="px-3 py-1.5 bg-emerald-600 text-white rounded-lg text-xs font-bold hover:bg-emerald-700 transition-all flex items-center gap-1">
                    <i class="bi bi-file-earmark-excel"></i> Excel
                </button>
                <button onclick="exportReport('pdf')" class="px-3 py-1.5 bg-red-600 text-white rounded-lg text-xs font-bold hover:bg-red-700 transition-all flex items-center gap-1">
                    <i class="bi bi-file-earmark-pdf"></i> PDF
                </button>
            </div>
        </section>

        <!-- CONTAINER FOR SCROLLABLE TABS -->
        <main class="flex-1 overflow-y-auto p-8 min-h-0 space-y-8 relative">

            <!-- ============================================== -->
            <!-- TAB 0: LIVE DASHBOARD SUMMARY                  -->
            <!-- ============================================== -->
            <div id="tab-dashboard" class="tab-content space-y-6">
                <!-- Top KPIs -->
                <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                    <div class="bg-white dark:bg-darkCard border border-slate-200 dark:border-darkBorder p-6 rounded-2xl flex items-center justify-between shadow-sm relative overflow-hidden group">
                        <div class="space-y-1">
                            <p class="text-xs font-bold text-slate-400 uppercase">Revenue Today</p>
                            <h3 id="stat-revenue" class="outfit-font text-3xl font-black tracking-tight text-slate-900 dark:text-white">$0.00</h3>
                            <span id="stat-revenue-growth" class="text-xs font-semibold text-emerald-500 flex items-center gap-1">
                                <i class="bi bi-arrow-up-right"></i> +0%
                            </span>
                        </div>
                        <div class="p-4 bg-emerald-50 dark:bg-emerald-950/20 text-emerald-500 rounded-xl group-hover:scale-110 transition-transform">
                            <i class="bi bi-cash-stack text-2xl"></i>
                        </div>
                    </div>

                    <div class="bg-white dark:bg-darkCard border border-slate-200 dark:border-darkBorder p-6 rounded-2xl flex items-center justify-between shadow-sm relative overflow-hidden group">
                        <div class="space-y-1">
                            <p class="text-xs font-bold text-slate-400 uppercase">Active Tables</p>
                            <h3 id="stat-active-tables" class="outfit-font text-3xl font-black tracking-tight text-slate-900 dark:text-white">0</h3>
                            <span class="text-xs text-slate-400 font-medium">In-service right now</span>
                        </div>
                        <div class="p-4 bg-blue-50 dark:bg-blue-950/20 text-blue-500 rounded-xl group-hover:scale-110 transition-transform">
                            <i class="bi bi-grid-3x3-gap-fill text-2xl"></i>
                        </div>
                    </div>

                    <div class="bg-white dark:bg-darkCard border border-slate-200 dark:border-darkBorder p-6 rounded-2xl flex items-center justify-between shadow-sm relative overflow-hidden group">
                        <div class="space-y-1">
                            <p class="text-xs font-bold text-slate-400 uppercase">Active Sessions</p>
                            <h3 id="stat-active-sessions" class="outfit-font text-3xl font-black tracking-tight text-slate-900 dark:text-white">0</h3>
                            <span class="text-xs text-slate-400 font-medium">Unique QR customer codes active</span>
                        </div>
                        <div class="p-4 bg-purple-50 dark:bg-purple-950/20 text-purple-500 rounded-xl group-hover:scale-110 transition-transform">
                            <i class="bi bi-qr-code-scan text-2xl"></i>
                        </div>
                    </div>

                    <div class="bg-white dark:bg-darkCard border border-slate-200 dark:border-darkBorder p-6 rounded-2xl flex items-center justify-between shadow-sm relative overflow-hidden group">
                        <div class="space-y-1">
                            <p class="text-xs font-bold text-slate-400 uppercase">Pending Orders</p>
                            <h3 id="stat-pending-orders" class="outfit-font text-3xl font-black tracking-tight text-slate-900 dark:text-white">0</h3>
                            <span id="stat-completed-orders" class="text-xs font-semibold text-indigo-500">0 completed today</span>
                        </div>
                        <div class="p-4 bg-amber-50 dark:bg-amber-950/20 text-amber-500 rounded-xl group-hover:scale-110 transition-transform">
                            <i class="bi bi-clock-history text-2xl"></i>
                        </div>
                    </div>
                </div>

                <!-- Live Chart & Live Notification logs -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <!-- Live Sales Area Chart -->
                    <div class="bg-white dark:bg-darkCard border border-slate-200 dark:border-darkBorder p-6 rounded-2xl shadow-sm lg:col-span-2 space-y-4">
                        <div class="flex items-center justify-between">
                            <h3 class="outfit-font text-base font-bold text-slate-900 dark:text-white">Live Revenue Intervals (Last 6 Hours)</h3>
                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-800 dark:bg-amber-950/30 dark:text-brand-400 uppercase tracking-widest animate-pulse">Real-time Feed</span>
                        </div>
                        <div id="chart-live-sales" class="w-full h-80"></div>
                    </div>

                    <!-- Live Notification Feed -->
                    <div class="bg-white dark:bg-darkCard border border-slate-200 dark:border-darkBorder p-6 rounded-2xl shadow-sm space-y-4 flex flex-col max-h-[30rem]">
                        <div class="flex items-center justify-between border-b pb-3 border-slate-100 dark:border-darkBorder">
                            <h3 class="outfit-font text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                                <i class="bi bi-bell-fill text-amber-500 animate-bounce"></i> Real-time Operations Logs
                            </h3>
                            <span class="text-xs font-semibold text-slate-400" id="notification-count">0 alerts</span>
                        </div>
                        
                        <!-- Notifications List -->
                        <div id="live-notifications-list" class="flex-1 overflow-y-auto space-y-3 pr-1">
                            <!-- Populated in JS -->
                        </div>
                    </div>
                </div>
            </div>

            <!-- ============================================== -->
            <!-- TAB 1: SALES LEDGER REPORT                     -->
            <!-- ============================================== -->
            <div id="tab-sales" class="tab-content hidden space-y-6">
                <!-- Sales KPI Summaries -->
                <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
                    <div class="bg-white dark:bg-darkCard p-4 border rounded-xl shadow-sm">
                        <p class="text-[10px] font-bold text-slate-400 uppercase">Gross Revenue</p>
                        <h4 id="sales-gross-revenue" class="outfit-font text-xl font-extrabold text-slate-800 dark:text-white">$0.00</h4>
                    </div>
                    <div class="bg-white dark:bg-darkCard p-4 border rounded-xl shadow-sm">
                        <p class="text-[10px] font-bold text-slate-400 uppercase">Net Revenue (P/L Basis)</p>
                        <h4 id="sales-net-revenue" class="outfit-font text-xl font-extrabold text-slate-800 dark:text-white">$0.00</h4>
                    </div>
                    <div class="bg-white dark:bg-darkCard p-4 border rounded-xl shadow-sm">
                        <p class="text-[10px] font-bold text-slate-400 uppercase">Taxes Collected (VAT)</p>
                        <h4 id="sales-taxes" class="outfit-font text-xl font-extrabold text-slate-800 dark:text-white">$0.00</h4>
                    </div>
                    <div class="bg-white dark:bg-darkCard p-4 border rounded-xl shadow-sm">
                        <p class="text-[10px] font-bold text-slate-400 uppercase">Average Order Value (AOV)</p>
                        <h4 id="sales-aov" class="outfit-font text-xl font-extrabold text-slate-800 dark:text-white">$0.00</h4>
                    </div>
                    <div class="bg-white dark:bg-darkCard p-4 border rounded-xl shadow-sm">
                        <p class="text-[10px] font-bold text-slate-400 uppercase">Discounts Granted</p>
                        <h4 id="sales-discounts" class="outfit-font text-xl font-extrabold text-slate-800 dark:text-white">$0.00</h4>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <!-- Daily Sales Trend Graph -->
                    <div class="bg-white dark:bg-darkCard p-6 border rounded-2xl shadow-sm lg:col-span-2 space-y-4">
                        <h3 class="outfit-font text-sm font-bold text-slate-900 dark:text-white">Revenue Growth & Trend Graphs</h3>
                        <div id="chart-sales-trend" class="w-full h-80"></div>
                    </div>
                    
                    <!-- Hourly Sales Peaks -->
                    <div class="bg-white dark:bg-darkCard p-6 border rounded-2xl shadow-sm space-y-4">
