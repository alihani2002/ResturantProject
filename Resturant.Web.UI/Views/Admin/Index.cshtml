        function addAdminSizeRow(listId, name = '', price = '') {
            const list = document.getElementById(listId);
            if (!list) return;
            const isFirstRow = list.children.length === 0;
            const rowId = 'sz-' + Date.now() + '-' + Math.random().toString(36).substr(2, 4);
            list.insertAdjacentHTML('beforeend', `
                <div id="${rowId}" class="grid grid-cols-12 gap-1 items-center">
                    <input type="text" class="col-span-6 admin-size-name bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-darkBorder rounded-lg px-2 py-1.5 text-xs text-slate-800 dark:text-white focus:outline-none focus:ring-1 focus:ring-amber-500"
                           placeholder="e.g. Small / S" value="${name.replace(/"/g,'&quot;')}">
                    <div class="col-span-5 flex items-center">
                        <input type="number" step="0.01" min="0.01" class="w-full admin-size-price bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-darkBorder rounded-lg px-2 py-1.5 text-xs text-slate-800 dark:text-white focus:outline-none focus:ring-1 focus:ring-amber-500"
                               placeholder="0.00" value="${price}" oninput="syncFirstSizeToBasePrice('${listId}')">
                    </div>
                    <button type="button" onclick="document.getElementById('${rowId}').remove(); syncFirstSizeToBasePrice('${listId}')" class="col-span-1 flex justify-center text-red-400 hover:text-red-600">
                        <i class="bi bi-x-circle text-sm"></i>
                    </button>
                </div>
            `);
            // If this is the first row being added, seed its price from the base price field
            if (isFirstRow && !price) {
                const basePriceId = listId === 'menu-sizes-list' ? 'menu-price' : 'edit-menu-price';
                const basePrice = document.getElementById(basePriceId);
                if (basePrice && basePrice.value) {
                    list.querySelector('.admin-size-price').value = parseFloat(basePrice.value).toFixed(2);
                }
            }
        }

        function syncFirstSizeToBasePrice(listId) {
            const list = document.getElementById(listId);
            if (!list) return;
            const firstPriceInput = list.querySelector('.admin-size-price');
            if (!firstPriceInput) return;
            const firstPrice = parseFloat(firstPriceInput.value) || 0;
            if (firstPrice <= 0) return;
            const basePriceId = listId === 'menu-sizes-list' ? 'menu-price' : 'edit-menu-price';
            const basePriceInput = document.getElementById(basePriceId);
            if (basePriceInput) basePriceInput.value = firstPrice.toFixed(2);
        }

        function serializeSizes(listId, hasSizesCheckId, rawDesc) {
            const toggle = document.getElementById(hasSizesCheckId);
            if (!toggle || !toggle.checked) return rawDesc;
            const list = document.getElementById(listId);
            if (!list) return rawDesc;
            const rows = list.querySelectorAll('[id^="sz-"]');
            const parts = [];
            rows.forEach(row => {
                const nameEl = row.querySelector('.admin-size-name');
                const priceEl = row.querySelector('.admin-size-price');
                const n = nameEl ? nameEl.value.trim() : '';
                const p = parseFloat(priceEl ? priceEl.value : 0) || 0;
                if (n && p > 0) parts.push(`${n} - ${p.toFixed(2)}`);
            });
            if (parts.length === 0) return rawDesc;
            const sizesString = 'Sizes: ' + parts.join(', ');
            return rawDesc ? rawDesc + '\n' + sizesString : sizesString;
        }

        function parseSizesFromDesc(fullDesc) {
            const result = { cleanDesc: fullDesc, sizes: [] };
            if (!fullDesc) return result;
            const m = fullDesc.match(/(?:^|\n|\r)\s*(?:sizes?)\s*:\s*([\s\S]+)$/i);
            if (!m) return result;
            result.cleanDesc = fullDesc.replace(/(?:\n|\r)*\s*(?:sizes?)\s*:[\s\S]+$/i, '').trim();
            m[1].split(/[,;]+/).forEach(part => {
                const pm = part.trim().match(/^([\w\u0600-\u06FF\s]+?)\s*[-:=]+\s*([0-9]+(?:\.[0-9]+)?)/);
                if (pm) result.sizes.push({ name: pm[1].trim(), price: parseFloat(pm[2]) });
            });
            return result;
        }
