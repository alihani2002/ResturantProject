        async function submitTable(e) {
            e.preventDefault();
            const tblNumberInput = document.getElementById('tbl-number');
            const tblDomainInput = document.getElementById('tbl-domain');
            const tableNumber = tblNumberInput.value;
            const websiteUrl = tblDomainInput ? tblDomainInput.value.trim() : '';

            if (!tableNumber || tableNumber <= 0) {
                showToastAlert("Please enter a valid Table Number.", "warning");
                return;
            }

            const formData = new FormData();
            formData.append('tableNumber', tableNumber);
            formData.append('websiteUrl', websiteUrl);

            showLoader();
            try {
                const response = await fetch('/api/analytics/tables/create', {
                    method: 'POST',
                    body: formData
                });
                if (response.ok) {
                    showToastAlert("New Table created with branded QR Code composite successfully!", "success");
                    tblNumberInput.value = '';
                    if (tblDomainInput) tblDomainInput.value = '';
                    loadTablesList();
                } else {
                    const err = await response.json();
                    showToastAlert(err.message || "Failed to create table.", "error");
                }
            } catch (err) {
                showToastAlert("Error connecting to server.", "error");
            } finally {
                hideLoader();
            }
        }

        async function deleteTable(id) {
            if (!confirm("Are you sure you want to delete this table? Customers won't be able to open QR sessions for this table number anymore.")) return;
            showLoader();
            try {
                const response = await fetch(`/api/analytics/tables/delete/${id}`, { method: 'POST' });
                if (response.ok) {
                    showToastAlert("Restaurant Table deleted successfully.", "success");
                    loadTablesList();
                } else {
                    showToastAlert("Failed to delete table.", "error");
                }
            } catch (err) {
                showToastAlert("Error connecting to server.", "error");
            } finally {
                hideLoader();
            }
        }

        // --- QR CODE MODAL LOGIC ---
        function openQrModal(tableNumber, qrImageUrl) {
            const modal = document.getElementById('qr-modal');
            const modalContent = document.getElementById('qr-modal-content');
            const modalImg = document.getElementById('qr-modal-image');
            const modalLoader = document.getElementById('qr-modal-loader');
            const modalTitle = document.getElementById('qr-modal-title');
            const modalDownload = document.getElementById('qr-modal-download');

            modalTitle.textContent = `Table ${tableNumber} QR Code`;
            modalImg.classList.add('hidden');
            modalLoader.classList.remove('hidden');

            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                modalContent.classList.remove('scale-95');
            }, 50);

            if (qrImageUrl) {
                modalImg.src = qrImageUrl;
                modalDownload.href = qrImageUrl;
                modalImg.onload = () => {
                    modalLoader.classList.add('hidden');
                    modalImg.classList.remove('hidden');
                };
            } else {
                modalLoader.classList.add('hidden');
                showToastAlert("QR Image URL is not available for this table.", "error");
            }
        }

