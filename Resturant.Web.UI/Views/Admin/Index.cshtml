            </button>
            <div class="text-center space-y-4">
                <h3 id="qr-modal-title" class="outfit-font text-slate-850 dark:text-white font-bold text-sm">Table QR Code</h3>
                <div class="flex items-center justify-center p-4 bg-slate-50 dark:bg-slate-900/50 rounded-2xl border border-slate-100 dark:border-darkBorder min-h-[300px]">
                    <img id="qr-modal-image" src="" alt="Table QR Code" class="max-w-[260px] w-full object-contain rounded-xl shadow-lg border border-slate-200 dark:border-slate-800 hidden">
                    <div id="qr-modal-loader" class="flex flex-col items-center gap-2">
                        <div class="w-8 h-8 border-4 border-brand-500 border-t-transparent rounded-full animate-spin"></div>
                        <span class="text-[10px] font-bold text-slate-400 tracking-wider uppercase">Generating Code...</span>
                    </div>
                </div>
                <div class="flex gap-3">
                    <a id="qr-modal-download" href="" download class="flex-1 py-2.5 rounded-xl bg-brand-500 hover:bg-brand-600 text-white font-semibold text-xs transition-all shadow-md shadow-brand-500/10 text-center flex items-center justify-center gap-1.5"><i class="bi bi-download"></i> Save PNG</a>
                    <button onclick="window.print()" class="flex-1 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-700 font-semibold text-xs transition-all flex items-center justify-center gap-1.5"><i class="bi bi-printer"></i> Print</button>
                </div>
            </div>
        </div>
    </div>

    <!-- EDIT CATEGORY MODAL -->
    <div id="edit-cat-modal" class="fixed inset-0 bg-slate-900/60 dark:bg-black/80 backdrop-blur-[4px] z-50 flex items-center justify-center hidden opacity-0 transition-opacity duration-300">
        <div class="bg-white dark:bg-darkCard rounded-2xl max-w-sm w-full mx-4 p-6 shadow-2xl border border-slate-100 dark:border-darkBorder relative scale-95 transition-transform duration-300" id="edit-cat-modal-content">
            <button onclick="closeEditCategoryModal()" class="absolute top-4 right-4 p-1.5 rounded-xl border border-slate-200 dark:border-darkBorder text-slate-500 hover:bg-slate-50 dark:hover:bg-slate-800 dark:text-slate-400 transition-all">
                <i class="bi bi-x text-lg"></i>
            </button>
            <h3 class="outfit-font text-slate-850 dark:text-white font-bold text-sm mb-4">Edit Menu Category</h3>
            <form id="form-edit-category" onsubmit="submitEditCategory(event)" class="space-y-4">
                <input type="hidden" id="edit-cat-id">
                <div class="grid grid-cols-3 gap-4">
                    <div class="col-span-2">
                        <label class="block text-xs font-bold text-slate-400 dark:text-slate-500 uppercase mb-1">Category Name</label>
                        <input type="text" id="edit-cat-name" required class="w-full bg-slate-50 dark:bg-slate-800/50 border border-slate-200/40 dark:border-darkBorder rounded-xl px-4 py-2.5 text-sm text-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-cyan-500 transition-all">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-400 dark:text-slate-500 uppercase mb-1">Order #</label>
                        <input type="number" id="edit-cat-order-number" required class="w-full bg-slate-50 dark:bg-slate-800/50 border border-slate-200/40 dark:border-darkBorder rounded-xl px-4 py-2.5 text-sm text-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-cyan-500 transition-all" min="0">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-400 dark:text-slate-500 uppercase mb-1">Description (Optional)</label>
                    <textarea id="edit-cat-desc" rows="2" class="w-full bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-darkBorder rounded-xl px-4 py-2.5 text-sm text-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-cyan-500 transition-all"></textarea>
                </div>
                <div class="flex items-center gap-2 mt-1">
                    <input type="checkbox" id="edit-cat-active" class="w-4 h-4 text-cyan-600 bg-slate-100 border-slate-300 rounded focus:ring-cyan-500">
                    <label class="text-xs font-bold text-slate-700 dark:text-slate-300 uppercase">Is Active</label>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-400 dark:text-slate-500 uppercase mb-1">Update Thumbnail Image</label>
                    <input type="file" id="edit-cat-image" accept="image/*" class="w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-cyan-50 file:text-cyan-700 hover:file:bg-cyan-100 cursor-pointer">
                    <div id="edit-cat-img-preview" class="mt-2 hidden">
                        <img src="" class="w-16 h-16 object-cover rounded-lg border border-slate-200 dark:border-slate-850">
                    </div>
                </div>
                <button type="submit" class="w-full py-3 rounded-xl bg-cyan-500 hover:bg-cyan-600 text-white font-semibold text-sm transition-all shadow-md shadow-cyan-500/10">Save Category Changes</button>
            </form>
        </div>
    </div>

    <!-- EDIT MENU ITEM MODAL -->
    <div id="edit-menu-modal" class="fixed inset-0 bg-slate-900/60 dark:bg-black/80 backdrop-blur-[4px] z-50 flex items-center justify-center hidden opacity-0 transition-opacity duration-300">
        <div class="bg-white dark:bg-darkCard rounded-2xl max-w-md w-full mx-4 p-6 shadow-2xl border border-slate-100 dark:border-darkBorder relative scale-95 transition-transform duration-300" id="edit-menu-modal-content">
            <button onclick="closeEditMenuItemModal()" class="absolute top-4 right-4 p-1.5 rounded-xl border border-slate-200 dark:border-darkBorder text-slate-500 hover:bg-slate-50 dark:hover:bg-slate-800 dark:text-slate-400 transition-all">
                <i class="bi bi-x text-lg"></i>
            </button>
            <h3 class="outfit-font text-slate-850 dark:text-white font-bold text-sm mb-4">Edit Menu Product</h3>
            <form id="form-edit-menuitem" onsubmit="submitEditMenuItem(event)" class="space-y-4">
                <input type="hidden" id="edit-menu-id">
                <div>
                    <label class="block text-xs font-bold text-slate-400 dark:text-slate-500 uppercase mb-1">Item Name</label>
                    <input type="text" id="edit-menu-name" required class="w-full bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-darkBorder rounded-xl px-4 py-2.5 text-sm text-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-rose-500 transition-all">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-400 dark:text-slate-500 uppercase mb-1">Description</label>
                    <textarea id="edit-menu-desc" rows="3" class="w-full bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-darkBorder rounded-xl px-4 py-2.5 text-sm text-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-rose-500 transition-all"></textarea>
                </div>
                <div class="grid grid-cols-3 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-400 dark:text-slate-500 uppercase mb-1">Price (L.E.)</label>
                        <input type="number" id="edit-menu-price" step="0.01" required class="w-full bg-slate-50 dark:bg-slate-800/50 border border-slate-200/40 dark:border-darkBorder rounded-xl px-4 py-2.5 text-sm text-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-rose-500 transition-all">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-400 dark:text-slate-500 uppercase mb-1">Category</label>
                        <select id="edit-menu-cat-id" required class="w-full bg-slate-50 dark:bg-slate-800/50 border border-slate-200/40 dark:border-darkBorder rounded-xl px-4 py-2.5 text-sm text-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-rose-500 transition-all">
                            <!-- Loaded dynamically -->
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-400 dark:text-slate-500 uppercase mb-1">Order #</label>
                        <input type="number" id="edit-menu-order-number" required class="w-full bg-slate-50 dark:bg-slate-800/50 border border-slate-200/40 dark:border-darkBorder rounded-xl px-4 py-2.5 text-sm text-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-rose-500 transition-all" min="0">
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-3 mt-2">
                    <div class="flex items-center gap-2">
                        <input type="checkbox" id="edit-menu-available" class="w-4 h-4 text-rose-600 bg-slate-100 border-slate-300 rounded focus:ring-rose-500">
                        <label class="text-xs font-bold text-slate-700 dark:text-slate-300 uppercase">Is Available</label>
                    </div>
                    <div class="flex items-center gap-2">
                        <input type="checkbox" id="edit-menu-popular" class="w-4 h-4 text-rose-600 bg-slate-100 border-slate-300 rounded focus:ring-rose-500">
                        <label class="text-xs font-bold text-slate-700 dark:text-slate-300 uppercase">Popular</label>
                    </div>
                    <div class="flex items-center gap-2">
                        <input type="checkbox" id="edit-menu-trending" class="w-4 h-4 text-rose-600 bg-slate-100 border-slate-300 rounded focus:ring-rose-500">
                        <label class="text-xs font-bold text-slate-700 dark:text-slate-300 uppercase">Trending</label>
                    </div>
                    <div class="flex items-center gap-2">
                        <input type="checkbox" id="edit-menu-recommended" class="w-4 h-4 text-rose-600 bg-slate-100 border-slate-300 rounded focus:ring-rose-500">
                        <label class="text-xs font-bold text-slate-700 dark:text-slate-300 uppercase">Recommended</label>
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-400 dark:text-slate-500 uppercase mb-1">Update Item Image</label>
                    <input type="file" id="edit-menu-image" accept="image/*" class="w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-rose-50 file:text-rose-700 hover:file:bg-rose-100 cursor-pointer">
                    <div id="edit-menu-img-preview" class="mt-2 hidden">
                        <img src="" class="w-16 h-16 object-cover rounded-lg border border-slate-200 dark:border-slate-850">
                    </div>
                </div>
                <button type="submit" class="w-full py-3 rounded-xl bg-rose-500 hover:bg-rose-600 text-white font-semibold text-sm transition-all shadow-md shadow-rose-500/10">Save Product Changes</button>
            </form>
        </div>
    </div>

    <!-- SCRIPT FOR CLOSING MODALS OUTSIDE CLICK & ESC -->
    <script>
        function closeQrModal() {
            const modal = document.getElementById('qr-modal');
            const modalContent = document.getElementById('qr-modal-content');
            modal.classList.add('opacity-0');
            modalContent.classList.add('scale-95');
            setTimeout(() => { modal.classList.add('hidden'); }, 300);
        }

        function closeEditCategoryModal() {
            const modal = document.getElementById('edit-cat-modal');
            const modalContent = document.getElementById('edit-cat-modal-content');
            modal.classList.add('opacity-0');
            modalContent.classList.add('scale-95');
            setTimeout(() => { modal.classList.add('hidden'); }, 300);
        }

        function closeEditMenuItemModal() {
            const modal = document.getElementById('edit-menu-modal');
            const modalContent = document.getElementById('edit-menu-modal-content');
            modal.classList.add('opacity-0');
            modalContent.classList.add('scale-95');
            setTimeout(() => { modal.classList.add('hidden'); }, 300);
        }

        // Close on escape key
        document.addEventListener('keydown', function(event) {
            if (event.key === "Escape") {
                closeQrModal();
                closeEditCategoryModal();
                closeEditMenuItemModal();
            }
        });
    </script>
</body>
</html>
