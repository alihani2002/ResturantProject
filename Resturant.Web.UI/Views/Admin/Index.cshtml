@{
    Layout = null;
    ViewData["Title"] = "Qore ERP - Reports & Analytics";
}
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Google Fonts Outfit & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" href="~/assets/images/q.png">
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        outfit: ['Outfit', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#fdfbf7',
                            100: '#fbf7e6',
                            200: '#f7eec2',
                            300: '#f1df91',
                            400: '#eac85c',
                            500: '#d4af37', // primary gold
                            600: '#bd992e',
                            700: '#9e7d24',
                            800: '#7f641e',
                            900: '#68511a',
                        },
                        darkBg: '#070708', // true luxury obsidian black
                        darkCard: '#0f0f12', // rich dark grey card
                        darkBorder: '#1c1c22', // subtle border
                    }
                }
            }
        }
    </script>

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- ApexCharts CDN -->
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>

    <!-- SheetJS (xlsx) for Excel Exports -->
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

    <!-- jsPDF & autoTable for PDF Exports -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.29/jspdf.plugin.autotable.min.js"></script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        .outfit-font {
            font-family: 'Outfit', sans-serif;
        }
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        .dark ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
    </style>
</head>
<body class="h-full bg-slate-50 text-slate-800 dark:bg-darkBg dark:text-slate-200 transition-colors duration-200 overflow-hidden flex">

    <!-- SIDEBAR -->
    <aside class="w-64 bg-white dark:bg-darkCard border-r border-slate-200 dark:border-darkBorder flex flex-col h-full z-20 transition-all duration-300 shrink-0">
        <!-- Sidebar Brand Logo -->
        <div class="h-16 flex items-center justify-between px-6 border-b border-slate-100 dark:border-darkBorder">
            <div class="flex items-center gap-3">
                <div class="p-1 rounded-xl">
                    <img src="/assets/images/Qore.png" alt="Qore" class="h-8 w-auto">
                </div>
                <div>
                    <h1 class="outfit-font font-black text-lg leading-tight tracking-wide text-slate-900 dark:text-white uppercase">QORE ERP</h1>
                    <p class="text-[10px] text-slate-400 font-semibold tracking-widest uppercase">Admin Operations</p>
                </div>
            </div>
        </div>

        <!-- Sidebar Navigation Tabs -->
        <nav class="flex-1 px-4 py-4 space-y-1 overflow-y-auto">
            <button onclick="switchTab('dashboard')" id="btn-tab-dashboard" class="w-full flex items-center gap-3 px-4 py-3 text-sm font-bold rounded-xl transition-all duration-200 bg-brand-500 text-white shadow-md shadow-brand-500/10 text-right justify-start" dir="rtl">
                <i class="bi bi-grid-fill text-base"></i>
                <span>خريطة النظام الرئيسية</span>
            </button>

            <button onclick="switchTab('shift-reports')" id="btn-tab-shift-reports" class="w-full flex items-center gap-3 px-4 py-2.5 text-sm font-semibold rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all text-right justify-start" dir="rtl">
                <i class="bi bi-clock-history text-base text-warning"></i>
                <span>تقارير الورديات (الشيفتات)</span>
            </button>

            <button onclick="switchTab('product-sales-report')" id="btn-tab-product-sales-report" class="w-full flex items-center gap-3 px-4 py-2.5 text-sm font-semibold rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all text-right justify-start" dir="rtl">
                <i class="bi bi-bar-chart-line text-base text-success"></i>
                <span>تقارير مبيعات المنتجات</span>
            </button>

            <div class="pt-4 pb-2 px-4 text-right" dir="rtl">
                <p class="text-[10px] font-black tracking-widest text-slate-400 dark:text-slate-500 uppercase">تهيئة وإعدادات النظام</p>
            </div>

            <button onclick="switchTab('menu-mgmt')" id="btn-tab-menu-mgmt" class="w-full flex items-center gap-3 px-4 py-2.5 text-sm font-semibold rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all text-right justify-start" dir="rtl">
                <i class="bi bi-journal-plus text-base text-rose-500"></i>
                <span>إضافة وإدارة المنيو</span>
            </button>

            <button onclick="switchTab('category-mgmt')" id="btn-tab-category-mgmt" class="w-full flex items-center gap-3 px-4 py-2.5 text-sm font-semibold rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all text-right justify-start" dir="rtl">
                <i class="bi bi-tags text-base text-cyan-500"></i>
                <span>إضافة وإدارة الأقسام</span>
            </button>

            <button onclick="switchTab('table-mgmt')" id="btn-tab-table-mgmt" class="w-full flex items-center gap-3 px-4 py-2.5 text-sm font-semibold rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all text-right justify-start" dir="rtl">
                <i class="bi bi-grid text-base text-orange-500"></i>
                <span>إضافة وإدارة الطاولات</span>
            </button>

            <button onclick="switchTab('waiter-assignment')" id="btn-tab-waiter-assignment" class="w-full flex items-center gap-3 px-4 py-2.5 text-sm font-semibold rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all text-right justify-start" dir="rtl">
                <i class="bi bi-person-lines-fill text-base text-indigo-500"></i>
                <span>إسناد الطاولات للويتر</span>
            </button>

            <button onclick="switchTab('settings-mgmt')" id="btn-tab-settings-mgmt" class="w-full flex items-center gap-3 px-4 py-2.5 text-sm font-semibold rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all text-right justify-start" dir="rtl">
                <i class="bi bi-sliders text-base text-emerald-500"></i>
                <span>إعدادات الضرائب والخدمة</span>
            </button>

            <button onclick="switchTab('branch-mgmt')" id="btn-tab-branch-mgmt" class="w-full flex items-center gap-3 px-4 py-2.5 text-sm font-semibold rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all text-right justify-start" dir="rtl">
                <i class="bi bi-geo-alt text-base text-brand-500"></i>
                <span>إدارة الفروع</span>
            </button>

            <div class="pt-4 pb-2 px-4 text-right" dir="rtl">
                <p class="text-[10px] font-black tracking-widest text-slate-400 dark:text-slate-500 uppercase">المخازن وسلاسل الإمداد</p>
            </div>

            <button onclick="switchTab('inventory-mgmt')" id="btn-tab-inventory-mgmt" class="w-full flex items-center gap-3 px-4 py-2.5 text-sm font-semibold rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all text-right justify-start" dir="rtl">
                <i class="bi bi-box-seam text-base text-amber-500"></i>
                <span>مخزون المواد الخام</span>
            </button>

            <button onclick="switchTab('stock-transfers')" id="btn-tab-stock-transfers" class="w-full flex items-center gap-3 px-4 py-2.5 text-sm font-semibold rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all text-right justify-start" dir="rtl">
                <i class="bi bi-arrow-left-right text-base text-indigo-500"></i>
                <span>تحويلات المخزون</span>
            </button>

            <button onclick="switchTab('recipe-mgmt')" id="btn-tab-recipe-mgmt" class="w-full flex items-center gap-3 px-4 py-2.5 text-sm font-semibold rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all text-right justify-start" dir="rtl">
                <i class="bi bi-receipt text-base text-rose-500"></i>
                <span>مكونات الوصفات (الريسبات)</span>
            </button>
        </nav>

        <!-- Footer Operations Link -->
        <div class="p-4 border-t border-slate-100 dark:border-darkBorder bg-slate-50/50 dark:bg-darkCard space-y-2">
            <a href="/Waiter" target="_blank" class="flex items-center gap-3 px-4 py-2 text-xs font-bold rounded-lg border border-indigo-200 dark:border-indigo-900/50 text-indigo-600 dark:text-indigo-400 hover:bg-indigo-50 dark:hover:bg-indigo-900/20 transition-all justify-center">
                <i class="bi bi-person-badge"></i>
                <span>شاشة الويتر (النادل)</span>
            </a>
            <a href="/Cashier" target="_blank" class="flex items-center gap-3 px-4 py-2 text-xs font-bold rounded-lg border border-emerald-200 dark:border-emerald-900/50 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-900/20 transition-all justify-center">
                <i class="bi bi-pc-display-horizontal"></i>
                <span>كاشير نقاط البيع POS</span>
            </a>
            <a href="/Chef" target="_blank" class="flex items-center gap-3 px-4 py-2 text-xs font-bold rounded-lg border border-rose-200 dark:border-rose-900/50 text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-900/20 transition-all justify-center">
                <i class="bi bi-fire"></i>
                <span>شاشة المطبخ (الشيف)</span>
            </a>
            <hr class="border-slate-200 dark:border-slate-700 my-2">
            <button onclick="switchTab('user-mgmt')" id="btn-tab-user-mgmt" class="w-full flex items-center gap-3 px-4 py-2 text-xs font-bold rounded-lg border border-sky-200 dark:border-sky-900/50 text-sky-600 dark:text-sky-400 hover:bg-sky-50 dark:hover:bg-sky-900/20 transition-all justify-center">
                <i class="bi bi-people-fill"></i>
                <span>إدارة المستخدمين والصلاحيات</span>
            </button>

            <form action="/Identity/Account/Logout?returnUrl=%2F" method="post" id="logoutForm" class="w-full m-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="w-full flex items-center gap-3 px-4 py-2.5 text-xs font-black rounded-lg bg-red-50 hover:bg-red-100 text-red-600 dark:bg-red-950/20 dark:hover:bg-red-950/30 dark:text-red-400 transition-all justify-center">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>تسجيل الخروج</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- MAIN APP WRAPPER -->
    <div class="flex-1 flex flex-col h-full overflow-hidden min-w-0">

        <!-- HEADER -->
        <header class="h-16 bg-white dark:bg-darkCard border-b border-slate-200 dark:border-darkBorder flex items-center justify-between px-8 z-10 shrink-0">
            <!-- Breadcrumbs / Active Tab Title -->
            <div class="flex items-center gap-2">
                <span class="text-slate-400 text-xs font-medium uppercase tracking-widest">QORE ERP</span>
                <span class="text-slate-300 dark:text-slate-600">/</span>
                <h2 id="active-tab-title" class="outfit-font text-slate-800 dark:text-white font-bold text-lg">Operations Hub & Features Map</h2>
            </div>

            <!-- Header Actions -->
            <div class="flex items-center gap-4">
                <!-- Branch Selector -->
                <div class="relative flex items-center">
                    <select id="header-branch-selector" onchange="onAdminBranchChanged(this.value)" class="pl-3 pr-8 py-2 border border-slate-200 dark:border-darkBorder rounded-xl text-xs font-semibold bg-slate-50 dark:bg-slate-900 focus:outline-none dark:text-white appearance-none cursor-pointer">
                        <option value="">Consolidated (All Branches)</option>
                        @if (ViewBag.Branches != null)
                        {
                            foreach (var branch in ViewBag.Branches)
                            {
                                if (ViewBag.ActiveBranchId == branch.Id.ToString())
                                {
                                    <option value="@branch.Id" selected>@branch.Name</option>
                                }
                                else
                                {
                                    <option value="@branch.Id">@branch.Name</option>
                                }
                            }
                        }
                    </select>
                    <span class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-slate-400">
                        <i class="bi bi-chevron-down text-[10px]"></i>
                    </span>
                </div>

                <!-- Dark Mode Toggle -->
                <button onclick="toggleDarkMode()" class="p-2.5 rounded-xl border border-slate-200 dark:border-darkBorder text-slate-500 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-all">
                    <i id="theme-toggle-icon" class="bi bi-moon-fill text-sm"></i>
                </button>
            </div>
        </header>

        <!-- CONTAINER FOR SCROLLABLE TABS -->
        <main class="flex-1 overflow-y-auto p-8 min-h-0 space-y-8 relative">

            <!-- ============================================== -->
            <!-- TAB 0: ALL FEATURES HUB (DIRECTORY MAP)        -->
            <!-- ============================================== -->
            <div id="tab-dashboard" class="tab-content space-y-6">

                <!-- Dynamic Branch Terminals Gateway (White Background Premium Panel) -->
                @{
                    var activeBranchId = ViewBag.ActiveBranchId as string;
                    var activeBranch = (ViewBag.Branches as List<Resturant.Core.Entities.Branch>)?.FirstOrDefault(b => b.Id.ToString() == activeBranchId);
                }

                <div class="bg-white border border-slate-200 p-8 rounded-2xl shadow-sm space-y-6">
                    <div class="flex flex-col md:flex-row justify-between items-start md:items-center border-b pb-4 border-slate-105 gap-4">
                        <div class="text-left">
                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-brand-500/10 text-brand-600 uppercase tracking-widest">Selected Branch Operations</span>
                            <h2 class="outfit-font text-xl font-extrabold text-slate-900 mt-1">
                                @if (activeBranch != null)
                                {
                                    <i class="bi bi-shop text-brand-500 me-2"></i>@activeBranch.Name
                                }
                                else
                                {
                                    <i class="bi bi-layers text-slate-400 me-2"></i><span>Consolidated View (All Branches)</span>
                                }
                            </h2>
                            <p class="text-xs text-slate-500 mt-1 font-medium">Quick operational terminals launchpad. Select a branch from the top header to control distinct terminals.</p>
                        </div>

                        @if (activeBranch == null)
                        {
                            <span class="text-xs text-amber-600 font-bold bg-amber-50 px-3 py-1.5 rounded-xl border border-amber-100 flex items-center gap-1.5">
                                <i class="bi bi-exclamation-circle-fill"></i> Please select a branch from the top-right header to unlock terminals.
                            </span>
                        }
                        else
                        {
                            <span class="text-xs text-emerald-600 font-bold bg-emerald-50 px-3 py-1.5 rounded-xl border border-emerald-100 flex items-center gap-1.5">
                                <i class="bi bi-check-circle-fill"></i> Branch active and routed.
                            </span>
                        }
                    </div>

                    @if (activeBranch != null)
                    {
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                            <!-- Waiter Terminal Card -->
                            <a href="/Waiter?branchId=@activeBranch.Id" target="_blank" class="block bg-slate-50 hover:bg-indigo-50/30 border border-slate-200/60 rounded-2xl p-6 transition-all duration-300 group hover:shadow-md hover:border-indigo-500/30 text-left">
                                <div class="flex items-center gap-4">
                                    <div class="p-3 bg-indigo-500 text-white rounded-xl shadow-md group-hover:scale-110 transition-transform">
                                        <i class="bi bi-person-badge text-xl"></i>
                                    </div>
                                    <div class="text-left">
                                        <h4 class="outfit-font font-bold text-slate-800 group-hover:text-indigo-600 transition-colors">Waiter Terminal</h4>
                                        <span class="text-[10px] font-bold text-indigo-500 uppercase tracking-widest">صالة المطعم & الطلبات</span>
                                    </div>
                                </div>
                                <p class="text-xs text-slate-500 mt-4 leading-relaxed">Launch table management, take table orders, and respond to waiter call-outs for @activeBranch.Name.</p>
                                <div class="mt-4 flex items-center gap-1.5 text-xs font-bold text-indigo-600">
                                    <span>Launch Terminal</span>
                                    <i class="bi bi-arrow-right group-hover:translate-x-1 transition-transform"></i>
                                </div>
                            </a>

                            <!-- Chef Terminal Card -->
                            <a href="/Chef?branchId=@activeBranch.Id" target="_blank" class="block bg-slate-50 hover:bg-rose-50/30 border border-slate-200/60 rounded-2xl p-6 transition-all duration-300 group hover:shadow-md hover:border-rose-500/30 text-left">
                                <div class="flex items-center gap-4">
                                    <div class="p-3 bg-rose-500 text-white rounded-xl shadow-md group-hover:scale-110 transition-transform">
                                        <i class="bi bi-fire text-xl"></i>
                                    </div>
                                    <div class="text-left">
                                        <h4 class="outfit-font font-bold text-slate-800 group-hover:text-rose-600 transition-colors">Kitchen Queue</h4>
                                        <span class="text-[10px] font-bold text-rose-500 uppercase tracking-widest">لوحة تحكم الشيف والمطبخ</span>
                                    </div>
                                </div>
                                <p class="text-xs text-slate-500 mt-4 leading-relaxed">Monitor prep lists, manage recipe items in real-time, and dispatch chef-completed orders.</p>
                                <div class="mt-4 flex items-center gap-1.5 text-xs font-bold text-rose-600">
                                    <span>Launch Display</span>
                                    <i class="bi bi-arrow-right group-hover:translate-x-1 transition-transform"></i>
                                </div>
                            </a>

                            <!-- Cashier Terminal Card -->
                            <a href="/Cashier?branchId=@activeBranch.Id" target="_blank" class="block bg-slate-50 hover:bg-emerald-50/30 border border-slate-200/60 rounded-2xl p-6 transition-all duration-300 group hover:shadow-md hover:border-emerald-500/30 text-left">
                                <div class="flex items-center gap-4">
                                    <div class="p-3 bg-emerald-500 text-white rounded-xl shadow-md group-hover:scale-110 transition-transform">
                                        <i class="bi bi-pc-display-horizontal text-xl"></i>
                                    </div>
                                    <div class="text-left">
                                        <h4 class="outfit-font font-bold text-slate-800 group-hover:text-emerald-600 transition-colors">Cashier POS</h4>
                                        <span class="text-[10px] font-bold text-emerald-500 uppercase tracking-widest">نظام المبيعات والحسابات</span>
                                    </div>
                                </div>
                                <p class="text-xs text-slate-500 mt-4 leading-relaxed">Activate shifts, accept payments, print receipts, and reconcile registers for @activeBranch.Name.</p>
                                <div class="mt-4 flex items-center gap-1.5 text-xs font-bold text-emerald-600">
                                    <span>Launch POS</span>
                                    <i class="bi bi-arrow-right group-hover:translate-x-1 transition-transform"></i>
                                </div>
                            </a>
                        </div>
                    }
                    else
                    {
                        <!-- Grid of All Branches with Quick Icons -->
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                            @if (ViewBag.Branches != null)
                            {
                                foreach (var branch in ViewBag.Branches)
                                {
                                    <div class="bg-slate-50 border border-slate-200/70 p-4 rounded-xl flex flex-col justify-between gap-3 text-left">
                                        <div>
                                            <h4 class="outfit-font font-bold text-slate-850"><i class="bi bi-shop text-brand-500 me-1.5"></i>@branch.Name</h4>
                                            <p class="text-[10px] text-slate-400 mt-0.5">Quick select shortcuts</p>
                                        </div>
                                        <div class="flex gap-2">
                                            <a href="/Waiter?branchId=@branch.Id" target="_blank" class="flex-1 py-2 bg-white hover:bg-indigo-50 border border-slate-200 text-slate-700 hover:text-indigo-600 rounded-lg text-[10px] font-bold text-center transition-all flex items-center justify-center gap-1">
                                                <i class="bi bi-person-badge"></i> Waiter
                                            </a>
                                            <a href="/Chef?branchId=@branch.Id" target="_blank" class="flex-1 py-2 bg-white hover:bg-rose-50 border border-slate-200 text-slate-700 hover:text-rose-600 rounded-lg text-[10px] font-bold text-center transition-all flex items-center justify-center gap-1">
                                                <i class="bi bi-fire"></i> Chef
                                            </a>
                                            <a href="/Cashier?branchId=@branch.Id" target="_blank" class="flex-1 py-2 bg-white hover:bg-emerald-50 border border-slate-200 text-slate-700 hover:text-emerald-600 rounded-lg text-[10px] font-bold text-center transition-all flex items-center justify-center gap-1">
                                                <i class="bi bi-pc-display-horizontal"></i> Cashier
                                            </a>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>

                <!-- Features Directory Map Grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <!-- Card 1: Add / Manage Menu -->
                    <div class="bg-white dark:bg-darkCard border border-slate-200 dark:border-darkBorder p-6 rounded-2xl flex flex-col justify-between shadow-sm relative overflow-hidden group hover:border-rose-500/40 transition-all duration-300">
                        <div class="space-y-3">
                            <div class="flex items-center gap-3">
                                <div class="p-3 bg-rose-50 dark:bg-rose-950/20 text-rose-500 rounded-xl">
                                    <i class="bi bi-journal-plus text-xl"></i>
                                </div>
                                <h3 class="outfit-font text-base font-bold text-slate-900 dark:text-white">Add / Manage Menu</h3>
                            </div>
                            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">Create, edit, and archive dishes or drinks, configure their prices, popularity badges, and upload high-resolution food images to Cloudinary.</p>
                        </div>
                        <div class="mt-6">
