        // CRM Guest Directory State Variables
        let crmSearchTerm = '';
        let crmLoyaltyFilter = '';
        let crmStatusFilter = '';
        let crmSortField = 'totalSpent';
        let crmSortAsc = false;
        let crmPage = 1;
        const crmPageSize = 8;
        let globalCrmGuests = [];

        function filterCRMDirectory() {
            crmSearchTerm = document.getElementById('crm-search').value.toLowerCase();
            crmLoyaltyFilter = document.getElementById('crm-filter-loyalty').value;
            crmStatusFilter = document.getElementById('crm-filter-status').value;
            crmPage = 1;
            renderCRMTable();
        }

        function sortCRMDirectory(field) {
            if (crmSortField === field) {
                crmSortAsc = !crmSortAsc;
            } else {
                crmSortField = field;
                crmSortAsc = true;
            }
            renderCRMTable();
        }

        function paginateCRM(direction) {
            if (direction === 'prev' && crmPage > 1) {
                crmPage--;
            } else if (direction === 'next' && crmPage * crmPageSize < getFilteredCRMCount()) {
                crmPage++;
            }
            renderCRMTable();
        }

        function getFilteredCRMCount() {
            return globalCrmGuests.filter(g => {
                const matchSearch = (g.customerName || '').toLowerCase().includes(crmSearchTerm) || 
                                    (g.phoneNumber || '').toLowerCase().includes(crmSearchTerm) || 
                                    (g.email || '').toLowerCase().includes(crmSearchTerm);
                const matchLoyalty = !crmLoyaltyFilter || g.loyaltySegment === crmLoyaltyFilter;
                const matchStatus = !crmStatusFilter || g.sessionStatus === crmStatusFilter;
                return matchSearch && matchLoyalty && matchStatus;
            }).length;
        }

        function renderCRMTable() {
            const tbody = document.querySelector('#table-vip-customers tbody');
            if (!tbody) return;
            tbody.innerHTML = '';

            let filtered = globalCrmGuests.filter(g => {
                const matchSearch = (g.customerName || '').toLowerCase().includes(crmSearchTerm) || 
                                    (g.phoneNumber || '').toLowerCase().includes(crmSearchTerm) || 
                                    (g.email || '').toLowerCase().includes(crmSearchTerm);
                const matchLoyalty = !crmLoyaltyFilter || g.loyaltySegment === crmLoyaltyFilter;
                const matchStatus = !crmStatusFilter || g.sessionStatus === crmStatusFilter;
                return matchSearch && matchLoyalty && matchStatus;
            });

            // Sort
            filtered.sort((a, b) => {
                let valA = a[crmSortField];
                let valB = b[crmSortField];

                if (typeof valA === 'string') {
                    valA = valA.toLowerCase();
                    valB = (valB || '').toLowerCase();
                }

                if (valA < valB) return crmSortAsc ? -1 : 1;
                if (valA > valB) return crmSortAsc ? 1 : -1;
                return 0;
            });

            const totalCount = filtered.length;
            const startIdx = (crmPage - 1) * crmPageSize;
            const endIdx = Math.min(startIdx + crmPageSize, totalCount);

            document.getElementById('crm-pagination-info').textContent = 
                `Showing ${totalCount > 0 ? startIdx + 1 : 0} to ${endIdx} of ${totalCount} guests`;

            document.querySelector("button[onclick=\"paginateCRM('prev')\"]").disabled = (crmPage === 1);
            document.querySelector("button[onclick=\"paginateCRM('next')\"]").disabled = (endIdx >= totalCount);

            const segmentBadges = {
                'Elite VIP': 'bg-brand-500/10 text-brand-600 dark:text-brand-400 border border-brand-500/20',
                'Frequent Buyer': 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/20 dark:text-emerald-400 border border-emerald-500/20',
                'Standard Loyalty': 'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-400 border border-slate-700/20'
            };

            const pageSlice = filtered.slice(startIdx, endIdx);
            if (pageSlice.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="py-6 text-center text-slate-400">No guest records found matching current criteria.</td></tr>`;
                return;
            }

            pageSlice.forEach(g => {
                const tr = `
                    <tr class="border-b border-slate-100 dark:border-darkBorder hover:bg-slate-50 dark:hover:bg-slate-900 transition-colors">
                        <td class="py-3 font-semibold text-slate-800 dark:text-slate-100 flex items-center gap-1.5">
                            <span class="w-6 h-6 rounded-full bg-brand-500/10 text-brand-650 flex items-center justify-center font-bold text-[10px]">
                                ${g.customerName ? g.customerName.charAt(0).toUpperCase() : 'G'}
                            </span>
                            ${g.customerName || 'Anonymous Guest'}
                        </td>
                        <td class="py-3 font-medium text-slate-550 dark:text-slate-400">
                            <div>${g.phoneNumber || 'No Phone'}</div>
                            <div class="text-[10px] text-slate-400">${g.email || 'No Email'}</div>
                        </td>
                        <td class="py-3 text-center font-semibold text-slate-700 dark:text-slate-300">${g.totalOrders} orders</td>
                        <td class="py-3 text-right font-bold text-slate-850 dark:text-white">${g.totalSpent.toFixed(2)} L.E.</td>
                        <td class="py-3 text-right font-black text-emerald-500">${g.customerLifetimeValue.toFixed(2)} L.E.</td>
                        <td class="py-3">
                            <span class="px-2 py-0.5 rounded text-[8px] font-bold uppercase tracking-wider ${segmentBadges[g.loyaltySegment] || segmentBadges['Standard Loyalty']}">
                                ${g.loyaltySegment}
                            </span>
                        </td>
                        <td class="py-3 text-right">
                            <button onclick="openCRMDetailsModal('${g.guestId}')" class="px-2.5 py-1 bg-brand-500/10 hover:bg-brand-500 hover:text-white text-brand-600 dark:text-brand-400 rounded-lg font-bold text-[10px] transition-all border border-brand-500/20">
                                <i class="bi bi-person-lines-fill mr-0.5"></i> Profile
                            </button>
                        </td>
                    </tr>
                `;
                tbody.insertAdjacentHTML('beforeend', tr);
            });
        }

        // Open CRM Guest Details Modal
        function openCRMDetailsModal(guestId) {
            const guest = globalCrmGuests.find(g => g.guestId === guestId);
            if (!guest) return;

            document.getElementById('crm-modal-name').textContent = guest.customerName || 'Anonymous Guest';
            document.getElementById('crm-modal-phone').textContent = guest.phoneNumber || 'Not Provided';
            document.getElementById('crm-modal-email').textContent = guest.email || 'Not Provided';
            document.getElementById('crm-modal-segment').className = `px-2.5 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider ${
                guest.loyaltySegment === 'Elite VIP' ? 'bg-brand-500/20 text-brand-550 border border-brand-500/30' : 
                guest.loyaltySegment === 'Frequent Buyer' ? 'bg-emerald-100 text-emerald-800 border border-emerald-550/30' : 
                'bg-slate-100 text-slate-700'
            }`;
            document.getElementById('crm-modal-segment').textContent = guest.loyaltySegment;

            // Details
            document.getElementById('crm-modal-joined').textContent = new Date(guest.firstVisit).toLocaleDateString([], { dateStyle: 'medium' });
            document.getElementById('crm-modal-last-visit').textContent = new Date(guest.lastVisit).toLocaleDateString([], { dateStyle: 'medium' });
            document.getElementById('crm-modal-status').textContent = guest.sessionStatus;
            document.getElementById('crm-modal-status-badge').className = `w-2.5 h-2.5 rounded-full ${guest.sessionStatus === 'Active' ? 'bg-emerald-500 animate-pulse' : 'bg-slate-400'}`;

            // Spending and Habits
            document.getElementById('crm-modal-spent').textContent = `${guest.totalSpent.toFixed(2)} L.E.`;
            document.getElementById('crm-modal-ltv').textContent = `${guest.customerLifetimeValue.toFixed(2)} L.E.`;
            document.getElementById('crm-modal-aov').textContent = `${guest.aov.toFixed(2)} L.E.`;
            document.getElementById('crm-modal-fav').textContent = guest.favoriteProduct || 'None Registered';

            // Counts
            document.getElementById('crm-modal-orders-completed').textContent = guest.completedOrdersCount;
            document.getElementById('crm-modal-orders-pending').textContent = guest.pendingOrdersCount;
            document.getElementById('crm-modal-orders-cancelled').textContent = guest.cancelledOrdersCount;

            // Notes
            document.getElementById('crm-modal-notes').value = guest.crmNotes || '';
            document.getElementById('crm-modal-save-btn').onclick = function() {
                saveCRMNotes(guestId);
            };

            // Open Modal
            const modal = document.getElementById('crm-guest-modal');
            const modalContent = document.getElementById('crm-guest-modal-content');
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                modalContent.classList.remove('scale-95');
            }, 50);
        }

        function closeCRMDetailsModal() {
            const modal = document.getElementById('crm-guest-modal');
            const modalContent = document.getElementById('crm-guest-modal-content');
            modal.classList.add('opacity-0');
            modalContent.classList.add('scale-95');
            setTimeout(() => { modal.classList.add('hidden'); }, 300);
        }

        async function saveCRMNotes(guestId) {
            const notes = document.getElementById('crm-modal-notes').value;
            showLoader();
            try {
                const response = await fetch(`/api/analytics/customers/${guestId}/notes`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(notes)
                });
                if (response.ok) {
                    showToastAlert("CRM Guest notes updated successfully.", "success");
                    // Update cache
                    const guest = globalCrmGuests.find(g => g.guestId === guestId);
                    if (guest) guest.crmNotes = notes;
                    closeCRMDetailsModal();
                } else {
                    showToastAlert("Failed to save guest CRM notes.", "error");
                }
            } catch (err) {
                showToastAlert("Error: " + err.message, "error");
            } finally {
                hideLoader();
            }
        }

        // Export CRM Guest Directory
        function exportGuestCRM(format) {
            if (globalCrmGuests.length === 0) {
                showToastAlert("No data available to export.", "warning");
                return;
            }

            if (format === 'excel') {
                // Generate CSV
                let csv = 'Guest ID,Name,Phone,Email,Segment,Total Orders,Completed,Pending,Cancelled,Total Spent (L.E.),CLV (L.E.),AOV (L.E.),First Visit,Last Visit,Status\n';
                globalCrmGuests.forEach(g => {
                    csv += `"${g.guestId}","${g.customerName || 'Anonymous'}","${g.phoneNumber || ''}","${g.email || ''}","${g.loyaltySegment}",${g.totalOrders},${g.completedOrdersCount},${g.pendingOrdersCount},${g.cancelledOrdersCount},${g.totalSpent.toFixed(2)},${g.customerLifetimeValue.toFixed(2)},${g.aov.toFixed(2)},"${g.firstVisit}","${g.lastVisit}","${g.sessionStatus}"\n`;
                });
                const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
                const link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.setAttribute('download', `qore_crm_guests_${new Date().toISOString().slice(0,10)}.csv`);
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                showToastAlert("CRM Guest list exported as CSV.", "success");
            } else if (format === 'pdf') {
                window.print();
            }
        }

