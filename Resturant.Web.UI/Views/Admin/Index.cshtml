        // --- WAITER ASSIGNMENT LOGIC ---
        async function loadWaiterAssignmentsList() {
            try {
                const response = await fetch('/Admin/GetWaiterAssignments');
                if (!response.ok) throw new Error('Failed to load table assignments');
                const data = await response.json();

                const tbody = document.querySelector('#table-waiter-assignment-list tbody');
                tbody.innerHTML = '';

                if (data.tables.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="3" class="text-center py-4 text-slate-400">لم يتم إعداد أي طاولات بعد.</td></tr>`;
                    return;
                }

                data.tables.forEach(table => {
                    let waiterSelectHtml = `<select class="w-full max-w-xs bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-darkBorder rounded-lg px-3 py-2 text-xs font-medium text-slate-800 dark:text-white focus:outline-none focus:ring-1 focus:ring-indigo-500" onchange="assignWaiterToTable(${table.id}, this.value)">
                        <option value="">-- غير مسند / لا يوجد نادل --</option>`;
                    data.waiters.forEach(waiter => {
                        const isSelected = table.waiterId === waiter.id ? 'selected' : '';
                        waiterSelectHtml += `<option value="${waiter.id}" ${isSelected}>${waiter.fullName}</option>`;
                    });
                    waiterSelectHtml += `</select>`;

                    const tr = document.createElement('tr');
                    tr.className = 'border-b border-slate-50 dark:border-darkBorder/50 hover:bg-slate-50/50 dark:hover:bg-slate-800/20 transition-colors';
                    tr.innerHTML = `
                        <td class="py-3 px-2 font-bold text-slate-800 dark:text-white">طاولة ${table.tableNumber}</td>
                        <td class="py-3 px-2">${waiterSelectHtml}</td>
                        <td class="py-3 px-2 text-right">
                            <span class="px-2 py-1 bg-emerald-50 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400 text-[10px] font-bold rounded-lg border border-emerald-200 dark:border-emerald-800 transition-opacity opacity-0" id="waiter-status-${table.id}">تم الحفظ <i class="bi bi-check-circle-fill"></i></span>
                        </td>
                    `;
                    tbody.appendChild(tr);
                });
            } catch (error) {
                console.error('Error loading waiter assignments:', error);
            }
        }

        async function assignWaiterToTable(tableId, waiterId) {
            try {
                const response = await fetch(`/Admin/AssignWaiter?tableId=${tableId}&waiterId=${waiterId || ''}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const result = await response.json();
                if(result.success) {
                    const statusSpan = document.getElementById(`waiter-status-${tableId}`);
                    statusSpan.classList.remove('opacity-0');
                    setTimeout(() => statusSpan.classList.add('opacity-0'), 2500);
                } else {
                    alert(result.message || "فشل إسناد النادل.");
                }
            } catch (error) {
                console.error('Error saving waiter assignment:', error);
                alert("حدث خطأ أثناء الحفظ.");
            }
        }

        // --- CASHIER SHIFT REPORTS LOGIC ---
        let allAdminShifts = [];
        let currentAdminShiftPage = 1;
        const shiftsPerPage = 10;

        function escapeHtml(str) {
            if (!str) return '';
            return str.toString()
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        async function loadShiftReportsList(page = 1) {
            showLoader();
            try {
                const searchTerm = document.getElementById('adminShiftSearch')?.value || '';
                const status = document.getElementById('adminShiftStatus')?.value || '';
                const dateFrom = document.getElementById('adminShiftDateFrom')?.value || '';
                const dateTo = document.getElementById('adminShiftDateTo')?.value || '';
                const hourFrom = document.getElementById('adminShiftHourFrom')?.value || '';
                const hourTo = document.getElementById('adminShiftHourTo')?.value || '';

                if (dateFrom && dateTo && dateFrom > dateTo) {
                    showToastAlert("Start date must be before or equal to the end date.", "warning");
                    hideLoader();
                    return;
                }

                const params = new URLSearchParams();
                if (searchTerm) params.append('searchTerm', searchTerm);
                if (status) params.append('status', status);
                if (dateFrom) params.append('dateFrom', dateFrom);
                if (dateTo) params.append('dateTo', dateTo);
                if (hourFrom !== '') params.append('hourFrom', hourFrom);
                if (hourTo !== '') params.append('hourTo', hourTo);
                params.append('page', page);
                params.append('pageSize', shiftsPerPage);

                const response = await fetch(`/api/analytics/shifts?${params.toString()}`);

                // Check if session is expired or redirected to login
                const contentType = response.headers.get("content-type");
                if (contentType && contentType.indexOf("text/html") !== -1) {
                    showToastAlert("Session expired or Unauthorized. Redirecting to login page...", "warning");
                    setTimeout(() => {
                        window.location.href = "/Identity/Account/Login?ReturnUrl=" + encodeURIComponent(window.location.pathname);
                    }, 2200);
                    return;
                }

                if (response.ok) {
                    const data = await response.json();
                    allAdminShifts = data.shifts;
                    currentAdminShiftPage = data.page;
                    renderShiftsTable(data.page, data.totalPages, data.totalCount);
                } else {
                    const errData = await response.json().catch(() => ({}));
                    showToastAlert(errData.message || "Server returned an error fetching shifts.", "error");
                }
            } catch (err) {
                console.error("Failed to load shifts:", err);
                showToastAlert("Could not connect to server.", "error");
            } finally {
                hideLoader();
            }
        }

        function resetShiftFilters() {
            const searchInput = document.getElementById('adminShiftSearch');
            if (searchInput) searchInput.value = '';

            const statusInput = document.getElementById('adminShiftStatus');
            if (statusInput) statusInput.value = '';

            const dateFromInput = document.getElementById('adminShiftDateFrom');
            if (dateFromInput) dateFromInput.value = '';

            const dateToInput = document.getElementById('adminShiftDateTo');
            if (dateToInput) dateToInput.value = '';

            const hourFromInput = document.getElementById('adminShiftHourFrom');
            if (hourFromInput) hourFromInput.value = '';

            const hourToInput = document.getElementById('adminShiftHourTo');
            if (hourToInput) hourToInput.value = '';

            loadShiftReportsList(1);
            showToastAlert("Filters reset successfully.", "info");
        }

        function renderShiftsTable(page = 1, totalPages = 1, totalCount = 0) {
            currentAdminShiftPage = page;
            const tbody = document.querySelector('#table-shifts-list tbody');
            const paginationContainer = document.getElementById('shiftsPagination');
            tbody.innerHTML = '';

            if (paginationContainer) {
                paginationContainer.innerHTML = '';
            }

            if (!allAdminShifts || allAdminShifts.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="9" class="text-center py-8 text-slate-400 dark:text-slate-500">
                            <i class="bi bi-clock-history text-3xl text-warning mb-2 d-block"></i>
                            لم يتم العثور على ورديات تطابق معايير البحث.
                        </td>
                    </tr>`;
                return;
            }

            allAdminShifts.forEach(shift => {
                let diffBadge = '-';
                if (shift.difference !== null) {
                    const diffVal = parseFloat(shift.difference);
                    if (diffVal === 0) {
                        diffBadge = `<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">متطابقة</span>`;
                    } else if (diffVal > 0) {
                        diffBadge = `<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">+${diffVal.toFixed(2)} ج.م</span>`;
                    } else {
                        diffBadge = `<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20">${diffVal.toFixed(2)} ج.م (عجز)</span>`;
                    }
                }

                const statusBadge = shift.isActive
                    ? `<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500 text-white animate-pulse">نشطة</span>`
                    : `<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-555/15 text-slate-400">مغلقة</span>`;

                const actualStr = shift.actualAmount !== null ? `${parseFloat(shift.actualAmount).toFixed(2)} ج.م` : '-';
                const actionBtn = !shift.isActive
                    ? `<button onclick="viewShiftDetails(${shift.id})" class="px-2.5 py-1 text-xs font-bold rounded-lg border border-brand-500/20 text-brand-500 hover:bg-brand-500/10 transition-all">عرض التفاصيل</button>`
                    : `<span class="text-xs text-slate-400">وردية نشطة</span>`;

                tbody.innerHTML += `
                    <tr class="border-b border-slate-50 dark:border-darkBorder/50 hover:bg-slate-50/50 dark:hover:bg-slate-800/20 transition-colors">
                        <td class="py-3.5 px-2 font-bold text-brand-500">#${shift.id}</td>
                        <td class="py-3.5 px-2 font-semibold text-slate-800 dark:text-white">${escapeHtml(shift.cashierName)}</td>
                        <td class="py-3.5 px-2 text-slate-500 dark:text-slate-400">${escapeHtml(shift.startTime)}</td>
                        <td class="py-3.5 px-2 text-slate-500 dark:text-slate-400">${escapeHtml(shift.endTime || '-')}</td>
                        <td class="py-3.5 px-2 text-right font-bold text-slate-900 dark:text-white">${parseFloat(shift.expectedAmount).toFixed(2)} ج.م</td>
                        <td class="py-3.5 px-2 text-right font-bold text-slate-900 dark:text-white">${actualStr}</td>
                        <td class="py-3.5 px-2 text-center">${diffBadge}</td>
                        <td class="py-3.5 px-2 text-center">${statusBadge}</td>
                        <td class="py-3.5 px-2 text-right">${actionBtn}</td>
                    </tr>`;
            });

            // Render Pagination Buttons
            if (totalPages > 1 && paginationContainer) {
                let paginationHtml = '';

                // Prev button
                paginationHtml += `<button onclick="loadShiftReportsList(${page - 1})" ${page === 1 ? 'disabled' : ''} class="px-3 py-1.5 mx-1 text-xs font-bold rounded-lg border border-slate-200 dark:border-darkBorder ${page === 1 ? 'text-slate-400 cursor-not-allowed opacity-50' : 'text-slate-700 dark:text-white hover:bg-slate-50 dark:hover:bg-slate-800'}">السابق</button>`;

                // Page numbers
                for (let i = 1; i <= totalPages; i++) {
                    const activeClass = i === page
                        ? 'bg-brand-500 text-white border-brand-500'
                        : 'text-slate-700 dark:text-white border-slate-200 dark:border-darkBorder hover:bg-slate-50 dark:hover:bg-slate-800';
                    paginationHtml += `<button onclick="loadShiftReportsList(${i})" class="px-3 py-1.5 mx-1 text-xs font-bold rounded-lg border ${activeClass}">${i}</button>`;
                }

                // Next button
                paginationHtml += `<button onclick="loadShiftReportsList(${page + 1})" ${page === totalPages ? 'disabled' : ''} class="px-3 py-1.5 mx-1 text-xs font-bold rounded-lg border border-slate-200 dark:border-darkBorder ${page === totalPages ? 'text-slate-400 cursor-not-allowed opacity-50' : 'text-slate-700 dark:text-white hover:bg-slate-50 dark:hover:bg-slate-800'}">التالي</button>`;

                paginationContainer.innerHTML = paginationHtml;
            }
        }

        async function exportAdminShiftsToExcel() {
            showLoader();
            try {
                const searchTerm = document.getElementById('adminShiftSearch')?.value || '';
                const status = document.getElementById('adminShiftStatus')?.value || '';
                const dateFrom = document.getElementById('adminShiftDateFrom')?.value || '';
                const dateTo = document.getElementById('adminShiftDateTo')?.value || '';
                const hourFrom = document.getElementById('adminShiftHourFrom')?.value || '';
                const hourTo = document.getElementById('adminShiftHourTo')?.value || '';

                const params = new URLSearchParams();
                if (searchTerm) params.append('searchTerm', searchTerm);
                if (status) params.append('status', status);
                if (dateFrom) params.append('dateFrom', dateFrom);
                if (dateTo) params.append('dateTo', dateTo);
                if (hourFrom !== '') params.append('hourFrom', hourFrom);
                if (hourTo !== '') params.append('hourTo', hourTo);
                params.append('export', 'true');

                const response = await fetch(`/api/analytics/shifts?${params.toString()}`);
                if (response.ok) {
                    const exportDataRaw = await response.json();
                    if (!exportDataRaw || exportDataRaw.length === 0) {
                        showToastAlert("لا توجد بيانات مطابقة للتصدير.", "warning");
                        return;
                    }

                    const exportData = exportDataRaw.map(shift => {
                        const diffVal = shift.difference !== null ? parseFloat(shift.difference).toFixed(2) : '0.00';
                        return {
                            "معرف الوردية": shift.id,
                            "الكاشير": shift.cashierName,
                            "وقت البدء": shift.startTime,
                            "وقت الانتهاء": shift.endTime || '-',
                            "المتوقع بالنظام (ج.م)": parseFloat(shift.expectedAmount).toFixed(2),
                            "المدخل الفعلي (ج.م)": shift.actualAmount !== null ? parseFloat(shift.actualAmount).toFixed(2) : '0.00',
                            "الفرق (ج.م)": diffVal,
                            "الحالة": shift.isActive ? "نشطة" : "مغلقة"
                        };
                    });

                    if (typeof XLSX !== 'undefined') {
                        const ws = XLSX.utils.json_to_sheet(exportData);
                        const wb = XLSX.utils.book_new();
                        XLSX.utils.book_append_sheet(wb, ws, "ورديات الكاشير");
                        XLSX.writeFile(wb, `تقرير_ورديات_الكاشير_${new Date().toISOString().slice(0,10)}.xlsx`);
                        showToastAlert("تم تصدير تقرير ورديات الكاشير إلى ملف إكسل بنجاح.", "success");
                    } else {
                        showToastAlert("مكتبة تصدير إكسل غير متوفرة حالياً.", "error");
                    }
                } else {
                    showToastAlert("فشل تحميل بيانات الورديات للتصدير.", "error");
                }
            } catch (err) {
                console.error("Export failed:", err);
                showToastAlert("حدث خطأ أثناء التصدير.", "error");
            } finally {
                hideLoader();
            }
        }

        function viewShiftDetails(shiftId) {
            window.open('/Cashier/ShiftSummary/' + shiftId, '_blank');
        }

        // --- GLOBAL SYSTEM SETTINGS LOGIC ---
        async function loadSystemSettings() {
            showLoader();
            try {
                const response = await fetch('/Admin/GetSettings');
                if (response.ok) {
                    const settings = await response.json();
                    document.getElementById('settings-tax').value = settings.taxPercentage;
                    document.getElementById('settings-service').value = settings.servicePercentage;
                }
            } catch (err) {
                console.error("Failed to load settings:", err);
            } finally {
                hideLoader();
            }
        }

        async function submitSystemSettings(event) {
            event.preventDefault();
            const tax = document.getElementById('settings-tax').value;
            const service = document.getElementById('settings-service').value;

            const formData = new FormData();
            formData.append('taxPercentage', tax);
            formData.append('servicePercentage', service);

            showLoader();
            try {
                const response = await fetch('/Admin/SaveSettings', {
                    method: 'POST',
                    body: formData
                });
                if (response.ok) {
                    const alert = document.getElementById('settings-success-alert');
                    alert.classList.remove('hidden');
                    setTimeout(() => alert.classList.add('hidden'), 3500);
                    showToastAlert("Global system settings updated successfully!", "success");
                } else {
                    showToastAlert("Failed to update system settings.", "error");
                }
            } catch (err) {
                console.error("Error updating settings:", err);
                showToastAlert("Error saving settings.", "error");
            } finally {
                hideLoader();
            }
        }

        async function onAdminBranchChanged(branchId) {
            try {
                const response = await fetch('/Admin/SwitchBranch?branchId=' + (branchId || ''), {
                    method: 'POST'
                });
                if (response.ok) {
                    location.reload();
                } else {
                    alert("Failed to switch branch");
                }
            } catch (err) {
                console.error(err);
                location.reload();
            }
        }

        // --- PRODUCT SALES REPORT LOGIC ---
        let allProductSales = [];
        let productSalesCategoriesLoaded = false;
        let productSalesBranchesLoaded = false;
        let currentProductSalesPage = 1;
        const productSalesPerPage = 10;

        async function loadProductSalesReportList() {
            showLoader();

            // Dynamic populate dropdowns on first load
            if (!productSalesCategoriesLoaded || !productSalesBranchesLoaded) {
                try {
                    if (!productSalesCategoriesLoaded) {
                        const catRes = await fetch('/api/analytics/categories');
                        if (catRes.ok) {
                            const categories = await catRes.json();
                            const catSelect = document.getElementById('prodSalesCategory');
                            if (catSelect) {
                                catSelect.innerHTML = '<option value="">All Categories</option>';
                                categories.forEach(c => {
                                    catSelect.innerHTML += `<option value="${c.id}">${c.name}</option>`;
                                });
                            }
                            productSalesCategoriesLoaded = true;
                        }
                    }
                    if (!productSalesBranchesLoaded) {
                        const branchRes = await fetch('/api/analytics/branches');
                        if (branchRes.ok) {
                            const branches = await branchRes.json();
                            const branchSelect = document.getElementById('prodSalesBranch');
                            if (branchSelect) {
                                branchSelect.innerHTML = '<option value="">All Branches</option>';
                                branches.forEach(b => {
                                    branchSelect.innerHTML += `<option value="${b.id}">${b.name}</option>`;
                                });
                            }
                            productSalesBranchesLoaded = true;
                        }
                    }
                } catch (err) {
                    console.error("Error loading filter categories/branches:", err);
                }
            }

            // Fetch report data from server
            const categoryId = document.getElementById('prodSalesCategory')?.value || '';
            const branchId = document.getElementById('prodSalesBranch')?.value || '';
            const dateFrom = document.getElementById('prodSalesDateFrom')?.value || '';
            const dateTo = document.getElementById('prodSalesDateTo')?.value || '';
            const hourFrom = document.getElementById('prodSalesHourFrom')?.value || '';
            const hourTo = document.getElementById('prodSalesHourTo')?.value || '';

            const params = new URLSearchParams();
            if (categoryId) params.append('categoryId', categoryId);
            if (branchId) params.append('branchId', branchId);
            if (dateFrom) params.append('dateFrom', dateFrom);
            if (dateTo) params.append('dateTo', dateTo);
            if (hourFrom !== '') params.append('hourFrom', hourFrom);
            if (hourTo !== '') params.append('hourTo', hourTo);

            try {
                const response = await fetch(`/api/analytics/products/sales-report?${params.toString()}`);

                // Session timeout handling
                const contentType = response.headers.get("content-type");
                if (contentType && contentType.indexOf("text/html") !== -1) {
                    showToastAlert("Session expired or Unauthorized. Redirecting to login...", "warning");
                    setTimeout(() => {
                        window.location.href = "/Identity/Account/Login?ReturnUrl=" + encodeURIComponent(window.location.pathname);
                    }, 2200);
                    return;
                }

                if (response.ok) {
                    allProductSales = await response.json();
                    renderProductSalesTable(1);
                } else {
                    showToastAlert("Server returned an error generating product report.", "error");
                }
            } catch (err) {
                console.error("Failed to load product sales report:", err);
                showToastAlert("Could not connect to server.", "error");
            } finally {
                hideLoader();
            }
        }

        function getFilteredProductSales() {
            const searchTerm = document.getElementById('prodSalesSearch')?.value.toLowerCase() || '';

            return allProductSales.filter(item => {
                const matchSearch = !searchTerm ||
                    (item.productName && item.productName.toLowerCase().includes(searchTerm)) ||
                    (item.size && item.size.toLowerCase().includes(searchTerm));
                return matchSearch;
            });
        }

        function renderProductSalesSummary(filtered) {
            const container = document.getElementById('productSalesSummaryCards');
            if (!container) return;
            const sum = (field) => filtered.reduce((acc, item) => acc + (parseFloat(item[field]) || 0), 0);
            const totalSales = sum('totalSalesBeforeTax');
            const totalGrossProfit = sum('grossProfit');
            const totalNetCustomerProfit = sum('netCustomerProfit');
            const cards = [
                ['Total Quantity Sold', sum('quantitySold').toFixed(0)],
                ['Sales Before Tax', `${totalSales.toFixed(2)} EGP`],
                ['Tax Collected', `${sum('totalTax').toFixed(2)} EGP`],
                ['Service Collected', `${sum('totalServiceCharge').toFixed(2)} EGP`],
                ['Customer Payments', `${sum('totalCustomerPaid').toFixed(2)} EGP`],
                ['Total Cost', `${sum('totalCost').toFixed(2)} EGP`],
                ['Total Gross Profit', `${totalGrossProfit.toFixed(2)} EGP`],
                ['Total Net Customer Profit', `${totalNetCustomerProfit.toFixed(2)} EGP`],
                ['Overall Margin', `${(totalSales > 0 ? (totalGrossProfit / totalSales) * 100 : 0).toFixed(2)}%`]
            ];
            container.innerHTML = cards.map(([label, value]) => `
                <div class="bg-white dark:bg-darkCard border border-slate-200 dark:border-darkBorder rounded-xl p-3">
                    <div class="text-[9px] font-bold uppercase text-slate-400">${label}</div>
                    <div class="text-sm font-black text-slate-800 dark:text-white mt-1">${value}</div>
                </div>
            `).join('');
        }

