                    columns = ["اسم النادل", "إجمالي الإيرادات (ج.م)", "الطلبات المنجزة", "متوسط السرعة", "التقييم", "شارة الأداء"];
                    const badgeLabels = {
                        "Highest Sales": "الأعلى مبيعاً",
                        "Fastest Waiter": "الأسرع خدمة",
                        "Star Performer": "الأداء المميز",
                        "Standard": "عادي"
                    };
                    rows = (data.waiterRankings || []).map(w => [w.waiterName, `${(w.totalRevenue ?? 0).toFixed(2)} ج.م`, w.ordersHandled, `${w.averageServiceTimeMinutes} دقيقة`, `${(w.customerRating ?? 0).toFixed(1)} / 5.0`, badgeLabels[w.performanceBadge] || w.performanceBadge || "عادي"]);
                } else if (currentTab === 'kitchen') {
                    columns = ["اسم الصنف", "متوسط وقت التحضير", "إجمالي الأطباق المحضرة"];
                    const items = (data.fastestItems || []).concat(data.slowestItems || []);
                    rows = items.map(i => [i.itemName, `${(i.averagePrepTimeMinutes ?? 0).toFixed(1)} دقيقة`, i.timesPrepared]);
                } else if (currentTab === 'financials') {
                    columns = ["تاريخ الإغلاق", "المدقق", "الدرج المتوقع (ج.م)", "الدرج الفعلي (ج.م)", "الفارق (ج.م)", "إجمالي الإيرادات المغلقة (ج.م)"];
                    rows = (data.closingReports || []).map(c => [new Date(c.date).toLocaleDateString(), c.closedBy, `${(c.expectedCash ?? 0).toFixed(2)} ج.م`, `${(c.actualCash ?? 0).toFixed(2)} ج.م`, `${(c.cashDiscrepancy ?? 0).toFixed(2)} ج.م`, `${(c.totalClosedRevenue ?? 0).toFixed(2)} ج.م`]);
                } else if (currentTab === 'inventory') {
                    columns = ["المكون الحرج", "المخزون الحالي", "حد إعادة الطلب", "الوحدة", "المورد", "حالة المخزون"];
                    const statusLabels = {
                        "Critical": "حرِج",
                        "Warning": "تحذير"
                    };
                    rows = (data.lowStockAlerts || []).map(i => [i.ingredientName, i.currentStock, i.reorderLevel, i.unit, i.supplierName, statusLabels[i.stockStatus] || i.stockStatus]);
                } else {
                    columns = ["مؤشر الأداء الرئيسي", "القيمة"];
                    rows = [
                        ["إيرادات اليوم الحية", `${(data.totalRevenueToday ?? 0).toFixed(2)} ج.م`],
                        ["الطاولات النشطة", data.activeTablesCount ?? 0],
                        ["جلسات QR النشطة", data.activeSessionsTodayCount ?? 0],
                        ["الالطلبات قيد الانتظار", data.pendingOrdersCount ?? 0]
                    ];
                }

                // Render Table PDF
                doc.autoTable({
                    head: [columns],
                    body: rows,
                    startY: 120,
                    theme: 'striped',
                    headStyles: { fillColor: [217, 119, 6], textColor: [255, 255, 255] }, // Amber-600 headers
                    styles: { fontSize: 8 },
