                        } else {
                            tbody.innerHTML = tables.map(t => `
                                <tr class="border-b border-slate-100 dark:border-darkBorder hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-all">
                                    <td class="py-3 font-semibold text-slate-800 dark:text-slate-200 text-xs">طاولة ${t.tableNumber}</td>
                                    <td class="py-3">
                                        ${t.qrCodeImageUrl ? `
                                            <button onclick="openQrModal(${t.tableNumber}, '${t.qrCodeImageUrl}')" class="px-2.5 py-1.5 rounded-lg bg-indigo-50 hover:bg-indigo-100 text-indigo-600 dark:bg-indigo-950/20 dark:hover:bg-indigo-950/30 dark:text-indigo-400 font-bold transition-all text-[10px] flex items-center gap-1"><i class="bi bi-qr-code"></i> عرض رمز QR</button>
