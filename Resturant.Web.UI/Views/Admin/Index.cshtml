                            <label class="block text-xs font-bold text-slate-450 dark:text-slate-400 uppercase tracking-wider mb-2">Service Charge %</label>
                            <div class="relative rounded-xl shadow-sm">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-450 dark:text-slate-400 font-bold">%</div>
                                <input type="number" step="0.01" min="0" max="100" id="settings-service" required class="w-full bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-darkBorder rounded-xl pl-9 pr-4 py-3 text-sm text-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-brand-500 transition-all" placeholder="12.00">
                            </div>
                            <span class="text-[10px] text-slate-400 dark:text-slate-500 mt-1 block">Default dining room and hall service charge percentage.</span>
                        </div>

                        <!-- Action Button -->
                        <button type="submit" class="w-full py-3 rounded-xl bg-brand-500 hover:bg-brand-600 text-white font-semibold text-sm transition-all shadow-md shadow-brand-500/10">Save Global Settings</button>
                    </form>
                </div>
            </div>

        </main>
    </div>

    <!-- TOAST CONTAINER FOR FLOATING LIVE NOTIFICATIONS -->
    <div id="toast-container" class="fixed bottom-6 right-6 z-50 flex flex-col gap-2 max-w-sm w-full"></div>

    <!-- JQUERY AND SIGNALR -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>

    <!-- SCRIPTS CORE LOGIC -->
    <script>
        // State Management
        let currentTab = 'dashboard';
        let charts = {};

        // Cache object to prevent over-fetching when toggling tabs
        let reportsData = {
            summary: null,
            'shift-reports': null
        };

        // Dark / Light Mode Toggle
        function toggleDarkMode() {
            const html = document.documentElement;
            const icon = document.getElementById('theme-toggle-icon');
            if (html.classList.contains('dark')) {
                html.classList.remove('dark');
                localStorage.setItem('theme', 'light');
                if (icon) icon.className = 'bi bi-moon-fill text-sm';
            } else {
                html.classList.add('dark');
                localStorage.setItem('theme', 'dark');
                if (icon) icon.className = 'bi bi-sun-fill text-sm';
            }
        }

        // Tab Switcher
        function switchTab(tabId) {
            // Hide all tabs
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            
            // Remove active classes from all sidebar buttons
            document.querySelectorAll('aside nav button').forEach(btn => {
                btn.className = "w-full flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all";
            });

            // Show active tab
            if (document.getElementById(`tab-${tabId}`)) {
                document.getElementById(`tab-${tabId}`).classList.remove('hidden');
            }

            // Apply active class to the button
            const activeBtn = document.getElementById(`btn-tab-${tabId}`);
            if (activeBtn) {
                activeBtn.className = "w-full flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-xl transition-all duration-200 bg-brand-500 text-white shadow-md shadow-brand-500/10";
            }

            // Update Breadcrumb
            const titles = {
                dashboard: 'Operations Hub & Features Map',
                'menu-mgmt': 'Add / Manage Menu Products',
                'category-mgmt': 'Add / Manage Categories',
                'table-mgmt': 'Add / Manage Restaurant Tables',
                'waiter-assignment': 'Assign Waiters to Tables',
                'shift-reports': 'Cashier Shift History & Reports',
                'settings-mgmt': 'System Taxes & Service Settings',
                'user-mgmt': 'System Access Control'
            };
            document.getElementById('active-tab-title').textContent = titles[tabId] || 'Management Portal';
            
            currentTab = tabId;

            // Fetch tab data if not already fetched
            if (tabId === 'menu-mgmt') {
                loadCategoriesList();
                loadMenuItemsList();
            } else if (tabId === 'category-mgmt') {
                loadCategoriesList();
            } else if (tabId === 'table-mgmt') {
                loadTablesList();
            } else if (tabId === 'waiter-assignment') {
                loadWaiterAssignmentsList();
            } else if (tabId === 'shift-reports') {
                loadShiftReportsList();
            } else if (tabId === 'settings-mgmt') {
                loadSystemSettings();
            } else if (tabId === 'dashboard' || tabId === 'user-mgmt') {
                // Static views
            } else {
                fetchTabReport(tabId);
            }
        }
        // Build API URL helper
        function buildUrl(endpoint) {
            let url = `/api/analytics/${endpoint}`;
            let params = [];
            if (activeFilters.startDate) params.push(`startDate=${activeFilters.startDate}`);
            if (activeFilters.endDate) params.push(`endDate=${activeFilters.endDate}`);
            if (activeFilters.tableNumber) params.push(`tableNumber=${activeFilters.tableNumber}`);
            if (activeFilters.waiterId) params.push(`waiterId=${activeFilters.waiterId}`);
            
            if (params.length > 0) {
                url += `?${params.join('&')}`;
            }
            return url;
        }

        // Fetch Tab-specific Reports
        async function fetchTabReport(tabId, forceRefresh = false) {
            if (!forceRefresh && reportsData[tabId]) {
                // If data exists, just render
                renderTabReport(tabId, reportsData[tabId]);
                return;
            }

            showLoader();
            try {
                const response = await fetch(buildUrl(tabId === 'dashboard' ? 'summary' : tabId));
                
                // Check if response is redirected to HTML login page (ASP.NET Core Cookie authentication default behavior)
                const contentType = response.headers.get("content-type");
                if (contentType && contentType.indexOf("text/html") !== -1) {
                    showToastAlert("Session expired or Unauthorized. Redirecting to login page...", "warning");
                    setTimeout(() => {
                        window.location.href = "/Identity/Account/Login?ReturnUrl=" + encodeURIComponent(window.location.pathname);
                    }, 2200);
                    return;
                }

                if (response.ok) {
                    const data = await response.json();
                    reportsData[tabId] = data;
                    
                    // Reset status badge to secure Sync mode if connection succeeds
                    const badge = document.getElementById('connection-status');
                    if (badge) {
                        badge.className = "inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 dark:bg-amber-950/30 dark:text-amber-400 border border-amber-500/20";
                        badge.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span><i class="bi bi-shield-check"></i> Ledger Sync Mode`;
                    }

                    renderTabReport(tabId, data);
                } else if (response.status === 401 || response.status === 403) {
                    showToastAlert("Access Denied! You must be logged in as an Admin, Manager, or Accountant.", "error");
                    setTimeout(() => {
                        window.location.href = "/Identity/Account/Login?ReturnUrl=" + encodeURIComponent(window.location.pathname);
                    }, 2200);
                } else {
                    console.warn("ERP server returned non-ok response. Activating Ledger Demo Sandbox...");
                    activateDemoSandbox(tabId);
                }
            } catch (err) {
                console.warn("Could not connect to ERP servers. Activating Ledger Demo Sandbox...", err);
                activateDemoSandbox(tabId);
            } finally {
                hideLoader();
            }
        }

        // Helper to load high-fidelity fallback sandbox data
        function activateDemoSandbox(tabId) {
            const mockData = generateFallbackData(tabId);
            reportsData[tabId] = mockData;
            
            // Set dynamic header badge to sandbox mode
            const badge = document.getElementById('connection-status');
            if (badge) {
                badge.className = "inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-800 dark:bg-amber-950/20 dark:text-amber-400 border border-amber-500/30";
                badge.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span><i class="bi bi-shield-check"></i> Demo Sandbox Mode`;
            }

            renderTabReport(tabId, mockData);
        }

        // ==============================================
        // DYNAMIC HIGH-FIDELITY DEMO SANDBOX FALLBACK GENERATOR
        // ==============================================
        function generateFallbackData(tabId) {
            switch (tabId) {
                case 'dashboard':
                    return {
                        totalRevenueToday: 0,
                        activeTablesCount: 0,
                        activeSessionsTodayCount: 0,
                        pendingOrdersCount: 0,
                        completedOrdersToday: 0,
                        revenueGrowthRate: 0,
                        totalRevenueThisWeek: 0,
                        totalRevenueThisMonth: 0,
                        totalRevenueSinceSystemStarted: 0,
                        totalOrdersCount: 0,
                        totalGuestsCount: 0,
                        totalTablesCount: 0,
                        totalMenuItemsCount: 0,
                        totalCategoriesCount: 0,
                        recentNotifications: []
                    };

                case 'sales':
                    return {
                        grossRevenue: 0,
                        netRevenue: 0,
                        totalTaxes: 0,
                        averageOrderValue: 0,
                        totalDiscounts: 0,
                        salesTrend: [],
                        salesByTable: [],
                        salesByPaymentMethod: [],
                        salesByWaiter: []
                    };

                case 'orders':
                    return {
                        totalOrders: 0,
                        averagePreparationTimeMinutes: 0,
                        averageServingTimeMinutes: 0,
                        averageTableTurnoverMinutes: 0,
                        ordersByCategory: [],
                        mostBusyTables: []
                    };

                case 'products':
                    return {
                        bestSellers: [],
                        trendingProducts: [],
                        upsellPerformanceRate: 0,
                        recommendationConversionRate: 0
                    };

                case 'customers':
                    return {
                        newCustomersCount: 0,
                        returningCustomersCount: 0,
                        customerRetentionRate: 0,
                        averageCustomerSpend: 0,
                        vipList: []
                    };

                case 'staff':
                    return {
                        waiterRankings: [],
                        shifts: []
                    };

                case 'kitchen':
                    return {
                        averagePreparationTimeMinutes: 0,
                        delayedOrdersCount: 0,
                        kitchenEfficiencyScore: 0,
                        kitchenLoadByHour: [],
                        fastestItems: [],
                        slowestItems: []
                    };

                case 'financials':
                    return {
                        netProfit: 0,
                        profitMarginPercentage: 0,
                        totalRevenue: 0,
                        totalExpenses: 0,
                        totalTaxAmount: 0,
                        expensesBreakdown: [],
                        paymentReconciliations: [],
                        closingReports: []
                    };

                case 'inventory':
                    return {
                        totalInventoryValuation: 0,
                        totalPurchasesAmount: 0,
                        totalWasteAmount: 0,
                        averageFoodCostPercentage: 0,
                        lowStockAlerts: [],
                        supplierPurchases: [],
                        recipeCosts: [],
                        wasteLogs: []
                    };

                default:
                    return {};
            }
        }

        // Universal Loader
        function showLoader() {
            if (!document.getElementById('erp-loader')) {
                const loader = `
                    <div id="erp-loader" class="absolute inset-0 bg-slate-50/60 dark:bg-darkBg/60 flex items-center justify-center z-50 backdrop-blur-[2px]">
                        <div class="flex flex-col items-center gap-3">
                            <div class="w-10 h-10 border-4 border-brand-500 border-t-transparent rounded-full animate-spin"></div>
                            <span class="text-xs font-bold text-slate-400 tracking-widest uppercase">Calculating Metrics...</span>
                        </div>
                    </div>
                `;
                document.querySelector('main').insertAdjacentHTML('beforeend', loader);
            }
        }

        function hideLoader() {
            const loader = document.getElementById('erp-loader');
            if (loader) loader.remove();
        }

        // Dynamic Renderer based on active tab
        function renderTabReport(tabId, data) {
            switch(tabId) {
                case 'dashboard':
                    renderDashboard(data);
                    break;
                case 'sales':
                    renderSalesReport(data);
                    break;
                case 'orders':
                    renderOrdersReport(data);
                    break;
                case 'products':
                    renderProductsReport(data);
                    break;
                case 'customers':
                    renderCustomersReport(data);
                    break;
                case 'staff':
                    renderStaffReport(data);
                    break;
                case 'kitchen':
                    renderKitchenReport(data);
                    break;
                case 'financials':
                    renderFinancialsReport(data);
                    break;
                case 'inventory':
                    renderInventoryReport(data);
                    break;
            }
        }

        // Apply filters
        function applyFilters() {
            activeFilters.startDate = document.getElementById('filter-start-date').value;
            activeFilters.endDate = document.getElementById('filter-end-date').value;
            activeFilters.tableNumber = document.getElementById('filter-table').value;
            activeFilters.waiterId = document.getElementById('filter-waiter').value;

            // Clear cache to force reload
            for (let key in reportsData) {
                reportsData[key] = null;
            }

            fetchTabReport(currentTab, true);
            showToastAlert("Filters applied successfully.", "success");
        }

        // Reset filters
        function resetFilters() {
            document.getElementById('filter-start-date').value = '';
            document.getElementById('filter-end-date').value = '';
            document.getElementById('filter-table').value = '';
            document.getElementById('filter-waiter').value = '';

            activeFilters = { startDate: '', endDate: '', tableNumber: '', waiterId: '' };

            // Clear cache
            for (let key in reportsData) {
                reportsData[key] = null;
            }

            fetchTabReport(currentTab, true);
            showToastAlert("Filters cleared.", "info");
        }

        // REDRAW CHARTS ON COLOR THEME CHANGE
        function redrawActiveTabCharts() {
            // Re-render charts that need color updates
            if (currentTab === 'dashboard' && charts['liveSales']) {
                charts['liveSales'].updateOptions({
                    theme: { mode: document.documentElement.classList.contains('dark') ? 'dark' : 'light' }
                });
            }
            // For other tabs, just refresh the tab render to cleanly recreate the chart instances
            if (reportsData[currentTab]) {
                renderTabReport(currentTab, reportsData[currentTab]);
            }
        }

        // =========================================================
        // RENDERING TABS IMPLEMENTATIONS
        // =========================================================

        // Live Ledger State Variables
        let liveLedgerSearchTerm = '';
        let liveLedgerFilterType = '';
        let liveLedgerPage = 1;
        const liveLedgerPageSize = 10;
        let globalLedgerNotifications = [];

        function filterLiveLedger() {
            liveLedgerSearchTerm = document.getElementById('live-ledger-search').value.toLowerCase();
            liveLedgerFilterType = document.getElementById('live-ledger-type').value;
            liveLedgerPage = 1;
            renderLiveLedgerTable();
        }

        function paginateLiveLedger(direction) {
            if (direction === 'prev' && liveLedgerPage > 1) {
                liveLedgerPage--;
            } else if (direction === 'next' && liveLedgerPage * liveLedgerPageSize < getFilteredLedgerCount()) {
                liveLedgerPage++;
            }
            renderLiveLedgerTable();
        }

        function getFilteredLedgerCount() {
            return globalLedgerNotifications.filter(n => {
                const matchSearch = n.title.toLowerCase().includes(liveLedgerSearchTerm) || n.message.toLowerCase().includes(liveLedgerSearchTerm);
                const matchType = !liveLedgerFilterType || n.type === liveLedgerFilterType;
                return matchSearch && matchType;
            }).length;
        }

        function renderLiveLedgerTable() {
            const tbody = document.querySelector('#table-live-ledger tbody');
            if (!tbody) return;
            tbody.innerHTML = '';

            const filtered = globalLedgerNotifications.filter(n => {
                const matchSearch = n.title.toLowerCase().includes(liveLedgerSearchTerm) || n.message.toLowerCase().includes(liveLedgerSearchTerm);
                const matchType = !liveLedgerFilterType || n.type === liveLedgerFilterType;
                return matchSearch && matchType;
            });

            const totalCount = filtered.length;
            const startIdx = (liveLedgerPage - 1) * liveLedgerPageSize;
            const endIdx = Math.min(startIdx + liveLedgerPageSize, totalCount);

            document.getElementById('live-ledger-pagination-info').textContent = 
                `Showing ${totalCount > 0 ? startIdx + 1 : 0} to ${endIdx} of ${totalCount} events`;

            document.querySelector("button[onclick=\"paginateLiveLedger('prev')\"]").disabled = (liveLedgerPage === 1);
            document.querySelector("button[onclick=\"paginateLiveLedger('next')\"]").disabled = (endIdx >= totalCount);

            const typeBadges = {
                success: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/20 dark:text-emerald-400 border border-emerald-500/20',
                info: 'bg-blue-100 text-blue-800 dark:bg-blue-950/20 dark:text-blue-400 border border-blue-500/20',
                warning: 'bg-amber-100 text-amber-800 dark:bg-amber-950/20 dark:text-brand-400 border border-brand-500/20',
                error: 'bg-red-100 text-red-800 dark:bg-red-950/20 dark:text-red-400 border border-red-500/20'
            };

            const typeIcons = {
                success: 'bi-check-circle-fill',
                info: 'bi-info-circle-fill',
                warning: 'bi-exclamation-triangle-fill',
                error: 'bi-shield-fill-x'
            };

            const pageSlice = filtered.slice(startIdx, endIdx);
            if (pageSlice.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="py-6 text-center text-slate-400">No events found matching current filter parameters.</td></tr>`;
                return;
            }

            pageSlice.forEach(n => {
                const date = new Date(n.timestamp);
                const timeStr = date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
                
                const tr = `
                    <tr class="border-b border-slate-100 dark:border-darkBorder hover:bg-slate-50 dark:hover:bg-slate-900 transition-colors">
                        <td class="py-3 font-semibold text-slate-400">${timeStr}</td>
                        <td class="py-3 font-bold text-slate-700 dark:text-slate-200 flex items-center gap-1.5">
                            <i class="bi ${typeIcons[n.type]} ${n.type === 'success' ? 'text-emerald-500' : n.type === 'info' ? 'text-blue-500' : n.type === 'warning' ? 'text-brand-500' : 'text-red-500'} text-[10px]"></i>
                            ${n.title}
                        </td>
                        <td class="py-3">
                            <span class="px-2 py-0.5 rounded text-[8px] font-bold uppercase tracking-wider ${typeBadges[n.type]}">
                                ${n.type}
                            </span>
                        </td>
                        <td class="py-3 text-slate-500 dark:text-slate-400 truncate max-w-xs" title="${n.message}">${n.message}</td>
                        <td class="py-3 text-right">
                            <span class="font-bold ${n.type === 'success' ? 'text-emerald-500' : n.type === 'info' ? 'text-blue-500' : n.type === 'warning' ? 'text-brand-500' : 'text-red-500'}">
                                ${n.type === 'success' ? 'Settled' : n.type === 'info' ? 'In-Service' : n.type === 'warning' ? 'Attention' : 'Cancelled'}
                            </span>
                        </td>
                    </tr>
                `;
                tbody.insertAdjacentHTML('beforeend', tr);
            });
        }

        // Render TAB 0: LIVE DASHBOARD SUMMARY
        function renderDashboard(data) {
            // Animate Primary Counters
            animateValue('stat-revenue', `${data.totalRevenueToday.toFixed(2)} L.E.`);
            animateValue('stat-active-tables', data.activeTablesCount);
            animateValue('stat-active-sessions', data.activeSessionsTodayCount);
            animateValue('stat-pending-orders', data.pendingOrdersCount);
            
            document.getElementById('stat-completed-orders').textContent = `${data.completedOrdersToday} completed today`;
            
            const growthBadge = document.getElementById('stat-revenue-growth');
            if (data.revenueGrowthRate >= 0) {
                growthBadge.className = "text-xs font-semibold text-emerald-500 flex items-center gap-1";
                growthBadge.innerHTML = `<i class="bi bi-arrow-up-right"></i> +${data.revenueGrowthRate}% vs yesterday`;
            } else {
                growthBadge.className = "text-xs font-semibold text-red-500 flex items-center gap-1";
                growthBadge.innerHTML = `<i class="bi bi-arrow-down-left"></i> ${data.revenueGrowthRate}% vs yesterday`;
            }

            // Set Secondary Counters
            document.getElementById('stat-rev-week').textContent = `${data.totalRevenueThisWeek.toFixed(2)} L.E.`;
            document.getElementById('stat-rev-month').textContent = `${data.totalRevenueThisMonth.toFixed(2)} L.E.`;
            document.getElementById('stat-rev-total').textContent = `${data.totalRevenueSinceSystemStarted.toFixed(2)} L.E.`;
            document.getElementById('stat-orders-count').textContent = data.totalOrdersCount;
            document.getElementById('stat-guests-count').textContent = data.totalGuestsCount;
            document.getElementById('stat-tables-count').textContent = data.totalTablesCount;
            document.getElementById('stat-menu-count').textContent = data.totalMenuItemsCount;
            document.getElementById('stat-categories-count').textContent = data.totalCategoriesCount;

            // Set Ledger Records
            globalLedgerNotifications = data.recentNotifications;
            renderLiveLedgerTable();

            // Populate Operations Log Feed (Right Panel)
            const list = document.getElementById('live-notifications-list');
            list.innerHTML = '';
            document.getElementById('notification-count').textContent = `${data.recentNotifications.length} logs`;
            
            data.recentNotifications.forEach(n => {
                const borderColors = {
                    info: 'border-l-blue-500',
                    warning: 'border-l-brand-500',
                    success: 'border-l-emerald-500',
                    error: 'border-l-red-500'
                };
                const bgColors = {
                    info: 'bg-blue-50/40 dark:bg-blue-950/10',
                    warning: 'bg-brand-50/40 dark:bg-brand-950/10',
                    success: 'bg-emerald-50/40 dark:bg-emerald-950/10',
                    error: 'bg-red-50/40 dark:bg-red-950/10'
                };
                const textColors = {
                    info: 'text-blue-500',
                    warning: 'text-brand-500',
                    success: 'text-emerald-500',
                    error: 'text-red-500'
                };
                const icons = {
                    info: 'bi-info-circle-fill',
                    warning: 'bi-exclamation-triangle-fill',
                    success: 'bi-check-circle-fill',
                    error: 'bi-shield-fill-x'
                };

                const date = new Date(n.timestamp);
                const timeString = date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

                const card = `
                    <div class="p-3 border-l-4 ${borderColors[n.type]} ${bgColors[n.type]} rounded-r-xl transition-all duration-300 hover:translate-x-1">
                        <div class="flex items-center gap-2">
                            <i class="bi ${icons[n.type]} ${textColors[n.type]}"></i>
                            <h4 class="text-xs font-bold text-slate-800 dark:text-slate-200">${n.title}</h4>
                            <span class="ml-auto text-[9px] font-bold text-slate-400">${timeString}</span>
                        </div>
                        <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1 leading-normal">${n.message}</p>
                    </div>
                `;
                list.insertAdjacentHTML('beforeend', card);
            });
        }

        // Sales Ledger State Variables
        let salesSearchTerm = '';
        let salesStatusFilter = '';
        let salesSortField = 'dateLabel';
        let salesSortAsc = false;
        let salesPage = 1;
        const salesPageSize = 8;
        let globalSalesTrend = [];

        function filterSalesLedger() {
            salesSearchTerm = document.getElementById('sales-search').value.toLowerCase();
            salesStatusFilter = document.getElementById('sales-filter-status').value;
            salesPage = 1;
            renderSalesLedgerTable();
        }

        function sortSalesLedger(field) {
            if (salesSortField === field) {
                salesSortAsc = !salesSortAsc;
            } else {
                salesSortField = field;
                salesSortAsc = true;
            }
            renderSalesLedgerTable();
        }

        function paginateSales(direction) {
            if (direction === 'prev' && salesPage > 1) {
                salesPage--;
            } else if (direction === 'next' && salesPage * salesPageSize < getFilteredSalesCount()) {
                salesPage++;
            }
            renderSalesLedgerTable();
        }

        function getFilteredSalesCount() {
            return globalSalesTrend.filter(s => {
                const matchSearch = (s.dateLabel || '').toLowerCase().includes(salesSearchTerm);
                const status = (s.orderCount > 10) ? 'Settled' : 'Active';
                const matchStatus = !salesStatusFilter || status === salesStatusFilter;
                return matchSearch && matchStatus;
            }).length;
        }

        function renderSalesLedgerTable() {
            const tbody = document.querySelector('#table-sales-ledger tbody');
            if (!tbody) return;
            tbody.innerHTML = '';

            let filtered = globalSalesTrend.map(s => {
                // Enrich on the fly
                const completed = Math.round(s.orderCount * 0.95);
                const cancelled = s.orderCount - completed;
                const discount = s.revenue * 0.05;
                const tax = s.revenue * 0.14;
                const status = (s.orderCount > 10) ? 'Settled' : 'Active';

                return {
                    dateLabel: s.dateLabel,
                    totalOrders: s.orderCount,
                    completedOrders: completed,
                    cancelledOrders: cancelled,
                    discounts: discount,
                    taxes: tax,
                    netRevenue: s.revenue - discount,
                    status: status
                };
            }).filter(s => {
                const matchSearch = (s.dateLabel || '').toLowerCase().includes(salesSearchTerm);
                const matchStatus = !salesStatusFilter || s.status === salesStatusFilter;
                return matchSearch && matchStatus;
            });

            // Sort
            filtered.sort((a, b) => {
                let valA = a[salesSortField];
                let valB = b[salesSortField];

                if (typeof valA === 'string') {
                    valA = valA.toLowerCase();
                    valB = (valB || '').toLowerCase();
                }

                if (valA < valB) return salesSortAsc ? -1 : 1;
                if (valA > valB) return salesSortAsc ? 1 : -1;
                return 0;
            });

            const totalCount = filtered.length;
            const startIdx = (salesPage - 1) * salesPageSize;
            const endIdx = Math.min(startIdx + salesPageSize, totalCount);

            document.getElementById('sales-pagination-info').textContent = 
                `Showing ${totalCount > 0 ? startIdx + 1 : 0} to ${endIdx} of ${totalCount} days`;

            document.querySelector("button[onclick=\"paginateSales('prev')\"]").disabled = (salesPage === 1);
            document.querySelector("button[onclick=\"paginateSales('next')\"]").disabled = (endIdx >= totalCount);

            const pageSlice = filtered.slice(startIdx, endIdx);
            if (pageSlice.length === 0) {
                tbody.innerHTML = `<tr><td colspan="9" class="py-6 text-center text-slate-400">No daily logs found matching filters.</td></tr>`;
                return;
            }

            pageSlice.forEach(s => {
                const badgeClass = s.status === 'Settled' 
                    ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/20 dark:text-emerald-400' 
                    : 'bg-amber-100 text-amber-800 dark:bg-amber-950/20 dark:text-amber-400';

                const tr = `
                    <tr class="border-b border-slate-100 dark:border-darkBorder hover:bg-slate-50 dark:hover:bg-slate-900 transition-colors">
                        <td class="py-3 font-semibold text-slate-800 dark:text-slate-100">${s.dateLabel}</td>
                        <td class="py-3 text-center font-semibold text-slate-700 dark:text-slate-350">${s.totalOrders}</td>
                        <td class="py-3 text-center text-emerald-500 font-bold">${s.completedOrders}</td>
                        <td class="py-3 text-center text-red-500 font-bold">${s.cancelledOrders}</td>
                        <td class="py-3 text-right font-medium text-amber-600 dark:text-amber-400">${s.discounts.toFixed(2)} L.E.</td>
                        <td class="py-3 text-right font-medium text-indigo-500">${s.taxes.toFixed(2)} L.E.</td>
                        <td class="py-3 text-right font-extrabold text-slate-900 dark:text-white">${s.netRevenue.toFixed(2)} L.E.</td>
                        <td class="py-3">
                            <span class="px-2 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider ${badgeClass}">${s.status}</span>
                        </td>
                        <td class="py-3 text-right">
                            <button onclick="openDailySalesModal('${s.dateLabel}')" class="px-2.5 py-1 bg-brand-500/10 hover:bg-brand-500 hover:text-white text-brand-600 dark:text-brand-400 rounded-lg font-bold text-[10px] transition-all border border-brand-500/20">
                                <i class="bi bi-eye mr-0.5"></i> Audit
                            </button>
                        </td>
                    </tr>
                `;
                tbody.insertAdjacentHTML('beforeend', tr);
            });
        }

        // Open Daily Sales Details Audit Modal
        function openDailySalesModal(dateString) {
            // Show Loader State in the Modal
            document.getElementById('audit-modal-date').textContent = dateString;
            document.getElementById('audit-modal-orders').textContent = 'Loading...';
            document.getElementById('audit-modal-completed').textContent = 'Loading...';
            document.getElementById('audit-modal-cancelled').textContent = 'Loading...';
            document.getElementById('audit-modal-revenue').textContent = 'Loading...';
            document.getElementById('audit-modal-discounts').textContent = 'Loading...';
            document.getElementById('audit-modal-taxes').textContent = 'Loading...';
            document.getElementById('audit-modal-aov').textContent = 'Loading...';

            const tbody = document.querySelector('#table-audit-orders tbody');
            tbody.innerHTML = `<tr><td colspan="8" class="py-8 text-center text-slate-400"><i class="bi bi-arrow-repeat animate-spin mr-1"></i> Generating day transactions ledger...</td></tr>`;

            // Open Modal
            const modal = document.getElementById('daily-sales-modal');
            const modalContent = document.getElementById('daily-sales-modal-content');
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                modalContent.classList.remove('scale-95');
            }, 50);

            // Fetch details via newly added API
            fetch(`/api/analytics/sales/details?date=${dateString}`)
                .then(res => {
                    if (!res.ok) throw new Error("Failed to load details");
                    return res.json();
                })
                .then(data => {
                    document.getElementById('audit-modal-orders').textContent = data.totalOrders;
                    document.getElementById('audit-modal-completed').textContent = data.completedOrdersCount;
                    document.getElementById('audit-modal-cancelled').textContent = data.cancelledOrdersCount;
                    document.getElementById('audit-modal-revenue').textContent = `${data.netRevenue.toFixed(2)} L.E.`;
                    document.getElementById('audit-modal-discounts').textContent = `${data.totalDiscounts.toFixed(2)} L.E.`;
                    document.getElementById('audit-modal-taxes').textContent = `${data.totalTaxes.toFixed(2)} L.E.`;
                    document.getElementById('audit-modal-aov').textContent = `${data.averageOrderValue.toFixed(2)} L.E.`;

                    // Render dynamic transactions list
                    tbody.innerHTML = '';
                    if (!data.orders || data.orders.length === 0) {
                        tbody.innerHTML = `<tr><td colspan="8" class="py-6 text-center text-slate-400">No transactions recorded on this date.</td></tr>`;
                        return;
                    }

                    data.orders.forEach(o => {
                        const statusBadge = o.orderStatus === 'Completed'
                            ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/20 dark:text-emerald-400'
                            : (o.orderStatus === 'Cancelled' ? 'bg-red-100 text-red-800 dark:bg-red-950/20 dark:text-red-400' : 'bg-amber-100 text-amber-800 dark:bg-amber-950/20 dark:text-amber-400');

                        const tr = `
                            <tr class="border-b border-slate-100 dark:border-darkBorder hover:bg-slate-50 dark:hover:bg-slate-900 transition-colors">
                                <td class="py-2.5 font-bold text-slate-700 dark:text-slate-200">#${o.orderId}</td>
                                <td class="py-2.5">Table ${o.tableNumber}</td>
                                <td class="py-2.5 font-medium">${o.waiterName}</td>
                                <td class="py-2.5 text-center">${o.itemsCount} items</td>
                                <td class="py-2.5 text-right font-bold text-slate-805 dark:text-slate-100">${o.totalValue.toFixed(2)} L.E.</td>
                                <td class="py-2.5 text-center"><span class="px-2 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider bg-slate-100 dark:bg-slate-800">${o.paymentMethod}</span></td>
                                <td class="py-2.5 text-center font-medium">${o.serviceDurationMinutes} min</td>
                                <td class="py-2.5"><span class="px-2 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider ${statusBadge}">${o.orderStatus}</span></td>
                            </tr>
                        `;
                        tbody.insertAdjacentHTML('beforeend', tr);
                    });
                })
                .catch(err => {
                    console.error(err);
                    showToastAlert("Error retrieving daily audit details.", "error");
                    tbody.innerHTML = `<tr><td colspan="8" class="py-6 text-center text-red-500">Failed to render day ledger records.</td></tr>`;
                });
        }

