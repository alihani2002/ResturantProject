                let csv = 'Product Name,Category,Qty Sold,Price (L.E.),Total Revenue (L.E.),Margin Profit (L.E.),Orders Containing It,Unique Guests,Avg Qty Per Order,Avg Revenue Per Order,Availability\n';
                globalAllProducts.forEach(p => {
