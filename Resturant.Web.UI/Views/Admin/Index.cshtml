        function renderInventoryTable() {
            const tbody = document.querySelector('#table-inventory-stock tbody');
            const alertList = document.getElementById('inventory-low-stock-list');
            tbody.innerHTML = '';
            alertList.innerHTML = '';

            const searchTerm = $('#search-inventory').val().toLowerCase();
