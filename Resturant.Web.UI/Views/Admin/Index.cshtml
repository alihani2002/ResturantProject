        // New Transfer Request Modal Actions
        let globalAllIngredientsList = [];
        let sourceBranchIngredientsMap = {};

        function loadAllSystemIngredients(callback) {
            $.get('/Inventory/GetStockLevels', { branchId: '' })
             .done(function(data) {
                 globalAllIngredientsList = data;
                 if (callback) callback();
             })
             .fail(function() {
                 console.error("Failed to load global ingredients list.");
                 if (callback) callback();
             });
        }

        function loadSourceBranchIngredients(branchId, callback) {
            if (!branchId) return;
            $.get('/Inventory/GetStockLevels', { branchId: parseInt(branchId) })
             .done(function(data) {
                 sourceBranchIngredientsMap = {};
                 data.forEach(item => {
                     sourceBranchIngredientsMap[item.name.toLowerCase().trim()] = item;
                 });

                 const rows = document.querySelectorAll('#transfer-items-tbody tr');
                 if (rows.length === 0) {
                     addTransferItemRow();
                 } else {
                     rows.forEach(row => {
                         const select = row.querySelector('.transfer-item-select');
                         if (select) {
                             const selectedVal = select.value;
                             populateIngredientDropdown(select, selectedVal);
                         }
                     });
                 }
                 if (callback) callback();
             })
             .fail(function() {
                 console.error("Failed to load ingredients for source branch " + branchId);
             });
        }

        function populateIngredientDropdown(selectElement, selectedValue = "") {
            selectElement.innerHTML = '<option value="">-- اختر الخامة --</option>';
            
            const uniqueIngredients = [];
            const seenNames = new Set();
            
            globalAllIngredientsList.forEach(item => {
                const nameKey = item.name.trim().toLowerCase();
                if (!seenNames.has(nameKey)) {
                    seenNames.add(nameKey);
                    uniqueIngredients.push({
                        name: item.name.trim(),
                        unit: item.unit
                    });
                }
            });

            uniqueIngredients.sort((a, b) => a.name.localeCompare(b.name));

            uniqueIngredients.forEach(item => {
                const nameKey = item.name.toLowerCase();
                const sourceItem = sourceBranchIngredientsMap[nameKey];
                const stock = sourceItem ? sourceItem.currentStock : 0;
                const unit = sourceItem ? sourceItem.unit : item.unit;
                
                const isSelected = item.name === selectedValue ? 'selected' : '';
                selectElement.innerHTML += `<option value="${item.name}" ${isSelected} data-unit="${unit}">${item.name} (المخزون بالمصدر: ${stock} ${unit})</option>`;
            });
        }

        function openRequestTransferModal() {
            const modal = document.getElementById('transfer-modal');
            
            $.get('/Inventory/GetBranches')
             .done(function(branches) {
                  const srcSelect = document.getElementById('transfer-source-branch');
                  const destSelect = document.getElementById('transfer-dest-branch');
                  srcSelect.innerHTML = '';
                  destSelect.innerHTML = '';

                  branches.forEach(b => {
                      srcSelect.innerHTML += `<option value="${b.id}">${b.name}</option>`;
                      destSelect.innerHTML += `<option value="${b.id}">${b.name}</option>`;
                  });

                  const activeBranchId = $('#header-branch-selector').val();
                  if (activeBranchId) {
                      destSelect.value = activeBranchId;
                  }
                  srcSelect.value = "3"; // Seeded Central Warehouse id

                  $(srcSelect).off('change').on('change', function() {
                      document.getElementById('transfer-items-tbody').innerHTML = '';
                      loadSourceBranchIngredients(this.value, function() {
                          addTransferItemRow();
                      });
                  });

                  document.getElementById('transfer-notes').value = '';
                  document.getElementById('transfer-items-tbody').innerHTML = '';

                  loadAllSystemIngredients(function() {
                      loadSourceBranchIngredients(srcSelect.value, function() {
                          addTransferItemRow();
                          
                          modal.classList.remove('hidden');
                          setTimeout(() => {
                              modal.classList.add('opacity-100');
                              document.getElementById('transfer-modal-content').classList.remove('scale-95');
                          }, 50);
                      });
                  });
             })
             .fail(function() {
                 showToastAlert("Failed to load branches for dispatch mapping.", "error");
             });
        }

        function closeRequestTransferModal() {
            const modal = document.getElementById('transfer-modal');
            modal.classList.remove('opacity-100');
            document.getElementById('transfer-modal-content').classList.add('scale-95');
            setTimeout(() => modal.classList.add('hidden'), 300);
        }

        function addTransferItemRow() {
            const tbody = document.getElementById('transfer-items-tbody');
            const rowId = Date.now() + Math.random().toString(36).substr(2, 5);
            
            const tr = document.createElement('tr');
            tr.id = `tr-item-${rowId}`;
            tr.className = "border-b border-slate-50 dark:border-darkBorder/30";
            
            tr.innerHTML = `
                <td class="py-2 px-3">
                    <select required onchange="handleTransferIngredientChange(this)" class="transfer-item-select w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-darkBorder rounded-lg px-2.5 py-1.5 text-xs text-slate-850 dark:text-white focus:outline-none cursor-pointer text-right" dir="rtl">
                        <option value="">-- اختر الخامة --</option>
                    </select>
                </td>
                <td class="py-2">
                    <input type="number" step="0.001" min="0.001" required placeholder="0.000" class="transfer-item-qty w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-darkBorder rounded-lg px-2.5 py-1.5 text-xs text-slate-850 dark:text-white focus:outline-none text-right">
                </td>
                <td class="py-2">
                    <input type="text" readonly class="transfer-item-unit w-full bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-darkBorder rounded-lg px-2.5 py-1.5 text-xs text-slate-500 dark:text-slate-400 focus:outline-none text-center" value="جم">
                </td>
                <td class="py-2 text-center">
                    <button type="button" onclick="removeTransferItemRow('${rowId}')" class="p-1 rounded bg-red-50 hover:bg-red-100 dark:bg-red-950/20 dark:hover:bg-red-950/40 text-red-500"><i class="bi bi-trash"></i></button>
                </td>`;
            
            tbody.appendChild(tr);
            
            const selectElement = tr.querySelector('.transfer-item-select');
            populateIngredientDropdown(selectElement);
        }

        function handleTransferIngredientChange(select) {
            const row = select.closest('tr');
            const unitInput = row.querySelector('.transfer-item-unit');
            const selectedOption = select.options[select.selectedIndex];
            if (selectedOption && selectedOption.value) {
                const unit = selectedOption.getAttribute('data-unit');
                unitInput.value = unit || 'جم';
            } else {
                unitInput.value = 'جم';
            }
        }

        function removeTransferItemRow(rowId) {
            const row = document.getElementById(`tr-item-${rowId}`);
            if (row) row.remove();
        }

        function submitStockTransfer(e) {
            e.preventDefault();

            const srcBranch = parseInt(document.getElementById('transfer-source-branch').value);
            const destBranch = parseInt(document.getElementById('transfer-dest-branch').value);

            if (srcBranch === destBranch) {
                showToastAlert("لا يمكن أن يكون الفرع المرسل والمستلم متطابقين.", "error");
                return;
            }

            const items = [];
            const rows = document.querySelectorAll('#transfer-items-tbody tr');

            rows.forEach(row => {
                const select = row.querySelector('.transfer-item-select');
                const qtyInput = row.querySelector('.transfer-item-qty');
                const unitInput = row.querySelector('.transfer-item-unit');
                
                if (select && select.value) {
                    items.push({
                        ingredientName: select.value,
                        quantity: parseFloat(qtyInput.value),
                        unit: unitInput.value
                    });
                }
            });

            if (items.length === 0) {
                showToastAlert("يرجى اختيار صنف واحد على الأقل للتحويل.", "error");
                return;
            }

            const request = {
                sourceBranchId: srcBranch,
                destinationBranchId: destBranch,
                notes: document.getElementById('transfer-notes').value,
                items: items
            };

            $.ajax({
                url: '/Inventory/RequestTransfer',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(request),
                success: function() {
                    showToastAlert("تم إنشاء طلب التحويل المخزني وإرساله بنجاح.");
                    closeRequestTransferModal();
                    loadStockTransfersList();
                },
                error: function(err) {
                    showToastAlert(err.responseText || "Failed to dispatch transfer request.", "error");
                }
            });
        }


        // 3. Recipes Config Actions
        function loadRecipeMenuItems() {
            const branchId = $('#header-branch-selector').val();
            $.get('/Inventory/GetMenuItems', { branchId: branchId ? parseInt(branchId) : null })
             .done(function(items) {
                 recipeMenuItemsData = items;
                 filterRecipeMenuItems();
             })
             .fail(function() {
                 showToastAlert("Failed to load branch products.", "error");
             });
        }

        function filterRecipeMenuItems() {
            const container = document.getElementById('recipe-menu-list');
            container.innerHTML = '';

            const searchTerm = $('#search-recipe-menu').val().toLowerCase();
            const filtered = recipeMenuItemsData.filter(item => 
                item.name.toLowerCase().includes(searchTerm)
            );

            if (filtered.length === 0) {
                container.innerHTML = `<p class="text-center py-4 text-slate-400 dark:text-slate-500 text-xs">No products found.</p>`;
                return;
            }

            filtered.forEach(item => {
                const activeClass = selectedRecipeMenuItemId === item.id 
                    ? 'bg-rose-500/10 text-rose-500 font-bold border border-rose-500/25' 
                    : 'text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 border border-transparent';
                
                container.innerHTML += `
                    <button onclick="selectRecipeMenuItem(${item.id}, '${item.name.replace(/'/g, "\\'")}', ${item.price})" class="w-full text-left px-4 py-2.5 text-xs rounded-xl transition-all ${activeClass}">
                        <div class="flex justify-between items-center">
                            <span>${item.name}</span>
                            <span class="text-[10px] font-bold text-slate-450 dark:text-slate-500">${parseFloat(item.price).toFixed(2)} L.E.</span>
                        </div>
                    </button>`;
            });
        }

        function selectRecipeMenuItem(id, name, price) {
            selectedRecipeMenuItemId = id;
            filterRecipeMenuItems(); // Refreshes active sidebar state highlight

            document.getElementById('recipe-editor-empty').classList.add('hidden');
            const editor = document.getElementById('recipe-editor-container');
            editor.classList.remove('hidden');

            document.getElementById('recipe-editor-name').textContent = name;
            document.getElementById('recipe-editor-price').textContent = `Product Price: ${parseFloat(price).toFixed(2)} EGP`;

            const tbody = document.getElementById('recipe-ingredients-tbody');
            tbody.innerHTML = '<tr><td colspan="4" class="text-center py-8 text-slate-400">Loading recipe components...</td></tr>';

            $.get('/Inventory/GetRecipes', { menuItemId: id })
             .done(function(recipes) {
                 tbody.innerHTML = '';
                 if (recipes.length === 0) {
                     tbody.innerHTML = `<tr id="recipe-no-items"><td colspan="4" class="text-center py-8 text-slate-400 dark:text-slate-500"><i class="bi bi-exclamation-circle text-lg d-block mb-1"></i> No recipe ingredients mapped yet. Add a row to configure ingredient consumption.</td></tr>`;
                 } else {
                     recipes.forEach(r => {
                         addRecipeIngredientRow(r.ingredientName, r.quantityRequired, r.unit);
                     });
                 }
             })
             .fail(function() {
                 showToastAlert("Failed to load recipe ingredients.", "error");
             });
        }

        function addRecipeIngredientRow(name = '', quantity = '', unit = 'Grams') {
            const tbody = document.getElementById('recipe-ingredients-tbody');
            const noItemsRow = document.getElementById('recipe-no-items');
            if (noItemsRow) noItemsRow.remove();

            const rowId = Date.now();

            tbody.innerHTML += `
                <tr id="tr-rec-${rowId}" class="border-b border-slate-50 dark:border-darkBorder/30">
                    <td class="py-2.5 px-3">
                        <input type="text" required value="${name}" placeholder="Espresso Powder, Ground Beef..." class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-darkBorder rounded-lg px-2.5 py-1.5 text-xs text-slate-850 dark:text-white focus:outline-none">
                    </td>
                    <td class="py-2.5 text-center">
                        <input type="number" step="0.001" min="0.001" required value="${quantity}" placeholder="0.000" class="w-full text-center bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-darkBorder rounded-lg px-2.5 py-1.5 text-xs text-slate-850 dark:text-white focus:outline-none">
                    </td>
                    <td class="py-2.5">
                        <select required class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-darkBorder rounded-lg px-2.5 py-1.5 text-xs text-slate-850 dark:text-white focus:outline-none cursor-pointer">
                            <option value="Grams" ${unit === 'Grams' ? 'selected' : ''}>Grams</option>
                            <option value="Kg" ${unit === 'Kg' ? 'selected' : ''}>Kg (Kilograms)</option>
                            <option value="Ltr" ${unit === 'Ltr' ? 'selected' : ''}>Ltr (Liters)</option>
                            <option value="Pcs" ${unit === 'Pcs' ? 'selected' : ''}>Pcs (Pieces)</option>
                        </select>
                    </td>
                    <td class="py-2.5 text-center">
                        <button type="button" onclick="removeRecipeIngredientRow(${rowId})" class="p-1 rounded bg-red-50 hover:bg-red-100 dark:bg-red-950/20 dark:hover:bg-red-950/40 text-red-500"><i class="bi bi-trash"></i></button>
                    </td>
                </tr>`;
        }

        function removeRecipeIngredientRow(rowId) {
            const row = document.getElementById(`tr-rec-${rowId}`);
            if (row) row.remove();

            const tbody = document.getElementById('recipe-ingredients-tbody');
            if (tbody.querySelectorAll('tr').length === 0) {
                tbody.innerHTML = `<tr id="recipe-no-items"><td colspan="4" class="text-center py-8 text-slate-400 dark:text-slate-500"><i class="bi bi-exclamation-circle text-lg d-block mb-1"></i> No recipe ingredients mapped yet. Add a row to configure ingredient consumption.</td></tr>`;
            }
        }

        function cancelRecipeEdit() {
            selectedRecipeMenuItemId = null;
            filterRecipeMenuItems();
            document.getElementById('recipe-editor-container').classList.add('hidden');
            document.getElementById('recipe-editor-empty').classList.remove('hidden');
        }

        function saveRecipeChanges(e) {
            e.preventDefault();
            if (!selectedRecipeMenuItemId) return;

            const items = [];
            const rows = document.querySelectorAll('#recipe-ingredients-tbody tr');

            if (rows.length === 1 && rows[0].id === 'recipe-no-items') {
                // Empty recipe is allowed (means no deductions)
            } else {
                rows.forEach(row => {
                    const inputs = row.querySelectorAll('input');
                    const select = row.querySelector('select');
                    if (inputs.length >= 2) {
                        items.push({
                            ingredientName: inputs[0].value,
                            quantityRequired: parseFloat(inputs[1].value),
                            unit: select.value
                        });
                    }
                });
            }

            const request = {
                menuItemId: selectedRecipeMenuItemId,
                items: items
            };

            $.ajax({
                url: '/Inventory/SaveRecipe',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(request),
                success: function() {
                    showToastAlert("Menu item recipe map saved successfully!");
                },
                error: function(err) {
                    showToastAlert(err.responseText || "Failed to save recipe map.", "error");
                }
            });
        }
        // ==============================================
    </script>

