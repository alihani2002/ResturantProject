        function renderShiftsTable(page = 1) {
            currentAdminShiftPage = page;
            const tbody = document.querySelector('#table-shifts-list tbody');
            const paginationContainer = document.getElementById('shiftsPagination');
            tbody.innerHTML = '';

            if (paginationContainer) {
                paginationContainer.innerHTML = '';
            }

            // Get shared filtered data
            let filteredShifts = getFilteredAdminShifts();

            if (filteredShifts.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="9" class="text-center py-8 text-slate-400 dark:text-slate-500">
                            <i class="bi bi-clock-history text-3xl text-warning mb-2 d-block"></i>
                            No cashier shifts matched the criteria.
                        </td>
                    </tr>`;
                return;
            }

            // Pagination
            const totalPages = Math.ceil(filteredShifts.length / shiftsPerPage);
            const startIndex = (page - 1) * shiftsPerPage;
            const paginatedShifts = filteredShifts.slice(startIndex, startIndex + shiftsPerPage);

            paginatedShifts.forEach(shift => {
                let diffBadge = '-';
                if (shift.difference !== null) {
                    const diffVal = parseFloat(shift.difference);
                    if (diffVal === 0) {
                        diffBadge = `<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">Balanced</span>`;
                    } else if (diffVal > 0) {
                        diffBadge = `<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">+${diffVal.toFixed(2)} EGP</span>`;
                    } else {
                        diffBadge = `<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20">${diffVal.toFixed(2)} EGP (Short)</span>`;
                    }
                }

                const statusBadge = shift.isActive
                    ? `<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500 text-white animate-pulse">Active</span>`
                    : `<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-550/15 text-slate-400">Closed</span>`;

                const actualStr = shift.actualAmount !== null ? `${parseFloat(shift.actualAmount).toFixed(2)} EGP` : '-';
                const actionBtn = !shift.isActive
                    ? `<button onclick="viewShiftDetails(${shift.id})" class="px-2.5 py-1 text-xs font-bold rounded-lg border border-brand-500/20 text-brand-500 hover:bg-brand-500/10 transition-all">View Details</button>`
                    : `<span class="text-xs text-slate-400">Active Shift</span>`;

                tbody.innerHTML += `
                    <tr class="border-b border-slate-50 dark:border-darkBorder/50 hover:bg-slate-50/50 dark:hover:bg-slate-800/20 transition-colors">
                        <td class="py-3.5 px-2 font-bold text-brand-500">#${shift.id}</td>
                        <td class="py-3.5 px-2 font-semibold text-slate-800 dark:text-white">${shift.cashierName}</td>
                        <td class="py-3.5 px-2 text-slate-500 dark:text-slate-400">${shift.startTime}</td>
                        <td class="py-3.5 px-2 text-slate-500 dark:text-slate-400">${shift.endTime || '-'}</td>
                        <td class="py-3.5 px-2 text-right font-bold text-slate-900 dark:text-white">${parseFloat(shift.expectedAmount).toFixed(2)} EGP</td>
                        <td class="py-3.5 px-2 text-right font-bold text-slate-900 dark:text-white">${actualStr}</td>
                        <td class="py-3.5 px-2 text-center">${diffBadge}</td>
                        <td class="py-3.5 px-2 text-center">${statusBadge}</td>
                        <td class="py-3.5 px-2 text-right">${actionBtn}</td>
                    </tr>`;
            });

            // Render Pagination Buttons
            if (totalPages > 1 && paginationContainer) {
                let paginationHtml = '';

                // Prev button
                paginationHtml += `<button onclick="renderShiftsTable(${page - 1})" ${page === 1 ? 'disabled' : ''} class="px-3 py-1.5 mx-1 text-xs font-bold rounded-lg border border-slate-200 dark:border-darkBorder ${page === 1 ? 'text-slate-400 cursor-not-allowed opacity-50' : 'text-slate-700 dark:text-white hover:bg-slate-50 dark:hover:bg-slate-800'}">Prev</button>`;

                // Page numbers
                for (let i = 1; i <= totalPages; i++) {
                    const activeClass = i === page
                        ? 'bg-brand-500 text-white border-brand-500'
                        : 'text-slate-700 dark:text-white border-slate-200 dark:border-darkBorder hover:bg-slate-50 dark:hover:bg-slate-800';
                    paginationHtml += `<button onclick="renderShiftsTable(${i})" class="px-3 py-1.5 mx-1 text-xs font-bold rounded-lg border ${activeClass}">${i}</button>`;
                }

                // Next button
                paginationHtml += `<button onclick="renderShiftsTable(${page + 1})" ${page === totalPages ? 'disabled' : ''} class="px-3 py-1.5 mx-1 text-xs font-bold rounded-lg border border-slate-200 dark:border-darkBorder ${page === totalPages ? 'text-slate-400 cursor-not-allowed opacity-50' : 'text-slate-700 dark:text-white hover:bg-slate-50 dark:hover:bg-slate-800'}">Next</button>`;

                paginationContainer.innerHTML = paginationHtml;
            }
        }

        function exportAdminShiftsToExcel() {
            if (!allAdminShifts || allAdminShifts.length === 0) return;

            // Get currently filtered list
            let filteredShifts = getFilteredAdminShifts();

            if (filteredShifts.length === 0) {
                showToastAlert("No data matching current filters to export.", "warning");
                return;
            }

            // Generate clean array of objects for Excel
            const exportData = filteredShifts.map(shift => {
                const diffVal = shift.difference !== null ? parseFloat(shift.difference).toFixed(2) : '0.00';
                return {
                    "Shift ID": shift.id,
                    "Cashier": shift.cashierName,
                    "Start Time": shift.startTime,
                    "End Time": shift.endTime || '-',
                    "System Expected (EGP)": parseFloat(shift.expectedAmount).toFixed(2),
                    "Actual Entered (EGP)": shift.actualAmount !== null ? parseFloat(shift.actualAmount).toFixed(2) : '0.00',
                    "Difference (EGP)": diffVal,
                    "Status": shift.isActive ? "Active" : "Closed"
                };
            });

            // Use SheetJS if available
            if (typeof XLSX !== 'undefined') {
                const ws = XLSX.utils.json_to_sheet(exportData);
                const wb = XLSX.utils.book_new();
                XLSX.utils.book_append_sheet(wb, ws, "Cashier Shifts");
                XLSX.writeFile(wb, `Cashier_Shifts_Report_${new Date().toISOString().slice(0,10)}.xlsx`);
                showToastAlert("Filtered Cashier shifts exported as Excel.", "success");
            } else {
                showToastAlert("Excel export library is currently not available.", "error");
            }
        }

