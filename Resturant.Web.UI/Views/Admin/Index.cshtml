        function parseShiftDateTime(dateTimeStr) {
            if (!dateTimeStr || dateTimeStr === '-') return null;
            const parts = dateTimeStr.split(' ');
            if (parts.length < 3) return null;
            const datePart = parts[0];
            const timePart = parts[1];
            const ampmPart = parts[2];

            const timeSplit = timePart.split(':');
            let hour = parseInt(timeSplit[0]);
            const minute = parseInt(timeSplit[1]);

            if (ampmPart === 'PM' && hour < 12) hour += 12;
            if (ampmPart === 'AM' && hour === 12) hour = 0;

            return {
                dateStr: datePart,
                hour: hour,
                minute: minute
            };
        }

        function getFilteredAdminShifts() {
            const searchTerm = document.getElementById('adminShiftSearch')?.value.toLowerCase() || '';
            const statusFilter = document.getElementById('adminShiftStatus')?.value || '';
            const dateFrom = document.getElementById('adminShiftDateFrom')?.value || '';
            const dateTo = document.getElementById('adminShiftDateTo')?.value || '';
            const hourFromVal = document.getElementById('adminShiftHourFrom')?.value;
            const hourToVal = document.getElementById('adminShiftHourTo')?.value;
            const hourFrom = hourFromVal !== "" && hourFromVal !== undefined ? parseInt(hourFromVal) : null;
            const hourTo = hourToVal !== "" && hourToVal !== undefined ? parseInt(hourToVal) : null;

            return allAdminShifts.filter(shift => {
                // Search match
                const searchMatch = !searchTerm ||
                    (shift.cashierName && shift.cashierName.toLowerCase().includes(searchTerm)) ||
                    shift.id.toString().includes(searchTerm);

                // Status match
                const shiftStatus = shift.isActive ? "Active" : "Closed";
                const statusMatch = !statusFilter || shiftStatus === statusFilter;

                // Date & hour parsing
                const parsedStart = parseShiftDateTime(shift.startTime);

                // Date range match
                let dateMatch = true;
                if (parsedStart) {
                    if (dateFrom && parsedStart.dateStr < dateFrom) dateMatch = false;
                    if (dateTo && parsedStart.dateStr > dateTo) dateMatch = false;
                }

                // Hour range match
                let hourMatch = true;
                if (parsedStart) {
                    if (hourFrom !== null && !isNaN(hourFrom) && parsedStart.hour < hourFrom) hourMatch = false;
                    if (hourTo !== null && !isNaN(hourTo) && parsedStart.hour > hourTo) hourMatch = false;
                }

                return searchMatch && statusMatch && dateMatch && hourMatch;
            });
        }

        function resetShiftFilters() {
            const searchInput = document.getElementById('adminShiftSearch');
            if (searchInput) searchInput.value = '';

            const statusInput = document.getElementById('adminShiftStatus');
