        function renderProductSalesTable(page = 1) {
            currentProductSalesPage = page;
            const tbody = document.querySelector('#table-productsales-list tbody');
            const paginationContainer = document.getElementById('productSalesPagination');
            tbody.innerHTML = '';

            if (paginationContainer) {
                paginationContainer.innerHTML = '';
            }

            let filtered = getFilteredProductSales();
            renderProductSalesSummary(filtered);

            if (filtered.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="18" class="text-center py-8 text-slate-400 dark:text-slate-500">
                            <i class="bi bi-bar-chart-line text-3xl text-success mb-2 d-block"></i>
                            No products sales matched the criteria.
                        </td>
                    </tr>`;
                return;
            }

            // Pagination
            const totalPages = Math.ceil(filtered.length / productSalesPerPage);
            const startIndex = (page - 1) * productSalesPerPage;
            const paginated = filtered.slice(startIndex, startIndex + productSalesPerPage);

            paginated.forEach(item => {
                tbody.innerHTML += `
                    <tr class="border-b border-slate-50 dark:border-darkBorder/50 hover:bg-slate-50/50 dark:hover:bg-slate-800/20 transition-colors">
                        <td class="py-3.5 px-2 font-semibold text-slate-800 dark:text-white">${item.productName}</td>
                        <td class="py-3.5 px-2 text-slate-500 dark:text-slate-400">${item.size || 'Default'}</td>
                        <td class="py-3.5 px-2 text-slate-500 dark:text-slate-400">${item.category}</td>
                        <td class="py-3.5 px-2 text-right font-semibold text-slate-650 dark:text-slate-400">${item.quantitySold}</td>
                        <td class="py-3.5 px-2 text-right font-semibold text-slate-650 dark:text-slate-400">${parseFloat(item.cost || 0).toFixed(2)} EGP</td>
                        <td class="py-3.5 px-2 text-right font-bold text-slate-900 dark:text-white">${parseFloat(item.averageSellingPrice || 0).toFixed(2)} EGP</td>
                        <td class="py-3.5 px-2 text-right text-slate-650 dark:text-slate-400">${parseFloat(item.lowestSellingPrice || 0).toFixed(2)} EGP</td>
                        <td class="py-3.5 px-2 text-right text-slate-650 dark:text-slate-400">${parseFloat(item.highestSellingPrice || 0).toFixed(2)} EGP</td>
                        <td class="py-3.5 px-2 text-right font-bold text-slate-900 dark:text-white">${parseFloat(item.totalSalesBeforeTax || 0).toFixed(2)} EGP</td>
                        <td class="py-3.5 px-2 text-right text-slate-650 dark:text-slate-400">${parseFloat(item.totalTax || 0).toFixed(2)} EGP</td>
                        <td class="py-3.5 px-2 text-right text-slate-650 dark:text-slate-400">${parseFloat(item.totalServiceCharge || 0).toFixed(2)} EGP</td>
                        <td class="py-3.5 px-2 text-right font-bold text-slate-900 dark:text-white">${parseFloat(item.totalCustomerPaid || 0).toFixed(2)} EGP</td>
                        <td class="py-3.5 px-2 text-right text-slate-650 dark:text-slate-400">${parseFloat(item.totalCost || 0).toFixed(2)} EGP</td>
                        <td class="py-3.5 px-2 text-right font-bold ${(item.grossProfit || item.totalProfit || 0) >= 0 ? 'text-emerald-600' : 'text-red-600'}">${parseFloat(item.grossProfit || item.totalProfit || 0).toFixed(2)} EGP</td>
                        <td class="py-3.5 px-2 text-right font-bold ${(item.netCustomerProfit || 0) >= 0 ? 'text-emerald-600' : 'text-red-600'}">${parseFloat(item.netCustomerProfit || 0).toFixed(2)} EGP</td>
                        <td class="py-3.5 px-2 text-right font-bold">${parseFloat(item.profitMarginPercentage || 0).toFixed(2)}%</td>
                        <td class="py-3.5 px-2 text-slate-650 dark:text-slate-400">${item.branch}</td>
                        <td class="py-3.5 px-2 text-slate-500 dark:text-slate-400">${item.lastSoldDate}</td>
                    </tr>`;
            });

            // Pagination UI Buttons
            if (totalPages > 1 && paginationContainer) {
                let paginationHtml = '';

                // Prev button
                paginationHtml += `<button onclick="renderProductSalesTable(${page - 1})" ${page === 1 ? 'disabled' : ''} class="px-3 py-1.5 mx-1 text-xs font-bold rounded-lg border border-slate-200 dark:border-darkBorder ${page === 1 ? 'text-slate-400 cursor-not-allowed opacity-50' : 'text-slate-700 dark:text-white hover:bg-slate-50 dark:hover:bg-slate-800'}">Prev</button>`;

                // Page numbers
                for (let i = 1; i <= totalPages; i++) {
                    const activeClass = i === page
                        ? 'bg-brand-500 text-white border-brand-500'
                        : 'text-slate-700 dark:text-white border-slate-200 dark:border-darkBorder hover:bg-slate-50 dark:hover:bg-slate-800';
                    paginationHtml += `<button onclick="renderProductSalesTable(${i})" class="px-3 py-1.5 mx-1 text-xs font-bold rounded-lg border ${activeClass}">${i}</button>`;
                }

                // Next button
                paginationHtml += `<button onclick="renderProductSalesTable(${page + 1})" ${page === totalPages ? 'disabled' : ''} class="px-3 py-1.5 mx-1 text-xs font-bold rounded-lg border border-slate-200 dark:border-darkBorder ${page === totalPages ? 'text-slate-400 cursor-not-allowed opacity-50' : 'text-slate-700 dark:text-white hover:bg-slate-50 dark:hover:bg-slate-800'}">Next</button>`;

                paginationContainer.innerHTML = paginationHtml;
            }
        }

        function exportProductSalesToExcel() {
            let filtered = getFilteredProductSales();

            if (filtered.length === 0) {
                showToastAlert("No data matching current filters to export.", "warning");
                return;
            }

            const exportData = filtered.map(item => {
                return {
                    "Product Name": item.productName,
                    "Size": item.size || "Default",
                    "Category": item.category,
                    "Quantity Sold": item.quantitySold,
                    "Cost (EGP)": parseFloat(item.cost || 0).toFixed(2),
                    "Average Selling Price (EGP)": parseFloat(item.averageSellingPrice || 0).toFixed(2),
                    "Lowest Selling Price (EGP)": parseFloat(item.lowestSellingPrice || 0).toFixed(2),
                    "Highest Selling Price (EGP)": parseFloat(item.highestSellingPrice || 0).toFixed(2),
                    "Total Sales Before Tax & Service (EGP)": parseFloat(item.totalSalesBeforeTax || 0).toFixed(2),
                    "Total Tax (EGP)": parseFloat(item.totalTax || 0).toFixed(2),
                    "Total Service Charge (EGP)": parseFloat(item.totalServiceCharge || 0).toFixed(2),
                    "Total Customer Paid (EGP)": parseFloat(item.totalCustomerPaid || 0).toFixed(2),
                    "Total Cost (EGP)": parseFloat(item.totalCost || 0).toFixed(2),
                    "Gross Profit (EGP)": parseFloat(item.grossProfit || item.totalProfit || 0).toFixed(2),
                    "Net Customer Profit (EGP)": parseFloat(item.netCustomerProfit || 0).toFixed(2),
                    "Profit Margin %": parseFloat(item.profitMarginPercentage || 0).toFixed(2),
                    "Branch": item.branch,
                    "Last Sold Date": item.lastSoldDate
                };
            });

            // Use SheetJS (XLSX) which is imported at the bottom of the page
            if (typeof XLSX !== 'undefined') {
                const ws = XLSX.utils.json_to_sheet(exportData);
                const wb = XLSX.utils.book_new();
                XLSX.utils.book_append_sheet(wb, ws, "Product Sales");
                XLSX.writeFile(wb, `Product_Sales_Report_${new Date().toISOString().slice(0,10)}.xlsx`);
                showToastAlert("Filtered product sales report exported as Excel.", "success");
            } else {
                showToastAlert("Excel export library is currently not available.", "error");
            }
        }



