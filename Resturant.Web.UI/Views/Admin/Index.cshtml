        // CRM Guest Directory State Variables
        let crmSearchTerm = '';
        let crmLoyaltyFilter = '';
        let crmStatusFilter = '';
        let crmSortField = 'totalSpent';
        let crmSortAsc = false;
        let crmPage = 1;
        const crmPageSize = 8;
        let globalCrmGuests = [];

        function filterCRMDirectory() {
            crmSearchTerm = document.getElementById('crm-search').value.toLowerCase();
            crmLoyaltyFilter = document.getElementById('crm-filter-loyalty').value;
            crmStatusFilter = document.getElementById('crm-filter-status').value;
            crmPage = 1;
            renderCRMTable();
        }

        function sortCRMDirectory(field) {
            if (crmSortField === field) {
                crmSortAsc = !crmSortAsc;
            } else {
                crmSortField = field;
                crmSortAsc = true;
            }
            renderCRMTable();
        }

        function paginateCRM(direction) {
            if (direction === 'prev' && crmPage > 1) {
                crmPage--;
            } else if (direction === 'next' && crmPage * crmPageSize < getFilteredCRMCount()) {
                crmPage++;
            }
            renderCRMTable();
        }

        function getFilteredCRMCount() {
            return globalCrmGuests.filter(g => {
                const matchSearch = (g.customerName || '').toLowerCase().includes(crmSearchTerm) ||
                                    (g.phoneNumber || '').toLowerCase().includes(crmSearchTerm) ||
                                    (g.email || '').toLowerCase().includes(crmSearchTerm);
                const matchLoyalty = !crmLoyaltyFilter || g.loyaltySegment === crmLoyaltyFilter;
                const matchStatus = !crmStatusFilter || g.sessionStatus === crmStatusFilter;
                return matchSearch && matchLoyalty && matchStatus;
            }).length;
        }

        function renderCRMTable() {
            const tbody = document.querySelector('#table-vip-customers tbody');
            if (!tbody) return;
            tbody.innerHTML = '';

            let filtered = globalCrmGuests.filter(g => {
                const matchSearch = (g.customerName || '').toLowerCase().includes(crmSearchTerm) ||
                                    (g.phoneNumber || '').toLowerCase().includes(crmSearchTerm) ||
                                    (g.email || '').toLowerCase().includes(crmSearchTerm);
                const matchLoyalty = !crmLoyaltyFilter || g.loyaltySegment === crmLoyaltyFilter;
                const matchStatus = !crmStatusFilter || g.sessionStatus === crmStatusFilter;
                return matchSearch && matchLoyalty && matchStatus;
            });

            // Sort
            filtered.sort((a, b) => {
                let valA = a[crmSortField];
                let valB = b[crmSortField];

                if (typeof valA === 'string') {
                    valA = valA.toLowerCase();
                    valB = (valB || '').toLowerCase();
                }

                if (valA < valB) return crmSortAsc ? -1 : 1;
                if (valA > valB) return crmSortAsc ? 1 : -1;
                return 0;
            });

            const totalCount = filtered.length;
            const startIdx = (crmPage - 1) * crmPageSize;
            const endIdx = Math.min(startIdx + crmPageSize, totalCount);

            document.getElementById('crm-pagination-info').textContent =
                `عرض ${totalCount > 0 ? startIdx + 1 : 0} إلى ${endIdx} من ${totalCount} زائر`;

            document.querySelector("button[onclick=\"paginateCRM('prev')\"]").disabled = (crmPage === 1);
            document.querySelector("button[onclick=\"paginateCRM('next')\"]").disabled = (endIdx >= totalCount);

            const segmentBadges = {
                'Elite VIP': 'bg-brand-500/10 text-brand-600 dark:text-brand-400 border border-brand-500/20',
                'Frequent Buyer': 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/20 dark:text-emerald-400 border border-emerald-500/20',
                'Standard Loyalty': 'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-400 border border-slate-700/20'
            };

            const pageSlice = filtered.slice(startIdx, endIdx);
            if (pageSlice.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="py-6 text-center text-slate-400">لم يتم العثور على سجلات زوار تطابق المعايير الحالية.</td></tr>`;
                return;
            }

            pageSlice.forEach(g => {
                const segmentLabel = g.loyaltySegment === 'Elite VIP' ? 'نخبة VIP' : (g.loyaltySegment === 'Frequent Buyer' ? 'عميل متكرر' : 'ولاء عادي');
                const tr = `
                    <tr class="border-b border-slate-100 dark:border-darkBorder hover:bg-slate-50 dark:hover:bg-slate-900 transition-colors">
                        <td class="py-3 font-semibold text-slate-800 dark:text-slate-100 flex items-center gap-1.5">
                            <span class="w-6 h-6 rounded-full bg-brand-500/10 text-brand-650 flex items-center justify-center font-bold text-[10px]">
                                ${g.customerName ? g.customerName.charAt(0).toUpperCase() : 'G'}
                            </span>
                            ${g.customerName || 'زائر مجهول'}
                        </td>
                        <td class="py-3 font-medium text-slate-550 dark:text-slate-400">
                            <div>${g.phoneNumber || 'بدون هاتف'}</div>
                            <div class="text-[10px] text-slate-400">${g.email || 'بدون بريد'}</div>
                        </td>
                        <td class="py-3 text-center font-semibold text-slate-700 dark:text-slate-300">${g.totalOrders} طلبات</td>
                        <td class="py-3 text-left font-bold text-slate-850 dark:text-white">${g.totalSpent.toFixed(2)} ج.م</td>
                        <td class="py-3 text-left font-black text-emerald-500">${g.customerLifetimeValue.toFixed(2)} ج.م</td>
                        <td class="py-3 text-center">
                            <span class="px-2 py-0.5 rounded text-[8px] font-bold uppercase tracking-wider ${segmentBadges[g.loyaltySegment] || segmentBadges['Standard Loyalty']}">
                                ${segmentLabel}
                            </span>
                        </td>
                        <td class="py-3 text-left">
                            <button onclick="openCRMDetailsModal('${g.guestId}')" class="px-2.5 py-1 bg-brand-500/10 hover:bg-brand-500 hover:text-white text-brand-600 dark:text-brand-400 rounded-lg font-bold text-[10px] transition-all border border-brand-500/20">
                                <i class="bi bi-person-lines-fill mr-0.5"></i> الملف الشخصي
                            </button>
                        </td>
                    </tr>
                `;
                tbody.insertAdjacentHTML('beforeend', tr);
            });
        }

        // Open CRM Guest Details Modal
        function openCRMDetailsModal(guestId) {
            const guest = globalCrmGuests.find(g => g.guestId === guestId);
            if (!guest) return;

            const segmentLabel = guest.loyaltySegment === 'Elite VIP' ? 'نخبة VIP' : (guest.loyaltySegment === 'Frequent Buyer' ? 'عميل متكرر' : 'ولاء عادي');

            document.getElementById('crm-modal-name').textContent = guest.customerName || 'زائر مجهول';
            document.getElementById('crm-modal-phone').textContent = guest.phoneNumber || 'غير مسجل';
            document.getElementById('crm-modal-email').textContent = guest.email || 'غير مسجل';
            document.getElementById('crm-modal-segment').className = `px-2.5 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider ${
                guest.loyaltySegment === 'Elite VIP' ? 'bg-brand-500/20 text-brand-550 border border-brand-500/30' :
