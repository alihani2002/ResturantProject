        async function submitMenuItem(e) {
            e.preventDefault();
            const name = document.getElementById('menu-name').value.trim();
            const rawDesc = document.getElementById('menu-desc').value.trim();
            const price = document.getElementById('menu-price').value;
            const cost = document.getElementById('menu-cost').value;
            const catId = document.getElementById('menu-cat-id').value;

            const isAvail = document.getElementById('menu-available') ? document.getElementById('menu-available').checked : true;
            const isPop = document.getElementById('menu-popular') ? document.getElementById('menu-popular').checked : false;
            const isTrend = document.getElementById('menu-trending') ? document.getElementById('menu-trending').checked : false;
            const isRec = document.getElementById('menu-recommended') ? document.getElementById('menu-recommended').checked : false;

            const fileInput = document.getElementById('menu-image');

            if (!name || !price || cost === '' || !catId) {
                showToastAlert("Please fill in all required fields.", "warning");
                return;
            }

            const sizes = collectSizes('menu-sizes-list', 'menu-has-sizes');

            const formData = new FormData();
            formData.append('name', name);
            formData.append('description', rawDesc);
            formData.append('price', price);
            formData.append('cost', cost);
            formData.append('menuCategoryId', catId);
            formData.append('isAvailable', isAvail);
            formData.append('isPopular', isPop);
            formData.append('isTrending', isTrend);
            formData.append('isRecommended', isRec);
            const orderNumInput = document.getElementById('menu-order-number');
            formData.append('orderNumber', orderNumInput ? orderNumInput.value : 0);
            formData.append('sizesJson', JSON.stringify(sizes));

            if (fileInput.files.length > 0) {
                formData.append('imageFile', fileInput.files[0]);
            }

            // Build addons JSON
            const addonContainer = document.getElementById('menu-addons-container');
            const addonRows = addonContainer.querySelectorAll('.flex');
            const addons = [];
            addonRows.forEach(row => {
                const inputs = row.querySelectorAll('input');
                if (inputs.length >= 2) {
                    const extraName = inputs[0].value.trim();
                    const extraPrice = parseFloat(inputs[1].value) || 0;
                    if (extraName) {
                        addons.push({ name: extraName, extraPrice: extraPrice });
                    }
                }
            });
            formData.append('addonsJson', JSON.stringify(addons));

            // Build recommendations JSON
            const recContainer = document.getElementById('menu-recommendations-list');
            const checkedCheckboxes = recContainer.querySelectorAll('input[type="checkbox"]:checked');
            const recIds = [];
            checkedCheckboxes.forEach(cb => {
                recIds.push(parseInt(cb.value));
            });
            formData.append('recommendationsJson', JSON.stringify(recIds));

            showLoader();
            try {
                const response = await fetch('/api/analytics/menu/create', {
                    method: 'POST',
                    body: formData
                });
                if (response.ok) {
                    showToastAlert("New Menu Item added successfully!", "success");
                    document.getElementById('form-add-menuitem').reset();
                    document.getElementById('menu-addons-container').innerHTML = '';
                    document.getElementById('menu-sizes-list').innerHTML = '';
                    document.getElementById('menu-sizes-body').classList.add('hidden');
                    document.getElementById('menu-has-sizes').checked = false;
                    renderRecommendationsList('menu-recommendations-list');
                    loadMenuItemsList();
                } else {
                    let errMsg = "Failed to add menu item.";
                    const text = await response.text();
                    try {
                        const err = JSON.parse(text);
                        errMsg = err.message || err.Message || errMsg;
                        if (err.details || err.Details) {
                            errMsg += " Details: " + (err.details || err.Details);
                        }
                    } catch (e) {
                        console.error("Server HTML error:", text);
                        errMsg = "Server Error: " + text.substring(0, 200);
                    }
                    showToastAlert(errMsg, "error");
                }
            } catch (err) {
                showToastAlert("Error connecting to server: " + err.message, "error");
            } finally {
                hideLoader();
            }
        }

