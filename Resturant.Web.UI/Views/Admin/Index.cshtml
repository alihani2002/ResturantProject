@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="main-content">
    <div class="row">
        <div class="col-lg-12">
            <div class="card stretch stretch-full">
                <div class="card-header">
                    <h5 class="card-title">Dashboard</h5>
                </div>
                <div class="card-body">
                    <h3>Welcome to the Admin Dashboard</h3>
                    <p class="mb-4">Select a dashboard to manage orders:</p>
                    
                    <div class="row">
                        <div class="col-md-3 mb-4">
                            <div class="card h-100">
                                <div class="card-body text-center">
                                    <i class="fas fa-utensils fa-3x mb-3 text-primary"></i>
                                    <h5>Waiter Dashboard</h5>
                                    <p class="text-muted">View and confirm pending orders</p>
                                    <a href="@Url.Action("Index", "Waiter")" class="btn btn-primary btn-block">
                                        Go to Waiter Dashboard
                                    </a>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-md-3 mb-4">
                            <div class="card h-100">
                                <div class="card-body text-center">
                                    <i class="fas fa-fire fa-3x mb-3 text-warning"></i>
                                    <h5>Chef Dashboard</h5>
                                    <p class="text-muted">View and prepare orders</p>
                                    <a href="@Url.Action("Index", "Chef")" class="btn btn-warning btn-block">
                                        Go to Chef Dashboard
                                    </a>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-md-3 mb-4">
                            <div class="card h-100">
                                <div class="card-body text-center">
                                    <i class="fas fa-cash-register fa-3x mb-3 text-success"></i>
                                    <h5>Cashier Dashboard</h5>
                                    <p class="text-muted">Process payments and print receipts</p>
                                    <a href="@Url.Action("Index", "Cashier")" class="btn btn-success btn-block">
                                        Go to Cashier Dashboard
                                    </a>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-md-3 mb-4">
                            <div class="card h-100">
                                <div class="card-body text-center">
                                    <i class="fas fa-list fa-3x mb-3 text-info"></i>
                                    <h5>Menu Management</h5>
                                    <p class="text-muted">Manage categories and items</p>
                                    <div class="d-grid gap-2">
                                        <a href="@Url.Action("Index", "MenuCategory")" class="btn btn-info">
                                            Manage Categories
                                        </a>
                                        <a href="@Url.Action("Index", "MenuItem")" class="btn btn-info">
                                            Manage Items
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row mt-4">
                        <div class="col-md-6 mb-4">
                            <div class="card h-100">
                                <div class="card-body text-center">
                                    <i class="fas fa-qrcode fa-3x mb-3 text-secondary"></i>
                                    <h5>Table Management</h5>
                                    <p class="text-muted">Create tables and generate QR codes</p>
                                    <a href="@Url.Action("Index", "Tables")" class="btn btn-secondary btn-block">
                                        Manage Tables
                                    </a>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-md-6 mb-4">
                            <div class="card h-100">
                                <div class="card-body text-center">
                                    <i class="fas fa-users fa-3x mb-3 text-dark"></i>
                                    <h5>User Management</h5>
                                    <p class="text-muted">Manage staff accounts</p>
                                    <a href="@Url.Action("Index", "Users")" class="btn btn-dark btn-block">
                                        Manage Users
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
