        // Animated numbers count
        function animateValue(elementId, targetValue) {
            const el = document.getElementById(elementId);
            if (!el) return;

            let isCurrency = false;
            let numericTarget = targetValue;

            if (typeof targetValue === 'string') {
                if (targetValue.includes('L.E.')) {
                    isCurrency = true;
                    numericTarget = parseFloat(targetValue.replace(/[^0-9.-]+/g, ""));
                } else {
                    numericTarget = parseInt(targetValue, 10);
                }
            }

            if (isNaN(numericTarget)) {
                el.textContent = targetValue;
                return;
            }

            const duration = 800; // ms
            const start = 0;
            const startTime = performance.now();

            function updateNumber(currentTime) {
                const elapsed = currentTime - startTime;
                const progress = Math.min(elapsed / duration, 1);
                const easedProgress = 1 - Math.pow(1 - progress, 3); // Ease out cubic
                
                const currentValue = start + (numericTarget - start) * easedProgress;

                if (isCurrency) {
                    el.textContent = `${currentValue.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})} L.E.`;
                } else {
                    el.textContent = Math.floor(currentValue).toLocaleString();
                }

                if (progress < 1) {
                    requestAnimationFrame(updateNumber);
                } else {
                    if (isCurrency) {
                        el.textContent = `${numericTarget.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})} L.E.`;
                    } else {
                        el.textContent = numericTarget.toLocaleString();
                    }
                }
            }

            requestAnimationFrame(updateNumber);
        }

