        // Toast alert helper (uses existing UI toast mechanism)
        function showToastAlert(message, type = 'success') {
            const container = document.getElementById('toast-container');
            if (!container) return;
            const bgClass = type === 'success' ? 'bg-emerald-500' : (type === 'error' ? 'bg-red-500' : 'bg-brand-500');
            const icon = type === 'success' ? 'bi-check-circle' : (type === 'error' ? 'bi-exclamation-triangle' : 'bi-info-circle');
            const toast = document.createElement('div');
            toast.className = `${bgClass} text-white px-4 py-3 rounded-xl shadow-lg flex items-center gap-3 text-xs font-bold transition-all duration-300 transform translate-y-2 opacity-0`;
            toast.innerHTML = `<i class="bi ${icon} text-base"></i> <span>${message}</span>`;
            container.appendChild(toast);
            setTimeout(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            }, 50);
            setTimeout(() => {
                toast.classList.add('translate-y-2', 'opacity-0');
                setTimeout(() => toast.remove(), 300);
            }, 4000);
        }

        // 1. Inventory Stock Actions
        function loadInventoryStockList() {
            const branchId = $('#header-branch-selector').val();
            const tbody = document.querySelector('#table-inventory-stock tbody');
            const alertList = document.getElementById('inventory-low-stock-list');
            if (tbody) {
                tbody.innerHTML = `<tr><td colspan="7" class="text-center py-8 text-slate-400 dark:text-slate-500">Loading live inventory records...</td></tr>`;
            }
            if (alertList) {
                alertList.innerHTML = `<div class="p-4 border border-slate-200 dark:border-darkBorder text-slate-400 text-xs rounded-xl text-center font-bold">Loading stock alerts...</div>`;
            }
            $.get('/Inventory/GetStockLevels', { branchId: branchId ? parseInt(branchId) : null })
             .done(function(data) {
                 inventoryStockData = data;
                 renderInventoryTable();
                 updateInventoryKPIs();
             })
             .fail(function() {
                 inventoryStockData = [];
                 if (tbody) {
                     tbody.innerHTML = `<tr><td colspan="7" class="text-center py-8 text-red-500">Could not load live inventory records from the database.</td></tr>`;
                 }
                 if (alertList) {
                     alertList.innerHTML = `<div class="p-4 border border-red-500/10 bg-red-500/5 text-red-500 text-xs rounded-xl text-center font-bold">Stock alerts unavailable because live inventory data failed to load.</div>`;
                 }
                 showToastAlert("Failed to load inventory stock levels.", "error");
             });
        }

        function renderInventoryTable() {
            const tbody = document.querySelector('#table-inventory-stock tbody');
            const alertList = document.getElementById('inventory-low-stock-list');
            tbody.innerHTML = '';
            alertList.innerHTML = '';

            const searchTerm = $('#search-inventory').val().toLowerCase();
            const filtered = inventoryStockData.filter(item => 
                item.name.toLowerCase().includes(searchTerm) || 
                (item.supplierName && item.supplierName.toLowerCase().includes(searchTerm))
            );

            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="text-center py-8 text-slate-400 dark:text-slate-500">No inventory materials matched the criteria.</td></tr>`;
            } else {
                filtered.forEach(item => {
                    const isLow = item.currentStock <= item.reorderLevel;
                    const valuation = item.currentStock * parseFloat(item.costPerUnit);
                    const stockClass = item.currentStock === 0 ? 'text-red-500 font-bold' : (isLow ? 'text-amber-500 font-semibold' : 'text-slate-700 dark:text-slate-350');
                    const minBadge = `<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-500">${item.reorderLevel} ${item.unit}</span>`;
                    
                    tbody.innerHTML += `
                        <tr class="border-b border-slate-50 dark:border-darkBorder/50 hover:bg-slate-50/50 dark:hover:bg-slate-800/20 transition-colors">
                            <td class="py-3.5 px-6 font-semibold text-slate-800 dark:text-white">${item.name}</td>
                            <td class="py-3.5 text-slate-500 dark:text-slate-400">${item.supplierName || 'Unassigned'}</td>
                            <td class="py-3.5 text-center ${stockClass}">${item.currentStock.toFixed(2)} ${item.unit}</td>
                            <td class="py-3.5 text-center">${minBadge}</td>
                            <td class="py-3.5 text-right font-semibold text-slate-600 dark:text-slate-400">${parseFloat(item.costPerUnit).toFixed(2)} EGP</td>
                            <td class="py-3.5 text-right font-bold text-slate-900 dark:text-white">${valuation.toFixed(2)} EGP</td>
                            <td class="py-3.5 text-center">
                                <div class="flex items-center justify-center gap-1.5">
                                    <button onclick="openAddStockModal(${item.id}, '${item.name.replace(/'/g, "\\'")}', '${item.unit}', ${item.costPerUnit})" class="px-2 py-1 text-[10px] font-bold rounded-lg bg-amber-50 hover:bg-amber-100 dark:bg-amber-950/20 dark:hover:bg-amber-950/40 text-amber-500 border border-amber-500/10 transition-all flex items-center gap-0.5" title="Intake Stock"><i class="bi bi-plus-lg"></i> Intake</button>
                                    <button onclick="openAdjustStockModal(${item.id}, '${item.name.replace(/'/g, "\\'")}', '${item.unit}')" class="px-2 py-1 text-[10px] font-bold rounded-lg bg-rose-50 hover:bg-rose-100 dark:bg-rose-950/20 dark:hover:bg-rose-950/40 text-rose-500 border border-rose-500/10 transition-all flex items-center gap-0.5" title="Audit/Waste"><i class="bi bi-sliders"></i> Audit</button>
                                    <button onclick="openEditIngredientModal(${item.id}, '${item.name.replace(/'/g, "\\'")}', '${item.unit}', ${item.costPerUnit}, ${item.reorderLevel}, ${item.supplierId || 'null'})" class="px-2 py-1 text-[10px] font-bold rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-white transition-all" title="Edit Material Details"><i class="bi bi-pencil"></i></button>
                                    <button onclick="deleteIngredient(${item.id})" class="px-2 py-1 text-[10px] font-bold rounded-lg bg-red-50 hover:bg-red-100 dark:bg-red-950/20 dark:hover:bg-red-950/40 text-red-550 border border-red-500/10 transition-all" title="Delete Material"><i class="bi bi-trash"></i></button>
                                </div>
                            </td>
                        </tr>`;

                    if (isLow) {
                        const statusClass = item.currentStock === 0 ? 'bg-red-500/10 text-red-500 border-red-500/20' : 'bg-amber-500/10 text-amber-500 border-amber-500/20';
                        const textStatus = item.currentStock === 0 ? 'OUT OF STOCK' : 'LOW STOCK';
                        alertList.innerHTML += `
                            <div class="p-3 border rounded-xl flex justify-between items-center ${statusClass}">
                                <div>
                                    <h5 class="font-bold text-xs">${item.name}</h5>
                                    <span class="text-[9px] font-semibold tracking-wide uppercase opacity-75">${textStatus} • Min: ${item.reorderLevel} ${item.unit}</span>
                                </div>
                                <span class="text-xs font-black">${item.currentStock.toFixed(1)} ${item.unit}</span>
                            </div>`;
                    }
                });
            }

            if (alertList.innerHTML === '') {
                alertList.innerHTML = `
                    <div class="p-4 border border-emerald-500/10 bg-emerald-500/5 text-emerald-600 dark:text-emerald-400 text-xs rounded-xl text-center font-bold">
                        <i class="bi bi-shield-check text-2xl block mb-1"></i> All stock levels healthy! No critical alerts.
                    </div>`;
            }
        }

