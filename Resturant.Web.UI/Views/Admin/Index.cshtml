        // --- EDIT MENU ITEM MODAL LOGIC ---
        function openEditMenuItemModal(id, name, description, price, cost, categoryId, isAvail, isPop, isTrend, isRec, imageUrl, orderNumber) {
            const modal = document.getElementById('edit-menu-modal');
            const modalContent = document.getElementById('edit-menu-modal-content');

            document.getElementById('edit-menu-id').value = id;
            document.getElementById('edit-menu-name').value = name;
            document.getElementById('edit-menu-price').value = price;
            document.getElementById('edit-menu-cost').value = cost || 0;

            const orderNumInput = document.getElementById('edit-menu-order-number');
            if (orderNumInput) orderNumInput.value = orderNumber || 0;

            if (document.getElementById('edit-menu-available')) document.getElementById('edit-menu-available').checked = isAvail;
            if (document.getElementById('edit-menu-popular')) document.getElementById('edit-menu-popular').checked = isPop;
            if (document.getElementById('edit-menu-trending')) document.getElementById('edit-menu-trending').checked = isTrend;
            if (document.getElementById('edit-menu-recommended')) document.getElementById('edit-menu-recommended').checked = isRec;

            // Parse sizes from description
            const parsed = parseSizesFromDesc(description || '');
            document.getElementById('edit-menu-desc').value = parsed.cleanDesc;

            // Reset sizes UI
            const editSizesList = document.getElementById('edit-menu-sizes-list');
            const editSizesBody = document.getElementById('edit-menu-sizes-body');
            const editSizesToggle = document.getElementById('edit-menu-has-sizes');
            editSizesList.innerHTML = '';
            const item = allMenuItems.find(i => i.id === id);
            const sizeRows = item && item.sizes && item.sizes.length > 0 ? item.sizes : parsed.sizes;
            if (sizeRows.length > 0) {
                editSizesToggle.checked = true;
                editSizesBody.classList.remove('hidden');
                sizeRows.forEach(s => addAdminSizeRow('edit-menu-sizes-list', s.name, s.price.toFixed(2), (s.cost || 0).toFixed(2)));
            } else {
                editSizesToggle.checked = false;
                editSizesBody.classList.add('hidden');
            }

            // Populate category list before selecting
            const origDropdown = document.getElementById('menu-cat-id');
            const editDropdown = document.getElementById('edit-menu-cat-id');
            if (origDropdown && editDropdown) {
                editDropdown.innerHTML = origDropdown.innerHTML;
                editDropdown.value = categoryId;
            }

            // Find current item in global list for recommendations & add-ons
            // Populate recommendations checkboxes
            const checkedRecIds = item && item.recommendations ? item.recommendations : [];
            renderRecommendationsList('edit-menu-recommendations-list', checkedRecIds, id);

            // Populate dynamic add-ons rows
            const addonContainer = document.getElementById('edit-menu-addons-container');
            addonContainer.innerHTML = '';
            if (item && item.addOns) {
                item.addOns.forEach(addon => {
                    addNewAddonRow('edit-menu-addons-container', addon.name, addon.extraPrice);
                });
            }

            const previewDiv = document.getElementById('edit-menu-img-preview');
            if (imageUrl) {
                previewDiv.querySelector('img').src = imageUrl;
                previewDiv.classList.remove('hidden');
            } else {
                previewDiv.classList.add('hidden');
            }

            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                modalContent.classList.remove('scale-95');
            }, 50);
        }

        function closeEditMenuItemModal() {
            const modal = document.getElementById('edit-menu-modal');
            const modalContent = document.getElementById('edit-menu-modal-content');

            modal.classList.add('opacity-0');
            modalContent.classList.add('scale-95');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300);
        }

        async function submitEditMenuItem(e) {
            e.preventDefault();
            const id = document.getElementById('edit-menu-id').value;
            const name = document.getElementById('edit-menu-name').value.trim();
            const rawDesc = document.getElementById('edit-menu-desc').value.trim();
            const price = document.getElementById('edit-menu-price').value;
            const cost = document.getElementById('edit-menu-cost').value;
            const catId = document.getElementById('edit-menu-cat-id').value;

            const isAvail = document.getElementById('edit-menu-available') ? document.getElementById('edit-menu-available').checked : true;
            const isPop = document.getElementById('edit-menu-popular') ? document.getElementById('edit-menu-popular').checked : false;
            const isTrend = document.getElementById('edit-menu-trending') ? document.getElementById('edit-menu-trending').checked : false;
            const isRec = document.getElementById('edit-menu-recommended') ? document.getElementById('edit-menu-recommended').checked : false;

            const fileInput = document.getElementById('edit-menu-image');

            if (!name || !price || cost === '' || !catId) {
                showToastAlert("Please fill in all required fields.", "warning");
                return;
            }

            const sizes = collectSizes('edit-menu-sizes-list', 'edit-menu-has-sizes');

            const formData = new FormData();
            formData.append('name', name);
            formData.append('description', rawDesc);
            formData.append('price', price);
            formData.append('cost', cost);
            formData.append('menuCategoryId', catId);
            formData.append('isAvailable', isAvail);
            formData.append('isPopular', isPop);
            formData.append('isTrending', isTrend);
            formData.append('isRecommended', isRec);
            const orderNumInput = document.getElementById('edit-menu-order-number');
            formData.append('orderNumber', orderNumInput ? orderNumInput.value : 0);
            formData.append('sizesJson', JSON.stringify(sizes));
            if (fileInput.files.length > 0) {
                formData.append('imageFile', fileInput.files[0]);
            }

            // Build addons JSON
            const addonContainer = document.getElementById('edit-menu-addons-container');
            const addonRows = addonContainer.querySelectorAll('.flex');
            const addons = [];
            addonRows.forEach(row => {
                const inputs = row.querySelectorAll('input');
                if (inputs.length >= 2) {
                    const extraName = inputs[0].value.trim();
                    const extraPrice = parseFloat(inputs[1].value) || 0;
                    if (extraName) {
                        addons.push({ name: extraName, extraPrice: extraPrice });
                    }
                }
            });
            formData.append('addonsJson', JSON.stringify(addons));

            // Build recommendations JSON
            const recContainer = document.getElementById('edit-menu-recommendations-list');
            const checkedCheckboxes = recContainer.querySelectorAll('input[type="checkbox"]:checked');
            const recIds = [];
            checkedCheckboxes.forEach(cb => {
                recIds.push(parseInt(cb.value));
            });
            formData.append('recommendationsJson', JSON.stringify(recIds));

            showLoader();
            try {
                const response = await fetch(`/api/analytics/menu/edit/${id}`, {
                    method: 'POST',
                    body: formData
                });
                if (response.ok) {
                    showToastAlert("Menu Item updated successfully!", "success");
                    closeEditMenuItemModal();
                    document.getElementById('form-edit-menuitem').reset();
                    loadMenuItemsList();
                } else {
                    let errMsg = "Failed to update menu item.";
                    const text = await response.text();
                    try {
                        const err = JSON.parse(text);
                        errMsg = err.message || err.Message || errMsg;
                        if (err.details || err.Details) {
                            errMsg += " Details: " + (err.details || err.Details);
                        }
                    } catch (e) {
                        console.error("Server HTML error:", text);
                        errMsg = "Server Error: " + text.substring(0, 200);
                    }
                    showToastAlert(errMsg, "error");
                }
            } catch (err) {
                showToastAlert("Error connecting to server: " + err.message, "error");
            } finally {
                hideLoader();
            }
        }

