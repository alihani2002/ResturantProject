        async function submitCategory(e) {
            e.preventDefault();
            const nameInput = document.getElementById('cat-name');
            const descInput = document.getElementById('cat-desc');
            const isActiveInput = document.getElementById('cat-active');
            const fileInput = document.getElementById('cat-image');

            if (!nameInput.value.trim()) {
                showToastAlert("Category name is required.", "warning");
                return;
            }

            const formData = new FormData();
            formData.append('name', nameInput.value.trim());
            formData.append('description', descInput ? descInput.value.trim() : '');
            formData.append('isActive', isActiveInput ? isActiveInput.checked : true);
            const orderNumInput = document.getElementById('cat-order-number');
            formData.append('orderNumber', orderNumInput ? orderNumInput.value : 0);
            if (fileInput.files.length > 0) {
                formData.append('imageFile', fileInput.files[0]);
            }

            showLoader();
            try {
                const response = await fetch('/api/analytics/categories/create', {
                    method: 'POST',
                    body: formData
                });
                if (response.ok) {
                    showToastAlert("New Category created successfully!", "success");
                    document.getElementById('form-add-category').reset();
                    loadCategoriesList();
                } else {
                    const err = await response.json();
                    showToastAlert(err.message || "Failed to create category.", "error");
                }
            } catch (err) {
                showToastAlert("Error connecting to server.", "error");
            } finally {
                hideLoader();
            }
        }

        async function deleteCategory(id) {
            if (!confirm("Are you sure you want to delete this category? All menu products assigned under this category will have missing relationships.")) return;
            showLoader();
            try {
                const response = await fetch(`/api/analytics/categories/delete/${id}`, { method: 'POST' });
                if (response.ok) {
                    showToastAlert("Category deleted successfully.", "success");
                    loadCategoriesList();
                } else {
                    showToastAlert("Failed to delete category.", "error");
                }
            } catch (err) {
                showToastAlert("Error connecting to server.", "error");
            } finally {
                hideLoader();
            }
        }

