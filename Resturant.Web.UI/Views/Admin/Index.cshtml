        // ==============================================
        // EXPORT ENGINE (PDF / EXCEL / CSV)
        // ==============================================
        function exportReport(format) {
            const reportName = `Restaurant_ERP_${currentTab}_Report_${new Date().toISOString().slice(0, 10)}`;
            const activeReportData = reportsData[currentTab];

            if (!activeReportData) {
                showToastAlert("Please wait for report data to load completely.", "warning");
                return;
            }

            if (format === 'excel') {
                exportToExcel(activeReportData, reportName);
            } else if (format === 'pdf') {
                exportToPDF(activeReportData, reportName);
            }
        }

        function exportToExcel(data, filename) {
            try {
                const wb = XLSX.utils.book_new();
                
                // Helper to push worksheet
                function addSheet(sheetName, tableData) {
                    if (!tableData) return;
                    const ws = XLSX.utils.json_to_sheet(tableData);
                    XLSX.utils.book_append_sheet(wb, ws, sheetName);
                }

                // Compile worksheets based on tab
                if (currentTab === 'sales') {
                    addSheet("Gross Trend", data.salesTrend);
                    addSheet("Hourly Performance", data.hourlySales);
                    const breakdown = (data.salesByPaymentMethod || []).concat(data.salesByTable || []);
                    addSheet("Dimension Breakdown", breakdown);
                } else if (currentTab === 'orders') {
                    addSheet("Table Turnover", data.mostBusyTables);
                    addSheet("Category Volume", data.ordersByCategory);
                    addSheet("Product Sales Count", data.ordersByProduct);
                } else if (currentTab === 'products') {
                    addSheet("Best Sellers", data.bestSellers);
                    addSheet("Least Sellers", data.leastSellers);
                    addSheet("Add-on Up-sells", data.addOnPerformance);
                } else if (currentTab === 'customers') {
                    addSheet("VIP Customer List", data.vipList);
                    addSheet("Customer Segmentation", data.segments);
                } else if (currentTab === 'staff') {
                    addSheet("Waiter Performance Rankings", data.waiterRankings);
                    addSheet("Shifts Output", data.shifts);
                } else if (currentTab === 'kitchen') {
                    addSheet("Fastest Prepared", data.fastestItems);
                    addSheet("Slowest Prepared", data.slowestItems);
                    addSheet("Hourly Load Heatmap", data.kitchenLoadByHour);
                } else if (currentTab === 'financials') {
                    addSheet("Operating Expenses Breakdown", data.expensesBreakdown);
                    addSheet("Daily closing ledger", data.closingReports);
                    addSheet("Cash Drawer Audits", data.paymentReconciliations);
                } else if (currentTab === 'inventory') {
                    addSheet("Low Stock Warning", data.lowStockAlerts);
                    addSheet("Recipe cost margin", data.recipeCosts);
                    addSheet("Ingredients Waste", data.wasteLogs);
                    addSheet("Supplier Purchase Audit", data.supplierPurchases);
                } else {
                    // Default fallback
                    addSheet("Overview Metrics", [{ "Today Revenue": data.totalRevenueToday, "Active Tables": data.activeTablesCount, "Pending Orders": data.pendingOrdersCount }]);
                }

                XLSX.writeFile(wb, `${filename}.xlsx`);
                showToastAlert("Excel file exported successfully.", "success");
            } catch (e) {
                console.error(e);
                showToastAlert("Failed to export Excel.", "error");
            }
        }

        function exportToPDF(data, filename) {
            try {
                const { jsPDF } = window.jspdf;
                const doc = new jsPDF('p', 'pt', 'a4');

                // Header styling
                doc.setFont("Helvetica", "bold");
                doc.setFontSize(22);
                doc.setTextColor(245, 158, 11); // Brand Color amber-500
                doc.text("QORE ERP SYSTEM", 40, 50);

                doc.setFontSize(14);
                doc.setTextColor(15, 23, 42); // slate-900
                doc.text(`Enterprise Back Office ERP: ${currentTab.toUpperCase()} LEDGER`, 40, 75);

                doc.setFontSize(9);
                doc.setFont("Helvetica", "normal");
                doc.setTextColor(148, 163, 184); // slate-400
                doc.text(`Generated on: ${new Date().toLocaleString()} | Secure Audit Records`, 40, 95);
                doc.line(40, 105, 555, 105);

                let columns = [];
                let rows = [];

                // Determine table dataset based on Tab
                if (currentTab === 'sales') {
                    columns = ["Date / Period", "Total Revenue (L.E.)", "Orders Basket Count"];
                    rows = (data.salesTrend || []).map(t => [t.dateLabel, `${(t.revenue ?? 0).toFixed(2)} L.E.`, t.orderCount]);
                } else if (currentTab === 'orders') {
                    columns = ["Table", "Total Sessions", "Total Orders", "Total Spent (L.E.)", "Avg Session Duration"];
                    rows = (data.mostBusyTables || []).map(t => [`Table ${t.tableNumber}`, t.totalSessions, t.totalOrders, `${(t.totalRevenue ?? 0).toFixed(2)} L.E.`, `${Math.round(t.averageSessionDurationMinutes ?? 0)} mins`]);
                } else if (currentTab === 'products') {
                    columns = ["Product Name", "Category", "Portions Sold", "Total Revenue", "Margin Profit"];
                    rows = (data.bestSellers || []).map(p => [p.productName, p.categoryName, p.salesCount, `${(p.revenue ?? 0).toFixed(2)} L.E.`, `${(p.profit ?? 0).toFixed(2)} L.E.`]);
                } else if (currentTab === 'customers') {
                    columns = ["Customer Name", "Phone", "Orders", "Total Spent", "LTV (L.E.)", "Last Visit"];
                    rows = (data.vipList || []).map(v => [v.customerName, v.phoneNumber, v.totalOrders, `${(v.totalSpent ?? 0).toFixed(2)} L.E.`, `${(v.customerLifetimeValue ?? 0).toFixed(2)} L.E.`, new Date(v.lastVisit).toLocaleDateString()]);
                } else if (currentTab === 'staff') {
                    columns = ["Waiter Name", "Total Revenue", "Orders Handled", "Avg Speed", "Rating Score", "Badge Award"];
                    rows = (data.waiterRankings || []).map(w => [w.waiterName, `${(w.totalRevenue ?? 0).toFixed(2)} L.E.`, w.ordersHandled, `${w.averageServiceTimeMinutes} mins`, `${(w.customerRating ?? 0).toFixed(1)} / 5.0`, w.performanceBadge]);
                } else if (currentTab === 'kitchen') {
                    columns = ["MenuItem", "Average Prep Time", "Total Prepared Portions"];
                    const items = (data.fastestItems || []).concat(data.slowestItems || []);
                    rows = items.map(i => [i.itemName, `${(i.averagePrepTimeMinutes ?? 0).toFixed(1)} mins`, i.timesPrepared]);
                } else if (currentTab === 'financials') {
                    columns = ["Closing Date", "Audited By", "Expected Drawer (L.E.)", "Actual Drawer (L.E.)", "Variance (L.E.)", "Total Revenue Closed (L.E.)"];
                    rows = (data.closingReports || []).map(c => [new Date(c.date).toLocaleDateString(), c.closedBy, `${(c.expectedCash ?? 0).toFixed(2)} L.E.`, `${(c.actualCash ?? 0).toFixed(2)} L.E.`, `${(c.cashDiscrepancy ?? 0).toFixed(2)} L.E.`, `${(c.totalClosedRevenue ?? 0).toFixed(2)} L.E.`]);
                } else if (currentTab === 'inventory') {
                    columns = ["Critical Ingredient", "Stock", "Reorder Level", "Unit", "Supplier Partner", "Status Alert"];
                    rows = (data.lowStockAlerts || []).map(i => [i.ingredientName, i.currentStock, i.reorderLevel, i.unit, i.supplierName, i.stockStatus]);
                } else {
                    columns = ["KPI Metric", "Value"];
                    rows = [
                        ["Today Live Revenue", `${(data.totalRevenueToday ?? 0).toFixed(2)} L.E.`],
                        ["Active Tables", data.activeTablesCount ?? 0],
                        ["Active QR Sessions", data.activeSessionsTodayCount ?? 0],
                        ["Pending Orders queue", data.pendingOrdersCount ?? 0]
                    ];
                }

                // Render Table PDF
                doc.autoTable({
                    head: [columns],
                    body: rows,
                    startY: 120,
                    theme: 'striped',
                    headStyles: { fillColor: [217, 119, 6], textColor: [255, 255, 255] }, // Amber-600 headers
                    styles: { fontSize: 8 },
                    margin: { left: 40, right: 40 }
                });

                doc.save(`${filename}.pdf`);
                showToastAlert("PDF file exported successfully.", "success");
            } catch (e) {
                console.error(e);
                showToastAlert("Failed to export PDF.", "error");
            }
        }

