        async function saveCRMNotes(guestId) {
            const notes = document.getElementById('crm-modal-notes').value;
            showLoader();
            try {
                const response = await fetch(`/api/analytics/customers/${guestId}/notes`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(notes)
                });
                if (response.ok) {
                    showToastAlert("CRM Guest notes updated successfully.", "success");
                    // Update cache
                    const guest = globalCrmGuests.find(g => g.guestId === guestId);
                    if (guest) guest.crmNotes = notes;
                    closeCRMDetailsModal();
                } else {
                    showToastAlert("Failed to save guest CRM notes.", "error");
                }
            } catch (err) {
                showToastAlert("Error: " + err.message, "error");
            } finally {
                hideLoader();
            }
        }

