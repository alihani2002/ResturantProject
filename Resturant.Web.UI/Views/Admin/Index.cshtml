            if (searchInput) searchInput.value = '';

            const categoryInput = document.getElementById('prodSalesCategory');
            if (categoryInput) categoryInput.value = '';

            const branchInput = document.getElementById('prodSalesBranch');
            if (branchInput) branchInput.value = '';

            const dateFromInput = document.getElementById('prodSalesDateFrom');
            if (dateFromInput) dateFromInput.value = '';

            const dateToInput = document.getElementById('prodSalesDateTo');
            if (dateToInput) dateToInput.value = '';

            const hourFromInput = document.getElementById('prodSalesHourFrom');
