        function submitIngredientCrud(e) {
            e.preventDefault();
            const branchId = $('#header-branch-selector').val();
            if (!branchId) {
                showToastAlert("Please select an active branch in the header context first.", "error");
                return;
            }

            const idVal = document.getElementById('ingredient-crud-id').value;
            const isEdit = idVal !== "";

            const url = isEdit ? '/Inventory/UpdateIngredient' : '/Inventory/CreateIngredient';
            
            const request = {
                name: document.getElementById('ingredient-crud-name').value,
                reorderLevel: parseFloat(document.getElementById('ingredient-crud-reorder-level').value),
                unit: document.getElementById('ingredient-crud-unit').value,
                costPerUnit: parseFloat(document.getElementById('ingredient-crud-cost').value),
                supplierId: document.getElementById('ingredient-crud-supplier').value ? parseInt(document.getElementById('ingredient-crud-supplier').value) : null
            };

            if (isEdit) {
                request.id = parseInt(idVal);
            } else {
                request.branchId = parseInt(branchId);
                request.initialStock = parseFloat(document.getElementById('ingredient-crud-initial-stock').value);
            }

            $.ajax({
                url: url,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(request),
