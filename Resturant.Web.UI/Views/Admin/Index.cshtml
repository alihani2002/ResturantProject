        // Show Toast Notifications
        function showToastAlert(message, type = 'info') {
            const container = document.getElementById('toast-container');
            if (!container) return;

            // Prevent duplicate toasts
            const activeToasts = container.getElementsByTagName('span');
            for (let activeToast of activeToasts) {
                if (activeToast.textContent === message) {
                    return; // Do not show duplicate toast alert
                }
            }

            const id = 'toast-' + Date.now();

            const colors = {
                success: 'bg-emerald-500 text-white',
                error: 'bg-red-500 text-white',
                warning: 'bg-amber-500 text-white',
                info: 'bg-slate-800 text-white dark:bg-slate-700'
            };

            const icons = {
                success: 'bi-check-circle-fill',
                error: 'bi-shield-fill-x',
                warning: 'bi-exclamation-triangle-fill',
                info: 'bi-info-circle-fill'
            };

            const html = `
                <div id="${id}" class="flex items-center gap-3 px-4 py-3 rounded-xl shadow-lg border border-slate-200/10 ${colors[type]} transition-all duration-300 translate-y-2 opacity-0">
                    <i class="bi ${icons[type]} text-base"></i>
                    <span class="text-xs font-semibold">${message}</span>
                    <button onclick="document.getElementById('${id}').remove()" class="ml-auto text-white/70 hover:text-white"><i class="bi bi-x-lg text-xs"></i></button>
                </div>
            `;

            container.insertAdjacentHTML('beforeend', html);
            const el = document.getElementById(id);
            setTimeout(() => {
                el?.classList.remove('translate-y-2', 'opacity-0');
            }, 50);

            setTimeout(() => {
                if (el) {
                    el.classList.add('translate-y-2', 'opacity-0');
                    setTimeout(() => el.remove(), 300);
                }
            }, 4500);
        }

