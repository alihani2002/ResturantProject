                    });
                    waiterSelectHtml += `</select>`;

                    const tr = document.createElement('tr');
                    tr.className = 'border-b border-slate-50 dark:border-darkBorder/50 hover:bg-slate-50/50 dark:hover:bg-slate-800/20 transition-colors';
                    tr.innerHTML = `
                        <td class="py-3 px-2 font-bold text-slate-800 dark:text-white">Table ${table.tableNumber}</td>
