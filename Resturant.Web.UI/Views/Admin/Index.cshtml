        // Render TAB 2: ORDERS ANALYSIS REPORT
        function renderOrdersReport(data) {
            animateValue('order-total-count', data.totalOrders);
            document.getElementById('order-avg-prep').textContent = `${data.averagePreparationTimeMinutes} min`;
            document.getElementById('order-avg-serve').textContent = `${data.averageServingTimeMinutes} min`;
            document.getElementById('order-avg-turnover').textContent = `${data.averageTableTurnoverMinutes} min`;

            // Table: Orders Breakdown By Menu Category
            const totalCategoryOrders = data.ordersByCategory.reduce((sum, c) => sum + (c.orderCount || 0), 0);
            const tbodyCat = document.querySelector('#table-orders-category tbody');
            if (tbodyCat) {
                tbodyCat.innerHTML = '';
                data.ordersByCategory.forEach(c => {
                    const share = totalCategoryOrders > 0 ? ((c.orderCount / totalCategoryOrders) * 100).toFixed(1) : 0;
                    const yieldVal = c.revenue !== undefined ? `${c.revenue.toFixed(2)} L.E.` : 'N/A';
                    const tr = `
                        <tr class="border-b border-slate-100 dark:border-darkBorder hover:bg-slate-50 dark:hover:bg-slate-800">
                            <td class="py-3 font-semibold text-slate-800 dark:text-slate-200">${c.dimensionValue}</td>
                            <td class="py-3 text-center font-bold">${c.orderCount}</td>
                            <td class="py-3 text-right text-emerald-500 font-bold">${yieldVal}</td>
                            <td class="py-3 text-right font-black text-indigo-500">${share}%</td>
                        </tr>
                    `;
                    tbodyCat.insertAdjacentHTML('beforeend', tr);
                });
            }

            // Table: Busy Tables
            const tbody = document.querySelector('#table-busy-tables tbody');
            tbody.innerHTML = '';
            data.mostBusyTables.forEach(t => {
                const tr = `
                    <tr class="border-b border-slate-100 dark:border-darkBorder hover:bg-slate-50 dark:hover:bg-slate-800">
                        <td class="py-3 font-semibold">Table ${t.tableNumber}</td>
                        <td class="py-3">${t.totalSessions}</td>
                        <td class="py-3">${t.totalOrders}</td>
                        <td class="py-3 font-bold text-slate-900 dark:text-white">${t.totalRevenue.toFixed(2)} L.E.</td>
                        <td class="py-3">${Math.round(t.averageSessionDurationMinutes)} min</td>
                    </tr>
                `;
                tbody.insertAdjacentHTML('beforeend', tr);
            });
