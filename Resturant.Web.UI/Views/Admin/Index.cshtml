                editSizesToggle.checked = true;
                editSizesBody.classList.remove('hidden');
                parsed.sizes.forEach(s => addAdminSizeRow('edit-menu-sizes-list', s.name, s.price.toFixed(2)));
            } else {
                editSizesToggle.checked = false;
                editSizesBody.classList.add('hidden');
