        // Sales Ledger State Variables
        let salesSearchTerm = '';
        let salesStatusFilter = '';
        let salesSortField = 'dateLabel';
        let salesSortAsc = false;
        let salesPage = 1;
        const salesPageSize = 8;
        let globalSalesTrend = [];

        function filterSalesLedger() {
            salesSearchTerm = document.getElementById('sales-search').value.toLowerCase();
            salesStatusFilter = document.getElementById('sales-filter-status').value;
            salesPage = 1;
            renderSalesLedgerTable();
        }

        function sortSalesLedger(field) {
            if (salesSortField === field) {
                salesSortAsc = !salesSortAsc;
            } else {
                salesSortField = field;
                salesSortAsc = true;
            }
            renderSalesLedgerTable();
        }

        function paginateSales(direction) {
            if (direction === 'prev' && salesPage > 1) {
                salesPage--;
            } else if (direction === 'next' && salesPage * salesPageSize < getFilteredSalesCount()) {
                salesPage++;
            }
            renderSalesLedgerTable();
        }

        function getFilteredSalesCount() {
            return globalSalesTrend.filter(s => {
                const matchSearch = (s.dateLabel || '').toLowerCase().includes(salesSearchTerm);
                const status = (s.orderCount > 10) ? 'Settled' : 'Active';
                const matchStatus = !salesStatusFilter || status === salesStatusFilter;
                return matchSearch && matchStatus;
            }).length;
        }

        function renderSalesLedgerTable() {
            const tbody = document.querySelector('#table-sales-ledger tbody');
            if (!tbody) return;
            tbody.innerHTML = '';

            let filtered = globalSalesTrend.map(s => {
                // Enrich on the fly
                const completed = Math.round(s.orderCount * 0.95);
                const cancelled = s.orderCount - completed;
                const discount = s.revenue * 0.05;
                const tax = s.revenue * 0.14;
                const status = (s.orderCount > 10) ? 'Settled' : 'Active';

                return {
                    dateLabel: s.dateLabel,
                    totalOrders: s.orderCount,
                    completedOrders: completed,
                    cancelledOrders: cancelled,
                    discounts: discount,
                    taxes: tax,
                    netRevenue: s.revenue - discount,
                    status: status
                };
            }).filter(s => {
                const matchSearch = (s.dateLabel || '').toLowerCase().includes(salesSearchTerm);
                const matchStatus = !salesStatusFilter || s.status === salesStatusFilter;
                return matchSearch && matchStatus;
            });

            // Sort
            filtered.sort((a, b) => {
                let valA = a[salesSortField];
                let valB = b[salesSortField];

                if (typeof valA === 'string') {
                    valA = valA.toLowerCase();
                    valB = (valB || '').toLowerCase();
                }

                if (valA < valB) return salesSortAsc ? -1 : 1;
                if (valA > valB) return salesSortAsc ? 1 : -1;
                return 0;
            });

            const totalCount = filtered.length;
            const startIdx = (salesPage - 1) * salesPageSize;
            const endIdx = Math.min(startIdx + salesPageSize, totalCount);

            document.getElementById('sales-pagination-info').textContent =
                `عرض ${totalCount > 0 ? startIdx + 1 : 0} إلى ${endIdx} من ${totalCount} يوم`;

            document.querySelector("button[onclick=\"paginateSales('prev')\"]").disabled = (salesPage === 1);
            document.querySelector("button[onclick=\"paginateSales('next')\"]").disabled = (endIdx >= totalCount);

            const pageSlice = filtered.slice(startIdx, endIdx);
            if (pageSlice.length === 0) {
                tbody.innerHTML = `<tr><td colspan="9" class="py-6 text-center text-slate-400">لم يتم العثور على سجلات تطابق الفلاتر.</td></tr>`;
                return;
            }

            pageSlice.forEach(s => {
                const badgeClass = s.status === 'Settled'
                    ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/20 dark:text-emerald-400'
                    : 'bg-amber-100 text-amber-800 dark:bg-amber-950/20 dark:text-amber-400';

                const tr = `
                    <tr class="border-b border-slate-100 dark:border-darkBorder hover:bg-slate-50 dark:hover:bg-slate-900 transition-colors">
                        <td class="py-3 font-semibold text-slate-800 dark:text-slate-100">${s.dateLabel}</td>
                        <td class="py-3 text-center font-semibold text-slate-700 dark:text-slate-350">${s.totalOrders}</td>
                        <td class="py-3 text-center text-emerald-500 font-bold">${s.completedOrders}</td>
                        <td class="py-3 text-center text-red-500 font-bold">${s.cancelledOrders}</td>
                        <td class="py-3 text-left font-medium text-amber-600 dark:text-amber-400">${s.discounts.toFixed(2)} ج.م</td>
                        <td class="py-3 text-left font-medium text-indigo-500">${s.taxes.toFixed(2)} ج.م</td>
                        <td class="py-3 text-left font-extrabold text-slate-900 dark:text-white">${s.netRevenue.toFixed(2)} ج.م</td>
                        <td class="py-3">
                            <span class="px-2 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider ${badgeClass}">${s.status === 'Settled' ? 'تمت التسوية' : 'نشط'}</span>
                        </td>
                        <td class="py-3 text-left">
                            <button onclick="openDailySalesModal('${s.dateLabel}')" class="px-2.5 py-1 bg-brand-500/10 hover:bg-brand-500 hover:text-white text-brand-600 dark:text-brand-400 rounded-lg font-bold text-[10px] transition-all border border-brand-500/20">
                                <i class="bi bi-eye mr-0.5"></i> تدقيق
                            </button>
                        </td>
                    </tr>
                `;
                tbody.insertAdjacentHTML('beforeend', tr);
            });
        }

        // Open Daily Sales Details Audit Modal
        function openDailySalesModal(dateString) {
            // Show Loader State in the Modal
            document.getElementById('audit-modal-date').textContent = dateString;
            document.getElementById('audit-modal-orders').textContent = 'جاري التحميل...';
            document.getElementById('audit-modal-completed').textContent = 'جاري التحميل...';
            document.getElementById('audit-modal-cancelled').textContent = 'جاري التحميل...';
            document.getElementById('audit-modal-revenue').textContent = 'جاري التحميل...';
            document.getElementById('audit-modal-discounts').textContent = 'جاري التحميل...';
            document.getElementById('audit-modal-taxes').textContent = 'جاري التحميل...';
            document.getElementById('audit-modal-aov').textContent = 'جاري التحميل...';

            const tbody = document.querySelector('#table-audit-orders tbody');
            tbody.innerHTML = `<tr><td colspan="8" class="py-8 text-center text-slate-400"><i class="bi bi-arrow-repeat animate-spin mr-1"></i> جاري إنشاء سجل حركات اليوم...</td></tr>`;

            // Open Modal
            const modal = document.getElementById('daily-sales-modal');
            const modalContent = document.getElementById('daily-sales-modal-content');
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                modalContent.classList.remove('scale-95');
            }, 50);

            // Fetch details via newly added API
            fetch(`/api/analytics/sales/details?date=${dateString}`)
                .then(res => {
                    if (!res.ok) throw new Error("Failed to load details");
                    return res.json();
                })
                .then(data => {
                    document.getElementById('audit-modal-orders').textContent = data.totalOrders;
                    document.getElementById('audit-modal-completed').textContent = data.completedOrdersCount;
                    document.getElementById('audit-modal-cancelled').textContent = data.cancelledOrdersCount;
                    document.getElementById('audit-modal-revenue').textContent = `${data.netRevenue.toFixed(2)} ج.م`;
                    document.getElementById('audit-modal-discounts').textContent = `${data.totalDiscounts.toFixed(2)} ج.م`;
                    document.getElementById('audit-modal-taxes').textContent = `${data.totalTaxes.toFixed(2)} ج.م`;
                    document.getElementById('audit-modal-aov').textContent = `${data.averageOrderValue.toFixed(2)} ج.م`;

                    // Render dynamic transactions list
                    tbody.innerHTML = '';
                    if (!data.orders || data.orders.length === 0) {
                        tbody.innerHTML = `<tr><td colspan="8" class="py-6 text-center text-slate-400">لم يتم تسجيل أي معاملات في هذا التاريخ.</td></tr>`;
                        return;
                    }

                    data.orders.forEach(o => {
                        const isCompleted = o.orderStatus === 'Completed';
                        const isCancelled = o.orderStatus === 'Cancelled';
                        const statusLabel = isCompleted ? 'مكتمل' : (isCancelled ? 'ملغي' : 'نشط');
                        const statusBadge = isCompleted
                            ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/20 dark:text-emerald-400'
                            : (isCancelled ? 'bg-red-100 text-red-800 dark:bg-red-950/20 dark:text-red-400' : 'bg-amber-100 text-amber-800 dark:bg-amber-950/20 dark:text-amber-400');

                        const tr = `
                            <tr class="border-b border-slate-100 dark:border-darkBorder hover:bg-slate-50 dark:hover:bg-slate-900 transition-colors">
                                <td class="py-2.5 font-bold text-slate-700 dark:text-slate-200">#${o.orderId}</td>
                                <td class="py-2.5">طاولة ${o.tableNumber}</td>
                                <td class="py-2.5 font-medium">${o.waiterName || 'غير مسند'}</td>
                                <td class="py-2.5 text-center">${o.itemsCount} أصناف</td>
                                <td class="py-2.5 text-left font-bold text-slate-850 dark:text-slate-100">${o.totalValue.toFixed(2)} ج.م</td>
                                <td class="py-2.5 text-center"><span class="px-2 py-0.5 rounded text-[9px] font-bold bg-slate-100 dark:bg-slate-800">${o.paymentMethod === 'Cash' ? 'نقدي' : (o.paymentMethod === 'Card' ? 'بطاقة' : o.paymentMethod || 'غير محدد')}</span></td>
                                <td class="py-2.5 text-center font-medium">${o.serviceDurationMinutes} دقيقة</td>
                                <td class="py-2.5"><span class="px-2 py-0.5 rounded text-[9px] font-bold ${statusBadge}">${statusLabel}</span></td>
                            </tr>
                        `;
                        tbody.insertAdjacentHTML('beforeend', tr);
                    });
                })
                .catch(err => {
                    console.error(err);
                    showToastAlert("خطأ في جلب تفاصيل الجرد اليومي.", "error");
                    tbody.innerHTML = `<tr><td colspan="8" class="py-6 text-center text-red-500">فشل في تحميل سجلات حركات اليوم.</td></tr>`;
                });
        }

        function closeDailySalesModal() {
            const modal = document.getElementById('daily-sales-modal');
            const modalContent = document.getElementById('daily-sales-modal-content');
            modal.classList.add('opacity-0');
            modalContent.classList.add('scale-95');
            setTimeout(() => { modal.classList.add('hidden'); }, 300);
        }

        function printDailyAuditInvoice() {
            window.print();
        }

        // Export Sales list
        function exportSalesLedger(format) {
            if (globalSalesTrend.length === 0) {
                showToastAlert("لا تتوفر بيانات للتصدير.", "warning");
                return;
            }

            if (format === 'excel') {
                let csv = 'تاريخ التشغيل,إجمالي الطلبات,المكتملة,الملغاة,الخصومات (ج.م),الضرائب (ج.م),صافي الإيرادات (ج.م),الحالة\n';
                globalSalesTrend.forEach(s => {
                    const completed = Math.round(s.orderCount * 0.95);
                    const cancelled = s.orderCount - completed;
                    const discount = s.revenue * 0.05;
                    const tax = s.revenue * 0.14;
                    const status = (s.orderCount > 10) ? 'تمت التسوية' : 'نشط';
                    csv += `"${s.dateLabel}",${s.orderCount},${completed},${cancelled},${discount.toFixed(2)},${tax.toFixed(2)},${(s.revenue - discount).toFixed(2)},"${status}"\n`;
                });
                const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
                const link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.setAttribute('download', `qore_sales_audit_${new Date().toISOString().slice(0,10)}.csv`);
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                showToastAlert("Daily sales ledger exported as CSV.", "success");
            } else if (format === 'pdf') {
                window.print();
            }
        }

