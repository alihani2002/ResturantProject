        let allMenuItems = [];

        function renderRecommendationsList(containerId, checkedIds = [], excludeId = null) {
            const container = document.getElementById(containerId);
            if (!container) return;
            
            const filteredItems = allMenuItems.filter(item => item.id !== excludeId);
            if (filteredItems.length === 0) {
                container.innerHTML = `<span class="text-[10px] text-slate-400 italic">No other products to recommend.</span>`;
                return;
            }
            
            container.innerHTML = filteredItems.map(item => {
                const isChecked = checkedIds.includes(item.id) ? 'checked' : '';
                return `
                    <div class="flex items-center gap-2">
                        <input type="checkbox" name="recommendation-item" value="${item.id}" ${isChecked} class="w-4 h-4 text-rose-600 bg-slate-100 border-slate-300 rounded focus:ring-rose-500">
                        <span class="text-xs font-semibold text-slate-700 dark:text-slate-350">${item.name} <span class="text-[10px] text-rose-500 font-bold">(${item.price.toFixed(2)} L.E.)</span></span>
                    </div>
                `;
            }).join('');
