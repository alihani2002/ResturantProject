@{
    Layout = null;
    ViewData["Title"] = "Qore ERP - Reports & Analytics";
}
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Google Fonts Outfit & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" href="~/assets/images/q.png">
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        outfit: ['Outfit', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#fdfbf7',
                            100: '#fbf7e6',
                            200: '#f7eec2',
                            300: '#f1df91',
                            400: '#eac85c',
                            500: '#d4af37', // primary gold
                            600: '#bd992e',
                            700: '#9e7d24',
                            800: '#7f641e',
                            900: '#68511a',
                        },
                        darkBg: '#070708', // true luxury obsidian black
                        darkCard: '#0f0f12', // rich dark grey card
                        darkBorder: '#1c1c22', // subtle border
                    }
                }
            }
        }
    </script>
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- ApexCharts CDN -->
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    
    <!-- SheetJS (xlsx) for Excel Exports -->
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    
    <!-- jsPDF & autoTable for PDF Exports -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.29/jspdf.plugin.autotable.min.js"></script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        .outfit-font {
            font-family: 'Outfit', sans-serif;
        }
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        .dark ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
    </style>
</head>
<body class="h-full bg-slate-50 text-slate-800 dark:bg-darkBg dark:text-slate-200 transition-colors duration-200 overflow-hidden flex">

    <!-- SIDEBAR -->
    <aside class="w-64 bg-white dark:bg-darkCard border-r border-slate-200 dark:border-darkBorder flex flex-col h-full z-20 transition-all duration-300 shrink-0">
        <!-- Sidebar Brand Logo -->
        <div class="h-16 flex items-center justify-between px-6 border-b border-slate-100 dark:border-darkBorder">
            <div class="flex items-center gap-3">
                <div class="p-1 rounded-xl">
                    <img src="/assets/images/Qore.png" alt="Qore" class="h-8 w-auto">
                </div>
                <div>
                    <h1 class="outfit-font font-black text-lg leading-tight tracking-wide text-slate-900 dark:text-white uppercase">QORE ERP</h1>
                    <p class="text-[10px] text-slate-400 font-semibold tracking-widest uppercase">Admin Operations</p>
                </div>
            </div>
        </div>

        <!-- Sidebar Navigation Tabs -->
        <nav class="flex-1 px-4 py-4 space-y-1 overflow-y-auto">
            <button onclick="switchTab('dashboard')" id="btn-tab-dashboard" class="w-full flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-xl transition-all duration-200 bg-brand-500 text-white shadow-md shadow-brand-500/10">
                <i class="bi bi-grid-fill text-base"></i>
                <span>All Features Map</span>
            </button>

            <button onclick="switchTab('shift-reports')" id="btn-tab-shift-reports" class="w-full flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
                <i class="bi bi-clock-history text-base text-warning"></i>
                <span>Shift Reports</span>
            </button>

            <div class="pt-4 pb-2 px-4">
                <p class="text-[10px] font-bold tracking-widest text-slate-400 dark:text-slate-500 uppercase">ERP Setup & Config</p>
            </div>

            <button onclick="switchTab('menu-mgmt')" id="btn-tab-menu-mgmt" class="w-full flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
                <i class="bi bi-journal-plus text-base text-rose-500"></i>
                <span>Add / Manage Menu</span>
            </button>

            <button onclick="switchTab('category-mgmt')" id="btn-tab-category-mgmt" class="w-full flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
                <i class="bi bi-tags text-base text-cyan-500"></i>
                <span>Add / Manage Categories</span>
            </button>

            <button onclick="switchTab('table-mgmt')" id="btn-tab-table-mgmt" class="w-full flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
                <i class="bi bi-grid text-base text-orange-500"></i>
                <span>Add / Manage Tables</span>
            </button>

            <button onclick="switchTab('waiter-assignment')" id="btn-tab-waiter-assignment" class="w-full flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
                <i class="bi bi-person-lines-fill text-base text-indigo-500"></i>
                <span>Assign Waiter Tables</span>
            </button>

            <button onclick="switchTab('settings-mgmt')" id="btn-tab-settings-mgmt" class="w-full flex items-center gap-3 px-4 py-2.5 text-sm font-medium rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">
                <i class="bi bi-sliders text-base text-emerald-500"></i>
                <span>Taxes & Service Settings</span>
            </button>
        </nav>

        <!-- Footer Operations Link -->
        <div class="p-4 border-t border-slate-100 dark:border-darkBorder bg-slate-50/50 dark:bg-darkCard space-y-2">
            <a href="/Waiter" target="_blank" class="flex items-center gap-3 px-4 py-2 text-xs font-semibold rounded-lg border border-indigo-200 dark:border-indigo-900/50 text-indigo-600 dark:text-indigo-400 hover:bg-indigo-50 dark:hover:bg-indigo-900/20 transition-all justify-center">
                <i class="bi bi-person-badge"></i>
                <span>Waiter Terminal</span>
            </a>
            <a href="/Cashier" target="_blank" class="flex items-center gap-3 px-4 py-2 text-xs font-semibold rounded-lg border border-emerald-200 dark:border-emerald-900/50 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-900/20 transition-all justify-center">
                <i class="bi bi-pc-display-horizontal"></i>
                <span>Cashier POS</span>
            </a>
            <a href="/Chef" target="_blank" class="flex items-center gap-3 px-4 py-2 text-xs font-semibold rounded-lg border border-rose-200 dark:border-rose-900/50 text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-900/20 transition-all justify-center">
                <i class="bi bi-fire"></i>
                <span>Kitchen Display</span>
            </a>
            <hr class="border-slate-200 dark:border-slate-700 my-2">
            <button onclick="switchTab('user-mgmt')" id="btn-tab-user-mgmt" class="w-full flex items-center gap-3 px-4 py-2 text-xs font-semibold rounded-lg border border-sky-200 dark:border-sky-900/50 text-sky-600 dark:text-sky-400 hover:bg-sky-50 dark:hover:bg-sky-900/20 transition-all justify-center">
                <i class="bi bi-people-fill"></i>
                <span>Manage Users & Roles</span>
            </button>
           
            <form action="/Identity/Account/Logout?returnUrl=%2F" method="post" id="logoutForm" class="w-full m-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="w-full flex items-center gap-3 px-4 py-2.5 text-xs font-bold rounded-lg bg-red-50 hover:bg-red-100 text-red-600 dark:bg-red-950/20 dark:hover:bg-red-950/30 dark:text-red-400 transition-all justify-center">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Log Out</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- MAIN APP WRAPPER -->
    <div class="flex-1 flex flex-col h-full overflow-hidden min-w-0">
        
        <!-- HEADER -->
        <header class="h-16 bg-white dark:bg-darkCard border-b border-slate-200 dark:border-darkBorder flex items-center justify-between px-8 z-10 shrink-0">
            <!-- Breadcrumbs / Active Tab Title -->
            <div class="flex items-center gap-2">
                <span class="text-slate-400 text-xs font-medium uppercase tracking-widest">QORE ERP</span>
                <span class="text-slate-300 dark:text-slate-600">/</span>
                <h2 id="active-tab-title" class="outfit-font text-slate-800 dark:text-white font-bold text-lg">Operations Hub & Features Map</h2>
            </div>

            <!-- Header Actions -->
            <div class="flex items-center gap-4">
                <!-- Dark Mode Toggle -->
                <button onclick="toggleDarkMode()" class="p-2.5 rounded-xl border border-slate-200 dark:border-darkBorder text-slate-500 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 transition-all">
                    <i id="theme-toggle-icon" class="bi bi-moon-fill text-sm"></i>
                </button>
            </div>
        </header>

        <!-- CONTAINER FOR SCROLLABLE TABS -->
        <main class="flex-1 overflow-y-auto p-8 min-h-0 space-y-8 relative">

            <!-- ============================================== -->
            <!-- TAB 0: ALL FEATURES HUB (DIRECTORY MAP)        -->
            <!-- ============================================== -->
            <div id="tab-dashboard" class="tab-content space-y-6">
               
                <!-- Features Directory Map Grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <!-- Card 1: Add / Manage Menu -->
                    <div class="bg-white dark:bg-darkCard border border-slate-200 dark:border-darkBorder p-6 rounded-2xl flex flex-col justify-between shadow-sm relative overflow-hidden group hover:border-rose-500/40 transition-all duration-300">
                        <div class="space-y-3">
                            <div class="flex items-center gap-3">
                                <div class="p-3 bg-rose-50 dark:bg-rose-950/20 text-rose-500 rounded-xl">
                                    <i class="bi bi-journal-plus text-xl"></i>
                                </div>
                                <h3 class="outfit-font text-base font-bold text-slate-900 dark:text-white">Add / Manage Menu</h3>
                            </div>
                            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">Create, edit, and archive dishes or drinks, configure their prices, popularity badges, and upload high-resolution food images to Cloudinary.</p>
                        </div>
                        <div class="mt-6">
                            <button onclick="switchTab('menu-mgmt')" class="w-full py-2.5 px-4 bg-rose-50 hover:bg-rose-100 dark:bg-rose-950/20 dark:hover:bg-rose-950/40 text-rose-500 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-1.5 border border-rose-500/10">
                                <span>Access Menu Manager</span>
                                <i class="bi bi-arrow-right-short"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Card 2: Manage Categories -->
                    <div class="bg-white dark:bg-darkCard border border-slate-200 dark:border-darkBorder p-6 rounded-2xl flex flex-col justify-between shadow-sm relative overflow-hidden group hover:border-cyan-500/40 transition-all duration-300">
                        <div class="space-y-3">
                            <div class="flex items-center gap-3">
                                <div class="p-3 bg-cyan-50 dark:bg-cyan-950/20 text-cyan-500 rounded-xl">
                                    <i class="bi bi-tags text-xl"></i>
                                </div>
                                <h3 class="outfit-font text-base font-bold text-slate-900 dark:text-white">Add / Manage Categories</h3>
                            </div>
                            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">Organize your menu items into custom food and beverage categories (e.g. Appetizers, Desserts). Set display order numbers and descriptions.</p>
                        </div>
                        <div class="mt-6">
                            <button onclick="switchTab('category-mgmt')" class="w-full py-2.5 px-4 bg-cyan-50 hover:bg-cyan-100 dark:bg-cyan-950/20 dark:hover:bg-cyan-950/40 text-cyan-500 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-1.5 border border-cyan-500/10">
                                <span>Access Category Manager</span>
                                <i class="bi bi-arrow-right-short"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Card 3: Add / Manage Tables -->
                    <div class="bg-white dark:bg-darkCard border border-slate-200 dark:border-darkBorder p-6 rounded-2xl flex flex-col justify-between shadow-sm relative overflow-hidden group hover:border-orange-500/40 transition-all duration-300">
                        <div class="space-y-3">
                            <div class="flex items-center gap-3">
                                <div class="p-3 bg-orange-50 dark:bg-orange-950/20 text-orange-500 rounded-xl">
                                    <i class="bi bi-grid text-xl"></i>
                                </div>
                                <h3 class="outfit-font text-base font-bold text-slate-900 dark:text-white">Add / Manage Tables</h3>
                            </div>
                            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">Register physical restaurant tables and instantly generate high-quality QR codes with custom branding ready to print for guest scanning.</p>
                        </div>
                        <div class="mt-6">
                            <button onclick="switchTab('table-mgmt')" class="w-full py-2.5 px-4 bg-orange-50 hover:bg-orange-100 dark:bg-orange-950/20 dark:hover:bg-orange-950/40 text-orange-500 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-1.5 border border-orange-500/10">
                                <span>Access Table Manager</span>
                                <i class="bi bi-arrow-right-short"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Card 4: Assign Waiter Tables -->
                    <div class="bg-white dark:bg-darkCard border border-slate-200 dark:border-darkBorder p-6 rounded-2xl flex flex-col justify-between shadow-sm relative overflow-hidden group hover:border-indigo-500/40 transition-all duration-300">
                        <div class="space-y-3">
                            <div class="flex items-center gap-3">
                                <div class="p-3 bg-indigo-50 dark:bg-indigo-950/20 text-indigo-500 rounded-xl">
                                    <i class="bi bi-person-lines-fill text-xl"></i>
                                </div>
                                <h3 class="outfit-font text-base font-bold text-slate-900 dark:text-white">Assign Waiter Tables</h3>
                            </div>
                            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">Map dining room tables to specific active waiter accounts. Waiters will only receive customer call and order notifications for assigned tables.</p>
                        </div>
                        <div class="mt-6">
                            <button onclick="switchTab('waiter-assignment')" class="w-full py-2.5 px-4 bg-indigo-50 hover:bg-indigo-100 dark:bg-indigo-950/20 dark:hover:bg-indigo-950/40 text-indigo-500 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-1.5 border border-indigo-500/10">
                                <span>Access Waiter Assignment</span>
                                <i class="bi bi-arrow-right-short"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Card 5: Shift Reports -->
                    <div class="bg-white dark:bg-darkCard border border-slate-200 dark:border-darkBorder p-6 rounded-2xl flex flex-col justify-between shadow-sm relative overflow-hidden group hover:border-warning/40 transition-all duration-300">
                        <div class="space-y-3">
                            <div class="flex items-center gap-3">
                                <div class="p-3 bg-brand-50 dark:bg-brand-950/20 text-brand-500 rounded-xl">
                                    <i class="bi bi-clock-history text-xl"></i>
                                </div>
                                <h3 class="outfit-font text-base font-bold text-slate-900 dark:text-white">Shift Reports</h3>
                            </div>
                            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">Review historical cashier shift logs, expected cash register totals vs actual cash input, and audit balanced, shortage, or surplus reports.</p>
                        </div>
                        <div class="mt-6">
                            <button onclick="switchTab('shift-reports')" class="w-full py-2.5 px-4 bg-brand-50 hover:bg-brand-100 dark:bg-brand-950/20 dark:hover:bg-brand-950/40 text-brand-500 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-1.5 border border-brand-500/10">
                                <span>Access Shift Reports</span>
                                <i class="bi bi-arrow-right-short"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Card 6: Manage Users & Roles -->
                    <div class="bg-white dark:bg-darkCard border border-slate-200 dark:border-darkBorder p-6 rounded-2xl flex flex-col justify-between shadow-sm relative overflow-hidden group hover:border-sky-500/40 transition-all duration-300">
                        <div class="space-y-3">
                            <div class="flex items-center gap-3">
                                <div class="p-3 bg-sky-50 dark:bg-sky-950/20 text-sky-500 rounded-xl">
                                    <i class="bi bi-people-fill text-xl"></i>
                                </div>
                                <h3 class="outfit-font text-base font-bold text-slate-900 dark:text-white">Manage Users & Roles</h3>
                            </div>
                            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">Register new staff accounts, manage security access levels, assign waiter/chef/cashier roles, and toggle account activation status.</p>
                        </div>
                        <div class="mt-6">
                            <button onclick="switchTab('user-mgmt')" class="w-full py-2.5 px-4 bg-sky-50 hover:bg-sky-100 dark:bg-sky-950/20 dark:hover:bg-sky-950/40 text-sky-500 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-1.5 border border-sky-500/10">
                                <span>Access User Manager</span>
                                <i class="bi bi-arrow-right-short"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Card 7: Taxes & Service Settings -->
                    <div class="bg-white dark:bg-darkCard border border-slate-200 dark:border-darkBorder p-6 rounded-2xl flex flex-col justify-between shadow-sm relative overflow-hidden group hover:border-emerald-500/40 transition-all duration-300 md:col-span-2 lg:col-span-3">
                        <div class="space-y-3">
                            <div class="flex items-center gap-3">
                                <div class="p-3 bg-emerald-50 dark:bg-emerald-950/20 text-emerald-500 rounded-xl">
                                    <i class="bi bi-sliders text-xl"></i>
                                </div>
                                <h3 class="outfit-font text-base font-bold text-slate-900 dark:text-white">Global Taxes & Service settings</h3>
                            </div>
                            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">Set up default VAT tax percentages and restaurant service/hall charge percentages applied dynamically to all new orders and customer billing invoices.</p>
                        </div>
                        <div class="mt-6">
                            <button onclick="switchTab('settings-mgmt')" class="w-full py-2.5 px-4 bg-emerald-50 hover:bg-emerald-100 dark:bg-emerald-950/20 dark:hover:bg-emerald-950/40 text-emerald-500 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-1.5 border border-emerald-500/10">
                                <span>Configure Global Settings</span>
                                <i class="bi bi-arrow-right-short"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ============================================== -->
            <!-- TAB 1: SALES LEDGER REPORT                     -->
            <!-- ============================================== -->
            <div id="tab-sales" class="tab-content hidden space-y-6">
                <!-- Sales KPI Summaries -->
                <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
                    <div class="bg-white dark:bg-darkCard p-4 border rounded-xl shadow-sm">
                        <p class="text-[10px] font-bold text-slate-400 uppercase">Gross Revenue</p>
                        <h4 id="sales-gross-revenue" class="outfit-font text-xl font-extrabold text-slate-800 dark:text-white">$0.00</h4>
                    </div>
                    <div class="bg-white dark:bg-darkCard p-4 border rounded-xl shadow-sm">
                        <p class="text-[10px] font-bold text-slate-400 uppercase">Net Revenue (P/L Basis)</p>
                        <h4 id="sales-net-revenue" class="outfit-font text-xl font-extrabold text-slate-800 dark:text-white">$0.00</h4>
                    </div>
                    <div class="bg-white dark:bg-darkCard p-4 border rounded-xl shadow-sm">
                        <p class="text-[10px] font-bold text-slate-400 uppercase">Taxes Collected (VAT)</p>
                        <h4 id="sales-taxes" class="outfit-font text-xl font-extrabold text-slate-800 dark:text-white">$0.00</h4>
                    </div>
                    <div class="bg-white dark:bg-darkCard p-4 border rounded-xl shadow-sm">
                        <p class="text-[10px] font-bold text-slate-400 uppercase">Average Order Value (AOV)</p>
                        <h4 id="sales-aov" class="outfit-font text-xl font-extrabold text-slate-800 dark:text-white">$0.00</h4>
                    </div>
                    <div class="bg-white dark:bg-darkCard p-4 border rounded-xl shadow-sm">
                        <p class="text-[10px] font-bold text-slate-400 uppercase">Discounts Granted</p>
                        <h4 id="sales-discounts" class="outfit-font text-xl font-extrabold text-slate-800 dark:text-white">$0.00</h4>
                    </div>
                </div>

                <!-- Daily Sales & Transaction Breakdown Ledger -->
                <div class="bg-white dark:bg-darkCard p-6 border rounded-2xl shadow-sm space-y-4">
                    <div class="flex items-center justify-between border-b pb-3 border-slate-100 dark:border-darkBorder">
                        <div>
                            <h3 class="outfit-font text-base font-bold text-slate-900 dark:text-white">Daily Operations & Sales Breakdown Ledger</h3>
                            <p class="text-xs text-slate-400 mt-0.5 font-medium">Daily business performance logs detailing transaction yields, tax provisions, and audit status</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <button onclick="exportSalesLedger('excel')" class="px-3 py-1.5 bg-emerald-600 text-white rounded-lg text-xs font-bold hover:bg-emerald-700 transition-all flex items-center gap-1">
                                <i class="bi bi-file-earmark-excel"></i> Excel
                            </button>
                            <button onclick="exportSalesLedger('pdf')" class="px-3 py-1.5 bg-red-650 text-white rounded-lg text-xs font-bold hover:bg-red-700 transition-all flex items-center gap-1">
                                <i class="bi bi-file-earmark-pdf"></i> PDF
                            </button>
                        </div>
                    </div>

                    <!-- Search / Filters toolbar -->
                    <div class="flex flex-wrap items-center gap-3 justify-between">
                        <div class="relative w-full md:w-80">
                            <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                                <i class="bi bi-search text-xs"></i>
                            </span>
                            <input type="text" id="sales-search" onkeyup="filterSalesLedger()" placeholder="Search days..." class="w-full pl-9 pr-4 py-2 border rounded-xl text-xs bg-slate-50 dark:bg-slate-900 dark:border-darkBorder focus:ring-1 focus:ring-brand-500 focus:outline-none dark:text-white">
                        </div>

