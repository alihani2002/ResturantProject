                doc.setTextColor(148, 163, 184); // slate-400
                doc.text(`Generated on: ${new Date().toLocaleString()} | Secure Audit Records`, 40, 95);
                doc.line(40, 105, 555, 105);

                let columns = [];
                let rows = [];

                // Determine table dataset based on Tab
                if (currentTab === 'sales') {
                    columns = ["Date / Period", "Total Revenue (L.E.)", "Orders Basket Count"];
                    rows = (data.salesTrend || []).map(t => [t.dateLabel, `${(t.revenue ?? 0).toFixed(2)} L.E.`, t.orderCount]);
                } else if (currentTab === 'orders') {
                    columns = ["Table", "Total Sessions", "Total Orders", "Total Spent (L.E.)", "Avg Session Duration"];
                    rows = (data.mostBusyTables || []).map(t => [`Table ${t.tableNumber}`, t.totalSessions, t.totalOrders, `${(t.totalRevenue ?? 0).toFixed(2)} L.E.`, `${Math.round(t.averageSessionDurationMinutes ?? 0)} mins`]);
                } else if (currentTab === 'products') {
                    columns = ["Product Name", "Category", "Portions Sold", "Total Revenue", "Margin Profit"];
                    rows = (data.bestSellers || []).map(p => [p.productName, p.categoryName, p.salesCount, `${(p.revenue ?? 0).toFixed(2)} L.E.`, `${(p.profit ?? 0).toFixed(2)} L.E.`]);
                } else if (currentTab === 'customers') {
                    columns = ["Customer Name", "Phone", "Orders", "Total Spent", "LTV (L.E.)", "Last Visit"];
                    rows = (data.vipList || []).map(v => [v.customerName, v.phoneNumber, v.totalOrders, `${(v.totalSpent ?? 0).toFixed(2)} L.E.`, `${(v.customerLifetimeValue ?? 0).toFixed(2)} L.E.`, new Date(v.lastVisit).toLocaleDateString()]);
                } else if (currentTab === 'staff') {
                    columns = ["Waiter Name", "Total Revenue", "Orders Handled", "Avg Speed", "Rating Score", "Badge Award"];
                    rows = (data.waiterRankings || []).map(w => [w.waiterName, `${(w.totalRevenue ?? 0).toFixed(2)} L.E.`, w.ordersHandled, `${w.averageServiceTimeMinutes} mins`, `${(w.customerRating ?? 0).toFixed(1)} / 5.0`, w.performanceBadge]);
                } else if (currentTab === 'kitchen') {
                    columns = ["MenuItem", "Average Prep Time", "Total Prepared Portions"];
                    const items = (data.fastestItems || []).concat(data.slowestItems || []);
                    rows = items.map(i => [i.itemName, `${(i.averagePrepTimeMinutes ?? 0).toFixed(1)} mins`, i.timesPrepared]);
                } else if (currentTab === 'financials') {
                    columns = ["Closing Date", "Audited By", "Expected Drawer (L.E.)", "Actual Drawer (L.E.)", "Variance (L.E.)", "Total Revenue Closed (L.E.)"];
                    rows = (data.closingReports || []).map(c => [new Date(c.date).toLocaleDateString(), c.closedBy, `${(c.expectedCash ?? 0).toFixed(2)} L.E.`, `${(c.actualCash ?? 0).toFixed(2)} L.E.`, `${(c.cashDiscrepancy ?? 0).toFixed(2)} L.E.`, `${(c.totalClosedRevenue ?? 0).toFixed(2)} L.E.`]);
                } else if (currentTab === 'inventory') {
                    columns = ["Critical Ingredient", "Stock", "Reorder Level", "Unit", "Supplier Partner", "Status Alert"];
                    rows = (data.lowStockAlerts || []).map(i => [i.ingredientName, i.currentStock, i.reorderLevel, i.unit, i.supplierName, i.stockStatus]);
                } else {
                    columns = ["KPI Metric", "Value"];
                    rows = [
                        ["Today Live Revenue", `${(data.totalRevenueToday ?? 0).toFixed(2)} L.E.`],
                        ["Active Tables", data.activeTablesCount ?? 0],
                        ["Active QR Sessions", data.activeSessionsTodayCount ?? 0],
                        ["Pending Orders queue", data.pendingOrdersCount ?? 0]
                    ];
                }

                // Render Table PDF
                doc.autoTable({
                    head: [columns],
                    body: rows,
                    startY: 120,
                    theme: 'striped',
                    headStyles: { fillColor: [217, 119, 6], textColor: [255, 255, 255] }, // Amber-600 headers
                    styles: { fontSize: 8 },
                    margin: { left: 40, right: 40 }
                });

                doc.save(`${filename}.pdf`);
                showToastAlert("PDF file exported successfully.", "success");
            } catch (e) {
                console.error(e);
                showToastAlert("Failed to export PDF.", "error");
            }
        }

