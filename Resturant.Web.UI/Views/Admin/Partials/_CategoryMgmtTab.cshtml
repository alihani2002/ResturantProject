            <div id="tab-category-mgmt" class="tab-content hidden space-y-6" dir="rtl">
                <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
                    <!-- Left: Add Form -->
                    <div class="bg-white dark:bg-darkCard p-6 border border-slate-200 dark:border-darkBorder rounded-2xl shadow-sm space-y-4">
                        <h3 class="outfit-font text-base font-bold text-slate-800 dark:text-white flex items-center gap-2">
                            <i class="bi bi-plus-circle text-cyan-500"></i> إضافة قسم جديد
                        </h3>
                        <form id="form-add-category" onsubmit="submitCategory(event)" class="space-y-4">
                            <div class="grid grid-cols-3 gap-4">
                                <div class="col-span-2">
                                    <label class="block text-xs font-bold text-slate-400 dark:text-slate-500 uppercase mb-1">اسم القسم</label>
                                    <input type="text" id="cat-name" required class="w-full bg-slate-50 dark:bg-slate-800/50 border border-slate-200/40 dark:border-darkBorder rounded-xl px-4 py-2.5 text-sm text-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-cyan-500 transition-all" placeholder="مثال: حلويات، مقبلات...">
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-slate-400 dark:text-slate-500 uppercase mb-1">الترتيب</label>
                                    <input type="number" id="cat-order-number" required class="w-full bg-slate-50 dark:bg-slate-800/50 border border-slate-200/40 dark:border-darkBorder rounded-xl px-4 py-2.5 text-sm text-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-cyan-500 transition-all" value="0" min="0">
                                </div>
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-400 dark:text-slate-500 uppercase mb-1">الوصف (اختياري)</label>
                                <textarea id="cat-desc" rows="2" class="w-full bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-darkBorder rounded-xl px-4 py-2.5 text-sm text-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-cyan-500 transition-all" placeholder="تفاصيل أو وصف القسم..."></textarea>
                            </div>
                            <div class="flex items-center gap-2 mt-1">
                                <input type="checkbox" id="cat-active" checked class="w-4 h-4 text-cyan-600 bg-slate-100 border-slate-300 rounded focus:ring-cyan-500">
                                <label class="text-xs font-bold text-slate-700 dark:text-slate-300 uppercase">نشط</label>
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-400 dark:text-slate-500 uppercase mb-1">صورة القسم</label>
                                <input type="file" id="cat-image" accept="image/*" class="w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-cyan-50 file:text-cyan-700 hover:file:bg-cyan-100 cursor-pointer">
                            </div>
                            <button type="submit" class="w-full py-3 rounded-xl bg-cyan-500 hover:bg-cyan-600 text-white font-semibold text-sm transition-all shadow-md shadow-cyan-500/10">إضافة القسم</button>
                        </form>
                    </div>

                    <!-- Right: List Table -->
                    <div class="xl:col-span-2 bg-white dark:bg-darkCard p-6 border border-slate-200 dark:border-darkBorder rounded-2xl shadow-sm space-y-4">
                        <h3 class="outfit-font text-base font-bold text-slate-800 dark:text-white flex items-center gap-2">
                            <i class="bi bi-list-check text-cyan-500"></i> قائمة أقسام المنيو
                        </h3>
                        <div class="overflow-x-auto">
                            <table id="table-cat-list" class="w-full text-right border-collapse text-xs">
                                <thead>
                                    <tr class="border-b border-slate-100 dark:border-darkBorder text-slate-400 font-bold uppercase">
                                        <th class="py-3">اسم القسم</th>
                                        <th class="py-3">الترتيب</th>
                                        <th class="py-3">الصورة</th>
                                        <th class="py-3 text-left">الإجراءات</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100 dark:divide-darkBorder">
                                    <!-- Dynamic -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
