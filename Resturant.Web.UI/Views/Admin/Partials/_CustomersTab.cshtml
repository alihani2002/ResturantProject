            <div id="tab-customers" class="tab-content hidden space-y-6" dir="rtl">
                <!-- Customer CRM KPIs -->
                <div class="grid grid-cols-1 md:grid-cols-4 gap-6 text-right">
                    <div class="bg-white dark:bg-darkCard p-5 border border-slate-200 dark:border-darkBorder rounded-2xl shadow-sm relative overflow-hidden group">
                        <p class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">جلسات العملاء الجدد</p>
                        <h4 id="customer-new-count" class="outfit-font text-2xl font-black text-slate-800 dark:text-white mt-1">0</h4>
                        <span class="text-[10px] text-slate-400">أول عمليات مسح (زيارة أولى) خلال الفترة</span>
                    </div>
                    <div class="bg-white dark:bg-darkCard p-5 border border-slate-200 dark:border-darkBorder rounded-2xl shadow-sm relative overflow-hidden group">
                        <p class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">العملاء الدائمين</p>
                        <h4 id="customer-return-count" class="outfit-font text-2xl font-black text-slate-800 dark:text-white mt-1">0</h4>
                        <span class="text-[10px] text-slate-400">معدل تكرار الزيارات للعملاء</span>
                    </div>
                    <div class="bg-white dark:bg-darkCard p-5 border border-slate-200 dark:border-darkBorder rounded-2xl shadow-sm relative overflow-hidden group">
                        <p class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">نسبة الاحتفاظ بالعملاء</p>
                        <h4 id="customer-retention-rate" class="outfit-font text-2xl font-black text-slate-800 dark:text-white mt-1">0%</h4>
                        <span class="text-[10px] text-brand-500 font-semibold">مؤشر ولاء العملاء ممتاز</span>
                    </div>
                    <div class="bg-white dark:bg-darkCard p-5 border border-slate-200 dark:border-darkBorder rounded-2xl shadow-sm relative overflow-hidden group">
                        <p class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">متوسط الإنفاق في الجلسة</p>
                        <h4 id="customer-avg-spend" class="outfit-font text-2xl font-black text-slate-800 dark:text-white mt-1">0.00 ج.م</h4>
                        <span class="text-[10px] text-slate-400">متوسط إجمالي السلة المحسوب</span>
                    </div>
                </div>

                <!-- Professional CRM Guest Directory Database Ledger -->
                <div class="bg-white dark:bg-darkCard p-6 border border-slate-200 dark:border-darkBorder rounded-2xl shadow-sm space-y-4 text-right">
                    <div class="flex items-center justify-between border-b pb-3 border-slate-100 dark:border-darkBorder">
                        <div>
                            <h3 class="outfit-font text-base font-bold text-slate-900 dark:text-white">دليل ملفات الزوار وقاعدة بيانات العملاء</h3>
                            <p class="text-xs text-slate-400 mt-0.5 font-medium">البحث والتصفية وتحليل عادات الطلب والقيمة الإجمالية لحسابات جميع الزوار</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <button onclick="exportGuestCRM('excel')" class="px-3 py-1.5 bg-emerald-600 text-white rounded-lg text-xs font-bold hover:bg-emerald-700 transition-all flex items-center gap-1">
                                <i class="bi bi-file-earmark-excel"></i> تصدير إكسل
                            </button>
                            @* <button onclick="exportGuestCRM('pdf')" class="px-3 py-1.5 bg-red-650 text-white rounded-lg text-xs font-bold hover:bg-red-700 transition-all flex items-center gap-1">
                                <i class="bi bi-file-earmark-pdf"></i> تصدير PDF
                            </button> *@
                        </div>
                    </div>

                    <!-- Filter / Search toolbar -->
                    <div class="flex flex-wrap items-center gap-3 justify-between">
                        <div class="relative w-full md:w-80">
                            <span class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-slate-400">
                                <i class="bi bi-search text-xs"></i>
                            </span>
                            <input type="text" id="crm-search" onkeyup="filterCRMDirectory()" placeholder="البحث عن عميل بالاسم، الهاتف، أو البريد..." class="w-full pr-9 pl-4 py-2 border rounded-xl text-xs bg-slate-50 dark:bg-slate-900 border-slate-200 dark:border-darkBorder focus:ring-1 focus:ring-brand-500 focus:outline-none dark:text-white text-right">
                        </div>

                        <div class="flex flex-wrap items-center gap-2">
                            <select id="crm-filter-loyalty" onchange="filterCRMDirectory()" class="px-3 py-2 border rounded-xl text-xs bg-slate-50 dark:bg-slate-900 border-slate-200 dark:border-darkBorder focus:outline-none dark:text-white">
                                <option value="">جميع فئات الولاء</option>
                                <option value="Elite VIP">نخبة العملاء VIP (أكثر من 1500 ج.م)</option>
                                <option value="Frequent Buyer">مشتري متكرر (5 طلبات فأكثر)</option>
                                <option value="Standard Loyalty">ولاء قياسي</option>
                            </select>

                            <select id="crm-filter-status" onchange="filterCRMDirectory()" class="px-3 py-2 border rounded-xl text-xs bg-slate-50 dark:bg-slate-900 border-slate-200 dark:border-darkBorder focus:outline-none dark:text-white">
                                <option value="">جميع الحالات</option>
                                <option value="Active">نشط</option>
                                <option value="Inactive">غير نشط</option>
                            </select>
                        </div>
                    </div>

                    <!-- Responsive CRM Data Table -->
                    <div class="overflow-x-auto">
                        <table id="table-vip-customers" class="w-full text-right border-collapse text-xs">
                            <thead>
                                <tr class="border-b border-slate-100 dark:border-darkBorder text-slate-400 dark:text-slate-500 font-bold uppercase tracking-wider text-[10px]">
                                    <th class="py-3 cursor-pointer select-none text-right" onclick="sortCRMDirectory('customerName')">اسم العميل <i class="bi bi-arrow-down-up ml-0.5 text-[8px]"></i></th>
                                    <th class="py-3 cursor-pointer select-none text-right" onclick="sortCRMDirectory('phoneNumber')">الهاتف / البريد الإلكتروني <i class="bi bi-arrow-down-up ml-0.5 text-[8px]"></i></th>
                                    <th class="py-3 cursor-pointer select-none text-center" onclick="sortCRMDirectory('totalOrders')">الطلبات <i class="bi bi-arrow-down-up ml-0.5 text-[8px]"></i></th>
                                    <th class="py-3 cursor-pointer select-none text-left" onclick="sortCRMDirectory('totalSpent')">إجمالي الإنفاق <i class="bi bi-arrow-down-up ml-0.5 text-[8px]"></i></th>
                                    <th class="py-3 cursor-pointer select-none text-left" onclick="sortCRMDirectory('customerLifetimeValue')">القيمة المتوقعة (CLV) <i class="bi bi-arrow-down-up ml-0.5 text-[8px]"></i></th>
                                    <th class="py-3 text-right">الفئة</th>
                                    <th class="py-3 text-left">الإجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Dynamic Guest rows populated here -->
                            </tbody>
                        </table>
                    </div>

                    <!-- CRM Table Pagination -->
                    <div class="flex items-center justify-between border-t pt-4 border-slate-100 dark:border-darkBorder text-xs text-slate-400">
                        <span id="crm-pagination-info">عرض 0 إلى 0 من 0 عميل</span>
                        <div class="flex items-center gap-1.5" dir="ltr">
                            <button onclick="paginateCRM('prev')" class="px-3 py-1.5 border dark:border-darkBorder rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800 disabled:opacity-50 font-semibold">السابق</button>
                            <button onclick="paginateCRM('next')" class="px-3 py-1.5 border dark:border-darkBorder rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800 disabled:opacity-50 font-semibold">التالي</button>
                        </div>
                    </div>
                </div>
            </div>
