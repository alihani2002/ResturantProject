                <div><label class="block text-xs font-bold text-slate-500 mb-2">Priority *</label><input id="price-priority" required type="number" min="0" step="1" value="100" class="w-full px-4 py-2.5 rounded-xl border dark:border-darkBorder bg-slate-50 dark:bg-slate-900 text-xs dark:text-white"></div>
