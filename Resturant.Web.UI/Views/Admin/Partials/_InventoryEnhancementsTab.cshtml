            <div><label class="block text-xs font-bold text-slate-500 mb-2">Notes</label><textarea id="po-notes" rows="2" maxlength="500" class="w-full px-4 py-2.5 rounded-xl border dark:border-darkBorder bg-slate-50 dark:bg-slate-900 text-xs dark:text-white"></textarea></div>
            <div class="flex justify-end gap-2 pt-2"><button type="button" onclick="closeModal('purchase-order-modal')" class="px-4 py-2 rounded-xl border dark:border-darkBorder text-xs font-bold">Cancel</button><button type="submit" class="px-5 py-2 rounded-xl bg-brand-500 text-white text-xs font-bold">Save Purchase Order</button></div>
        </form>
    </div>
</div>

<!-- WASTE MODAL -->
<div id="waste-modal" class="fixed inset-0 bg-slate-900/60 dark:bg-black/80 backdrop-blur-[4px] z-50 hidden opacity-0 transition-opacity duration-300 flex items-center justify-center">
    <div id="waste-modal-content" class="bg-white dark:bg-darkCard rounded-2xl max-w-lg w-full mx-4 p-6 shadow-2xl border border-slate-100 dark:border-darkBorder scale-95 transition-transform duration-300">
        <div class="flex justify-between items-start border-b border-slate-100 dark:border-darkBorder pb-3 mb-5">
            <button onclick="closeModal('waste-modal')" class="p-1.5 rounded-xl border border-slate-200 dark:border-darkBorder text-slate-500"><i class="bi bi-x text-lg"></i></button>
            <div class="text-right"><span class="text-[10px] font-black text-red-500 uppercase">Waste</span><h3 class="text-lg font-black text-slate-900 dark:text-white">Record Waste</h3></div>
        </div>
        <form id="form-waste" onsubmit="submitWasteForm(event)" class="space-y-4" dir="rtl">
            <div><label class="block text-xs font-bold text-slate-500 mb-2">Ingredient *</label><select id="waste-ingredient" required onchange="syncWasteUnit()" class="w-full px-4 py-2.5 rounded-xl border dark:border-darkBorder bg-slate-50 dark:bg-slate-900 text-xs dark:text-white"></select></div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <div><label class="block text-xs font-bold text-slate-500 mb-2">Quantity *</label><input id="waste-quantity" required type="number" min="0.001" step="0.001" class="w-full px-4 py-2.5 rounded-xl border dark:border-darkBorder bg-slate-50 dark:bg-slate-900 text-xs dark:text-white"></div>
                <div><label class="block text-xs font-bold text-slate-500 mb-2">Unit</label><select id="waste-unit" class="w-full px-4 py-2.5 rounded-xl border dark:border-darkBorder bg-slate-50 dark:bg-slate-900 text-xs dark:text-white"><option>Kg</option><option>Grams</option><option>Ltr</option><option>Pcs</option><option>Box</option></select></div>
            </div>
            <div><label class="block text-xs font-bold text-slate-500 mb-2">Reason *</label><select id="waste-reason" required class="w-full px-4 py-2.5 rounded-xl border dark:border-darkBorder bg-slate-50 dark:bg-slate-900 text-xs dark:text-white"><option value="Expired">Expired</option><option value="Damage">Damaged</option><option value="Spoiled">Spoiled</option><option value="Lost">Lost</option><option value="CustomerReturn">Customer Return</option></select></div>
            <div><label class="block text-xs font-bold text-slate-500 mb-2">Date and time</label><input id="waste-date-time" type="datetime-local" class="w-full px-4 py-2.5 rounded-xl border dark:border-darkBorder bg-slate-50 dark:bg-slate-900 text-xs dark:text-white"></div>
            <div><label class="block text-xs font-bold text-slate-500 mb-2">Notes</label><textarea id="waste-notes" rows="3" maxlength="500" class="w-full px-4 py-2.5 rounded-xl border dark:border-darkBorder bg-slate-50 dark:bg-slate-900 text-xs dark:text-white"></textarea></div>
            <div class="flex justify-end gap-2 pt-2"><button type="button" onclick="closeModal('waste-modal')" class="px-4 py-2 rounded-xl border dark:border-darkBorder text-xs font-bold">Cancel</button><button type="submit" class="px-5 py-2 rounded-xl bg-red-500 text-white text-xs font-bold">Save Waste</button></div>
        </form>
    </div>
</div>

