                <div class="md:col-span-2"><label class="block text-xs font-bold text-slate-500 mb-2">المورد *</label><select id="po-supplier" required class="w-full px-4 py-2.5 rounded-xl border dark:border-darkBorder bg-slate-50 dark:bg-slate-900 text-xs dark:text-white text-right"></select></div>
                <div><label class="block text-xs font-bold text-slate-500 mb-2">تاريخ التسليم المتوقع</label><input id="po-expected-date" type="date" class="w-full px-4 py-2.5 rounded-xl border dark:border-darkBorder bg-slate-50 dark:bg-slate-900 text-xs dark:text-white text-right"></div>
            </div>
            <div class="rounded-xl border dark:border-darkBorder overflow-hidden">
                <table class="w-full text-xs text-right"><thead class="bg-slate-50 dark:bg-slate-900 text-slate-400"><tr><th class="p-3">المادة الخام</th><th>الكمية</th><th>تكلفة الوحدة</th><th>الإجمالي</th><th></th></tr></thead><tbody id="po-items-body"></tbody></table>
            </div>
            <div class="flex justify-between items-center">
                <button type="button" onclick="addPurchaseOrderItemRow()" class="px-3 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-xs font-bold"><i class="bi bi-plus-lg"></i> إضافة مادة خام</button>
                <div class="text-sm font-black text-slate-900 dark:text-white">الإجمالي: <span id="po-total">0.00</span> ج.م</div>
            </div>
            <div><label class="block text-xs font-bold text-slate-500 mb-2">ملاحظات</label><textarea id="po-notes" rows="2" maxlength="500" class="w-full px-4 py-2.5 rounded-xl border dark:border-darkBorder bg-slate-50 dark:bg-slate-900 text-xs dark:text-white text-right"></textarea></div>
            <div class="flex justify-end gap-2 pt-2"><button type="button" onclick="closeModal('purchase-order-modal')" class="px-4 py-2 rounded-xl border dark:border-darkBorder text-xs font-bold">إلغاء</button><button type="submit" class="px-5 py-2 rounded-xl bg-brand-500 text-white text-xs font-bold">حفظ طلب الشراء</button></div>
        </form>
    </div>
</div>

<!-- WASTE MODAL -->
<div id="waste-modal" class="fixed inset-0 bg-slate-900/60 dark:bg-black/80 backdrop-blur-[4px] z-50 hidden opacity-0 transition-opacity duration-300 flex items-center justify-center">
    <div id="waste-modal-content" class="bg-white dark:bg-darkCard rounded-2xl max-w-lg w-full mx-4 p-6 shadow-2xl border border-slate-100 dark:border-darkBorder scale-95 transition-transform duration-300">
        <div class="flex justify-between items-start border-b border-slate-100 dark:border-darkBorder pb-3 mb-5">
            <button onclick="closeModal('waste-modal')" class="p-1.5 rounded-xl border border-slate-200 dark:border-darkBorder text-slate-500"><i class="bi bi-x text-lg"></i></button>
            <div class="text-right"><span class="text-[10px] font-black text-red-500 uppercase">التالف والهالك</span><h3 class="text-lg font-black text-slate-900 dark:text-white">تسجيل تالف / هالك</h3></div>
        </div>
        <form id="form-waste" onsubmit="submitWasteForm(event)" class="space-y-4" dir="rtl">
            <div><label class="block text-xs font-bold text-slate-500 mb-2">المادة الخام *</label><select id="waste-ingredient" required onchange="syncWasteUnit()" class="w-full px-4 py-2.5 rounded-xl border dark:border-darkBorder bg-slate-50 dark:bg-slate-900 text-xs dark:text-white text-right"></select></div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <div><label class="block text-xs font-bold text-slate-500 mb-2">الكمية *</label><input id="waste-quantity" required type="number" min="0.001" step="0.001" class="w-full px-4 py-2.5 rounded-xl border dark:border-darkBorder bg-slate-50 dark:bg-slate-900 text-xs dark:text-white text-right"></div>
                <div><label class="block text-xs font-bold text-slate-500 mb-2">الوحدة</label><select id="waste-unit" class="w-full px-4 py-2.5 rounded-xl border dark:border-darkBorder bg-slate-50 dark:bg-slate-900 text-xs dark:text-white text-right"><option value="Kg">كجم</option><option value="Grams">جرام</option><option value="Ltr">لتر</option><option value="Pcs">قطعة</option><option value="Box">صندوق</option></select></div>
            </div>
            <div><label class="block text-xs font-bold text-slate-500 mb-2">السبب *</label><select id="waste-reason" required class="w-full px-4 py-2.5 rounded-xl border dark:border-darkBorder bg-slate-50 dark:bg-slate-900 text-xs dark:text-white text-right"><option value="Expired">منتهي الصلاحية</option><option value="Damage">ضرر/كسر</option><option value="Spoiled">تالف/فاسد</option><option value="Lost">مفقود/عجز</option><option value="CustomerReturn">مرتجع عميل</option></select></div>
            <div><label class="block text-xs font-bold text-slate-500 mb-2">التاريخ والوقت</label><input id="waste-date-time" type="datetime-local" class="w-full px-4 py-2.5 rounded-xl border dark:border-darkBorder bg-slate-50 dark:bg-slate-900 text-xs dark:text-white text-right"></div>
            <div><label class="block text-xs font-bold text-slate-500 mb-2">ملاحظات</label><textarea id="waste-notes" rows="3" maxlength="500" class="w-full px-4 py-2.5 rounded-xl border dark:border-darkBorder bg-slate-50 dark:bg-slate-900 text-xs dark:text-white text-right"></textarea></div>
            <div class="flex justify-end gap-2 pt-2"><button type="button" onclick="closeModal('waste-modal')" class="px-4 py-2 rounded-xl border dark:border-darkBorder text-xs font-bold">إلغاء</button><button type="submit" class="px-5 py-2 rounded-xl bg-red-500 text-white text-xs font-bold">حفظ التعديلات</button></div>
        </form>
    </div>
</div>

<!-- PRODUCT PRICE MODAL -->
<div id="product-price-modal" class="fixed inset-0 bg-slate-900/60 dark:bg-black/80 backdrop-blur-[4px] z-50 hidden opacity-0 transition-opacity duration-300 flex items-center justify-center">
    <div id="product-price-modal-content" class="bg-white dark:bg-darkCard rounded-2xl max-w-lg w-full mx-4 p-6 shadow-2xl border border-slate-100 dark:border-darkBorder scale-95 transition-transform duration-300">
        <div class="flex justify-between items-start border-b border-slate-100 dark:border-darkBorder pb-3 mb-5">
            <button onclick="closeModal('product-price-modal')" class="p-1.5 rounded-xl border border-slate-200 dark:border-darkBorder text-slate-500"><i class="bi bi-x text-lg"></i></button>
            <div class="text-right"><span class="text-[10px] font-black text-indigo-500 uppercase">قوائم الأسعار</span><h3 id="price-modal-title" class="text-lg font-black text-slate-900 dark:text-white">إضافة سعر صنف</h3></div>
        </div>
        <form id="form-product-price" onsubmit="submitProductPriceForm(event)" class="space-y-4" dir="rtl">
            <input type="hidden" id="price-id">
            <div><label class="block text-xs font-bold text-slate-500 mb-2">اسم نوع السعر *</label><input id="price-type" required maxlength="50" class="w-full px-4 py-2.5 rounded-xl border dark:border-darkBorder bg-slate-50 dark:bg-slate-900 text-xs dark:text-white text-right" placeholder="retail، صالة، سفري، دليفري..."></div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <div><label class="block text-xs font-bold text-slate-500 mb-2">السعر *</label><input id="price-value" required type="number" min="0.01" step="0.01" class="w-full px-4 py-2.5 rounded-xl border dark:border-darkBorder bg-slate-50 dark:bg-slate-900 text-xs dark:text-white text-right"></div>
                <div><label class="block text-xs font-bold text-slate-500 mb-2">الأولوية *</label><input id="price-priority" required type="number" min="0" step="1" value="100" class="w-full px-4 py-2.5 rounded-xl border dark:border-darkBorder bg-slate-50 dark:bg-slate-900 text-xs dark:text-white text-right"></div>
            </div>
            <div><label class="block text-xs font-bold text-slate-500 mb-2">الفرع</label><select id="price-branch" class="w-full px-4 py-2.5 rounded-xl border dark:border-darkBorder bg-slate-50 dark:bg-slate-900 text-xs dark:text-white text-right"><option value="">كل الفروع</option></select></div>
            <div><label class="block text-xs font-bold text-slate-500 mb-2">الوصف</label><textarea id="price-description" rows="3" maxlength="100" class="w-full px-4 py-2.5 rounded-xl border dark:border-darkBorder bg-slate-50 dark:bg-slate-900 text-xs dark:text-white text-right"></textarea></div>
            <label class="flex items-center gap-2 text-xs font-bold text-slate-500"><input id="price-allow-override" type="checkbox" checked class="rounded"> السماح للمخولين بتعديل السعر أثناء الطلب</label>
            <div class="flex justify-end gap-2 pt-2"><button type="button" onclick="closeModal('product-price-modal')" class="px-4 py-2 rounded-xl border dark:border-darkBorder text-xs font-bold">إلغاء</button><button type="submit" class="px-5 py-2 rounded-xl bg-indigo-500 text-white text-xs font-bold">حفظ السعر</button></div>
        </form>
    </div>
</div>

<!-- CONFIRM MODAL -->
<div id="confirm-modal" class="fixed inset-0 bg-slate-900/60 dark:bg-black/80 backdrop-blur-[4px] z-50 hidden opacity-0 transition-opacity duration-300 flex items-center justify-center">
    <div id="confirm-modal-content" class="bg-white dark:bg-darkCard rounded-2xl max-w-sm w-full mx-4 p-6 shadow-2xl border border-slate-100 dark:border-darkBorder scale-95 transition-transform duration-300 text-right" dir="rtl">
        <h3 id="confirm-title" class="text-base font-black text-slate-900 dark:text-white mb-2">تأكيد الإجراء</h3>
        <p id="confirm-message" class="text-xs text-slate-500 mb-5">هل أنت متأكد من رغبتك في الاستمرار؟</p>
        <div class="flex justify-end gap-2"><button type="button" onclick="closeModal('confirm-modal')" class="px-4 py-2 rounded-xl border dark:border-darkBorder text-xs font-bold">إلغاء</button><button id="confirm-action-btn" type="button" class="px-5 py-2 rounded-xl bg-red-500 text-white text-xs font-bold">حذف</button></div>
    </div>
</div>
