<!-- SUPPLIER MODAL -->
<div id="supplier-modal" class="fixed inset-0 bg-slate-900/60 dark:bg-black/80 backdrop-blur-[4px] z-50 hidden opacity-0 transition-opacity duration-300 flex items-center justify-center">
    <div id="supplier-modal-content" class="bg-white dark:bg-darkCard rounded-2xl max-w-lg w-full mx-4 p-6 shadow-2xl border border-slate-100 dark:border-darkBorder scale-95 transition-transform duration-300">
        <div class="flex justify-between items-start border-b border-slate-100 dark:border-darkBorder pb-3 mb-5">
            <button onclick="closeModal('supplier-modal')" class="p-1.5 rounded-xl border border-slate-200 dark:border-darkBorder text-slate-500"><i class="bi bi-x text-lg"></i></button>
            <div class="text-right"><span class="text-[10px] font-black text-sky-500 uppercase">الموردين</span><h3 class="text-lg font-black text-slate-900 dark:text-white">تفاصيل المورد</h3></div>
        </div>
        <form id="form-supplier" onsubmit="submitSupplierForm(event)" class="space-y-4" dir="rtl">
            <input type="hidden" id="supplier-id">
            <div><label class="block text-xs font-bold text-slate-500 mb-2">اسم المورد *</label><input id="supplier-name" required maxlength="100" class="w-full px-4 py-2.5 rounded-xl border dark:border-darkBorder bg-slate-50 dark:bg-slate-900 text-xs dark:text-white text-right"></div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <div><label class="block text-xs font-bold text-slate-500 mb-2">الشخص المسؤول</label><input id="supplier-contact" maxlength="100" class="w-full px-4 py-2.5 rounded-xl border dark:border-darkBorder bg-slate-50 dark:bg-slate-900 text-xs dark:text-white text-right"></div>
                <div><label class="block text-xs font-bold text-slate-500 mb-2">رقم الهاتف</label><input id="supplier-phone" maxlength="20" class="w-full px-4 py-2.5 rounded-xl border dark:border-darkBorder bg-slate-50 dark:bg-slate-900 text-xs dark:text-white text-right"></div>
            </div>
            <div><label class="block text-xs font-bold text-slate-500 mb-2">البريد الإلكتروني</label><input id="supplier-email" type="email" maxlength="100" class="w-full px-4 py-2.5 rounded-xl border dark:border-darkBorder bg-slate-50 dark:bg-slate-900 text-xs dark:text-white text-right"></div>
            <div><label class="block text-xs font-bold text-slate-500 mb-2">العنوان</label><input id="supplier-address" maxlength="160" class="w-full px-4 py-2.5 rounded-xl border dark:border-darkBorder bg-slate-50 dark:bg-slate-900 text-xs dark:text-white text-right"></div>
            <div><label class="block text-xs font-bold text-slate-500 mb-2">ملاحظات</label><textarea id="supplier-notes" rows="3" maxlength="300" class="w-full px-4 py-2.5 rounded-xl border dark:border-darkBorder bg-slate-50 dark:bg-slate-900 text-xs dark:text-white text-right"></textarea></div>
            <div class="flex justify-end gap-2 pt-2"><button type="button" onclick="closeModal('supplier-modal')" class="px-4 py-2 rounded-xl border dark:border-darkBorder text-xs font-bold">إلغاء</button><button type="submit" class="px-5 py-2 rounded-xl bg-brand-500 text-white text-xs font-bold">حفظ المورد</button></div>
        </form>
    </div>
</div>

<!-- PURCHASE ORDER MODAL -->
<div id="purchase-order-modal" class="fixed inset-0 bg-slate-900/60 dark:bg-black/80 backdrop-blur-[4px] z-50 hidden opacity-0 transition-opacity duration-300 flex items-center justify-center">
    <div id="purchase-order-modal-content" class="bg-white dark:bg-darkCard rounded-2xl max-w-4xl w-full mx-4 p-6 shadow-2xl border border-slate-100 dark:border-darkBorder scale-95 transition-transform duration-300">
        <div class="flex justify-between items-start border-b border-slate-100 dark:border-darkBorder pb-3 mb-5">
            <button onclick="closeModal('purchase-order-modal')" class="p-1.5 rounded-xl border border-slate-200 dark:border-darkBorder text-slate-500"><i class="bi bi-x text-lg"></i></button>
            <div class="text-right"><span class="text-[10px] font-black text-brand-500 uppercase">طلب الشراء والتوريد</span><h3 class="text-lg font-black text-slate-900 dark:text-white">إنشاء طلب شراء وتوريد</h3></div>
        </div>
        <form id="form-purchase-order" onsubmit="submitPurchaseOrderForm(event)" class="space-y-4" dir="rtl">
