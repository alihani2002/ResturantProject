            <div class="rounded-xl border dark:border-darkBorder overflow-hidden">
                <table class="w-full text-xs text-right"><thead class="bg-slate-50 dark:bg-slate-900 text-slate-400"><tr><th class="p-3">Ingredient</th><th>Quantity</th><th>Unit cost</th><th>Total</th><th></th></tr></thead><tbody id="po-items-body"></tbody></table>
            </div>
            <div class="flex justify-between items-center">
                <button type="button" onclick="addPurchaseOrderItemRow()" class="px-3 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-xs font-bold"><i class="bi bi-plus-lg"></i> Add item</button>
