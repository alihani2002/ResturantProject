                        <h4 id="sales-taxes" class="outfit-font text-xl font-extrabold text-slate-800 dark:text-white">0.00 ج.م</h4>
                    </div>
                    <div class="bg-white dark:bg-darkCard p-4 border border-slate-200 dark:border-darkBorder rounded-xl shadow-sm">
                        <p class="text-[10px] font-bold text-slate-400 uppercase">متوسط قيمة الطلب (AOV)</p>
                        <h4 id="sales-aov" class="outfit-font text-xl font-extrabold text-slate-800 dark:text-white">0.00 ج.م</h4>
                    </div>
                    <div class="bg-white dark:bg-darkCard p-4 border border-slate-200 dark:border-darkBorder rounded-xl shadow-sm">
                        <p class="text-[10px] font-bold text-slate-400 uppercase">الخصومات الممنوحة</p>
                        <h4 id="sales-discounts" class="outfit-font text-xl font-extrabold text-slate-800 dark:text-white">0.00 ج.م</h4>
