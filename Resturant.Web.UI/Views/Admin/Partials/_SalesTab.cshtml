                                    <th class="py-3 cursor-pointer select-none text-right" onclick="sortSalesLedger('dateString')">تاريخ العمل <i class="bi bi-arrow-down-up ml-0.5 text-[8px]"></i></th>
                                    <th class="py-3 cursor-pointer select-none text-center" onclick="sortSalesLedger('totalOrders')">إجمالي الطلبات <i class="bi bi-arrow-down-up ml-0.5 text-[8px]"></i></th>
                                    <th class="py-3 cursor-pointer select-none text-center" onclick="sortSalesLedger('completedOrders')">المكتملة <i class="bi bi-arrow-down-up ml-0.5 text-[8px]"></i></th>
                                    <th class="py-3 cursor-pointer select-none text-center" onclick="sortSalesLedger('cancelledOrders')">الملغاة <i class="bi bi-arrow-down-up ml-0.5 text-[8px]"></i></th>
                                    <th class="py-3 cursor-pointer select-none text-left" onclick="sortSalesLedger('discounts')">الخصومات <i class="bi bi-arrow-down-up ml-0.5 text-[8px]"></i></th>
                                    <th class="py-3 cursor-pointer select-none text-left" onclick="sortSalesLedger('taxes')">الضرائب (ضريبة القيمة المضافة) <i class="bi bi-arrow-down-up ml-0.5 text-[8px]"></i></th>
                                    <th class="py-3 cursor-pointer select-none text-left" onclick="sortSalesLedger('netRevenue')">صافي الإيراد <i class="bi bi-arrow-down-up ml-0.5 text-[8px]"></i></th>
                                    <th class="py-3 text-right">الحالة</th>
                                    <th class="py-3 text-left">الإجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Loaded dynamically in JS -->
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="flex items-center justify-between border-t pt-4 border-slate-100 dark:border-darkBorder text-xs text-slate-400">
                        <span id="sales-pagination-info">عرض 0 إلى 0 من 0 يوم</span>
                        <div class="flex items-center gap-1.5" dir="ltr">
                            <button onclick="paginateSales('prev')" class="px-3 py-1.5 border dark:border-darkBorder rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800 disabled:opacity-50 font-semibold">السابق</button>
                            <button onclick="paginateSales('next')" class="px-3 py-1.5 border dark:border-darkBorder rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800 disabled:opacity-50 font-semibold">التالي</button>
                        </div>
                    </div>
