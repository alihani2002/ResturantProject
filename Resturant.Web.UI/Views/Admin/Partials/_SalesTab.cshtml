            <div id="tab-sales" class="tab-content hidden space-y-6">
                <!-- Sales KPI Summaries -->
                <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
                    <div class="bg-white dark:bg-darkCard p-4 border rounded-xl shadow-sm">
                        <p class="text-[10px] font-bold text-slate-400 uppercase">Gross Revenue</p>
                        <h4 id="sales-gross-revenue" class="outfit-font text-xl font-extrabold text-slate-800 dark:text-white">$0.00</h4>
                    </div>
                    <div class="bg-white dark:bg-darkCard p-4 border rounded-xl shadow-sm">
                        <p class="text-[10px] font-bold text-slate-400 uppercase">Net Revenue (P/L Basis)</p>
                        <h4 id="sales-net-revenue" class="outfit-font text-xl font-extrabold text-slate-800 dark:text-white">$0.00</h4>
                    </div>
                    <div class="bg-white dark:bg-darkCard p-4 border rounded-xl shadow-sm">
                        <p class="text-[10px] font-bold text-slate-400 uppercase">Taxes Collected (VAT)</p>
                        <h4 id="sales-taxes" class="outfit-font text-xl font-extrabold text-slate-800 dark:text-white">$0.00</h4>
                    </div>
                    <div class="bg-white dark:bg-darkCard p-4 border rounded-xl shadow-sm">
                        <p class="text-[10px] font-bold text-slate-400 uppercase">Average Order Value (AOV)</p>
                        <h4 id="sales-aov" class="outfit-font text-xl font-extrabold text-slate-800 dark:text-white">$0.00</h4>
                    </div>
                    <div class="bg-white dark:bg-darkCard p-4 border rounded-xl shadow-sm">
                        <p class="text-[10px] font-bold text-slate-400 uppercase">Discounts Granted</p>
                        <h4 id="sales-discounts" class="outfit-font text-xl font-extrabold text-slate-800 dark:text-white">$0.00</h4>
                    </div>
                </div>

                <!-- Daily Sales & Transaction Breakdown Ledger -->
                <div class="bg-white dark:bg-darkCard p-6 border rounded-2xl shadow-sm space-y-4">
                    <div class="flex items-center justify-between border-b pb-3 border-slate-100 dark:border-darkBorder">
                        <div>
                            <h3 class="outfit-font text-base font-bold text-slate-900 dark:text-white">Daily Operations & Sales Breakdown Ledger</h3>
                            <p class="text-xs text-slate-400 mt-0.5 font-medium">Daily business performance logs detailing transaction yields, tax provisions, and audit status</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <button onclick="exportSalesLedger('excel')" class="px-3 py-1.5 bg-emerald-600 text-white rounded-lg text-xs font-bold hover:bg-emerald-700 transition-all flex items-center gap-1">
                                <i class="bi bi-file-earmark-excel"></i> Excel
                            </button>
                            <button onclick="exportSalesLedger('pdf')" class="px-3 py-1.5 bg-red-650 text-white rounded-lg text-xs font-bold hover:bg-red-700 transition-all flex items-center gap-1">
                                <i class="bi bi-file-earmark-pdf"></i> PDF
                            </button>
                        </div>
                    </div>

                    <!-- Search / Filters toolbar -->
                    <div class="flex flex-wrap items-center gap-3 justify-between">
                        <div class="relative w-full md:w-80">
                            <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                                <i class="bi bi-search text-xs"></i>
                            </span>
                            <input type="text" id="sales-search" onkeyup="filterSalesLedger()" placeholder="Search days..." class="w-full pl-9 pr-4 py-2 border rounded-xl text-xs bg-slate-50 dark:bg-slate-900 dark:border-darkBorder focus:ring-1 focus:ring-brand-500 focus:outline-none dark:text-white">
                        </div>

                        <div class="flex items-center gap-2">
                            <select id="sales-filter-status" onchange="filterSalesLedger()" class="px-3 py-2 border rounded-xl text-xs bg-slate-50 dark:bg-slate-900 dark:border-darkBorder focus:outline-none dark:text-white">
                                <option value="">All Days Statuses</option>
                                <option value="Settled">Settled (All Orders Closed)</option>
                                <option value="Active">Active Operations</option>
                            </select>
                        </div>
                    </div>

                    <!-- Responsive Data Table -->
                    <div class="overflow-x-auto">
                        <table id="table-sales-ledger" class="w-full text-left border-collapse text-xs">
                            <thead>
                                <tr class="border-b border-slate-100 dark:border-darkBorder text-slate-400 dark:text-slate-500 font-bold uppercase tracking-wider text-[10px]">
                                    <th class="py-3 cursor-pointer select-none" onclick="sortSalesLedger('dateString')">Operating Date <i class="bi bi-arrow-down-up ml-0.5 text-[8px]"></i></th>
                                    <th class="py-3 cursor-pointer select-none text-center" onclick="sortSalesLedger('totalOrders')">Total Orders <i class="bi bi-arrow-down-up ml-0.5 text-[8px]"></i></th>
                                    <th class="py-3 cursor-pointer select-none text-center" onclick="sortSalesLedger('completedOrders')">Completed <i class="bi bi-arrow-down-up ml-0.5 text-[8px]"></i></th>
                                    <th class="py-3 cursor-pointer select-none text-center" onclick="sortSalesLedger('cancelledOrders')">Cancelled <i class="bi bi-arrow-down-up ml-0.5 text-[8px]"></i></th>
                                    <th class="py-3 cursor-pointer select-none text-right" onclick="sortSalesLedger('discounts')">Discounts <i class="bi bi-arrow-down-up ml-0.5 text-[8px]"></i></th>
                                    <th class="py-3 cursor-pointer select-none text-right" onclick="sortSalesLedger('taxes')">Taxes (VAT) <i class="bi bi-arrow-down-up ml-0.5 text-[8px]"></i></th>
                                    <th class="py-3 cursor-pointer select-none text-right" onclick="sortSalesLedger('netRevenue')">Net Yield <i class="bi bi-arrow-down-up ml-0.5 text-[8px]"></i></th>
                                    <th class="py-3">Status</th>
                                    <th class="py-3 text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Loaded dynamically in JS -->
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="flex items-center justify-between border-t pt-4 border-slate-100 dark:border-darkBorder text-xs text-slate-400">
                        <span id="sales-pagination-info">Showing 0 to 0 of 0 days</span>
                        <div class="flex items-center gap-1.5">
                            <button onclick="paginateSales('prev')" class="px-3 py-1.5 border dark:border-darkBorder rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800 disabled:opacity-50 font-semibold">Prev</button>
                            <button onclick="paginateSales('next')" class="px-3 py-1.5 border dark:border-darkBorder rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800 disabled:opacity-50 font-semibold">Next</button>
                        </div>
                    </div>
                </div>

                <!-- Breakdown of waiter / Table yields side-by-side -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Table Sales Performance list -->
                    <div class="bg-white dark:bg-darkCard p-6 border rounded-2xl shadow-sm space-y-4">
                        <h3 class="outfit-font text-sm font-bold text-slate-900 dark:text-white">Restaurant Table Profit Centers</h3>
                        <div class="overflow-x-auto">
                            <table id="table-sales-by-tables" class="w-full text-left border-collapse text-xs">
                                <thead>
                                    <tr class="border-b border-slate-100 dark:border-darkBorder text-slate-400 font-bold uppercase text-[9px] tracking-wider">
                                        <th class="py-3">Table Identifier</th>
                                        <th class="py-3 text-center">Sessions Logged</th>
                                        <th class="py-3 text-center">Orders Placed</th>
                                        <th class="py-3 text-right">Total Net Yield</th>
                                        <th class="py-3 text-center">Avg Session Duration</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Dynamic -->
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Pay Method and Waiter Yield summaries -->
                    <div class="bg-white dark:bg-darkCard p-6 border rounded-2xl shadow-sm space-y-4">
                        <h3 class="outfit-font text-sm font-bold text-slate-900 dark:text-white">Operational Service Performance Summary</h3>
                        <div class="overflow-x-auto">
                            <table id="table-sales-by-payment" class="w-full text-left border-collapse text-xs">
                                <thead>
                                    <tr class="border-b border-slate-100 dark:border-darkBorder text-slate-400 font-bold uppercase text-[9px] tracking-wider">
                                        <th class="py-3">Method / Waiter</th>
                                        <th class="py-3 text-center">Orders Served</th>
                                        <th class="py-3 text-right">Total Settled Yield</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Dynamic -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
