                        </div>
                        <div class="flex items-center gap-2">
                            <button onclick="exportSalesLedger('excel')" class="px-3 py-1.5 bg-emerald-600 text-white rounded-lg text-xs font-bold hover:bg-emerald-700 transition-all flex items-center gap-1">
                                <i class="bi bi-file-earmark-excel"></i> تصدير إكسل
                            </button>
                            <button onclick="exportSalesLedger('pdf')" class="px-3 py-1.5 bg-red-650 text-white rounded-lg text-xs font-bold hover:bg-red-700 transition-all flex items-center gap-1">
                                <i class="bi bi-file-earmark-pdf"></i> تصدير PDF
                            </button>
                        </div>
                    </div>

                    <!-- Search / Filters toolbar -->
                    <div class="flex flex-wrap items-center gap-3 justify-between">
                        <div class="relative w-full md:w-80">
