                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-right">
                    <!-- Table Sales Performance list -->
                    <div class="bg-white dark:bg-darkCard p-6 border border-slate-200 dark:border-darkBorder rounded-2xl shadow-sm space-y-4">
                        <h3 class="outfit-font text-sm font-bold text-slate-900 dark:text-white">مراكز أرباح طاولات المطعم</h3>
                        <div class="overflow-x-auto">
                            <table id="table-sales-by-tables" class="w-full text-right border-collapse text-xs">
                                <thead>
                                    <tr class="border-b border-slate-100 dark:border-darkBorder text-slate-400 font-bold uppercase text-[9px] tracking-wider">
                                        <th class="py-3 text-right">رقم الطاولة</th>
                                        <th class="py-3 text-center">الجلسات المسجلة</th>
                                        <th class="py-3 text-center">الطلبات المقدمة</th>
                                        <th class="py-3 text-left">إجمالي صافي الإيراد</th>
                                        <th class="py-3 text-center">متوسط مدة الجلسة</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Dynamic -->
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Pay Method and Waiter Yield summaries -->
                    <div class="bg-white dark:bg-darkCard p-6 border border-slate-200 dark:border-darkBorder rounded-2xl shadow-sm space-y-4">
                        <h3 class="outfit-font text-sm font-bold text-slate-900 dark:text-white">ملخص أداء الخدمة والعمليات</h3>
                        <div class="overflow-x-auto">
                            <table id="table-sales-by-payment" class="w-full text-right border-collapse text-xs">
                                <thead>
                                    <tr class="border-b border-slate-100 dark:border-darkBorder text-slate-400 font-bold uppercase text-[9px] tracking-wider">
                                        <th class="py-3 text-right">طريقة الدفع / الويتر</th>
                                        <th class="py-3 text-center">الطلبات المخدمة</th>
                                        <th class="py-3 text-left">إجمالي الإيرادات المسواة</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Dynamic -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
