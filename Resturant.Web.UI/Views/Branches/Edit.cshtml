@model Resturant.Core.Entities.Branch

@{
    ViewData["Title"] = "تعديل الفرع";
    bool isIframe = ViewBag.IsIframe == true;
    Layout = isIframe ? "~/Views/Shared/_IframeLayout.cshtml" : "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row">
    <div class="col-lg-6 mx-auto">
        <div class="card border-top border-0 border-4 border-info shadow-sm rounded-3">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center py-3">
                <h4 class="card-title mb-0 text-info fw-bold">
                    <i class="feather-edit me-2"></i>تعديل معلومات الفرع
                </h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 text-start"></div>
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Name" class="form-label fw-semibold">اسم الفرع</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="feather-home"></i></span>
                                <input asp-for="Name" class="form-control" required />
                            </div>
                            <span asp-validation-for="Name" class="text-danger fs-12 text-start d-block"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Address" class="form-label fw-semibold">العنوان</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="feather-map-pin"></i></span>
                                <input asp-for="Address" class="form-control" />
                            </div>
                            <span asp-validation-for="Address" class="text-danger fs-12 text-start d-block"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="ContactPhone" class="form-label fw-semibold">هاتف التواصل</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="feather-phone"></i></span>
                                <input asp-for="ContactPhone" class="form-control text-start" />
                            </div>
                            <span asp-validation-for="ContactPhone" class="text-danger fs-12 text-start d-block"></span>
                        </div>

                        <div class="col-12 mt-4 text-start">
                            <div class="form-check form-switch d-inline-block">
                                <input class="form-check-input ms-0 me-2" type="checkbox" role="switch" asp-for="IsActive" />
                                <label class="form-check-label fw-semibold mr-4" asp-for="IsActive">
                                    الفرع نشط ويقوم بالعمليات
                                </label>
                            </div>
                        </div>
                    </div>

                    <input type="hidden" name="iframe" value="@(isIframe ? "true" : "")" />

                    <hr class="my-4 border-dashed" />

                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" asp-route-iframe="@(isIframe ? "true" : "")" class="btn btn-light text-muted rounded-pill px-3">
                            <i class="feather-arrow-left me-1"></i>العودة للقائمة
                        </a>
                        <button type="submit" class="btn btn-info text-white rounded-pill px-4" style="background-color: #0dcaf0 !important; border-color: #0dcaf0 !important;">
                            <i class="feather-check-circle me-1"></i>حفظ التغييرات
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
