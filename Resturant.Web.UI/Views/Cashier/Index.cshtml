@model IEnumerable<Resturant.Core.Entities.Order>
@{
    ViewData["Title"] = "لوحة الكاشير والدفع";
    bool noActiveShift = ViewBag.NoActiveShift == true;
    var activeShift = ViewBag.ActiveShift as Resturant.Core.Entities.CashierShift;
}

<div class="container-fluid py-4 text-right" style="font-family: 'Cairo', 'Segoe UI', Tahoma, Geneva, sans-serif; direction: rtl; text-align: right;">
    
    @if (noActiveShift)
    {
        <!-- ================================================================ -->
        <!-- [START] NO ACTIVE SHIFT PORTAL (STUNNING PREMIUM WELCOME SCREEN) -->
        <!-- ================================================================ -->
        <div class="row justify-content-center align-items-center" style="min-height: 80vh;">
            <div class="col-xl-5 col-lg-7 col-md-9 text-center">
                <div class="card border-0 shadow-sm p-5" style="background: #ffffff; border-radius: 24px; border: 1px solid rgba(0, 0, 0, 0.05); position: relative;">
                    <div style="height: 6px; background: linear-gradient(90deg, #d4af37, #f3e5ab, #d4af37); position: absolute; top: 0; left: 0; right: 0; border-radius: 24px 24px 0 0;"></div>
                    
                    <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle mb-4" style="width: 90px; height: 90px; border: 2px solid #d4af37; box-shadow: 0 0 25px rgba(212, 175, 55, 0.15);">
                        <i class="bi bi-shield-lock text-warning" style="font-size: 2.5rem;"></i>
                    </div>
                    
                    <h2 class="fw-bold text-dark mb-2" style="letter-spacing: 0.5px;">بدء وردية الكاشير</h2>
                    <p class="text-warning fw-semibold mb-4">تفعيل الوردية الجديدة</p>
                    
                    <p class="text-muted mb-4 px-3">
                        مرحباً بك في لوحة تحكم المبيعات. لدواعي الأمان المالي وضمان مطابقة الحسابات والدرج، يرجى تفعيل بدء الوردية قبل استقبال أو محاسبة أي طلبات.
                    </p>

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger py-2 px-3 mb-3 rounded-pill text-center small">
                            <i class="bi bi-exclamation-octagon ms-1"></i> @TempData["ErrorMessage"]
                        </div>
                    }

                    @if (ViewBag.OtherActiveShift != null)
                    {
                        var otherShift = ViewBag.OtherActiveShift as Resturant.Core.Entities.CashierShift;
                        <div class="alert alert-warning py-3 px-4 mb-4 rounded-4 text-center text-dark" style="border: 1px solid rgba(255, 193, 7, 0.3); background-color: rgba(255, 193, 7, 0.08);">
                            <i class="bi bi-exclamation-triangle-fill fs-3 mb-2 d-block text-warning"></i>
                            <strong class="d-block mb-1">يوجد وردية نشطة حالياً!</strong>
                            هذا الفرع مفتوح فيه وردية نشطة حالياً بواسطة الكاشير:
                            <strong class="text-danger d-block mt-1">@(otherShift?.Cashier?.FullName ?? otherShift?.Cashier?.UserName)</strong>
                            بدأت في الساعة: <strong>@otherShift?.StartTime.ToString("hh:mm tt")</strong>
                            <span class="d-block mt-2 text-muted small">لا يمكن فتح وردية جديدة حتى يقوم الزميل بإنهاء وإغلاق ورديته الحالية.</span>
                        </div>
                        
                        @if (User.IsInRole(Resturant.Core.Common.AppRoles.Admin) || User.IsInRole(Resturant.Core.Common.AppRoles.Manager))
                        {
                            <a href="@Url.Action("SelectBranch", "Cashier")" class="btn btn-outline-warning w-100 py-3 fw-bold rounded-pill mb-3" style="font-size: 1rem; color: #1e1e2d; border-color: #d4af37;">
                                <i class="bi bi-arrow-left-right ms-1"></i> تغيير الفرع الحالي
                            </a>
                        }
                    }
                    else
                    {
                        @if (User.IsInRole(Resturant.Core.Common.AppRoles.Admin) || User.IsInRole(Resturant.Core.Common.AppRoles.Manager))
                        {
                            <a href="@Url.Action("SelectBranch", "Cashier")" class="btn btn-outline-warning w-100 py-2.5 fw-bold rounded-pill mb-3" style="font-size: 1rem; color: #1e1e2d; border-color: #d4af37;">
                                <i class="bi bi-arrow-left-right ms-1"></i> تغيير الفرع الحالي
                            </a>
                        }

                        <form asp-action="StartShift" method="post" onsubmit="this.querySelector('button[type=submit]').disabled = true;">
                            <button type="submit" class="btn btn-warning w-100 py-3 fw-bold rounded-pill shadow-lg" style="font-size: 1.1rem; letter-spacing: 0.5px; transition: all 0.3s ease;">
                                <i class="bi bi-play-circle-fill ms-2"></i> بدأ الوردية الآن
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- ================================================================ -->
        <!-- [START] ACTIVE CASHIER DASHBOARD                                  -->
        <!-- ================================================================ -->
        
        <!-- Header & Info Panel -->
        <div class="card border-0 mb-4 shadow-sm" style="border-radius: 16px; border: 1px solid rgba(0, 0, 0, 0.05); background: #ffffff;">
            <div class="card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                
                <div>
                    <h3 class="fw-bold text-dark mb-1">
                        <i class="bi bi-cash-coin text-dark ms-2"></i>لوحة الكاشير والدفع
                        <span id="connection-status" class="badge bg-secondary text-dark ms-2" style="font-size: 0.75rem;"><i class="bi bi-wifi"></i> جاري الاتصال...</span>
                    </h3>
                    <div class="d-flex align-items-center gap-3 mt-2 text-muted small">
                        <span><i class="bi bi-clock-fill text-warning ms-1"></i> الوردية بدأت: @activeShift?.StartTime.ToString("hh:mm tt")</span>
                        <span class="text-secondary">|</span>
                        <span><i class="bi bi-person-circle text-warning ms-1"></i> الكاشير: @User.Identity?.Name</span>
                    </div>
                </div>
                
                <!-- Quick Controls -->
                <div class="d-flex flex-wrap gap-2">
                    @if (User.IsInRole(Resturant.Core.Common.AppRoles.Admin) || User.IsInRole(Resturant.Core.Common.AppRoles.Manager))
                    {
                        <a href="@Url.Action("SelectBranch", "Cashier")" class="btn btn-outline-warning fw-bold px-3 py-2 rounded-pill shadow-sm" style="color: #1e1e2d; border-color: #ffc107;">
                            <i class="bi bi-arrow-left-right ms-1"></i> تغيير الفرع
                        </a>
                    }

                    <button class="btn btn-warning fw-bold px-3 py-2 rounded-pill shadow-sm" onclick="openTakeawayModal()">
                        <i class="bi bi-bag-plus-fill ms-1"></i> تيك أواي جديد
                    </button>
                    
                    <button class="btn btn-danger fw-bold px-3 py-2 rounded-pill shadow-sm" onclick="triggerCloseShiftModal()">
                        <i class="bi bi-power ms-1"></i> تقفيل وإنهاء الوردية
                    </button>
                </div>
            </div>
        </div>

        <!-- Orders Grid Container -->
        @if (!Model.Any())
        {
            <div class="text-center py-5" id="empty-state" style="background: #ffffff; border-radius: 16px; border: 1px solid rgba(0, 0, 0, 0.05);">
                <i class="bi bi-wallet2 display-1 text-secondary"></i>
                <h3 class="mt-3 text-dark">لا توجد طلبات معلقة حالياً</h3>
                <p class="text-muted">الرجاء الانتظار حتى يقوم النادل أو المطبخ بتأكيد وتجهيز الطلبات.</p>
            </div>
        }
        else
        {
            <div class="row g-4" id="orders-container">
                @{
                    var groupedOrders = Model.GroupBy(o => o.TableSessionId ?? -o.TableNumber);
                }
                @foreach (var group in groupedOrders)
                {
                    var firstOrder = group.First();
                    var totalAmount = group.Where(o => o.Status != Resturant.Core.Entities.OrderStatus.Cancelled).Sum(o => o.TotalAmount);
                    var orderIds = string.Join(",", group.Select(o => o.Id));
                    var isReady = group.Any(o => o.Status == Resturant.Core.Entities.OrderStatus.Ready);
                    var isCancelledGroup = group.All(o => o.Status == Resturant.Core.Entities.OrderStatus.Cancelled);
                    
                    <div class="col-lg-4 col-md-6" id="order-card-@(group.Key)">
                        <div class="card h-100 shadow-sm border-0" style="background: #1e1e2d; border-radius: 16px; border: 1px solid @(isCancelledGroup ? "rgba(220, 53, 69, 0.4)" : "rgba(255,255,255,0.05)") !important; color: #fff;">
                            <div class="card-header border-0 d-flex justify-content-between align-items-center p-3 rounded-top-4" style="background: @(isCancelledGroup ? "rgba(220, 53, 69, 0.15)" : isReady ? "rgba(40, 167, 69, 0.15)" : "rgba(255, 193, 7, 0.1)"); border-bottom: 1px solid rgba(255,255,255,0.05) !important;">
                                <h5 class="mb-0 fw-bold text-light">طاولة @firstOrder.TableNumber @(isCancelledGroup ? "— ملغي" : "")</h5>
                                <span class="badge @(isCancelledGroup ? "bg-danger" : isReady ? "bg-success" : "bg-warning") text-dark fw-bold">
                                    @(isCancelledGroup ? "ملغي" : isReady ? "جاهز" : firstOrder.Status == Resturant.Core.Entities.OrderStatus.Pending ? "معلق" : "نشط")
                                </span>
                            </div>
                            
                            <div class="card-body p-4 text-right" style="direction: rtl;">
                                <div class="customer-info mb-3 p-3 rounded-4" style="background: rgba(255, 255, 255, 0.02); border-right: 4px solid @(isCancelledGroup ? "#dc3545" : "#d4af37"); border-left: 0;">
                                    <div class="fw-bold text-light"><i class="bi bi-person-fill ms-1 text-warning"></i> @(firstOrder.CustomerName ?? "ضيف")</div>
                                    <div class="small text-muted mt-1"><i class="bi bi-telephone-fill ms-1"></i> @(firstOrder.PhoneNumber ?? "غير متوفر")</div>
                                </div>

                                <h3 class="card-title text-center my-3 fw-bold @(isCancelledGroup ? "text-danger text-decoration-line-through" : "text-warning")" style="font-size: 2.2rem;">
                                    @totalAmount.ToString("N2") <span style="font-size: 1.1rem; color: #fff;">ج.م</span>
                                </h3>
                                
                                <div class="table-responsive" style="max-height: 180px; overflow-y: auto;">
                                    <table class="table table-sm table-dark table-borderless mb-0">
                                        <thead>
                                            <tr style="color: #d4af37; border-bottom: 1px solid rgba(255,255,255,0.05);">
                                                <th class="text-right">الصنف</th>
                                                <th class="text-left">الكمية</th>
                                                <th class="text-left">السعر</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var order in group)
                                            {
                                                @foreach (var item in order.OrderItems)
                                                {
                                                    <tr class="@(item.IsCancelled ? "text-decoration-line-through text-danger" : "")">
                                                        <td class="py-1 text-right">@item.MenuItem.Name @(item.IsCancelled ? "(ملغي)" : "")</td>
                                                        <td class="text-left py-1">@item.Quantity</td>
                                                        <td class="text-left py-1">@item.Price.ToString("N2")</td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            
                            <div class="card-footer border-0 bg-transparent d-flex gap-2 p-3">
                                @if (isCancelledGroup)
                                {
                                    <button class="btn btn-danger w-100 fw-bold rounded-pill py-2.5" onclick="dismissCancelled('@orderIds')">
                                        <i class="bi bi-x-circle ms-1"></i> تجاهل وإزالة الإلغاء
                                    </button>
                                }
                                else
                                {
                                    <a href="@Url.Action("Receipt", "Cashier", new { ids = orderIds })" target="_blank" class="btn btn-outline-light w-50 rounded-pill py-2.5">
                                        <i class="bi bi-printer ms-1"></i> الفاتورة
                                    </a>
                                    <button class="btn btn-success w-50 fw-bold rounded-pill py-2.5 shadow-sm" onclick="initiatePaymentModal('@orderIds', @totalAmount)">
                                        <i class="bi bi-cash-stack ms-1"></i> محاسبة
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

<!-- ================================================================ -->
<!-- [START] MODAL: CHOOSE CASH & CLOSE SHIFT (تقفيل الشفت)           -->
<!-- ================================================================ -->
<div class="modal fade" id="closeShiftModal" tabindex="-1" aria-hidden="true" style="font-family: 'Cairo', sans-serif;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 text-dark" style="background: #ffffff; border-radius: 20px; border: 1px solid rgba(0, 0, 0, 0.05) !important;">
            <div style="height: 5px; background: linear-gradient(90deg, #dc3545, #ff6b6b); border-radius: 20px 20px 0 0;"></div>
            
            <div class="modal-header border-0 pb-0 d-flex justify-content-between align-items-center">
                <h5 class="modal-title fw-bold text-dark"><i class="bi bi-power text-danger ms-2"></i>تقفيل وإنهاء الوردية</h5>
                <button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <form asp-action="CloseShift" method="post" onsubmit="this.querySelector('button[type=submit]').disabled = true;">
                <div class="modal-body p-4 text-right" style="direction: rtl;">
                    <p class="text-muted small">
                        أنت على وشك إغلاق الوردية الحالية. لدواعي الأمان وضمان الشفافية، الرجاء جرد وكتابة المبلغ الفعلي المتواجد في صندوق الكاش (الدرج) حالياً بالجنيه المصري.
                    </p>
                    
                    <div class="mb-3">
                        <label class="form-label text-warning small fw-bold">إجمالي الكاش الفعلي بالدرج / ج.م</label>
                        <div class="input-group" style="direction: ltr;">
                            <input type="number" step="0.01" min="0" required name="actualAmount" id="actualAmount" class="form-control bg-white text-dark border-1 py-3 text-right" style="border-radius: 0 12px 12px 0; border-color: #ddd; border-left: 0; direction: rtl;" placeholder="0.00 ج.م" />
                            <span class="input-group-text bg-light border-1 text-dark" style="border-radius: 12px 0 0 12px; border-color: #ddd;"><i class="bi bi-wallet2"></i></span>
                        </div>
                    </div>
                </div>
                
                <div class="modal-footer border-0 pt-0 d-flex justify-content-between" style="direction: rtl;">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-danger fw-bold rounded-pill px-4">تأكيد إنهاء الوردية</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================================================================ -->
<!-- [START] MODAL: ADVANCED PAYMENT & TIPPING CALCULATOR            -->
<!-- ================================================================ -->
<div class="modal fade" id="paymentModal" tabindex="-1" aria-hidden="true" style="font-family: 'Cairo', sans-serif;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 text-dark" style="background: #ffffff; border-radius: 20px; border: 1px solid rgba(0, 0, 0, 0.05) !important;">
            <div style="height: 5px; background: linear-gradient(90deg, #4caf50, #81c784); border-radius: 20px 20px 0 0;"></div>
            
            <div class="modal-header border-0 pb-0 d-flex justify-content-between align-items-center">
                <h5 class="modal-title fw-bold text-dark"><i class="bi bi-calculator-fill text-success ms-2"></i>حاسبة الدفع والبقشيش</h5>
                <button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <div class="modal-body p-4 text-right" style="direction: rtl;">
                <input type="hidden" id="payOrderIds" />
                
                <!-- Total Display -->
                <div class="text-center p-3 rounded-4 mb-4" style="background: rgba(0, 0, 0, 0.02); border: 1px solid rgba(0, 0, 0, 0.04);">
                    <div class="text-secondary small mb-1">المبلغ المطلوب</div>
                    <div class="fs-2 fw-bold text-success" id="payTotalLabel">0.00 <span style="font-size: 1rem;">ج.م</span></div>
                </div>

                <!-- Input Amount Received -->
                <div class="mb-3">
                    <label class="form-label text-warning small fw-bold">المبلغ المدفوع من العميل</label>
                    <div class="input-group" style="direction: ltr;">
                        <input type="number" step="0.01" min="0" id="payAmountReceived" class="form-control bg-white text-dark border-1 py-2.5 text-right" style="border-radius: 0 12px 12px 0; border-color: #ddd; border-left: 0; direction: rtl;" placeholder="0.00" oninput="calculateChangeAndTips()" />
                        <span class="input-group-text bg-light border-1 text-dark" style="border-radius: 12px 0 0 12px; border-color: #ddd;"><i class="bi bi-cash-stack"></i></span>
                    </div>
                </div>

                <!-- Input Change Returned -->
                <div class="mb-4">
                    <label class="form-label text-warning small fw-bold">المتبقي المرتجع للعميل</label>
                    <div class="input-group" style="direction: ltr;">
                        <input type="number" step="0.01" min="0" id="payChangeReturned" class="form-control bg-white text-dark border-1 py-2.5 text-right" style="border-radius: 0 12px 12px 0; border-color: #ddd; border-left: 0; direction: rtl;" placeholder="0.00" oninput="calculateChangeAndTips()" />
                        <span class="input-group-text bg-light border-1 text-dark" style="border-radius: 12px 0 0 12px; border-color: #ddd;"><i class="bi bi-arrow-return-left"></i></span>
                    </div>
                </div>

                <!-- Tips display card -->
                <div class="p-3 rounded-4 text-center d-flex justify-content-between align-items-center" style="background: rgba(212, 175, 55, 0.05); border: 1px solid rgba(212, 175, 55, 0.15); direction: rtl;">
                    <div class="text-right">
                        <span class="fw-bold text-warning d-block" style="font-size: 0.95rem;">البقشيش المستلم للدرج</span>
                        <small class="text-muted">يُحسب تلقائياً من الفارق</small>
                    </div>
                    <div class="fs-4 fw-bold text-warning" id="payTipsLabel">0.00 ج.م</div>
                </div>
            </div>
            
            <div class="modal-footer border-0 pt-0 d-flex justify-content-between" style="direction: rtl;">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">إلغاء</button>
                <button type="button" class="btn btn-success fw-bold rounded-pill px-4" onclick="submitProcessedPayment()">تأكيد واستلام النقد</button>
            </div>
        </div>
    </div>
</div>

<!-- ================================================================ -->
<!-- [START] MODAL: TAKEAWAY MENU & ORDER CREATOR                      -->
<!-- ================================================================ -->
<div class="modal fade modal-xl" id="takeawayModal" tabindex="-1" aria-hidden="true" style="font-family: 'Cairo', sans-serif;">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 text-dark" style="background: #ffffff; border-radius: 24px; border: 1px solid rgba(0, 0, 0, 0.05) !important;">
            <div style="height: 6px; background: linear-gradient(90deg, #d4af37, #f3e5ab, #d4af37); border-radius: 24px 24px 0 0;"></div>
            
            <div class="modal-header border-0 pb-0 px-4 pt-4 d-flex justify-content-between align-items-center">
                <h5 class="modal-title fw-bold text-dark"><i class="bi bi-bag-plus-fill text-warning ms-2"></i>طلب تيك أواي جديد</h5>
                <button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <div class="modal-body px-4 py-3">
                <div class="row g-4" style="height: 60vh;">
                    
                    <!-- Right: Menu Explorer (Categories and Items) -->
                    <div class="col-lg-8 d-flex flex-column h-100 border-start ps-3">
                        <div class="input-group mb-3 shadow-sm" style="direction: ltr;">
                            <input type="text" id="menuSearchInput" class="form-control bg-white text-dark border-1 text-right" style="border-radius: 0 12px 12px 0; border-color: #ddd; border-left: 0; direction: rtl;" placeholder="ابحث عن صنف من المنيو..." oninput="filterMenuItems()" />
                            <span class="input-group-text bg-light border-1 text-dark" style="border-radius: 12px 0 0 12px; border-color: #ddd;"><i class="bi bi-search"></i></span>
                        </div>
                        
                        <!-- Categories slider -->
                        <div class="d-flex gap-2 overflow-auto pb-2 mb-3" id="categoriesSlider" style="scrollbar-width: thin; direction: rtl;">
                            <!-- Dynamically loaded -->
                        </div>

                        <!-- Menu items grid -->
                        <div class="row g-3 overflow-auto flex-grow-1" id="menuItemsGrid" style="scrollbar-width: thin; max-height: calc(60vh - 120px); direction: rtl;">
                            <!-- Dynamically loaded -->
                        </div>
                    </div>
                    
                    <!-- Left: Active Cart Pane -->
                    <div class="col-lg-4 d-flex flex-column h-100 p-3 rounded-4 bg-light border">
                        <h5 class="fw-bold text-warning border-bottom pb-2 mb-3"><i class="bi bi-cart3 ms-2"></i>سلة الطلبات</h5>
                        
                        <!-- Cart list -->
                        <div class="flex-grow-1 overflow-auto mb-3" id="cartItemsList" style="scrollbar-width: thin; max-height: calc(60vh - 180px); direction: rtl;">
                            <!-- Dynamic -->
                            <div class="text-center py-5 text-muted" id="cartEmptyState">
                                <i class="bi bi-cart-x display-4 mb-3 d-block text-secondary"></i>
                                السلة فارغة
                            </div>
                        </div>
                        
                        <!-- Summary and Checkout -->
                        <div class="border-top pt-3" style="border-color: rgba(0, 0, 0, 0.08) !important; direction: rtl;">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">الإجمالي المبدئي:</span>
                                <span class="fw-bold text-dark" id="cartSubtotal">0.00 ج.م</span>
                            </div>
                            
                            <button class="btn btn-warning w-100 py-3 fw-bold rounded-pill mt-2 shadow" id="btnCartCheckout" disabled onclick="checkoutTakeawayOrder()">
                                <i class="bi bi-credit-card-2-back-fill ms-2"></i> دفع وإنهاء الطلب
                            </button>
                        </div>
                    </div>
                    
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script>
        const activeBranchId = @(ViewBag.ActiveBranchId ?? "null");
        document.addEventListener('DOMContentLoaded', () => {
            const storedToast = sessionStorage.getItem('cashier_toast');
            if (storedToast) {
                try {
                    const toast = JSON.parse(storedToast);
                    showNotification(toast.message, toast.type);
                } catch (e) { console.error(e); }
                sessionStorage.removeItem('cashier_toast');
            }
        });

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/orderHub")
            .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
            .configureLogging(signalR.LogLevel.Warning)
            .build();

        const pendingRequests = new Set();
        function safeFetch(url, options = {}) {
            const method = options.method || 'GET';
            if (method !== 'GET') {
                const requestKey = `${method}:${url}:${options.body || ''}`;
                if (pendingRequests.has(requestKey)) {
                    console.warn("Blocked duplicate request:", requestKey);
                    return Promise.reject(new Error("Request is already in progress."));
                }
                pendingRequests.add(requestKey);
                return fetch(url, options).finally(() => {
                    pendingRequests.delete(requestKey);
                });
            }
            return fetch(url, options);
        }

        function updateConnectionStatus(connected) {
            const badge = document.getElementById('connection-status');
            if (badge) {
                badge.className = connected ? 'badge bg-success text-dark ms-2' : 'badge bg-danger text-light ms-2';
                badge.innerHTML = connected ? '<i class="bi bi-wifi"></i> مباشر' : '<i class="bi bi-wifi-off"></i> غير متصل';
            }
        }

        function updateOrderCount() {
            const container = document.getElementById('orders-container');
            const count = container ? container.querySelectorAll('.col-lg-4').length : 0;
            const badge = document.getElementById('active-count');
            if (badge) badge.textContent = count + ' معلق للدفع';
        }

        function triggerCloseShiftModal() {
            const modal = new bootstrap.Modal(document.getElementById('closeShiftModal'));
            modal.show();
        }

        let currentOrderTotal = 0;
        let payModalInstance = null;

        function initiatePaymentModal(orderIds, total) {
            document.getElementById('payOrderIds').value = orderIds;
            currentOrderTotal = total;
            document.getElementById('payTotalLabel').innerHTML = `${total.toFixed(2)} <span style="font-size: 1rem;">ج.م</span>`;
            
            document.getElementById('payAmountReceived').value = total.toFixed(2);
            document.getElementById('payChangeReturned').value = (0).toFixed(2);
            document.getElementById('payTipsLabel').textContent = "0.00 ج.م";

            payModalInstance = new bootstrap.Modal(document.getElementById('paymentModal'));
            payModalInstance.show();
        }

        function calculateChangeAndTips() {
            const amountReceived = parseFloat(document.getElementById('payAmountReceived').value) || 0;
            const changeReturned = parseFloat(document.getElementById('payChangeReturned').value) || 0;
            
            let tips = amountReceived - currentOrderTotal - changeReturned;
            if (tips < 0) tips = 0;

            document.getElementById('payTipsLabel').textContent = `${tips.toFixed(2)} ج.م`;
        }

        function submitProcessedPayment() {
            const orderIds = document.getElementById('payOrderIds').value;
            const paidAmount = parseFloat(document.getElementById('payAmountReceived').value) || 0;
            const changeReturned = parseFloat(document.getElementById('payChangeReturned').value) || 0;
            
            let tips = paidAmount - currentOrderTotal - changeReturned;
            if (tips < 0) tips = 0;

            if (paidAmount < currentOrderTotal) {
                alert("المبلغ المدفوع أقل من القيمة المطلوبة للفاتورة!");
                return;
            }

            const btn = document.querySelector('#paymentModal .btn-success');
            const originalText = btn ? btn.innerHTML : '';
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm ms-2"></span>جاري الحفظ...';
            }

            safeFetch('/Cashier/ProcessPayment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `orderIds=${orderIds}&paidAmount=${paidAmount}&changeReturned=${changeReturned}&tips=${tips}`
            })
            .then(response => {
                if (response.ok) {
                    if (payModalInstance) payModalInstance.hide();
                    sessionStorage.setItem('cashier_toast', JSON.stringify({ message: 'تم تأكيد الدفع ومطابقة الخزينة بنجاح!', type: 'success' }));
                    location.reload();
                } else {
                    alert('خطأ أثناء معالجة الدفع');
                    if (btn) { btn.disabled = false; btn.innerHTML = originalText; }
                }
            })
            .catch(err => {
                console.error(err);
                if (btn) { btn.disabled = false; btn.innerHTML = originalText; }
            });
        }

        let takeawayModalInstance = null;
        let fullMenuData = [];
        let selectedCategory = 0;
        let cart = [];

        function openTakeawayModal() {
            takeawayModalInstance = new bootstrap.Modal(document.getElementById('takeawayModal'));
            takeawayModalInstance.show();

            if (fullMenuData.length === 0) {
                fetch('/Cashier/GetMenuData')
                .then(res => res.json())
                .then(data => {
                    fullMenuData = data;
                    renderCategories();
                    renderMenuItems();
                });
            } else {
                cart = [];
                updateCartUI();
                renderMenuItems();
            }
        }

        function renderCategories() {
            const container = document.getElementById('categoriesSlider');
            let html = `<button class="btn btn-sm ${selectedCategory === 0 ? "btn-warning" : "btn-outline-dark"} rounded-pill px-3" onclick="selectCategory(0)">الكل</button>`;
            
            fullMenuData.forEach(cat => {
                html += `<button class="btn btn-sm ${selectedCategory === cat.categoryId ? "btn-warning" : "btn-outline-dark"} rounded-pill px-3" onclick="selectCategory(${cat.categoryId})">${cat.categoryName}</button>`;
            });

            container.innerHTML = html;
        }

        function selectCategory(catId) {
            selectedCategory = catId;
            renderCategories();
