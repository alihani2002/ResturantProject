@model IEnumerable<Resturant.Core.Entities.Order>
@{
    ViewData["Title"] = "Cashier - Payments Dashboard";
    bool noActiveShift = ViewBag.NoActiveShift == true;
    var activeShift = ViewBag.ActiveShift as Resturant.Core.Entities.CashierShift;
}

<div class="container-fluid py-4" style="font-family: 'Inter', 'Outfit', sans-serif;">
    
    @if (noActiveShift)
    {
        <!-- ================================================================ -->
        <!-- [START] NO ACTIVE SHIFT PORTAL (STUNNING PREMIUM WELCOME SCREEN) -->
        <!-- ================================================================ -->
        <div class="row justify-content-center align-items-center" style="min-height: 80vh;">
            <div class="col-xl-5 col-lg-7 col-md-9 text-center">
                <div class="card border-0 shadow-lg p-5" style="background: linear-gradient(135deg, #1e1e2d 0%, #151521 100%); border-radius: 24px; border: 1px solid rgba(255, 255, 255, 0.05);">
                    <div style="height: 6px; background: linear-gradient(90deg, #d4af37, #f3e5ab, #d4af37); position: absolute; top: 0; left: 0; right: 0; border-radius: 24px 24px 0 0;"></div>
                    
                    <div class="d-inline-flex align-items-center justify-content-center bg-dark rounded-circle mb-4" style="width: 90px; height: 90px; border: 2px solid #d4af37; box-shadow: 0 0 25px rgba(212, 175, 55, 0.25);">
                        <i class="bi bi-shield-lock text-warning" style="font-size: 2.5rem;"></i>
                    </div>
                    
                    <h2 class="fw-bold text-light mb-2" style="letter-spacing: 0.5px;">بدء وردية الكاشير</h2>
                    <p class="text-warning fw-semibold mb-4">Start Cashier Shift</p>
                    
                    <p class="text-muted mb-5 px-3">
                        مرحباً بك في لوحة تحكم المبيعات. لدواعي الأمان المالي وضمان مطابقة الحسابات والدرج، يرجى تفعيل بدء الشفت قبل استقبال أو محاسبة أي طلبات.
                    </p>

                    <form asp-action="StartShift" method="post">
                        <button type="submit" class="btn btn-warning w-100 py-3 fw-bold rounded-pill shadow-lg" style="font-size: 1.1rem; letter-spacing: 0.5px; transition: all 0.3s ease;">
                            <i class="bi bi-play-circle-fill me-2"></i> بدأ الشفت الآن / Start Shift
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- ================================================================ -->
        <!-- [START] ACTIVE CASHIER DASHBOARD                                  -->
        <!-- ================================================================ -->
        
        <!-- Header & Info Panel -->
        <div class="card border-0 mb-4 shadow-sm" style="background: #1e1e2d; border-radius: 16px; border: 1px solid rgba(255, 255, 255, 0.05);">
            <div class="card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                
                <div>
                    <h3 class="fw-bold text-light mb-1">
                        <i class="bi bi-cash-coin text-warning me-2"></i>لوحة الكاشير والدفع
                        <span id="connection-status" class="badge bg-secondary text-dark ms-2" style="font-size: 0.75rem;"><i class="bi bi-wifi"></i> Connecting...</span>
                    </h3>
                    <div class="d-flex align-items-center gap-3 mt-2 text-muted small">
                        <span><i class="bi bi-clock-fill text-warning me-1"></i> الشفت بدأ: @activeShift?.StartTime.ToString("hh:mm tt")</span>
                        <span class="text-secondary">|</span>
                        <span><i class="bi bi-person-circle text-warning me-1"></i> الكاشير: @User.Identity?.Name</span>
                    </div>
                </div>
                
                <!-- Quick Controls -->
                <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-warning fw-bold px-3 py-2 rounded-pill shadow-sm" onclick="openTakeawayModal()">
                        <i class="bi bi-bag-plus-fill me-1"></i> تيك أواي جديد / Takeaway
                    </button>
                    
                    <button class="btn btn-danger fw-bold px-3 py-2 rounded-pill shadow-sm" onclick="triggerCloseShiftModal()">
                        <i class="bi bi-power me-1"></i> تقفيل الشفت / Close Shift
                    </button>
                </div>
            </div>
        </div>

        <!-- Orders Grid Container -->
        @if (!Model.Any())
        {
            <div class="text-center py-5" id="empty-state">
                <i class="bi bi-wallet2 display-1 text-secondary"></i>
                <h3 class="mt-3 text-light">لا توجد طلبات معلقة حالياً</h3>
                <p class="text-muted">الرجاء الانتظار حتى يقوم الكابتن أو المطبخ بتجهيز وتأكيد الطلبات.</p>
            </div>
        }
        else
        {
            <div class="row g-4" id="orders-container">
                @{
                    var groupedOrders = Model.GroupBy(o => o.TableSessionId ?? -o.TableNumber);
                }
                @foreach (var group in groupedOrders)
                {
                    var firstOrder = group.First();
                    var totalAmount = group.Where(o => o.Status != Resturant.Core.Entities.OrderStatus.Cancelled).Sum(o => o.TotalAmount);
                    var orderIds = string.Join(",", group.Select(o => o.Id));
                    var isReady = group.Any(o => o.Status == Resturant.Core.Entities.OrderStatus.Ready);
                    var isCancelledGroup = group.All(o => o.Status == Resturant.Core.Entities.OrderStatus.Cancelled);
                    
                    <div class="col-lg-4 col-md-6" id="order-card-@(group.Key)">
                        <div class="card h-100 shadow-sm border-0" style="background: #1e1e2d; border-radius: 16px; border: 1px solid @(isCancelledGroup ? "rgba(220, 53, 69, 0.4)" : "rgba(255,255,255,0.05)") !important; color: #fff;">
                            <div class="card-header border-0 d-flex justify-content-between align-items-center p-3 rounded-top-4" style="background: @(isCancelledGroup ? "rgba(220, 53, 69, 0.15)" : isReady ? "rgba(40, 167, 69, 0.15)" : "rgba(255, 193, 7, 0.1)"); border-bottom: 1px solid rgba(255,255,255,0.05) !important;">
                                <h5 class="mb-0 fw-bold text-light">Table @firstOrder.TableNumber @(isCancelledGroup ? "— CANCELLED" : "")</h5>
                                <span class="badge @(isCancelledGroup ? "bg-danger" : isReady ? "bg-success" : "bg-warning") text-dark fw-bold">
                                    @(isCancelledGroup ? "Cancelled" : isReady ? "Ready" : firstOrder.Status.ToString())
                                </span>
                            </div>
                            
                            <div class="card-body p-4">
                                <div class="customer-info mb-3 p-3 rounded-4" style="background: rgba(255, 255, 255, 0.02); border-left: 4px solid @(isCancelledGroup ? "#dc3545" : "#d4af37");">
                                    <div class="fw-bold text-light"><i class="bi bi-person-fill me-1 text-warning"></i> @(firstOrder.CustomerName ?? "Guest")</div>
                                    <div class="small text-muted mt-1"><i class="bi bi-telephone-fill me-1"></i> @(firstOrder.PhoneNumber ?? "N/A")</div>
                                </div>

                                <h3 class="card-title text-center my-3 fw-bold @(isCancelledGroup ? "text-danger text-decoration-line-through" : "text-warning")" style="font-size: 2.2rem;">
                                    @totalAmount.ToString("N2") <span style="font-size: 1.1rem; color: #fff;">EGP</span>
                                </h3>
                                
                                <div class="table-responsive" style="max-height: 180px; overflow-y: auto;">
                                    <table class="table table-sm table-dark table-borderless mb-0">
                                        <thead>
                                            <tr style="color: #d4af37; border-bottom: 1px solid rgba(255,255,255,0.05);">
                                                <th>الصنف</th>
                                                <th class="text-end">الكمية</th>
                                                <th class="text-end">السعر</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var order in group)
                                            {
                                                @foreach (var item in order.OrderItems)
                                                {
                                                    <tr class="@(item.IsCancelled ? "text-decoration-line-through text-danger" : "")">
                                                        <td class="py-1">@item.MenuItem.Name @(item.IsCancelled ? "(ملغي)" : "")</td>
                                                        <td class="text-end py-1">@item.Quantity</td>
                                                        <td class="text-end py-1">@item.Price.ToString("N2")</td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            
                            <div class="card-footer border-0 bg-transparent d-flex gap-2 p-3">
                                @if (isCancelledGroup)
                                {
                                    <button class="btn btn-danger w-100 fw-bold rounded-pill py-2.5" onclick="dismissCancelled('@orderIds')">
                                        <i class="bi bi-x-circle me-1"></i> تجاهل وإزالة الإلغاء
                                    </button>
                                }
                                else
                                {
                                    <a href="@Url.Action("Receipt", "Cashier", new { ids = orderIds })" target="_blank" class="btn btn-outline-light w-50 rounded-pill py-2.5">
                                        <i class="bi bi-printer me-1"></i> الفاتورة
                                    </a>
                                    <button class="btn btn-success w-50 fw-bold rounded-pill py-2.5 shadow-sm" onclick="initiatePaymentModal('@orderIds', @totalAmount)">
                                        <i class="bi bi-cash-stack me-1"></i> محاسبة / Paid
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

<!-- ================================================================ -->
<!-- [START] MODAL: CHOOSE CASH & CLOSE SHIFT (تقفيل الشفت)           -->
<!-- ================================================================ -->
<div class="modal fade" id="closeShiftModal" tabindex="-1" aria-hidden="true" style="font-family: 'Inter', sans-serif;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 text-white" style="background: #151521; border-radius: 20px; border: 1px solid rgba(255, 255, 255, 0.05) !important;">
            <div style="height: 5px; background: linear-gradient(90deg, #dc3545, #ff6b6b); border-radius: 20px 20px 0 0;"></div>
            
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-light"><i class="bi bi-power text-danger me-2"></i>تقفيل وإنهاء الوردية</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <form asp-action="CloseShift" method="post">
                <div class="modal-body p-4">
                    <p class="text-muted small">
                        أنت على وشك إغلاق الوردية الحالية. لدواعي الأمان وضمان الشفافية، الرجاء جرد وكتابة المبلغ الفعلي المتواجد في صندوق الكاش (الدرج) حالياً بالجنيه المصري.
                    </p>
                    
                    <div class="mb-3">
                        <label class="form-label text-warning small fw-bold">إجمالي الكاش الفعلي بالدرج / Actual Cash Amount</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-0 text-warning" style="border-radius: 12px 0 0 12px;"><i class="bi bi-wallet2"></i></span>
                            <input type="number" step="0.01" min="0" required name="actualAmount" id="actualAmount" class="form-control bg-dark text-white border-0 py-3" style="border-radius: 0 12px 12px 0;" placeholder="0.00 EGP" />
                        </div>
                    </div>
                </div>
                
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-light rounded-pill px-4" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-danger fw-bold rounded-pill px-4">تأكيد إنهاء الوردية</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================================================================ -->
<!-- [START] MODAL: ADVANCED PAYMENT & TIPPING CALCULATOR            -->
<!-- ================================================================ -->
<div class="modal fade" id="paymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 text-white" style="background: #151521; border-radius: 20px; border: 1px solid rgba(255, 255, 255, 0.05) !important;">
            <div style="height: 5px; background: linear-gradient(90deg, #4caf50, #81c784); border-radius: 20px 20px 0 0;"></div>
            
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-light"><i class="bi bi-calculator-fill text-success me-2"></i>حاسبة الدفع والبقشيش</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <div class="modal-body p-4">
                <input type="hidden" id="payOrderIds" />
                
                <!-- Total Display -->
                <div class="text-center p-3 rounded-4 mb-4" style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.04);">
                    <div class="text-secondary small mb-1">المبلغ المطلوب / Total Amount Due</div>
                    <div class="fs-2 fw-bold text-success" id="payTotalLabel">0.00 <span style="font-size: 1rem;">EGP</span></div>
                </div>

                <!-- Input Amount Received -->
                <div class="mb-3">
                    <label class="form-label text-warning small fw-bold">المبلغ المدفوع من العميل / Amount Received</label>
                    <div class="input-group">
                        <span class="input-group-text bg-dark border-0 text-warning" style="border-radius: 12px 0 0 12px;"><i class="bi bi-cash-stack"></i></span>
                        <input type="number" step="0.01" min="0" id="payAmountReceived" class="form-control bg-dark text-white border-0 py-2.5" style="border-radius: 0 12px 12px 0;" placeholder="0.00" oninput="calculateChangeAndTips()" />
                    </div>
                </div>

                <!-- Input Change Returned -->
                <div class="mb-4">
                    <label class="form-label text-warning small fw-bold">المتبقي المرتجع للعميل / Change Returned</label>
                    <div class="input-group">
                        <span class="input-group-text bg-dark border-0 text-warning" style="border-radius: 12px 0 0 12px;"><i class="bi bi-arrow-return-left"></i></span>
                        <input type="number" step="0.01" min="0" id="payChangeReturned" class="form-control bg-dark text-white border-0 py-2.5" style="border-radius: 0 12px 12px 0;" placeholder="0.00" oninput="calculateChangeAndTips()" />
                    </div>
                </div>

                <!-- Tips display card -->
                <div class="p-3 rounded-4 text-center d-flex justify-content-between align-items-center" style="background: rgba(212, 175, 55, 0.05); border: 1px solid rgba(212, 175, 55, 0.15);">
                    <div class="text-start">
                        <span class="fw-bold text-warning d-block" style="font-size: 0.95rem;">البقشيش المستلم للدرج / Tips</span>
                        <small class="text-muted">يُحسب تلقائياً من الفارق</small>
                    </div>
                    <div class="fs-4 fw-bold text-warning" id="payTipsLabel">0.00 EGP</div>
                </div>
            </div>
            
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-light rounded-pill px-4" data-bs-dismiss="modal">إلغاء</button>
                <button type="button" class="btn btn-success fw-bold rounded-pill px-4" onclick="submitProcessedPayment()">تأكيد واستلام النقد</button>
            </div>
        </div>
    </div>
</div>

<!-- ================================================================ -->
<!-- [START] MODAL: TAKEAWAY MENU & ORDER CREATOR                      -->
<!-- ================================================================ -->
<div class="modal fade modal-xl" id="takeawayModal" tabindex="-1" aria-hidden="true" style="font-family: 'Inter', sans-serif;">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 text-white" style="background: #151521; border-radius: 24px; border: 1px solid rgba(255, 255, 255, 0.05) !important;">
            <div style="height: 6px; background: linear-gradient(90deg, #d4af37, #f3e5ab, #d4af37); border-radius: 24px 24px 0 0;"></div>
            
            <div class="modal-header border-0 pb-0 px-4 pt-4">
                <h5 class="modal-title fw-bold text-light"><i class="bi bi-bag-plus-fill text-warning me-2"></i>طلب تيك أواي جديد / Takeaway Order</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <div class="modal-body px-4 py-3">
                <div class="row g-4" style="height: 60vh;">
                    
                    <!-- Left: Menu Explorer (Categories and Items) -->
                    <div class="col-lg-8 d-flex flex-column h-100">
                        <div class="input-group mb-3 shadow-sm">
                            <span class="input-group-text bg-dark border-0 text-warning" style="border-radius: 12px 0 0 12px;"><i class="bi bi-search"></i></span>
                            <input type="text" id="menuSearchInput" class="form-control bg-dark text-white border-0" style="border-radius: 0 12px 12px 0; py: 2.5rem;" placeholder="ابحث عن صنف من المنيو..." oninput="filterMenuItems()" />
                        </div>
                        
                        <!-- Categories slider -->
                        <div class="d-flex gap-2 overflow-auto pb-2 mb-3" id="categoriesSlider" style="scrollbar-width: thin;">
                            <!-- Dynamically loaded -->
                        </div>

                        <!-- Menu items grid -->
                        <div class="row g-3 overflow-auto flex-grow-1" id="menuItemsGrid" style="scrollbar-width: thin; max-height: calc(60vh - 120px);">
                            <!-- Dynamically loaded -->
                        </div>
                    </div>
                    
                    <!-- Right: Active Cart Pane -->
                    <div class="col-lg-4 d-flex flex-column h-100 p-3 rounded-4" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.04);">
                        <h5 class="fw-bold text-warning border-bottom pb-2 mb-3"><i class="bi bi-cart3 me-2"></i>سلة الطلبات / Cart</h5>
                        
                        <!-- Cart list -->
                        <div class="flex-grow-1 overflow-auto mb-3" id="cartItemsList" style="scrollbar-width: thin; max-height: calc(60vh - 180px);">
                            <!-- Dynamic -->
                            <div class="text-center py-5 text-muted" id="cartEmptyState">
                                <i class="bi bi-cart-x display-4 mb-3 d-block text-secondary"></i>
                                السلة فارغة
                            </div>
                        </div>
                        
                        <!-- Summary and Checkout -->
                        <div class="border-top pt-3" style="border-color: rgba(255,255,255,0.08) !important;">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">الإجمالي المبدئي:</span>
                                <span class="fw-bold" id="cartSubtotal">0.00 EGP</span>
                            </div>
                            
                            <button class="btn btn-warning w-100 py-3 fw-bold rounded-pill mt-2 shadow" id="btnCartCheckout" disabled onclick="checkoutTakeawayOrder()">
                                <i class="bi bi-credit-card-2-back-fill me-2"></i> دفع وإنهاء الطلب / Pay
                            </button>
                        </div>
                    </div>
                    
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script>
        // SignalR Connection
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/orderHub")
            .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
            .configureLogging(signalR.LogLevel.Warning)
            .build();

        function updateConnectionStatus(connected) {
            const badge = document.getElementById('connection-status');
            if (badge) {
                badge.className = connected ? 'badge bg-success text-dark ms-2' : 'badge bg-danger text-light ms-2';
                badge.innerHTML = connected ? '<i class="bi bi-wifi"></i> Live' : '<i class="bi bi-wifi-off"></i> Offline';
            }
        }

        function updateOrderCount() {
            const container = document.getElementById('orders-container');
            const count = container ? container.querySelectorAll('.col-lg-4').length : 0;
            const badge = document.getElementById('active-count');
            if (badge) badge.textContent = count + ' معلق للدفع / Active';
        }

        // ================================================================
        // MODAL ACTIONS: CLOSE SHIFT
        // ================================================================
        function triggerCloseShiftModal() {
            const modal = new bootstrap.Modal(document.getElementById('closeShiftModal'));
            modal.show();
        }

        // ================================================================
        // MODAL ACTIONS: TIPPING PAYMENT SYSTEM
        // ================================================================
        let currentOrderTotal = 0;
        let payModalInstance = null;

        function initiatePaymentModal(orderIds, total) {
            document.getElementById('payOrderIds').value = orderIds;
            currentOrderTotal = total;
            document.getElementById('payTotalLabel').innerHTML = `${total.toFixed(2)} <span style="font-size: 1rem;">EGP</span>`;
            
            // Auto fill
            document.getElementById('payAmountReceived').value = total.toFixed(2);
            document.getElementById('payChangeReturned').value = (0).toFixed(2);
            document.getElementById('payTipsLabel').textContent = "0.00 EGP";

            payModalInstance = new bootstrap.Modal(document.getElementById('paymentModal'));
            payModalInstance.show();
        }

        function calculateChangeAndTips() {
            const amountReceived = parseFloat(document.getElementById('payAmountReceived').value) || 0;
            const changeReturned = parseFloat(document.getElementById('payChangeReturned').value) || 0;
            
            // Calculate change suggestion if they just input amountReceived but changeReturned is 0 (or pristine)
            // But let them edit it!
            let tips = amountReceived - currentOrderTotal - changeReturned;
            if (tips < 0) tips = 0;

            document.getElementById('payTipsLabel').textContent = `${tips.toFixed(2)} EGP`;
        }

        function submitProcessedPayment() {
            const orderIds = document.getElementById('payOrderIds').value;
            const paidAmount = parseFloat(document.getElementById('payAmountReceived').value) || 0;
            const changeReturned = parseFloat(document.getElementById('payChangeReturned').value) || 0;
            
            let tips = paidAmount - currentOrderTotal - changeReturned;
            if (tips < 0) tips = 0;

            if (paidAmount < currentOrderTotal) {
                alert("المبلغ المدفوع أقل من القيمة المطلوبة للفاتورة!");
                return;
            }

            fetch('/Cashier/ProcessPayment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `orderIds=${orderIds}&paidAmount=${paidAmount}&changeReturned=${changeReturned}&tips=${tips}`
            })
            .then(response => {
                if (response.ok) {
                    if (payModalInstance) payModalInstance.hide();
                    fetchAndRefreshOrders();
                    showNotification('تم تأكيد الدفع ومطابقة الخزينة بنجاح!', 'success');
                } else {
                    alert('خطأ أثناء معالجة الدفع');
                }
            });
        }

        // ================================================================
        // MODAL ACTIONS: TAKEAWAY MENU & CART SYSTEM
        // ================================================================
        let takeawayModalInstance = null;
        let fullMenuData = [];
        let selectedCategory = 0;
        let cart = [];

        function openTakeawayModal() {
            takeawayModalInstance = new bootstrap.Modal(document.getElementById('takeawayModal'));
            takeawayModalInstance.show();

            // Load menu once
            if (fullMenuData.length === 0) {
                fetch('/Cashier/GetMenuData')
                .then(res => res.json())
                .then(data => {
                    fullMenuData = data;
                    renderCategories();
                    renderMenuItems();
                });
            } else {
                // Reset cart
                cart = [];
                updateCartUI();
                renderMenuItems();
            }
        }

        function renderCategories() {
            const container = document.getElementById('categoriesSlider');
            let html = `<button class="btn btn-sm ${selectedCategory === 0 ? "btn-warning" : "btn-outline-light"} rounded-pill px-3" onclick="selectCategory(0)">All</button>`;
            
            fullMenuData.forEach(cat => {
                html += `<button class="btn btn-sm ${selectedCategory === cat.categoryId ? "btn-warning" : "btn-outline-light"} rounded-pill px-3" onclick="selectCategory(${cat.categoryId})">${cat.categoryName}</button>`;
            });

            container.innerHTML = html;
        }

        function selectCategory(catId) {
            selectedCategory = catId;
            renderCategories();
            renderMenuItems();
        }

        function renderMenuItems() {
            const grid = document.getElementById('menuItemsGrid');
            const search = document.getElementById('menuSearchInput').value.toLowerCase();
            let html = '';

            fullMenuData.forEach(cat => {
                if (selectedCategory !== 0 && cat.categoryId !== selectedCategory) return;

                cat.items.forEach(item => {
                    if (search && !item.name.toLowerCase().includes(search)) return;

                    html += `
                        <div class="col-sm-6 col-md-4">
                            <div class="card h-100 border-0 shadow-sm p-3" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05) !important; color: #fff;">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="fw-bold text-light" style="font-size: 0.95rem;">${item.name}</div>
                                    <span class="badge bg-warning text-dark fw-bold">${item.price.toFixed(2)} EGP</span>
                                </div>
                                <div class="mt-3">
                                    <button class="btn btn-outline-warning btn-xs w-100 py-1.5 fw-bold rounded-pill" onclick="addItemToCart(${item.id}, '${item.name.replace(/'/g, "\\'")}', ${item.price})">
                                        <i class="bi bi-plus-circle me-1"></i> إضافة للسلة
                                    </button>
                                </div>
                            </div>
                        </div>
                    `;
                });
            });

            grid.innerHTML = html || `<div class="text-center py-5 text-muted col-12">لا توجد أصناف مطابقة للبحث</div>`;
        }

        function filterMenuItems() {
            renderMenuItems();
        }

        function addItemToCart(id, name, price) {
            const existing = cart.find(i => i.id === id);
            if (existing) {
                existing.quantity++;
            } else {
                cart.push({ id: id, name: name, price: price, quantity: 1 });
            }
            updateCartUI();
        }

        function updateQuantity(id, delta) {
            const existing = cart.find(i => i.id === id);
            if (existing) {
                existing.quantity += delta;
                if (existing.quantity <= 0) {
                    cart = cart.filter(i => i.id !== id);
                }
            }
            updateCartUI();
        }

        function updateCartUI() {
            const container = document.getElementById('cartItemsList');
            const checkoutBtn = document.getElementById('btnCartCheckout');
            const emptyState = document.getElementById('cartEmptyState');
            
            if (cart.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-5 text-muted" id="cartEmptyState">
                        <i class="bi bi-cart-x display-4 mb-3 d-block text-secondary"></i>
                        السلة فارغة
                    </div>
                `;
                document.getElementById('cartSubtotal').textContent = "0.00 EGP";
                checkoutBtn.disabled = true;
                return;
            }

            let html = '';
            let subtotal = 0;

            cart.forEach(item => {
                const total = item.price * item.quantity;
                subtotal += total;

                html += `
                    <div class="d-flex justify-content-between align-items-center mb-3 p-2.5 rounded-3" style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255,255,255,0.04);">
                        <div class="text-start">
                            <span class="fw-bold d-block text-light" style="font-size: 0.9rem;">${item.name}</span>
                            <span class="text-muted small">${item.price.toFixed(2)} EGP</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button class="btn btn-outline-warning btn-xs rounded-circle" style="width: 26px; height: 26px; padding:0; display:flex; align-items:center; justify-content:center;" onclick="updateQuantity(${item.id}, -1)"><i class="bi bi-dash"></i></button>
                            <span class="fw-bold">${item.quantity}</span>
                            <button class="btn btn-outline-warning btn-xs rounded-circle" style="width: 26px; height: 26px; padding:0; display:flex; align-items:center; justify-content:center;" onclick="updateQuantity(${item.id}, 1)"><i class="bi bi-plus"></i></button>
                        </div>
                    </div>
                `;
            });

            container.innerHTML = html;
            document.getElementById('cartSubtotal').textContent = `${subtotal.toFixed(2)} EGP`;
            checkoutBtn.disabled = false;
        }

        function checkoutTakeawayOrder() {
            let subtotal = cart.reduce((acc, i) => acc + (i.price * i.quantity), 0);
            
            // Close Takeaway modal and open payment modal!
            if (takeawayModalInstance) takeawayModalInstance.hide();
            
            setTimeout(() => {
                // Hook payment confirm to takeaway checkout!
                document.getElementById('payOrderIds').value = "TAKEAWAY";
                currentOrderTotal = subtotal;
                document.getElementById('payTotalLabel').innerHTML = `${subtotal.toFixed(2)} <span style="font-size: 1rem;">EGP</span>`;
                
                document.getElementById('payAmountReceived').value = subtotal.toFixed(2);
                document.getElementById('payChangeReturned').value = (0).toFixed(2);
                document.getElementById('payTipsLabel').textContent = "0.00 EGP";

                // Re-wire pay confirm to submit takeaway
                const confirmBtn = document.querySelector('#paymentModal .btn-success');
                confirmBtn.setAttribute('onclick', 'submitTakeawayPayment()');

                payModalInstance = new bootstrap.Modal(document.getElementById('paymentModal'));
                payModalInstance.show();
            }, 350);
        }

        function submitTakeawayPayment() {
            const paidAmount = parseFloat(document.getElementById('payAmountReceived').value) || 0;
            const changeReturned = parseFloat(document.getElementById('payChangeReturned').value) || 0;
            
            let tips = paidAmount - currentOrderTotal - changeReturned;
            if (tips < 0) tips = 0;

            if (paidAmount < currentOrderTotal) {
                alert("المبلغ المدفوع أقل من القيمة المطلوبة للفاتورة!");
                return;
            }

            const items = cart.map(i => ({
                menuItemId: i.id,
                quantity: i.quantity,
                addOnIds: []
            }));

            const payload = {
                items: items,
                paidAmount: paidAmount,
                changeReturned: changeReturned,
                tips: tips
            };

            fetch('/Cashier/CreateTakeawayOrder', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(response => {
                if (response.ok) {
                    if (payModalInstance) payModalInstance.hide();
                    fetchAndRefreshOrders();
                    
                    // Reset confirm button action back to original processPayment
                    const confirmBtn = document.querySelector('#paymentModal .btn-success');
                    confirmBtn.setAttribute('onclick', 'submitProcessedPayment()');

                    showNotification('تم تسجيل طلب التيك أواي ودفع الفاتورة بنجاح!', 'success');
                } else {
                    alert('خطأ أثناء إرسال طلب التيك أواي');
                }
            });
        }

        // ================================================================
        // OTHER SYSTEM REFRESH & SIGNALR EVENTS
        // ================================================================
        function playNotificationSound() {
            try {
                const audioContext = new (window.AudioContext || window.webkitAudioContext)();
                const oscillator = audioContext.createOscillator();
                const gainNode = audioContext.createGain();
                oscillator.connect(gainNode);
                gainNode.connect(audioContext.destination);
                oscillator.frequency.value = 700;
                oscillator.type = 'sine';
                gainNode.gain.setValueAtTime(0.3, audioContext.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.3);
                oscillator.start(audioContext.currentTime);
                oscillator.stop(audioContext.currentTime + 0.3);
            } catch (e) { }
        }

        function showNotification(message, type = 'info') {
            const container = document.querySelector('.toast-container') || createToastContainer();
            const toastId = 'toast-' + Date.now();
            const bgColor = type === 'success' ? 'bg-success' : type === 'warning' ? 'bg-warning' : 'bg-info';

            const toastHtml = `
                <div id="${toastId}" class="toast align-items-center text-white ${bgColor} border-0" role="alert">
                    <div class="d-flex">
                        <div class="toast-body">${message}</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>
            `;
            container.insertAdjacentHTML('beforeend', toastHtml);
            const toastEl = document.getElementById(toastId);
            const toast = new bootstrap.Toast(toastEl, { delay: 4000 });
            toast.show();
            toastEl.addEventListener('hidden.bs.toast', () => toastEl.remove());
        }

        function createToastContainer() {
            const container = document.createElement('div');
            container.className = 'toast-container position-fixed bottom-0 end-0 p-3';
            document.body.appendChild(container);
            return container;
        }

        // SignalR Handlers
        connection.on("OrderAccepted", () => fetchAndRefreshOrders());
        connection.on("OrderReady", () => {
            fetchAndRefreshOrders();
            playNotificationSound();
            showNotification('يوجد طلبات جديدة جاهزة للدفع من المطبخ!', 'success');
        });
        connection.on("OrderCompleted", () => fetchAndRefreshOrders());
        connection.on("OrderCancelled", (order) => {
            fetchAndRefreshOrders();
            showNotification(`⚠️ تم إلغاء الطلب #${order.id} للطاولة ${order.tableNumber}`, 'warning');
        });
        connection.on("OrderItemCancelled", (data) => {
            fetchAndRefreshOrders();
            showNotification(`تم إلغاء صنف ${data.cancelledItemName} في الطاولة ${data.tableNumber}`, 'warning');
        });
        connection.on("OrderStatusChanged", () => fetchAndRefreshOrders());

        async function fetchAndRefreshOrders() {
            try {
                const response = await fetch('/Cashier/GetOrdersData');
                if (!response.ok) return;

                const orders = await response.json();
                let container = document.getElementById('orders-container');

                if (!container) {
                    const emptyState = document.getElementById('empty-state');
                    if (emptyState) {
                        emptyState.outerHTML = `<div class="row g-4" id="orders-container"></div>`;
                        container = document.getElementById('orders-container');
                    } else {
                        return;
                    }
                }

                if (!container) return;

                // Re-render group list
                let html = '';
                orders.forEach(group => {
                    const isReady = group.status === 3;
                    const isCancelled = group.isCancelled === true;
                    const orderIdsStr = group.orderIds.join(',');
                    
                    let itemsHtml = '';
                    group.orderItems.forEach(item => {
                        const itemCancelled = item.isCancelled === true;
                        itemsHtml += `
                            <tr class="${itemCancelled ? "text-decoration-line-through text-danger" : ""}">
                                <td class="py-1">${item.menuItemName} ${itemCancelled ? "(ملغي)" : ""}</td>
                                <td class="text-end py-1">${item.quantity}</td>
                                <td class="text-end py-1">${item.price.toFixed(2)}</td>
                            </tr>
                        `;
                    });

                    const actionHtml = isCancelled
                        ? `<button class="btn btn-danger w-100 fw-bold rounded-pill py-2.5" onclick="dismissCancelled('${orderIdsStr}')">
                                <i class="bi bi-x-circle me-1"></i> تجاهل وإزالة الإلغاء
                           </button>`
                        : `<a href="/Cashier/Receipt?ids=${orderIdsStr}" target="_blank" class="btn btn-outline-light w-50 rounded-pill py-2.5">
                                <i class="bi bi-printer me-1"></i> الفاتورة
                           </a>
                           <button class="btn btn-success w-50 fw-bold rounded-pill py-2.5 shadow-sm" onclick="initiatePaymentModal('${orderIdsStr}', ${group.totalAmount})">
                                <i class="bi bi-cash-stack me-1"></i> محاسبة / Paid
                           </button>`;

                    html += `
                        <div class="col-lg-4 col-md-6" id="order-card-${group.sessionId ? group.sessionId : -group.tableNumber}">
                            <div class="card h-100 shadow-sm border-0" style="background: #1e1e2d; border-radius: 16px; border: 1px solid ${isCancelled ? "rgba(220, 53, 69, 0.4)" : "rgba(255,255,255,0.05)"} !important; color: #fff;">
                                <div class="card-header border-0 d-flex justify-content-between align-items-center p-3 rounded-top-4" style="background: ${isCancelled ? "rgba(220, 53, 69, 0.15)" : isReady ? "rgba(40, 167, 69, 0.15)" : "rgba(255, 193, 7, 0.1)"}; border-bottom: 1px solid rgba(255,255,255,0.05) !important;">
                                    <h5 class="mb-0 fw-bold text-light">Table ${group.tableNumber} ${isCancelled ? '— CANCELLED' : ''}</h5>
                                    <span class="badge ${isCancelled ? "bg-danger" : isReady ? "bg-success" : "bg-warning"} text-dark fw-bold">
                                        ${isCancelled ? "Cancelled" : isReady ? "Ready" : (group.status === 1 ? 'Confirmed' : 'Active')}
                                    </span>
                                </div>
                                <div class="card-body p-4">
                                    <div class="customer-info mb-3 p-3 rounded-4" style="background: rgba(255, 255, 255, 0.02); border-left: 4px solid ${isCancelled ? "#dc3545" : "#d4af37"};">
                                        <div class="fw-bold text-light"><i class="bi bi-person-fill me-1 text-warning"></i> ${group.customerName}</div>
                                        <div class="small text-muted mt-1"><i class="bi bi-telephone-fill me-1"></i> ${group.phoneNumber}</div>
                                    </div>
                                    <h3 class="card-title text-center my-3 fw-bold ${isCancelled ? "text-danger text-decoration-line-through" : "text-warning"}" style="font-size: 2.2rem;">
                                        ${group.totalAmount.toFixed(2)} <span style="font-size: 1.1rem; color: #fff;">EGP</span>
                                    </h3>
                                    <div class="table-responsive" style="max-height: 180px; overflow-y: auto;">
                                        <table class="table table-sm table-dark table-borderless mb-0">
                                            <thead>
                                                <tr style="color: #d4af37; border-bottom: 1px solid rgba(255,255,255,0.05);">
                                                    <th>الصنف</th>
                                                    <th class="text-end">الكمية</th>
                                                    <th class="text-end">السعر</th>
                                                </tr>
                                            </thead>
                                            <tbody>${itemsHtml}</tbody>
                                        </table>
                                    </div>
                                </div>
                                <div class="card-footer border-0 bg-transparent d-flex gap-2 p-3">${actionHtml}</div>
                            </div>
                        </div>
                    `;
                });

                container.innerHTML = html;
                updateOrderCount();
                
                if (orders.length === 0) {
                    container.outerHTML = `
                        <div class="text-center py-5" id="empty-state">
                            <i class="bi bi-wallet2 display-1 text-secondary"></i>
                            <h3 class="mt-3 text-light">لا توجد طلبات معلقة حالياً</h3>
                            <p class="text-muted">الرجاء الانتظار حتى يقوم الكابتن أو المطبخ بتجهيز وتأكيد الطلبات.</p>
                        </div>
                    `;
                }
            } catch (error) {
                console.error(error);
            }
        }

        async function startConnection() {
            try {
                await connection.start();
                await connection.invoke("JoinDashboard", "cashier");
                updateConnectionStatus(true);
            } catch (err) {
                updateConnectionStatus(false);
                setTimeout(startConnection, 5000);
            }
        }

        connection.onreconnecting(() => updateConnectionStatus(false));
        connection.onreconnected(() => {
            connection.invoke("JoinDashboard", "cashier");
            updateConnectionStatus(true);
            fetchAndRefreshOrders();
        });
        connection.onclose(() => updateConnectionStatus(false));

        startConnection();

        function dismissCancelled(orderIds) {
            if (!confirm('هل تريد بالتأكيد تجاهل هذه الطلبات الملغية وإخفائها؟')) return;
            fetch('/Cashier/ProcessPayment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `orderIds=${orderIds}&paidAmount=0&changeReturned=0&tips=0`
            })
            .then(response => {
                if (response.ok) { fetchAndRefreshOrders(); showNotification('تم تجاهل الطلب الملغي.', 'success'); }
                else { alert('حدث خطأ'); }
            });
        }
    </script>
}