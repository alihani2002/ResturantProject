        function filterMenuItems() {
            renderMenuItems();
        }

        function handleMenuAddClick(itemId) {
            let foundItem = null;
            for (const cat of fullMenuData) {
                const item = cat.items.find(i => i.id === itemId);
                if (item) {
                    foundItem = item;
                    break;
                }
            }
            if (!foundItem) return;

            const hasCustomization = (foundItem.sizes && foundItem.sizes.length > 0) || (foundItem.addOns && foundItem.addOns.length > 0);
            if (hasCustomization) {
                openCustomizationModal(itemId);
            } else {
                addItemToCartDirect(foundItem.id, foundItem.name, foundItem.price);
            }
        }

        function addItemToCartDirect(id, name, price) {
            const cartItemId = `${id}__`;
            const existing = cart.find(i => i.cartItemId === cartItemId);
            if (existing) {
                existing.quantity++;
            } else {
                cart.push({
                    cartItemId: cartItemId,
                    id: id,
                    name: name,
                    price: price,
                    quantity: 1,
                    addOns: []
                });
            }
            updateCartUI();
        }

        function updateQuantity(cartItemId, delta) {
            const existing = cart.find(i => i.cartItemId === cartItemId);
            if (existing) {
                existing.quantity += delta;
                if (existing.quantity <= 0) {
                    cart = cart.filter(i => i.cartItemId !== cartItemId);
                }
            }
            updateCartUI();
        }

        function updateCartUI() {
            const container = document.getElementById('cartItemsList');
            const checkoutBtn = document.getElementById('btnCartCheckout');
            
            if (cart.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-5 text-muted" id="cartEmptyState">
                        <i class="bi bi-cart-x display-4 mb-3 d-block text-secondary"></i>
                        السلة فارغة
                    </div>
                `;
                document.getElementById('cartSubtotal').textContent = "0.00 ج.م";
                checkoutBtn.disabled = true;
                return;
            }

            let html = '';
            let subtotal = 0;

            cart.forEach(item => {
                const addonsTotal = item.addOns ? item.addOns.reduce((sum, a) => sum + a.price, 0) : 0;
                const total = (item.price + addonsTotal) * item.quantity;
                subtotal += total;

                let addonsText = '';
                if (item.addOns && item.addOns.length > 0) {
                    addonsText = `<div class="text-muted small pr-2 border-right border-2 border-warning mt-1" style="font-size: 0.75rem; text-align: right;">+ ${item.addOns.map(a => a.name).join(', ')}</div>`;
                }

                html += `
                    <div class="d-flex justify-content-between align-items-center mb-3 p-2.5 rounded-3 text-right" style="background: rgba(0, 0, 0, 0.02); border: 1px solid rgba(0,0,0,0.08); direction: rtl;">
                        <div style="max-width: 65%;">
                            <span class="fw-bold d-block text-dark" style="font-size: 0.9rem;">${item.name}</span>
                            ${addonsText}
                            <span class="text-muted small">${(item.price + addonsTotal).toFixed(2)} ج.م</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button class="btn btn-outline-warning btn-xs rounded-circle" style="width: 26px; height: 26px; padding:0; display:flex; align-items:center; justify-content:center;" onclick="updateQuantity('${item.cartItemId}', -1)"><i class="bi bi-dash"></i></button>
                            <span class="fw-bold text-dark">${item.quantity}</span>
                            <button class="btn btn-outline-warning btn-xs rounded-circle" style="width: 26px; height: 26px; padding:0; display:flex; align-items:center; justify-content:center;" onclick="updateQuantity('${item.cartItemId}', 1)"><i class="bi bi-plus"></i></button>
                        </div>
                    </div>
                `;
            });

            container.innerHTML = html;
            document.getElementById('cartSubtotal').textContent = `${subtotal.toFixed(2)} ج.م`;
            checkoutBtn.disabled = false;
        }

        function checkoutTakeawayOrder() {
            let subtotal = cart.reduce((acc, i) => {
                const addonsTotal = i.addOns ? i.addOns.reduce((sum, a) => sum + a.price, 0) : 0;
                return acc + ((i.price + addonsTotal) * i.quantity);
            }, 0);
            
            if (takeawayModalInstance) takeawayModalInstance.hide();
            
            setTimeout(() => {
                document.getElementById('payOrderIds').value = "TAKEAWAY";
                currentOrderTotal = subtotal;
                document.getElementById('payTotalLabel').innerHTML = `${subtotal.toFixed(2)} <span style="font-size: 1rem;">ج.م</span>`;
                
                document.getElementById('payAmountReceived').value = subtotal.toFixed(2);
                document.getElementById('payChangeReturned').value = (0).toFixed(2);
                document.getElementById('payTipsLabel').textContent = "0.00 ج.م";
 
                const confirmBtn = document.querySelector('#paymentModal .btn-success');
                confirmBtn.setAttribute('onclick', 'submitTakeawayPayment()');
 
                payModalInstance = new bootstrap.Modal(document.getElementById('paymentModal'));
                payModalInstance.show();
            }, 350);
        }
 
        function submitTakeawayPayment() {
            const paidAmount = parseFloat(document.getElementById('payAmountReceived').value) || 0;
            const changeReturned = parseFloat(document.getElementById('payChangeReturned').value) || 0;
            
            let tips = paidAmount - currentOrderTotal - changeReturned;
            if (tips < 0) tips = 0;
 
            if (paidAmount < currentOrderTotal) {
                alert("المبلغ المدفوع أقل من القيمة المطلوبة للفاتورة!");
                return;
            }
 
            const items = cart.map(i => ({
                menuItemId: i.id,
                quantity: i.quantity,
                addOnIds: i.addOns ? i.addOns.map(a => a.id) : [],
                price: i.price,
                size: i.size || ''
            }));
 
            const payload = {
                items: items,
                paidAmount: paidAmount,
                changeReturned: changeReturned,
                tips: tips
            };
 
            const btn = document.querySelector('#paymentModal .btn-success');
            const originalText = btn ? btn.innerHTML : '';
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm ms-2"></span>جاري حفظ الطلب...';
            }
 
            safeFetch('/Cashier/CreateTakeawayOrder', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(response => {
                if (response.ok) {
                    if (payModalInstance) payModalInstance.hide();
                    sessionStorage.setItem('cashier_toast', JSON.stringify({ message: 'تم تسجيل طلب التيك أواي ودفع الفاتورة بنجاح!', type: 'success' }));
                    location.reload();
                } else {
                    alert('خطأ أثناء إرسال طلب التيك أواي');
                    if (btn) { btn.disabled = false; btn.innerHTML = originalText; }
                }
            })
            .catch(err => {
                console.error(err);
                if (btn) { btn.disabled = false; btn.innerHTML = originalText; }
            });
        }

        function playNotificationSound() {
            try {
                const audioContext = new (window.AudioContext || window.webkitAudioContext)();
                const oscillator = audioContext.createOscillator();
                const gainNode = audioContext.createGain();
                oscillator.connect(gainNode);
                gainNode.connect(audioContext.destination);
                oscillator.frequency.value = 700;
                oscillator.type = 'sine';
                gainNode.gain.setValueAtTime(0.3, audioContext.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.3);
                oscillator.start(audioContext.currentTime);
                oscillator.stop(audioContext.currentTime + 0.3);
            } catch (e) { }
        }

        function showNotification(message, type = 'info') {
            const container = document.querySelector('.toast-container') || createToastContainer();
            const toastId = 'toast-' + Date.now();
            const bgColor = type === 'success' ? 'bg-success' : type === 'warning' ? 'bg-warning text-dark' : 'bg-info';

            const toastHtml = `
                <div id="${toastId}" class="toast align-items-center text-white ${bgColor} border-0" role="alert">
                    <div class="d-flex">
                        <div class="toast-body">${message}</div>
                        <button type="button" class="btn-close btn-close-white ms-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>
            `;
            container.insertAdjacentHTML('beforeend', toastHtml);
            const toastEl = document.getElementById(toastId);
            const toast = new bootstrap.Toast(toastEl, { delay: 4000 });
            toast.show();
            toastEl.addEventListener('hidden.bs.toast', () => toastEl.remove());
        }

        function createToastContainer() {
            const container = document.createElement('div');
            container.className = 'toast-container position-fixed bottom-0 start-0 p-3';
            document.body.appendChild(container);
            return container;
        }

        connection.on("OrderAccepted", () => fetchAndRefreshOrders());
        connection.on("OrderReady", () => {
            fetchAndRefreshOrders();
            playNotificationSound();
            showNotification('يوجد طلبات جديدة جاهزة للدفع من المطبخ!', 'success');
        });
        connection.on("OrderCompleted", () => fetchAndRefreshOrders());
        connection.on("OrderCancelled", (order) => {
            fetchAndRefreshOrders();
            showNotification(`⚠️ تم إلغاء الطلب #${order.id} للطاولة ${order.tableNumber}`, 'warning');
        });
        connection.on("OrderItemCancelled", (data) => {
            fetchAndRefreshOrders();
            showNotification(`تم إلغاء صنف ${data.cancelledItemName} في الطاولة ${data.tableNumber}`, 'warning');
        });
        connection.on("OrderStatusChanged", () => fetchAndRefreshOrders());

        async function fetchAndRefreshOrders() {
            try {
                const response = await fetch('/Cashier/GetOrdersData');
                if (!response.ok) return;

                const orders = await response.json();
                let container = document.getElementById('orders-container');

                if (!container) {
                    const emptyState = document.getElementById('empty-state');
                    if (emptyState) {
                        emptyState.outerHTML = `<div class="row g-4" id="orders-container"></div>`;
                        container = document.getElementById('orders-container');
                    } else {
                        return;
                    }
                }

                if (!container) return;

                let html = '';
                orders.forEach(group => {
                    const isReady = group.status === 3;
                    const isCancelled = group.isCancelled === true;
                    const orderIdsStr = group.orderIds.join(',');
                    
                    let itemsHtml = '';
                    group.orderItems.forEach(item => {
                        const itemCancelled = item.isCancelled === true;
                        itemsHtml += `
                            <tr class="${itemCancelled ? "text-decoration-line-through text-danger" : ""}">
                                <td class="py-1 text-right">${item.menuItemName} ${itemCancelled ? "(ملغي)" : ""}</td>
                                <td class="text-left py-1">${item.quantity}</td>
                                <td class="text-left py-1">${item.price.toFixed(2)}</td>
                            </tr>
                        `;
                    });

                    const actionHtml = isCancelled
                        ? `<button class="btn btn-danger w-100 fw-bold rounded-pill py-2.5" onclick="dismissCancelled('${orderIdsStr}')">
                                <i class="bi bi-x-circle ms-1"></i> تجاهل وإزالة الإلغاء
                           </button>`
                        : `<a href="/Cashier/Receipt?ids=${orderIdsStr}" target="_blank" class="btn btn-outline-light w-50 rounded-pill py-2.5">
                                <i class="bi bi-printer ms-1"></i> الفاتورة
                           </a>
                           <button class="btn btn-success w-50 fw-bold rounded-pill py-2.5 shadow-sm" onclick="initiatePaymentModal('${orderIdsStr}', ${group.totalAmount})">
                                <i class="bi bi-cash-stack ms-1"></i> محاسبة
                           </button>`;

                    html += `
                        <div class="col-lg-4 col-md-6" id="order-card-${group.sessionId ? group.sessionId : -group.tableNumber}">
                            <div class="card h-100 shadow-sm border-0" style="background: #1e1e2d; border-radius: 16px; border: 1px solid ${isCancelled ? "rgba(220, 53, 69, 0.4)" : "rgba(255,255,255,0.05)"} !important; color: #fff;">
                                <div class="card-header border-0 d-flex justify-content-between align-items-center p-3 rounded-top-4" style="background: ${isCancelled ? "rgba(220, 53, 69, 0.15)" : isReady ? "rgba(40, 167, 69, 0.15)" : "rgba(255, 193, 7, 0.1)"}; border-bottom: 1px solid rgba(255,255,255,0.05) !important;">
                                    <h5 class="mb-0 fw-bold text-light">طاولة ${group.tableNumber} ${isCancelled ? '— ملغي' : ''}</h5>
                                    <span class="badge ${isCancelled ? "bg-danger" : isReady ? "bg-success" : "bg-warning"} text-dark fw-bold">
                                        ${isCancelled ? "ملغي" : isReady ? "جاهز" : (group.status === 1 ? 'مؤكد' : 'نشط')}
                                    </span>
                                </div>
                                <div class="card-body p-4 text-right" style="direction: rtl;">
                                    <div class="customer-info mb-3 p-3 rounded-4" style="background: rgba(255, 255, 255, 0.02); border-right: 4px solid ${isCancelled ? "#dc3545" : "#d4af37"}; border-left: 0;">
                                        <div class="fw-bold text-light"><i class="bi bi-person-fill ms-1 text-warning"></i> ${group.customerName}</div>
                                        <div class="small text-muted mt-1"><i class="bi bi-telephone-fill ms-1"></i> ${group.phoneNumber}</div>
                                    </div>
                                    <h3 class="card-title text-center my-3 fw-bold ${isCancelled ? "text-danger text-decoration-line-through" : "text-warning"}" style="font-size: 2.2rem;">
                                        ${group.totalAmount.toFixed(2)} <span style="font-size: 1.1rem; color: #fff;">ج.م</span>
                                    </h3>
                                    <div class="table-responsive" style="max-height: 180px; overflow-y: auto;">
                                        <table class="table table-sm table-dark table-borderless mb-0">
                                            <thead>
                                                <tr style="color: #d4af37; border-bottom: 1px solid rgba(255,255,255,0.05);">
                                                    <th class="text-right">الصنف</th>
                                                    <th class="text-left">الكمية</th>
