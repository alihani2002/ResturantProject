@model IEnumerable<Resturant.Core.Entities.Order>

@{
    ViewData["Title"] = "Cashier - Payments";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-cash-coin text-success me-2"></i>Cashier / Payments <span id="connection-status" class="badge bg-secondary ms-2"><i class="bi bi-wifi"></i> Connecting...</span></h2>
    <div class="d-flex align-items-center gap-3">
            <span class="badge bg-success fs-6" id="active-count">@Model.Count(o => o.Status != Resturant.Core.Entities.OrderStatus.Cancelled) Active</span>
            <span class="badge bg-danger fs-6" id="cancelled-count" style="display:@(Model.Any(o => o.Status == Resturant.Core.Entities.OrderStatus.Cancelled) ? "inline-block" : "none")!">@Model.Count(o => o.Status == Resturant.Core.Entities.OrderStatus.Cancelled) Cancelled</span>
            <a href="@Url.Action("AllOrders", "Cashier")" class="btn btn-outline-dark btn-sm">
                <i class="bi bi-calendar-range me-1"></i> All Orders
            </a>
            <a href="@Url.Action("PaidOrders", "Cashier")" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-clock-history me-1"></i> Paid Orders
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-wallet2 display-1 text-secondary"></i>
            <h3 class="mt-3">No payments pending</h3>
            <p class="text-muted">Wait for completed orders from the kitchen.</p>
        </div>
    }
    else
    {
        <div class="row g-4" id="orders-container">
            @{
                var groupedOrders = Model.GroupBy(o => o.TableSessionId ?? -o.TableNumber);
            }
            @foreach (var group in groupedOrders)
            {
                var firstOrder = group.First();
                // Effective total for initial render (excludes cancelled items)
                var totalAmount = group.SelectMany(o => o.OrderItems).Where(i => !i.IsCancelled).Sum(i => i.EffectiveTotal);
                var orderIds = string.Join(",", group.Select(o => o.Id));
                var isReady = group.Any(o => o.Status == Resturant.Core.Entities.OrderStatus.Ready);
                var isCancelledGroup = group.All(o => o.Status == Resturant.Core.Entities.OrderStatus.Cancelled);
                
                <div class="col-lg-4 col-md-6" id="order-card-@(group.Key)">
                    <div class="card h-100 shadow-sm @(isCancelledGroup ? "border-danger border-3" : "border-success")">
                        <div class="card-header @(isCancelledGroup ? "bg-danger" : isReady ? "bg-success" : "bg-warning") text-white d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">Table @firstOrder.TableNumber @(isCancelledGroup ? "— CANCELLED" : "")</h5>
                            <span class="badge bg-white @(isCancelledGroup ? "text-danger" : isReady ? "text-success" : "text-warning")">
                                @(isCancelledGroup ? "Cancelled" : isReady ? "Ready" : firstOrder.Status.ToString())
                            </span>
                        </div>
                        <div class="card-body">
                            <div class="customer-info mb-3 p-2 bg-light rounded border-start border-4 @(isCancelledGroup ? "border-danger" : "border-success")">
                                <div class="fw-bold text-dark"><i class="bi bi-person-fill me-1"></i> @(firstOrder.CustomerName ?? "Guest")</div>
                                <div class="small text-muted"><i class="bi bi-telephone-fill me-1"></i> @(firstOrder.PhoneNumber ?? "N/A")</div>
                            </div>

                            <h4 class="card-title text-center mb-4 display-6 @(isCancelledGroup ? "text-danger text-decoration-line-through" : "")">
                                $@totalAmount.ToString("0.00")
                            </h4>
                            <div class="table-responsive mb-3" style="max-height: 200px; overflow-y: auto;">
                                <table class="table table-sm table-borderless">
                                    <thead><tr><th>Item</th><th class="text-end">Qty</th><th class="text-end">Price</th></tr></thead>
                                    <tbody>
                                        @foreach (var order in group)
                                        {
                                            @foreach (var item in order.OrderItems)
                                            {
                                                <tr class="@(item.IsCancelled ? "text-decoration-line-through text-danger" : "")">
                                                    <td>@item.MenuItem.Name @(item.IsCancelled ? "(Cancelled)" : "")</td>
                                                    <td class="text-end">@item.Quantity</td>
                                                    <td class="text-end">$@item.Price.ToString("0.00")</td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="card-footer bg-white border-top-0 d-flex gap-2 pb-3">
                            @if (isCancelledGroup)
                            {
                                <button class="btn btn-danger flex-grow-1 fw-bold" onclick="dismissCancelled('@orderIds')">
                                    <i class="bi bi-x-circle me-1"></i> Dismiss Cancelled
                                </button>
                            }
                            else
                            {
                                <a href="@Url.Action("Receipt", "Cashier", new { ids = orderIds })" target="_blank" class="btn btn-outline-secondary flex-grow-1">
                                    <i class="bi bi-printer me-1"></i> Receipt
                                </a>
                                <button class="btn btn-success flex-grow-1 fw-bold" onclick="processPayment('@orderIds')">
                                    <i class="bi bi-check-circle me-1"></i> Paid
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script>
        // SignalR Connection with auto-reconnect
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/orderHub")
            .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
            .configureLogging(signalR.LogLevel.Warning)
            .build();

        // Connection state indicator
        function updateConnectionStatus(connected) {
            const badge = document.getElementById('connection-status');
            if (badge) {
                badge.className = connected ? 'badge bg-success ms-2' : 'badge bg-danger ms-2';
                badge.innerHTML = connected ? '<i class="bi bi-wifi"></i> Live' : '<i class="bi bi-wifi-off"></i> Offline';
            }
        }

        // Update order count badge
        function updateOrderCount() {
            const container = document.getElementById('orders-container');
            const count = container ? container.querySelectorAll('.col-lg-4').length : 0;
            const badge = document.querySelector('.badge.bg-success');
            if (badge) badge.textContent = count + ' Ready for Payment';
        }

        function createOrderCard(group) {
            const isReady = group.status === 3;
            const isCancelled = group.isCancelled === true;
            const statusClass = isCancelled ? 'bg-danger' : isReady ? 'bg-success' : 'bg-warning';
            const statusTextClass = isCancelled ? 'text-danger' : isReady ? 'text-success' : 'text-warning';
            const statusText = isCancelled ? 'Cancelled' : isReady ? 'Ready' : (group.status === 1 ? 'Confirmed' : 'Active');
            const cardBorder = isCancelled ? 'border-danger border-3' : 'border-success';
            const cardId = group.sessionId ? group.sessionId : -group.tableNumber;
            const orderIdsStr = group.orderIds.join(',');

            let itemsHtml = '';
            if (group.orderItems && group.orderItems.length > 0) {
                group.orderItems.forEach(item => {
                    const itemCancelled = item.isCancelled === true;
                    const lineStyle = itemCancelled ? 'text-decoration: line-through; color: #ef4444;' : '';
                    const cancelLabel = itemCancelled ? ' <span class="badge bg-danger" style="font-size:0.6rem;">Cancelled</span>' : '';
                    itemsHtml += `
                        <tr style="${lineStyle}">
                            <td>${item.menuItemName || 'Item'}${cancelLabel}</td>
                            <td class="text-end">${item.quantity}</td>
                            <td class="text-end">$${item.price.toFixed(2)}</td>
                        </tr>
                    `;
                });
            }

            const actionHtml = isCancelled
                ? `<button class="btn btn-danger flex-grow-1 fw-bold" onclick="dismissCancelled('${orderIdsStr}')">
                        <i class="bi bi-x-circle me-1"></i> Dismiss Cancelled
                   </button>`
                : `<a href="/Cashier/Receipt?ids=${orderIdsStr}" target="_blank" class="btn btn-outline-secondary flex-grow-1">
                        <i class="bi bi-printer me-1"></i> Receipt
                   </a>
                   <button class="btn btn-success flex-grow-1 fw-bold" onclick="processPayment('${orderIdsStr}')">
                        <i class="bi bi-credit-card-2-front me-1"></i> Paid
                   </button>`;

            const amountStyle = isCancelled ? 'text-decoration: line-through; color: #ef4444;' : '';

            return `
                <div class="col-lg-4 col-md-6" id="order-card-${cardId}">
                    <div class="card h-100 shadow-sm ${cardBorder}">
                        <div class="card-header ${statusClass} text-white d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">Table ${group.tableNumber}${isCancelled ? ' — CANCELLED' : ''}</h5>
                            <span class="badge bg-white ${statusTextClass}">${statusText}</span>
                        </div>
                        <div class="card-body">
                            <div class="customer-info mb-3 p-2 bg-light rounded border-start border-4 ${isCancelled ? 'border-danger' : 'border-success'}">
                                <div class="fw-bold text-dark"><i class="bi bi-person-fill me-1"></i> ${group.customerName}</div>
                                <div class="small text-muted"><i class="bi bi-telephone-fill me-1"></i> ${group.phoneNumber}</div>
                            </div>
                            <h4 class="card-title text-center mb-4 display-6" style="${amountStyle}">$${group.totalAmount.toFixed(2)}</h4>
                            <div class="table-responsive mb-3" style="max-height: 200px; overflow-y: auto;">
                                <table class="table table-sm table-borderless">
                                    <thead><tr><th>Item</th><th class="text-end">Qty</th><th class="text-end">Price</th></tr></thead>
                                    <tbody>${itemsHtml}</tbody>
                                </table>
                            </div>
                        </div>
                        <div class="card-footer bg-white border-top-0 d-flex gap-2 pb-3">${actionHtml}</div>
                    </div>
                </div>
            `;
        }

        // Add new order to the grid
        function addOrderCard(order) {
            const container = document.getElementById('orders-container');
            if (!container) {
                // If there's no container (empty state), refresh the page once
                location.reload();
                return;
            }

            // Check if order already exists
            const existingCard = document.getElementById(`order-card-${order.id}`);
            if (existingCard) {
                // Update existing card (status may have changed)
                existingCard.outerHTML = createOrderCard(order);
                return;
            }

            const cardHtml = createOrderCard(order);
            container.insertAdjacentHTML('afterbegin', cardHtml);

            // Flash animation
            const newCard = document.getElementById(`order-card-${order.id}`);
            if (newCard) {
                newCard.style.animation = 'pulse 0.5s ease-in-out';
            }

            updateOrderCount();
            playNotificationSound();
            showNotification(`Order for Table ${order.tableNumber} is ready for payment!`, 'success');
        }

        // Remove order card
        function removeOrderCard(cardId) {
            const card = document.getElementById(`order-card-${cardId}`);
            if (card) {
                card.style.transition = 'opacity 0.3s, transform 0.3s';
                card.style.opacity = '0';
                card.style.transform = 'scale(0.8)';
                setTimeout(() => {
                    card.remove();
                    updateOrderCount();
                    checkEmptyState();
                }, 300);
            }
        }

        // Check if we should show empty state
        function checkEmptyState() {
            const container = document.getElementById('orders-container');
            if (container && container.children.length === 0) {
                container.outerHTML = `
                    <div class="text-center py-5" id="empty-state">
                        <i class="bi bi-wallet2 display-1 text-secondary"></i>
                        <h3 class="mt-3">No payments pending</h3>
                        <p class="text-muted">Wait for completed orders from the kitchen.</p>
                    </div>
                `;
            }
        }

        // Play notification sound
        function playNotificationSound() {
            try {
                const audioContext = new (window.AudioContext || window.webkitAudioContext)();
                const oscillator = audioContext.createOscillator();
                const gainNode = audioContext.createGain();
                oscillator.connect(gainNode);
                gainNode.connect(audioContext.destination);
                oscillator.frequency.value = 700;
                oscillator.type = 'sine';
                gainNode.gain.setValueAtTime(0.3, audioContext.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.3);
                oscillator.start(audioContext.currentTime);
                oscillator.stop(audioContext.currentTime + 0.3);
            } catch (e) { }
        }

        // Show toast notification
        function showNotification(message, type = 'info') {
            const container = document.querySelector('.toast-container') || createToastContainer();
            const toastId = 'toast-' + Date.now();
            const bgColor = type === 'success' ? 'bg-success' : type === 'warning' ? 'bg-warning' : 'bg-info';

            const toastHtml = `
                <div id="${toastId}" class="toast align-items-center text-white ${bgColor} border-0" role="alert">
                    <div class="d-flex">
                        <div class="toast-body">${message}</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>
            `;
            container.insertAdjacentHTML('beforeend', toastHtml);
            const toastEl = document.getElementById(toastId);
            const toast = new bootstrap.Toast(toastEl, { delay: 4000 });
            toast.show();
            toastEl.addEventListener('hidden.bs.toast', () => toastEl.remove());
        }

        function createToastContainer() {
            const container = document.createElement('div');
            container.className = 'toast-container position-fixed bottom-0 end-0 p-3';
            document.body.appendChild(container);
            return container;
        }

        // SignalR event handlers - make cashier fully real-time
        connection.on("OrderAccepted", function (order) {
            fetchAndRefreshOrders();
        });

        connection.on("OrderReady", function (order) {
            fetchAndRefreshOrders();
        });

        connection.on("OrderCompleted", function (data) {
            fetchAndRefreshOrders();
        });

        connection.on("OrderCancelled", function (order) {
            fetchAndRefreshOrders();
            showNotification(`⚠️ Order #${order.id} for Table ${order.tableNumber} was CANCELLED by waiter`, 'warning');
        });

        connection.on("OrderItemCancelled", function (data) {
            fetchAndRefreshOrders();
            showNotification(`Item cancelled: ${data.cancelledItemName} on Table ${data.tableNumber}`, 'warning');
        });

        // Generic status change broadcast (used by many actions)
        connection.on("OrderStatusChanged", function (data) {
            fetchAndRefreshOrders();
        });

        // Legacy / broad events for extra safety
        connection.on("ReceiveAccountantUpdate", function (message) {
            fetchAndRefreshOrders();
        });

        connection.on("ReceiveWaiterUpdate", function (message) {
            fetchAndRefreshOrders();
        });

        connection.on("ReceiveChefUpdate", function (message) {
            fetchAndRefreshOrders();
        });

        // Fetch and refresh orders (real-time safe, handles empty state)
        async function fetchAndRefreshOrders() {
            try {
                const response = await fetch('/Cashier/GetOrdersData');
                if (!response.ok) return;

                const orders = await response.json();
                let container = document.getElementById('orders-container');

                // If we are currently showing the empty state, recreate the orders grid container
                if (!container) {
                    const emptyState = document.getElementById('empty-state');
                    if (emptyState) {
                        emptyState.outerHTML = `
                            <div class="row g-4" id="orders-container"></div>
                        `;
                        container = document.getElementById('orders-container');
                    } else {
                        // Fallback: hard refresh if structure is unexpected
                        location.reload();
                        return;
                    }
                }

                if (!container) return;

                // Build current and new sets of card IDs
                const currentCardIds = new Set(
                    Array.from(container.querySelectorAll('[id^="order-card-"]'))
                         .map(el => el.id.replace('order-card-', ''))
                );
                const newCardIds = new Set(
                    orders.map(o => (o.sessionId ? o.sessionId.toString() : (-o.tableNumber).toString()))
                );

                // Remove cards that are no longer present
                currentCardIds.forEach(id => {
                    if (!newCardIds.has(id)) removeOrderCard(id);
                });

                // Add or update cards
                orders.forEach(group => {
                    const cardId = group.sessionId ? group.sessionId.toString() : (-group.tableNumber).toString();
                    const existingCard = document.getElementById(`order-card-${cardId}`);
                    if (existingCard) {
                        existingCard.outerHTML = createOrderCard(group);
                    } else {
                        container.insertAdjacentHTML('afterbegin', createOrderCard(group));
                    }
                });

                updateOrderCount();
                checkEmptyState();   // will show empty message again if everything was removed
            } catch (error) {
                console.error('Error fetching orders for cashier:', error);
            }
        }

        // Start connection and join dashboard group
        async function startConnection() {
            try {
                await connection.start();
                console.log("SignalR Connected");
                await connection.invoke("JoinDashboard", "cashier");
                updateConnectionStatus(true);
            } catch (err) {
                console.error("SignalR Connection Error:", err);
                updateConnectionStatus(false);
                setTimeout(startConnection, 5000);
            }
        }

        connection.onreconnecting(() => updateConnectionStatus(false));
        connection.onreconnected(() => {
            connection.invoke("JoinDashboard", "cashier");
            updateConnectionStatus(true);
            fetchAndRefreshOrders();
        });
        connection.onclose(() => updateConnectionStatus(false));

        startConnection();

        function processPayment(orderIds) {
            if (!confirm('Confirm payment received for Table orders?')) return;

            fetch('/Cashier/ProcessPayment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `orderIds=${orderIds}`
            })
            .then(response => {
                if (response.ok) { fetchAndRefreshOrders(); showNotification('Payment processed and Table cleared!', 'success'); }
                else { alert('Error processing payment'); }
            });
        }

        function dismissCancelled(orderIds) {
            if (!confirm('Mark these cancelled orders as acknowledged and complete them?')) return;
            fetch('/Cashier/ProcessPayment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `orderIds=${orderIds}`
            })
            .then(response => {
                if (response.ok) { fetchAndRefreshOrders(); showNotification('Cancelled order dismissed.', 'success'); }
                else { alert('Error dismissing order'); }
            });
        }
    </script>
}