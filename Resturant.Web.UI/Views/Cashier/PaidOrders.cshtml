@model IEnumerable<Resturant.Core.Entities.Order>

@{
    ViewData["Title"] = "سجل الطلبات المدفوعة";
}

<div class="container-fluid mt-4" style="font-family: 'Cairo', 'Segoe UI', Tahoma, Geneva, sans-serif; direction: rtl; text-align: right;">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h2><i class="bi bi-clock-history text-primary ms-2"></i>سجل الطلبات المدفوعة</h2>
        <a href="@Url.Action("Index", "Cashier")" class="btn btn-outline-success rounded-pill px-3">
            <i class="bi bi-arrow-right ms-1"></i> العودة للوحة الكاشير
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-journal-x display-1 text-secondary opacity-25"></i>
            <h3 class="mt-3 text-muted">لا توجد طلبات مدفوعة بعد</h3>
            <p class="text-muted">الطلبات المكتملة ستظهر هنا.</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle mb-0" id="paidOrdersTable">
                        <thead class="table-dark">
                            <tr>
                                <th>رقم الطلب</th>
                                <th>الطاولة</th>
                                <th>الأصناف</th>
                                <th>المجموع الفرعي</th>
                                <th>المجموع الإجمالي</th>
                                <th>تاريخ الطلب</th>
                                <th>تاريخ الدفع</th>
                                <th class="text-center">الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td><strong>#@order.Id</strong></td>
                                    <td>
                                        <span class="badge bg-primary">طاولة @order.TableNumber</span>
                                    </td>
                                    <td>
                                        @foreach (var item in order.OrderItems)
                                        {
                                            <span class="d-block small text-muted">
                                                @item.Quantity x @item.MenuItem?.Name
                                            </span>
                                        }
                                    </td>
                                    <td>@order.TotalAmount.ToString("N2") ج.م</td>
                                    <td class="fw-bold text-success">@((order.TotalAmount + order.TaxAmount + order.ServiceAmount).ToString("N2")) ج.م</td>
                                    <td class="small text-muted">@order.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="small text-muted">@order.CompletedDate?.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="text-center">
                                        <a href="@Url.Action("Receipt", "Cashier", new { id = order.Id })" target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                            <i class="bi bi-printer ms-1"></i> طباعة الفاتورة
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <!-- DataTables JS & CSS -->
    <link rel="stylesheet" type="text/css" href="/assets/vendors/css/dataTables.bs5.min.css">
    <script src="/assets/vendors/js/dataTables.min.js"></script>
    <script src="/assets/vendors/js/dataTables.bs5.min.js"></script>
    
    <script>
        $(document).ready(function() {
            $('#paidOrdersTable').DataTable({
                "paging": true,
                "lengthChange": true,
                "searching": true,
                "ordering": true,
                "info": true,
                "autoWidth": false,
                "responsive": true,
                "language": {
                    "search": "البحث في الطلبات:",
                    "lengthMenu": "عرض _MENU_ طلبات لكل صفحة",
                    "info": "عرض من _START_ إلى _END_ من إجمالي _TOTAL_ طلب مدفوع",
                    "infoEmpty": "عرض 0 إلى 0 من 0 طلب",
                    "infoFiltered": "(تصفية من إجمالي _MAX_ طلب)",
                    "emptyTable": "لا توجد طلبات مدفوعة بعد",
                    "paginate": {
                        "first": "الأول",
                        "previous": "السابق",
                        "next": "التالي",
                        "last": "الأخير"
                    }
                }
            });
        });
    </script>
}
