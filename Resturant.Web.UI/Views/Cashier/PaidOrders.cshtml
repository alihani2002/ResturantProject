@model IEnumerable<Resturant.Core.Entities.Order>

@{
    ViewData["Title"] = "Paid Orders History";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-clock-history text-primary me-2"></i>Paid Orders History</h2>
        <a href="@Url.Action("Index", "Cashier")" class="btn btn-outline-success">
            <i class="bi bi-arrow-left me-1"></i> Back to Live Dashboard
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-journal-x display-1 text-secondary"></i>
            <h3 class="mt-3">No paid orders yet</h3>
            <p class="text-muted">Completed orders will appear here.</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Order #</th>
                                <th>Table</th>
                                <th>Items</th>
                                <th class="text-end">Total</th>
                                <th>Order Date</th>
                                <th>Paid Date</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td><strong>#@order.Id</strong></td>
                                    <td>
                                        <span class="badge bg-primary">Table @order.TableNumber</span>
                                    </td>
                                    <td>
                                        @foreach (var item in order.OrderItems)
                                        {
                                            <span class="d-block small">
                                                @item.Quantity x @item.MenuItem?.Name
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end fw-bold">$@order.TotalAmount.ToString("0.00")</td>
                                    <td>@order.OrderDate.ToString("MMM dd, HH:mm")</td>
                                    <td>@order.CompletedDate?.ToString("MMM dd, HH:mm")</td>
                                    <td class="text-center">
                                        <a href="@Url.Action("Receipt", "Cashier", new { id = order.Id })" target="_blank" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-printer me-1"></i> Receipt
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="3" class="text-end fw-bold">Total Revenue:</td>
                                <td class="text-end fw-bold text-success fs-5">$@Model.Sum(o => o.TotalAmount).ToString("0.00")</td>
                                <td colspan="3"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
