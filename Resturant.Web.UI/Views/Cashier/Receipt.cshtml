@model Resturant.Core.Entities.Order
@{
    Layout = null;
    var allOrders = ViewBag.AllOrders as List<Resturant.Core.Entities.Order> ?? new List<Resturant.Core.Entities.Order> { Model };
    
    // Sum from all orders in this session
    decimal subtotal = allOrders.Sum(o => o.OrderItems.Where(oi => !oi.IsCancelled).Sum(oi => oi.EffectiveTotal));
    decimal serviceAmount = allOrders.Sum(o => o.ServiceAmount);
    decimal taxAmount = allOrders.Sum(o => o.TaxAmount);
    decimal grandTotal = allOrders.Sum(o => o.TotalAmount);

    var firstOrder = allOrders.First();
    decimal servicePct = firstOrder.ServicePercentage;
    decimal taxPct = firstOrder.TaxPercentage;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>فاتورة - طاولة @Model.TableNumber</title>
    <!-- Google Fonts Cairo -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Cairo', 'Courier New', Courier, monospace;
            width: 76mm;
            margin: 0 auto;
            padding: 8px;
            color: #000;
            line-height: 1.3;
            direction: rtl;
            text-align: right;
            font-size: 12px;
        }
        .header {
            text-align: center;
            margin-bottom: 12px;
        }
        .header h1 {
            margin: 0 0 2px 0;
            font-size: 1.4rem;
            font-weight: bold;
        }
        .header p {
            margin: 0;
            font-size: 0.8rem;
        }
        .details {
            margin-bottom: 10px;
            font-size: 0.85rem;
            border-bottom: 1px dashed #000;
            padding-bottom: 8px;
        }
        .details table {
            width: 100%;
        }
        .details td {
            padding: 1px 0;
        }
        .items-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.85rem;
        }
        .items-table th {
            text-align: right;
            border-bottom: 1px dashed black;
            font-weight: bold;
            padding-bottom: 4px;
        }
        .items-table th.price-col, .items-table td.price-col {
            text-align: left;
        }
        .items-table td {
            padding: 4px 0;
        }
        .totals-block {
            margin-top: 10px;
            border-top: 1px dashed black;
            padding-top: 8px;
            font-size: 0.85rem;
        }
        .totals-block table {
            width: 100%;
        }
        .totals-block td {
            padding: 2px 0;
        }
        .grand-total-row {
            font-weight: bold;
            font-size: 1.15rem;
            border-top: 1px dotted #000;
        }
        .footer {
            margin-top: 20px;
            text-align: center;
            font-size: 0.8rem;
            border-top: 1px dashed black;
            padding-top: 8px;
        }
        @@media print {
            body { margin: 0; padding: 0; }
            .no-print { display: none !important; }
        }
    </style>
</head>
<body onload="window.print()">
    <div class="header">
        <h1>فاتورة مطعم وديوان</h1>
        <p>الفرع الرئيسي</p>
    </div>

    <div class="details">
        <table>
            <tr>
                <td><strong>التاريخ:</strong> @DateTime.Now.ToString("yyyy-MM-dd hh:mm tt")</td>
                <td style="text-align: left;"><strong>الطاولة:</strong> @(Model.TableNumber == 0 ? "تيك أواي" : "طاولة " + Model.TableNumber)</td>
            </tr>
            <tr>
                <td><strong>العميل:</strong> @(Model.CustomerName ?? "عميل زائر")</td>
                <td style="text-align: left;"><strong>الهاتف:</strong> @(Model.PhoneNumber ?? "غير متوفر")</td>
            </tr>
        </table>
    </div>

    <table class="items-table">
        <thead>
            <tr>
                <th>الصنف</th>
                <th style="width: 15%; text-align: center;">الكمية</th>
                <th class="price-col" style="width: 30%;">السعر</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in allOrders)
            {
                @foreach (var item in order.OrderItems)
                {
                    var isItemCancelled = item.IsCancelled;
                    var lineStyle = isItemCancelled ? "text-decoration: line-through; color: #777;" : "";
                    var displayPrice = isItemCancelled ? 0m : item.EffectiveTotal;
                    
                    <tr style="@lineStyle">
                        <td style="vertical-align: top;">
                            <span style="font-weight: bold;">@item.MenuItem.Name</span>
                            @if (isItemCancelled)
                            {
                                <span style="color:#d9534f; font-size:0.7rem; margin-right:4px;">(ملغي)</span>
                            }
                            @if (item.AddOns != null && item.AddOns.Any())
                            {
                                <div style="font-size: 0.75rem; padding-right: 6px; color: #555; font-style: italic;">
                                    @foreach (var addon in item.AddOns)
                                    {
                                        <div>+ @addon.AddOn?.Name (+@addon.Price.ToString("N2") ج.م)</div>
                                    }
                                </div>
                            }
                        </td>
                        <td style="text-align: center; vertical-align: top;">@item.Quantity</td>
                        <td class="price-col" style="vertical-align: top;">@displayPrice.ToString("N2") ج.م</td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <div class="totals-block">
        <table>
            <tr>
                <td>المجموع الفرعي:</td>
                <td style="text-align: left;">@subtotal.ToString("N2") ج.م</td>
            </tr>
            <tr>
                <td>الخدمة (@servicePct.ToString("0")%):</td>
                <td style="text-align: left;">@serviceAmount.ToString("N2") ج.م</td>
            </tr>
            <tr>
                <td>الضريبة (@taxPct.ToString("0")%):</td>
                <td style="text-align: left;">@taxAmount.ToString("N2") ج.م</td>
            </tr>
            <tr class="grand-total-row">
                <td style="padding-top: 6px;">الإجمالي الكلي:</td>
                <td style="text-align: left; padding-top: 6px;">@grandTotal.ToString("N2") ج.م</td>
            </tr>
        </table>
        
        @if (ViewBag.HadCancellations == true)
        {
            <div style="font-size: 0.7rem; color: #d9534f; margin-top: 6px; text-align: center;">(تم استبعاد الأصناف الملغية من الحساب الإجمالي)</div>
        }
    </div>

    <div class="footer">
        <p>شكراً لزيارتكم! سعدنا بخدمتكم</p>
        <p>نأمل رؤيتكم مرة أخرى قريباً</p>
    </div>

    <div class="no-print" style="margin-top: 20px; text-align: center;">
        <button onclick="window.print()" style="padding: 10px 20px; cursor: pointer; font-weight: bold; border-radius: 8px; border: 1px solid #000; background: #fff; font-family: 'Cairo', sans-serif;">طباعة الفاتورة</button>
    </div>
</body>
</html>
