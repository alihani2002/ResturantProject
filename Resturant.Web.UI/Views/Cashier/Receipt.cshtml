@model Resturant.Core.Entities.Order
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Receipt - Table @Model.TableNumber</title>
    <style>
        body {
            font-family: 'Courier New', Courier, monospace;
            width: 80mm;
            margin: 0 auto;
            padding: 10px;
        }
        .header {
            text-align: center;
            margin-bottom: 20px;
        }
        .header h1 {
            margin: 0;
            font-size: 1.5rem;
        }
        .details {
            margin-bottom: 20px;
            font-size: 0.9rem;
        }
        .items-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.9rem;
        }
        .items-table th {
            text-align: left;
            border-bottom: 1px dashed black;
        }
        .items-table td {
            padding: 4px 0;
        }
        .total-section {
            margin-top: 20px;
            border-top: 1px dashed black;
            padding-top: 10px;
            text-align: right;
            font-weight: bold;
            font-size: 1.1rem;
        }
        .footer {
            margin-top: 30px;
            text-align: center;
            font-size: 0.8rem;
        }
        @@media print {
            body { margin: 0; padding: 0; }
            .no-print { display: none; }
        }
    </style>
</head>
<body onload="window.print()">
    <div class="header">
        <h1>TestResturant</h1>
        <p>123 Restaurant Street<br>Food City</p>
    </div>

    <div class="details">
        <div>Date: @DateTime.Now.ToString("g")</div>
        <div>Table: @Model.TableNumber</div>
        <div style="border-top: 1px solid #eee; margin-top: 5px; padding-top: 5px;">
            <strong>Customer: @(Model.CustomerName ?? "Guest")</strong><br>
            Phone: @(Model.PhoneNumber ?? "N/A")
        </div>
    </div>

    <table class="items-table">
        <thead>
            <tr>
                <th>Item</th>
                <th>Qty</th>
                <th style="text-align: right;">Price</th>
            </tr>
        </thead>
        <tbody>
            @{
                var allOrders = ViewBag.AllOrders as List<Resturant.Core.Entities.Order> ?? new List<Resturant.Core.Entities.Order> { Model };
                decimal grandTotal = 0;
            }
            @foreach (var order in allOrders)
            {
                // Only sum non-cancelled items for the amount the customer actually pays
                var activeItems = order.OrderItems.Where(i => !i.IsCancelled).ToList();
                var orderEffectiveTotal = activeItems.Sum(i => i.EffectiveTotal);
                grandTotal += orderEffectiveTotal;

                @foreach (var item in order.OrderItems)
                {
                    var isItemCancelled = item.IsCancelled;
                    var lineStyle = isItemCancelled ? "text-decoration: line-through; color: #999;" : "";
                    var displayPrice = isItemCancelled ? 0m : item.EffectiveTotal;
                    <tr style="@lineStyle">
                        <td>
                            <span style="font-weight: bold;">@item.MenuItem.Name</span>
                            @if (isItemCancelled)
                            {
                                <span style="color:#dc3545; font-size:0.7rem; margin-left:6px;">(Cancelled)</span>
                            }
                            @if (item.AddOns != null && item.AddOns.Any())
                            {
                                <div style="font-size: 0.75rem; padding-left: 8px; color: #666; font-style: italic;">
                                    @foreach (var addon in item.AddOns)
                                    {
                                        <div>+ @addon.AddOn?.Name (+@addon.Price.ToString("F2") L.E.)</div>
                                    }
                                </div>
                            }
                        </td>
                        <td>@item.Quantity</td>
                        <td style="text-align: right;">@displayPrice.ToString("F2")</td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <div class="total-section">
        <strong>Total Due: @grandTotal.ToString("F2") L.E.</strong>
        @if (ViewBag.HadCancellations == true)
        {
            <div style="font-size: 0.75rem; color: #dc3545; margin-top: 4px;">(Some items were cancelled — only active items are charged)</div>
        }
    </div>

    <div class="footer">
        <p>Thank you for dining with us!</p>
        <p>Please visit us again.</p>
    </div>

    <div class="no-print" style="margin-top: 20px; text-align: center;">
        <button onclick="window.print()" style="padding: 10px 20px; cursor: pointer;">Print Receipt</button>
    </div>
</body>
</html>
