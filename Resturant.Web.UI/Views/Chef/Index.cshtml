@{
    ViewData["Title"] = "Chef Dashboard";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h2>Chef Dashboard</h2>
            <p>View and prepare orders</p>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h4>Orders to Prepare</h4>
                </div>
                <div class="card-body">
                    <div id="orders-container">
                        <p class="text-muted">Loading orders...</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/signalr/7.0.2/signalr.min.js"></script>
    <script>
        // SignalR connection
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/orderHub")
            .build();

        // Load orders to prepare
        function loadOrdersToPrepare() {
            // Load Confirmed (1) and InPreparation (2) orders
            Promise.all([
                fetch('/Order/GetOrdersByStatus?status=1').then(r => r.json()),
                fetch('/Order/GetOrdersByStatus?status=2').then(r => r.json())
            ])
            .then(([confirmedOrders, inPreparationOrders]) => {
                const container = document.getElementById('orders-container');
                const allOrders = [...confirmedOrders, ...inPreparationOrders];
                
                if (allOrders.length === 0) {
                    container.innerHTML = '<p class="text-muted">No orders to prepare</p>';
                    return;
                }

                let html = '<div class="row">';
                allOrders.forEach(order => {
                    const orderDate = new Date(order.orderDate).toLocaleString();
                    const isConfirmed = order.status === 1;
                    const statusText = isConfirmed ? 'Ready to Prepare' : 'In Preparation';
                    const statusClass = isConfirmed ? 'warning' : 'info';
                    const actionText = isConfirmed ? 'Start Preparation' : 'Mark as Ready';
                    const actionStatus = isConfirmed ? 2 : 3; // 2 = InPreparation, 3 = Ready
                    
                    let itemsHtml = '<ul class="list-group list-group-flush">';
                    
                    order.orderItems.forEach(item => {
                        itemsHtml += `
                            <li class="list-group-item d-flex justify-content-between">
                                <span>${item.menuItem.name} x ${item.quantity}</span>
                                <span>$${(item.price * item.quantity).toFixed(2)}</span>
                            </li>
                        `;
                    });
                    
                    itemsHtml += '</ul>';

                    html += `
                        <div class="col-md-6 mb-4">
                            <div class="card">
                                <div class="card-header">
                                    <h5>Order #${order.id} - Table ${order.tableNumber}</h5>
                                    <small>${orderDate}</small>
                                    <span class="badge bg-${statusClass}">${statusText}</span>
                                </div>
                                <div class="card-body">
                                    ${itemsHtml}
                                    <hr>
                                    <div class="d-flex justify-content-between">
                                        <strong>Total:</strong>
                                        <strong>$${order.totalAmount.toFixed(2)}</strong>
                                    </div>
                                </div>
                                <div class="card-footer">
                                    <button class="btn btn-primary btn-block" onclick="updateOrderStatus(${order.id}, ${actionStatus})">
                                        ${actionText}
                                    </button>
                                </div>
                            </div>
                        </div>
                    `;
                });
                
                html += '</div>';
                container.innerHTML = html;
            })
            .catch(error => {
                console.error('Error loading orders:', error);
            });
        }

        // Update order status
        function updateOrderStatus(orderId, status) {
            const statusText = status === 2 ? 'start preparation' : 'mark as ready';
            if (!confirm(`Are you sure you want to ${statusText} for this order?`)) {
                return;
            }

            fetch('/Order/UpdateStatus', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: `orderId=${orderId}&status=${status}`
            })
            .then(response => {
                if (response.ok) {
                    alert('Order status updated successfully');
                    loadOrdersToPrepare();
                } else {
                    alert('Error updating order status');
                }
            })
            .catch(error => {
                console.error('Error updating order status:', error);
                alert('Error updating order status');
            });
        }

        // SignalR event handlers
        connection.on("ReceiveChefUpdate", function(message) {
            console.log("Chef update received:", message);
            loadOrdersToPrepare();
        });

        connection.on("ReceiveOrderDetails", function(order) {
            console.log("Order details received:", order);
            loadOrdersToPrepare();
        });

        // Start SignalR connection
        connection.start()
            .then(function() {
                console.log("SignalR connected");
                loadOrdersToPrepare();
            })
            .catch(function(err) {
                console.error("SignalR connection error:", err);
            });

        // Load orders on page load
        document.addEventListener('DOMContentLoaded', function() {
            loadOrdersToPrepare();
        });
    </script>
}