@model IEnumerable<Resturant.Core.Entities.Order>

@{
    ViewData["Title"] = "تتبع طلبك";
}

<div class="container mt-5 text-right" style="direction: rtl; font-family: 'Cairo', sans-serif;">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0 rounded-lg">
                <div class="card-header bg-white text-dark text-center py-4">
                    <h3 class="font-weight-light mb-0"><i class="bi bi-search ms-2"></i>تتبع حالة طلبك</h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Track" method="get" class="mb-5">
                        <div class="input-group" style="direction: ltr;">
                            <button type="submit" class="btn btn-warning btn-lg rounded-pill-start px-4">
                                <i class="bi bi-search"></i>
                            </button>
                            <input type="tel" name="phone" class="form-control form-control-lg rounded-pill-end text-right" placeholder="أدخل رقم هاتفك المحمول للتتبع..." required style="direction: rtl;" />
                        </div>
                    </form>

                    @if (Model != null && Model.Any())
                    {
                        <h4 class="mb-4 text-right">طلباتك الأخيرة</h4>
                        @foreach (var order in Model.OrderByDescending(o => o.OrderDate))
                        {
                            <div class="card mb-3 border-0 bg-light shadow-sm text-right">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <div class="text-right">
                                            <h5 class="mb-0">طلب رقم #@order.Id</h5>
                                            <small class="text-muted">@order.OrderDate.ToString("yyyy-MM-dd, HH:mm")</small>
                                        </div>
                                        <div>
                                            @{
                                                var badgeClass = order.Status switch
                                                {
                                                    Resturant.Core.Entities.OrderStatus.Pending => "bg-warning text-dark",
                                                    Resturant.Core.Entities.OrderStatus.InPreparation => "bg-info text-white",
                                                    Resturant.Core.Entities.OrderStatus.Ready => "bg-primary text-white",
                                                    Resturant.Core.Entities.OrderStatus.Served => "bg-success text-white",
                                                    Resturant.Core.Entities.OrderStatus.Paid => "bg-success text-white",
                                                    _ => "bg-secondary text-white"
                                                };
                                                var statusArabic = order.Status switch
                                                {
                                                    Resturant.Core.Entities.OrderStatus.Pending => "قيد الانتظار",
                                                    Resturant.Core.Entities.OrderStatus.Confirmed => "مؤكد",
                                                    Resturant.Core.Entities.OrderStatus.InPreparation => "تحت التحضير",
                                                    Resturant.Core.Entities.OrderStatus.Ready => "جاهز للاستلام",
                                                    Resturant.Core.Entities.OrderStatus.Served => "تم التقديم",
                                                    Resturant.Core.Entities.OrderStatus.Paid => "تم الدفع",
                                                    _ => order.Status.ToString()
                                                };
                                            }
                                            <span class="badge @badgeClass p-2 fs-6">@statusArabic</span>
                                        </div>
                                    </div>
                                    <div class="progress mb-3" style="height: 10px; direction: ltr;">
                                        @{
                                            var progress = order.Status switch
                                            {
                                                Resturant.Core.Entities.OrderStatus.Pending => 20,
                                                Resturant.Core.Entities.OrderStatus.Confirmed => 40,
                                                Resturant.Core.Entities.OrderStatus.InPreparation => 60,
                                                Resturant.Core.Entities.OrderStatus.Ready => 80,
                                                Resturant.Core.Entities.OrderStatus.Served => 100,
                                                Resturant.Core.Entities.OrderStatus.Paid => 100,
                                                _ => 0
                                            };
                                        }
                                        <div class="progress-bar progress-bar-striped progress-bar-animated @(order.Status == Resturant.Core.Entities.OrderStatus.Paid ? "bg-success" : "")" 
                                             role="progressbar" style="width: @progress%" aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="fw-bold text-success">الإجمالي: @order.TotalAmount.ToString("0.00") ج.م</span>
                                        <span class="text-muted small">عرض التفاصيل</span>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else if (Context.Request.Query.ContainsKey("phone"))
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-emoji-frown display-1 text-muted opacity-25"></i>
                            <p class="mt-3 text-muted">لا توجد أي طلبات مسجلة برقم الهاتف هذا.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .rounded-pill-start { border-top-left-radius: 50rem !important; border-bottom-left-radius: 50rem !important; }
    .rounded-pill-end { border-top-right-radius: 50rem !important; border-bottom-right-radius: 50rem !important; padding-right: 1.5rem; }
    .card { border: none; }
</style>
