@* 
 * NOTE: didn't create migration or database
 *@
@model IEnumerable<Resturant.Core.Entities.Order>

@{
    ViewData["Title"] = "Track Your Order";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0 rounded-lg">
                <div class="card-header bg-dark text-gold text-center py-4">
                    <h3 class="font-weight-light mb-0"><i class="bi bi-search me-2"></i>Track Your Order</h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Track" method="get" class="mb-5">
                        <div class="input-group">
                            <input type="tel" name="phone" class="form-control form-control-lg rounded-pill-start" placeholder="Enter your phone number..." required />
                            <button type="submit" class="btn btn-dark btn-lg rounded-pill-end px-4">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </form>

                    @if (Model != null && Model.Any())
                    {
                        <h4 class="mb-4">Recent Orders</h4>
                        @foreach (var order in Model.OrderByDescending(o => o.OrderDate))
                        {
                            <div class="card mb-3 border-0 bg-light shadow-sm">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <div>
                                            <h5 class="mb-0">Order #@order.Id</h5>
                                            <small class="text-muted">@order.OrderDate.ToString("MMM dd, HH:mm")</small>
                                        </div>
                                        <div>
                                            @{
                                                var badgeClass = order.Status switch
                                                {
                                                    Resturant.Core.Entities.OrderStatus.Pending => "bg-warning text-dark",
                                                    Resturant.Core.Entities.OrderStatus.InPreparation => "bg-info text-white",
                                                    Resturant.Core.Entities.OrderStatus.Ready => "bg-primary text-white",
                                                    Resturant.Core.Entities.OrderStatus.Served => "bg-success text-white",
                                                    Resturant.Core.Entities.OrderStatus.Paid => "bg-success text-white",
                                                    _ => "bg-secondary text-white"
                                                };
                                            }
                                            <span class="badge @badgeClass p-2 fs-6">@order.Status</span>
                                        </div>
                                    </div>
                                    <div class="progress mb-3" style="height: 10px;">
                                        @{
                                            var progress = order.Status switch
                                            {
                                                Resturant.Core.Entities.OrderStatus.Pending => 20,
                                                Resturant.Core.Entities.OrderStatus.Confirmed => 40,
                                                Resturant.Core.Entities.OrderStatus.InPreparation => 60,
                                                Resturant.Core.Entities.OrderStatus.Ready => 80,
                                                Resturant.Core.Entities.OrderStatus.Served => 100,
                                                Resturant.Core.Entities.OrderStatus.Paid => 100,
                                                _ => 0
                                            };
                                        }
                                        <div class="progress-bar progress-bar-striped progress-bar-animated @(order.Status == Resturant.Core.Entities.OrderStatus.Paid ? "bg-success" : "")" 
                                             role="progressbar" style="width: @progress%" aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <span class="fw-bold">Total: $@order.TotalAmount.ToString("0.00")</span>
                                        <a href="#" class="text-dark small">View Details</a>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else if (Context.Request.Query.ContainsKey("phone"))
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-emoji-frown display-1 text-muted opacity-25"></i>
                            <p class="mt-3 text-muted">No orders found for this phone number.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .text-gold { color: #d4af37; }
    .bg-dark { background-color: #1a1a1a !important; }
    .btn-dark { background-color: #1a1a1a; border-color: #1a1a1a; }
    .btn-dark:hover { background-color: #d4af37; border-color: #d4af37; color: #1a1a1a; }
    .rounded-pill-start { border-top-left-radius: 50rem !important; border-bottom-left-radius: 50rem !important; padding-left: 1.5rem; }
    .rounded-pill-end { border-top-right-radius: 50rem !important; border-bottom-right-radius: 50rem !important; }
</style>
