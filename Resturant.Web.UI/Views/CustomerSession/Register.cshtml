@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Welcome - Qore Premium Menu</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="icon" type="image/png" href="~/assets/images/q.png">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Bootstrap 5.3 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <style>
            html {
                height: 100%;
                margin: 0;
                padding: 0;
            }

            :root {
                --bg-gradient: linear-gradient(135deg, #fffdf8 0%, #f8f6f2 100%);
                --gold-primary: #f59e0b;
                --gold-secondary: #d97706;
                --gold-glow: rgba(245, 158, 11, 0.15);
                --glass-bg: rgba(255, 255, 255, 0.88);
                --glass-border: rgba(245, 158, 11, 0.12);
                --text-dark: #1c1917;
                --text-muted: #78716c;
            }

            *, *::before, *::after {
                box-sizing: border-box;
            }

            body {
                background: var(--bg-gradient);
                font-family: 'Outfit', sans-serif;
                color: var(--text-dark);
                min-height: 100vh;
                overflow-x: hidden;
                margin: 0;
                padding: 0;
                position: relative;
            }

            .main-wrapper {
                width: 100%;
                min-height: 100vh;
                min-height: 100dvh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 20px;
                position: relative;
                z-index: 10;
            }

            /* Background Glow */
            .ambient-glow {
                position: absolute;
                width: 450px;
                height: 450px;
                border-radius: 50%;
                pointer-events: none;
                filter: blur(100px);
                opacity: 0.4;
                z-index: 1;
            }

            .glow-1 {
                background: radial-gradient(circle, rgba(245,158,11,0.12) 0%, transparent 70%);
                top: -10%;
                left: -10%;
            }

            .glow-2 {
                background: radial-gradient(circle, rgba(251,191,36,0.1) 0%, transparent 70%);
                bottom: -10%;
                right: -10%;
            }

            /* Arabic Text */
            .ar-text {
                font-family: 'Cairo', sans-serif !important;
                direction: rtl !important;
                unicode-bidi: embed;
                letter-spacing: normal !important;
            }

            /* Card */
            .glass-card {
                background: var(--glass-bg);
                border: 1px solid var(--glass-border);
                backdrop-filter: blur(25px);
                -webkit-backdrop-filter: blur(25px);
                border-radius: 32px;
                padding: 50px 40px 40px;
                max-width: 480px;
                width: 100%;
                position: relative;
                z-index: 10;
                box-shadow: 0 20px 60px rgba(0,0,0,0.08), 0 0 40px rgba(245,158,11,0.05);
            }

            /* Logo */
            .logo-container {
                width: 110px;
                height: 110px;
                margin: -105px auto 30px;
                position: relative;
            }

            .logo-ring-outer {
                width: 100%;
                height: 100%;
                border-radius: 50%;
                padding: 3px;
                background: linear-gradient(135deg, var(--gold-primary), var(--gold-secondary));
                box-shadow: 0 10px 30px rgba(245,158,11,0.25);
            }

            .logo-inner {
                width: 100%;
                height: 100%;
                border-radius: 50%;
                overflow: hidden;
                background: white;
                display: flex;
                align-items: center;
                justify-content: center;
            }

                .logo-inner img {
                    width: 85%;
                    height: 85%;
                    object-fit: contain;
                }

            /* Titles */
            .welcome-title-ar {
                font-size: 1.9rem;
                font-weight: 800;
                color: var(--gold-primary);
                text-align: center;
                margin-bottom: 8px;
            }

            .welcome-title-en {
                font-size: 1.3rem;
                font-weight: 700;
                color: var(--text-dark);
                text-align: center;
                margin-bottom: 18px;
                letter-spacing: 2px;
                text-transform: uppercase;
            }

            /* Subtitle Box */
            .welcome-subtitle-container {
                background: rgba(255,255,255,0.7);
                border: 1px solid rgba(245,158,11,0.08);
                border-radius: 18px;
                padding: 18px 20px;
                margin-bottom: 35px;
                text-align: center;
            }

            .subtitle-ar {
                color: #44403c;
                font-size: 0.95rem;
                line-height: 1.8;
                margin-bottom: 8px;
            }

            .subtitle-en {
                color: var(--text-muted);
                font-size: 0.88rem;
                margin: 0;
            }

            /* Inputs */
            .input-group-premium {
                margin-bottom: 26px;
            }

            .labels-row {
                display: flex;
                justify-content: space-between;
                margin-bottom: 10px;
            }

            .input-label-en {
                font-size: 0.8rem;
                font-weight: 700;
                color: #57534e;
                text-transform: uppercase;
                letter-spacing: 1px;
            }

            .input-label-ar {
                font-size: 0.85rem;
                font-weight: 700;
                color: var(--gold-primary);
            }

            .input-wrapper {
                position: relative;
            }

            .form-control-premium {
                width: 100%;
                padding: 16px 20px 16px 52px !important;
                background: rgba(255,255,255,0.95) !important;
                border: 1.5px solid rgba(245,158,11,0.12) !important;
                border-radius: 16px !important;
                color: var(--text-dark) !important;
                font-size: 1rem;
                transition: 0.3s ease;
                box-shadow: inset 0 2px 4px rgba(0,0,0,0.03);
            }

                .form-control-premium::placeholder {
                    color: #a8a29e !important;
                }

                .form-control-premium:focus {
                    border-color: var(--gold-primary) !important;
                    box-shadow: 0 0 0 4px rgba(245,158,11,0.12) !important;
                    outline: none;
                }

            .input-icon {
                position: absolute;
                left: 18px;
                top: 50%;
                transform: translateY(-50%);
                color: #a8a29e;
                font-size: 1.2rem;
            }

            /* Button */
            .btn-gold-glow {
                border: none;
                width: 100%;
                border-radius: 50px;
                padding: 16px 25px;
                background: linear-gradient(135deg, var(--gold-primary), var(--gold-secondary));
                color: white !important;
                font-weight: 700;
                font-size: 1rem;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 12px;
                transition: 0.3s ease;
                box-shadow: 0 12px 25px rgba(245,158,11,0.25);
            }

                .btn-gold-glow:hover {
                    transform: translateY(-3px);
                    box-shadow: 0 18px 35px rgba(245,158,11,0.35);
                }

            .btn-divider {
                width: 1px;
                height: 14px;
                background: rgba(255,255,255,0.4);
            }

            /* Footer */
            .footer-note {
                margin-top: 35px;
                padding-top: 22px;
                border-top: 1px solid rgba(0,0,0,0.05);
                text-align: center;
            }

            .footer-badge {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                background: rgba(245,158,11,0.08);
                border: 1px solid rgba(245,158,11,0.12);
                padding: 6px 14px;
                border-radius: 30px;
                margin-bottom: 12px;
            }

                .footer-badge i {
                    color: var(--gold-primary);
                }

                .footer-badge span {
                    font-size: 0.75rem;
                    font-weight: 600;
                    color: #57534e;
                }

            .footer-note-ar {
                font-size: 0.8rem;
                color: var(--text-muted);
            }

            /* Error */
            .custom-error-alert {
                background: rgba(239,68,68,0.08) !important;
                border: 1px solid rgba(239,68,68,0.2) !important;
                color: #dc2626 !important;
                border-radius: 16px !important;
                padding: 14px 18px !important;
                margin-bottom: 25px;
            }

            /* Mobile */
            @@media (max-width: 480px) {

                .glass-card {
                    padding: 35px 22px 25px;
                    border-radius: 24px;
                }

                .logo-container {
                    width: 90px;
                    height: 90px;
                    margin: -75px auto 20px;
                }

                .welcome-title-ar {
                    font-size: 1.5rem;
                }

                .welcome-title-en {
                    font-size: 1.1rem;
                }

                .form-control-premium {
                    padding: 14px 18px 14px 46px !important;
                    font-size: 0.92rem;
                }

                .btn-gold-glow {
                    flex-direction: column;
                    gap: 4px;
                }

                .btn-divider {
                    display: none;
                }
            }
    </style>
</head>
<body>
    <!-- Background ambient glowing particles -->
    <div class="ambient-glow glow-1"></div>
    <div class="ambient-glow glow-2"></div>

    <div class="main-wrapper">
        <div class="glass-card">
            <!-- Circular Qore Brand Logo Badge -->
            <div class="logo-container">
                <div class="logo-ring-outer">
                    <div class="logo-inner">
                        <img src="/assets/images/Qore.png" alt="Qore Logo" onerror="this.src='https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&q=80&w=200'">
                    </div>
                </div>
            </div>

        <!-- Bilingual Welcome Headings -->
        <h1 class="welcome-title-ar ar-text">أهلاً بك في الديوان</h1>
        <h2 class="welcome-title-en">Welcome</h2>
        
        <!-- Bilingual Subtitle Box -->
        @if (ViewBag.Error != null || ViewBag.TableIsOccupied == true)
        {
            <div class="welcome-subtitle-container" style="border-color: rgba(239,68,68,0.2); background: rgba(239,68,68,0.04);">
                <p class="subtitle-ar ar-text" style="color: #fca5a5;">هذه الطاولة محجوزة. يرجى إدخال نفس الاسم ورقم الهاتف المسجّل لهذه الطاولة (أو البيانات المخزنة على هاتفك إن كنت أنت الحاجز).</p>
                <p class="subtitle-en" style="color: #fca5a5;">This table is occupied. Enter the exact name &amp; phone used when it was reserved (or the data cached on your phone if you are the original guest).</p>
            </div>
        }
        else
        {
            <div class="welcome-subtitle-container">
                <p class="subtitle-ar ar-text">يرجى إدخال اسمك ورقم هاتفك لبدء تجربة طلب فريدة ومميزة.</p>
                <p class="subtitle-en">Please provide your details to start your digital ordering experience.</p>
            </div>
        }

        <!-- Validation Alert Banner -->
        @if (ViewBag.Error != null)
        {
            <div class="alert custom-error-alert d-flex align-items-center gap-3">
                <i class="bi bi-exclamation-triangle-fill fs-5 text-danger flex-shrink-0"></i>
                <div class="flex-grow-1">@ViewBag.Error</div>
            </div>
        }

        <!-- Registration Form -->
        <form asp-action="Register" method="post" class="needs-validation" novalidate>
            
            <!-- Full Name Input Group -->
            <div class="input-group-premium">
                <div class="labels-row">
                    <label for="nameInput" class="input-label-en">Full Name</label>
                    <label for="nameInput" class="input-label-ar ar-text">الاسم بالكامل</label>
                </div>
                <div class="input-wrapper">
                    <input type="text" name="customerName" class="form-control-premium" id="nameInput" placeholder="e.g. Aly Hani" required autocomplete="name">
                    <i class="bi bi-person-fill input-icon"></i>
                </div>
            </div>

            <!-- Phone Number Input Group -->
            <div class="input-group-premium">
                <div class="labels-row">
                    <label for="phoneInput" class="input-label-en">Phone Number</label>
                    <label for="phoneInput" class="input-label-ar ar-text">رقم الهاتف المحمول</label>
                </div>
                <div class="input-wrapper">
                    <input type="tel" name="phoneNumber" class="form-control-premium" id="phoneInput" placeholder="e.g. 01xxxxxxxxx" required autocomplete="tel">
                    <i class="bi bi-telephone-fill input-icon"></i>
                </div>
            </div>

            <!-- Start Ordering Action Button -->
            <div class="d-grid mt-4">
                <button type="submit" class="btn btn-gold-glow">
                    <span class="btn-label-en">Start Ordering</span>
                    <span class="btn-divider"></span>
                    <span class="btn-label-ar ar-text">ابدأ الطلب الآن</span>
                    <i class="bi bi-arrow-right-short fs-4"></i>
                </button>
            </div>
        </form>

        <!-- Premium Footer Privacy Note -->
        <div class="footer-note">
            <div class="footer-badge">
                <i class="bi bi-shield-fill-check"></i>
                <span>SECURE & PRIVATE SESSION</span>
            </div>
            <div class="footer-note-ar ar-text">بياناتك الشخصية آمنة طوال فترة تواجدك على الطاولة.</div>
        </div>
    </div>
</div>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Simple form validation styling for premium feedback
        (() => {
            'use strict'
            const forms = document.querySelectorAll('.needs-validation')
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault()
                        event.stopPropagation()
                    }
                    form.classList.add('was-validated')
                }, false)
            })
        })();

        // Handle client-side caching of Guest details (localStorage on the user's phone)
        document.addEventListener("DOMContentLoaded", function() {
            const CACHE_KEY_NAME = 'qore_guest_name';
            const CACHE_KEY_PHONE = 'qore_guest_phone';
            const CACHE_KEY_EXPIRY = 'qore_guest_expiry';
            const hasServerError = @(ViewBag.Error != null ? "true" : "false");

            const nameInput = document.getElementById('nameInput');
            const phoneInput = document.getElementById('phoneInput');
            const form = document.querySelector('form');

            // Always save to localStorage on successful submit (6-hour client cache)
            form.addEventListener('submit', function(e) {
                if (form.checkValidity()) {
                    localStorage.setItem(CACHE_KEY_NAME, nameInput.value.trim());
                    localStorage.setItem(CACHE_KEY_PHONE, phoneInput.value.trim());
                    localStorage.setItem(CACHE_KEY_EXPIRY, Date.now() + (6 * 60 * 60 * 1000));
                }
            });

            if (hasServerError) {
                // Previous attempt failed (wrong name/phone for occupied table) → clear bad cache
                localStorage.removeItem(CACHE_KEY_NAME);
                localStorage.removeItem(CACHE_KEY_PHONE);
                localStorage.removeItem(CACHE_KEY_EXPIRY);
            } else {
                // Pre-fill from phone cache if still valid (helps user re-use same data)
                // BUT do NOT auto-submit — the form must always be visibly displayed to the user.
                const expiry = localStorage.getItem(CACHE_KEY_EXPIRY);
                if (expiry && Date.now() < parseInt(expiry)) {
                    const cachedName = localStorage.getItem(CACHE_KEY_NAME);
                    const cachedPhone = localStorage.getItem(CACHE_KEY_PHONE);
                    if (cachedName && cachedPhone) {
                        nameInput.value = cachedName;
                        phoneInput.value = cachedPhone;
                        // Form is pre-filled from your phone's cache.
                        // User still sees the form and must tap the button to confirm.
                    }
                } else {
                    // Expired cache — clean up
                    localStorage.removeItem(CACHE_KEY_NAME);
                    localStorage.removeItem(CACHE_KEY_PHONE);
                    localStorage.removeItem(CACHE_KEY_EXPIRY);
                }
            }
        });
    </script>
</body>
</html>

