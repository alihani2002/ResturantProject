@model IEnumerable<Resturant.Core.Entities.Order>
@{
    ViewData["Title"] = "سجل توصيل الطيار";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var driver = ViewBag.Driver as Resturant.Core.Entities.Driver;
    var completedTrips = Model.Where(o => o.Status == Resturant.Core.Entities.OrderStatus.Completed || o.Status == Resturant.Core.Entities.OrderStatus.Paid || o.Status == Resturant.Core.Entities.OrderStatus.Delivered).ToList();
    var failedTrips = Model.Where(o => o.Status == Resturant.Core.Entities.OrderStatus.FailedDelivery).ToList();
    var totalCashCollected = completedTrips.Sum(o => o.TotalAmount);
    var totalFeesCollected = completedTrips.Sum(o => o.DeliveryFee);
}

<div class="container py-4" style="direction: rtl; text-align: right; font-family: 'Cairo', sans-serif;">
    <!-- Driver Info Header -->
    <div class="card border-0 shadow-sm rounded-4 mb-4" style="background: linear-gradient(135deg, #1e1e2d, #2c2c3e); color: #fff;">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                        <i class="bi bi-person-badge fs-2"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-1">مرحباً، @driver.FullName</h4>
                        <p class="text-light-50 small mb-0"><i class="bi bi-geo-alt-fill text-warning ms-1"></i> فرع: @driver.Branch?.Name</p>
                    </div>
                </div>
                <div>
                    <span class="badge rounded-pill px-3 py-2 fs-6 bg-success text-white">
                        سجل الرحلات
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="d-flex gap-2 mb-4">
        <a asp-action="Index" class="btn btn-outline-warning text-dark rounded-pill px-4 fw-bold">
            <i class="bi bi-bicycle ms-1"></i> الطلبات النشطة
        </a>
        <a asp-action="History" class="btn btn-warning rounded-pill px-4 fw-bold shadow-sm">
            <i class="bi bi-clock-history ms-1"></i> سجل الرحلات المنتهية
        </a>
    </div>

    <!-- Statistics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 text-center p-3 bg-white">
                <div class="text-warning display-6 mb-1"><i class="bi bi-check-circle-fill"></i></div>
                <span class="text-muted small">رحلات ناجحة</span>
                <h4 class="fw-bold text-dark mb-0">@completedTrips.Count</h4>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 text-center p-3 bg-white">
                <div class="text-danger display-6 mb-1"><i class="bi bi-x-circle-fill"></i></div>
                <span class="text-muted small">رحلات فاشلة</span>
                <h4 class="fw-bold text-dark mb-0">@failedTrips.Count</h4>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 text-center p-3 bg-white">
                <div class="text-success display-6 mb-1"><i class="bi bi-cash-stack"></i></div>
                <span class="text-muted small">إجمالي كاش المحصل</span>
                <h4 class="fw-bold text-success mb-0">@totalCashCollected.ToString("N2") ج.م</h4>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 text-center p-3 bg-white">
                <div class="text-primary display-6 mb-1"><i class="bi bi-bicycle"></i></div>
                <span class="text-muted small">إجمالي التوصيل</span>
                <h4 class="fw-bold text-primary mb-0">@totalFeesCollected.ToString("N2") ج.م</h4>
            </div>
        </div>
    </div>

    <!-- History Table/List -->
    <h5 class="fw-bold mb-3"><i class="bi bi-clock-history text-warning ms-1"></i> سجل الرحلات السابقة (آخر 50 رحلة)</h5>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 text-center py-5 bg-white">
            <div class="card-body">
                <i class="bi bi-inbox display-1 text-muted mb-3 d-block"></i>
                <h4 class="fw-bold text-dark">لا يوجد أي رحلات مسجلة سابقاً</h4>
                <p class="text-muted mb-0">رحلاتك المكتملة ستظهر هنا.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary">
                        <tr>
                            <th class="py-3 text-right">رقم الطلب</th>
                            <th class="py-3 text-right">العميل</th>
                            <th class="py-3 text-right">العنوان</th>
                            <th class="py-3 text-right">التاريخ والوقت</th>
                            <th class="py-3 text-left">خدمة التوصيل</th>
                            <th class="py-3 text-left">المبلغ الإجمالي</th>
                            <th class="py-3 text-center">الحالة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td class="py-3 fw-bold text-dark">#@order.Id</td>
                                <td class="py-3 fw-bold text-dark">
                                    @order.CustomerName
                                    <div class="small text-muted">@order.PhoneNumber</div>
                                </td>
                                <td class="py-3 text-muted small" style="max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                    @if (order.DeliveryAddress != null)
                                    {
                                        <span>@order.DeliveryAddress.Governorate، @order.DeliveryAddress.Area، @order.DeliveryAddress.Street</span>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td class="py-3 text-muted small">@order.OrderDate.ToString("yyyy-MM-dd hh:mm tt")</td>
                                <td class="py-3 text-left fw-bold text-primary">@order.DeliveryFee.ToString("N2") ج.م</td>
                                <td class="py-3 text-left fw-bold text-success">@order.TotalAmount.ToString("N2") ...ج.م</td>
                                <td class="py-3 text-center">
                                    <span class="badge rounded-pill px-3 py-1.5 fw-bold @(order.Status == Resturant.Core.Entities.OrderStatus.Completed || order.Status == Resturant.Core.Entities.OrderStatus.Paid ? "bg-success-subtle text-success border border-success-subtle" : order.Status == Resturant.Core.Entities.OrderStatus.Delivered ? "bg-info-subtle text-info border border-info-subtle" : "bg-danger-subtle text-danger border border-danger-subtle")">
                                        @(order.Status == Resturant.Core.Entities.OrderStatus.Completed || order.Status == Resturant.Core.Entities.OrderStatus.Paid ? "مكتمل ومسوى" : order.Status == Resturant.Core.Entities.OrderStatus.Delivered ? "تم التوصيل (بانتظار التسوية)" : "فشل التوصيل")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
