@model IEnumerable<Resturant.Core.Entities.Order>
@{
    ViewData["Title"] = "لوحة تحكم الطيار";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var driver = ViewBag.Driver as Resturant.Core.Entities.Driver;
}

<div class="container py-4" style="direction: rtl; text-align: right; font-family: 'Cairo', sans-serif;">
    <!-- Driver Info Header -->
    <div class="card border-0 shadow-sm rounded-4 mb-4" style="background: linear-gradient(135deg, #1e1e2d, #2c2c3e); color: #fff;">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                        <i class="bi bi-person-badge fs-2"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-1">مرحباً، @driver.FullName</h4>
                        <p class="text-light-50 small mb-0"><i class="bi bi-geo-alt-fill text-warning ms-1"></i> فرع: @driver.Branch?.Name</p>
                    </div>
                </div>
                <div>
                    <span class="badge rounded-pill px-3 py-2 fs-6 @(driver.Status == Resturant.Core.Entities.DriverStatus.Idle ? "bg-success text-white" : driver.Status == Resturant.Core.Entities.DriverStatus.OnDelivery ? "bg-warning text-dark" : "bg-secondary text-white")">
                        <i class="bi bi-circle-fill ms-1" style="font-size: 0.7rem;"></i>
                        @(driver.Status == Resturant.Core.Entities.DriverStatus.Idle ? "متاح للعمل" : driver.Status == Resturant.Core.Entities.DriverStatus.OnDelivery ? "خارج للتوصيل" : "غير متاح")
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="d-flex gap-2 mb-4">
        <a asp-action="Index" class="btn btn-warning rounded-pill px-4 fw-bold shadow-sm">
            <i class="bi bi-bicycle ms-1"></i> الطلبات النشطة
        </a>
        <a asp-action="History" class="btn btn-outline-secondary rounded-pill px-4 fw-bold">
            <i class="bi bi-clock-history ms-1"></i> سجل الرحلات المنتهية
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 rounded-4 text-center p-3 mb-4 shadow-sm" style="background-color: rgba(40, 167, 69, 0.15); color: #28a745;">
            <i class="bi bi-check-circle-fill ms-2"></i>@TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 rounded-4 text-center p-3 mb-4 shadow-sm" style="background-color: rgba(220, 53, 69, 0.15); color: #dc3545;">
            <i class="bi bi-x-circle-fill ms-2"></i>@TempData["ErrorMessage"]
        </div>
    }

    <!-- Active Orders List -->
    <h5 class="fw-bold mb-3"><i class="bi bi-card-list text-warning ms-1"></i> الطلبات المسندة إليك حالياً</h5>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 text-center py-5 bg-white">
            <div class="card-body">
                <i class="bi bi-inbox display-1 text-muted mb-3 d-block"></i>
                <h4 class="fw-bold text-dark">لا توجد طلبات نشطة حالياً</h4>
                <p class="text-muted mb-0">انتظر قيام الكاشير بتعيين طلب جديد لك.</p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var order in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 bg-white h-100 overflow-hidden" style="border: 1px solid rgba(0,0,0,0.05) !important;">
                        <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fw-bold text-dark">طلب دليفري #@order.Id</span>
                            </div>
                            <div>
                                <span class="badge @(order.Status == Resturant.Core.Entities.OrderStatus.OutForDelivery ? "bg-warning text-dark" : "bg-info text-dark") fw-bold">
                                    @(order.Status == Resturant.Core.Entities.OrderStatus.OutForDelivery ? "في الطريق للعميل" : "جاهز للتوصيل")
                                </span>
                            </div>
                        </div>

                        <div class="card-body p-4">
                            <!-- Customer Details -->
                            <div class="mb-3">
                                <span class="text-muted small d-block">العميل</span>
                                <span class="fw-bold text-dark"><i class="bi bi-person-fill text-warning ms-1"></i> @order.CustomerName</span>
                            </div>

                            <div class="mb-3">
                                <span class="text-muted small d-block">رقم الهاتف</span>
                                <a href="tel:@order.PhoneNumber" class="btn btn-sm btn-outline-warning text-dark fw-bold px-3 rounded-pill mt-1">
                                    <i class="bi bi-telephone-fill ms-1"></i> @order.PhoneNumber
                                </a>
                            </div>

                            <div class="mb-3 p-3 rounded-3 bg-light border-right-warning" style="border-right: 4px solid #ffc107;">
                                <span class="text-muted small d-block">عنوان التوصيل</span>
                                @if (order.DeliveryAddress != null)
                                {
                                    <span class="text-dark small fw-semibold">
                                        @order.DeliveryAddress.Governorate، @order.DeliveryAddress.Area، شارع @order.DeliveryAddress.Street، عمارة @order.DeliveryAddress.Building، دور @order.DeliveryAddress.Floor، شقة @order.DeliveryAddress.ApartmentNumber
                                    </span>
                                    @if (!string.IsNullOrEmpty(order.DeliveryAddress.DeliveryInstructions))
                                    {
                                        <div class="mt-2 text-danger small">
                                            <strong>ملاحظة السائق:</strong> @order.DeliveryAddress.DeliveryInstructions
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="text-danger small">لا يوجد تفاصيل عنوان</span>
                                }
                            </div>

                            <!-- Financial Summary -->
                            <div class="d-flex justify-content-between align-items-center border-top pt-3 mt-3">
                                <div>
                                    <span class="text-muted small">تكلفة التوصيل</span>
                                    <h6 class="fw-bold text-dark mb-0">@order.DeliveryFee.ToString("N2") ج.م</h6>
                                </div>
                                <div class="text-left">
                                    <span class="text-muted small">المجموع المطلوب</span>
                                    <h5 class="fw-bold text-success mb-0">@order.TotalAmount.ToString("N2") ج.م</h5>
                                </div>
                            </div>
                        </div>

                        <div class="card-footer bg-transparent border-0 p-3 pt-0 d-flex gap-2">
                            @if (order.Status == Resturant.Core.Entities.OrderStatus.Ready)
                            {
                                <form asp-action="StartTrip" method="post" class="w-100">
                                    <input type="hidden" name="orderId" value="@order.Id" />
                                    <button type="submit" class="btn btn-warning text-dark w-100 fw-bold rounded-pill py-2">
                                        <i class="bi bi-bicycle ms-1"></i> بدء الرحلة والتوصيل
                                    </button>
                                </form>
                            }
                            else if (order.Status == Resturant.Core.Entities.OrderStatus.OutForDelivery)
                            {
                                <form asp-action="CompleteOrder" method="post" class="w-50">
                                    <input type="hidden" name="orderId" value="@order.Id" />
                                    <button type="submit" class="btn btn-success w-100 fw-bold rounded-pill py-2">
                                        <i class="bi bi-check-circle-fill ms-1"></i> تم التوصيل
                                    </button>
                                </form>

                                <button class="btn btn-outline-danger w-50 fw-bold rounded-pill py-2" onclick="openFailModal(@order.Id)">
                                    <i class="bi bi-x-circle-fill ms-1"></i> فشل التوصيل
                                </button>
                            }
                        </div>

                        <!-- Live Location Simulator for Driver -->
                        @if (order.Status == Resturant.Core.Entities.OrderStatus.OutForDelivery)
                        {
                            <div class="p-3 bg-light border-top text-center">
                                <span class="small text-muted d-block mb-2">محاكي موقع الطيار المباشر (SignalR)</span>
                                <button class="btn btn-sm btn-dark rounded-pill px-3 fw-bold" onclick="simulateLocation(@order.Id)">
                                    <i class="bi bi-geo-alt-fill text-warning ms-1"></i> محاكاة خط السير للعميل
                                </button>
                                <span id="loc-status-@order.Id" class="small d-block mt-1 text-success fw-bold" style="display:none;">جاري إرسال الموقع للعميل...</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Modal: Fail Delivery -->
<div class="modal fade" id="failOrderModal" tabindex="-1" aria-hidden="true" style="font-family: 'Cairo', sans-serif;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0">
            <div style="height: 5px; background: #dc3545; border-radius: 4px 4px 0 0;"></div>
            <div class="modal-header border-0 bg-light p-3">
                <h5 class="modal-title fw-bold text-dark"><i class="bi bi-exclamation-triangle-fill text-danger ms-2"></i>تسجيل فشل التوصيل</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="margin-right: auto; margin-left: 0;"></button>
            </div>
            <form asp-action="FailOrder" method="post">
                <div class="modal-body p-4 text-right" style="direction: rtl;">
                    <input type="hidden" name="orderId" id="failOrderId" />
                    
                    <div class="mb-3">
                        <label class="form-label text-dark fw-bold">سبب فشل التوصيل</label>
                        <select name="reason" class="form-select rounded-pill text-right" required>
                            <option value="العميل لا يجيب على الهاتف">العميل لا يجيب على الهاتف</option>
                            <option value="العنوان غير صحيح أو غير واضح">العنوان غير صحيح أو غير واضح</option>
                            <option value="العميل قام بإلغاء الطلب عند الوصول">العميل قام بإلغاء الطلب عند الوصول</option>
                            <option value="حدث عطل في وسيلة التوصيل">حدث عطل في وسيلة التوصيل</option>
                            <option value="أخرى">أخرى (اذكر في الملاحظات)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0 p-3 bg-light d-flex justify-content-between">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">تأكيد التسجيل</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script>
        // Setup SignalR connection for location simulation
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/orderHub")
            .withAutomaticReconnect()
            .build();

        connection.start().then(() => {
            console.log("SignalR Connected for Driver Live updates.");
        }).catch(err => console.error("SignalR Connection Error: ", err));

        function openFailModal(orderId) {
            document.getElementById('failOrderId').value = orderId;
            const modal = new bootstrap.Modal(document.getElementById('failOrderModal'));
            modal.show();
        }

        // Simulate path movement coordinates
        const pathPoints = [
            { lat: 30.0444, lng: 31.2357 },
            { lat: 30.0450, lng: 31.2370 },
            { lat: 30.0460, lng: 31.2385 },
            { lat: 30.0475, lng: 31.2400 },
            { lat: 30.0490, lng: 31.2420 },
            { lat: 30.0500, lng: 31.2435 }
        ];

        function simulateLocation(orderId) {
            const statusSpan = document.getElementById(`loc-status-${orderId}`);
            statusSpan.style.display = 'block';
            statusSpan.textContent = "جاري الاتصال بقمر تحديد المواقع...";

            let index = 0;
            const interval = setInterval(async () => {
                if (index >= pathPoints.length) {
                    clearInterval(interval);
                    statusSpan.textContent = "تم إكمال خط السير المحاكي بنجاح!";
                    setTimeout(() => { statusSpan.style.display = 'none'; }, 4000);
                    return;
                }

                const point = pathPoints[index];
                statusSpan.textContent = `إرسال الموقع المباشر: (${point.lat.toFixed(4)} , ${point.lng.toFixed(4)})`;

                try {
                    // Send location via POST to the api
                    await fetch('/api/delivery/driver/location', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            orderId: orderId,
                            latitude: point.lat,
                            longitude: point.lng
                        })
                    });
                } catch (e) {
                    console.error("Error sending simulation location", e);
                }

                index++;
            }, 3000);
        }
    </script>
}
