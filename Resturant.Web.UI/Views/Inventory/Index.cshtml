@{
    Layout = null;
    ViewData["Title"] = "Qore ERP - المخازن وسلاسل الإمداد";
}
<!DOCTYPE html>
<html lang="ar" class="h-full" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Google Fonts Outfit & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" href="~/assets/images/q.png">
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        outfit: ['Outfit', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#fdfbf7',
                            100: '#fbf7e6',
                            200: '#f7eec2',
                            300: '#f1df91',
                            400: '#eac85c',
                            500: '#d4af37', // primary gold
                            600: '#bd992e',
                            700: '#9e7d24',
                            800: '#7f641e',
                            900: '#68511a',
                        },
                        darkBg: '#070708', // true luxury obsidian black
                        darkCard: '#0f0f12', // rich dark grey card
                        darkBorder: '#1c1c22', // subtle border
                    }
                }
            }
        }
    </script>

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- SheetJS (xlsx) for Excel Exports -->
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        .outfit-font {
            font-family: 'Outfit', sans-serif;
        }
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        .dark ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
    </style>
</head>
<body class="h-full bg-slate-50 text-slate-800 dark:bg-darkBg dark:text-slate-200 transition-colors duration-200 overflow-hidden flex">

    <!-- INVENTORY SIDEBAR -->
    <aside class="w-64 bg-white dark:bg-darkCard border-r border-slate-200 dark:border-darkBorder flex flex-col h-full z-20 transition-all duration-300 shrink-0">
        <!-- Sidebar Brand Logo -->
        <div class="h-16 flex items-center justify-between px-6 border-b border-slate-100 dark:border-darkBorder">
            <div class="flex items-center gap-3">
                <div class="p-1 rounded-xl">
                    <img src="/assets/images/Qore.png" alt="Qore" class="h-8 w-auto">
                </div>
                <div>
                    <h1 class="outfit-font font-black text-lg leading-tight tracking-wide text-slate-900 dark:text-white uppercase">QORE ERP</h1>
                    <p class="text-[10px] text-amber-500 font-semibold tracking-widest uppercase">المخازن وسلاسل الإمداد</p>
                </div>
            </div>
        </div>

        <!-- Sidebar Navigation Tabs -->
        <nav class="flex-1 px-4 py-4 space-y-1 overflow-y-auto">
            <button onclick="switchTab('inventory-mgmt')" id="btn-tab-inventory-mgmt" class="w-full flex items-center gap-3 px-4 py-3 text-sm font-bold rounded-xl transition-all duration-200 bg-brand-500 text-white shadow-md shadow-brand-500/10 text-right justify-start" dir="rtl">
                <i class="bi bi-box-seam text-base"></i>
                <span>مخزون المواد الخام</span>
            </button>

            <button onclick="switchTab('stock-transfers')" id="btn-tab-stock-transfers" class="w-full flex items-center gap-3 px-4 py-2.5 text-sm font-semibold rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all text-right justify-start" dir="rtl">
                <i class="bi bi-arrow-left-right text-base text-indigo-500"></i>
                <span>تحويلات المخزون</span>
            </button>

            <button onclick="switchTab('recipe-mgmt')" id="btn-tab-recipe-mgmt" class="w-full flex items-center gap-3 px-4 py-2.5 text-sm font-semibold rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all text-right justify-start" dir="rtl">
                <i class="bi bi-receipt text-base text-rose-500"></i>
                <span>مكونات الوصفات (الريسبات)</span>
            </button>

            <button onclick="switchTab('daily-consumption')" id="btn-tab-daily-consumption" class="w-full flex items-center gap-3 px-4 py-2.5 text-sm font-semibold rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all text-right justify-start" dir="rtl">
                <i class="bi bi-calendar-check text-base text-emerald-500"></i>
                <span>تقرير الاستهلاك ومطابقة المخزن</span>
            </button>
        </nav>

        <!-- Footer Operations Link -->
        <div class="p-4 border-t border-slate-100 dark:border-darkBorder bg-slate-50/50 dark:bg-darkCard space-y-2">
            <a href="/Admin" class="w-full flex items-center gap-3 px-4 py-2 text-xs font-bold rounded-lg border border-sky-200 dark:border-sky-900/50 text-sky-600 dark:text-sky-400 hover:bg-sky-50 dark:hover:bg-sky-900/20 transition-all justify-center">
                <i class="bi bi-speedometer2"></i>
                <span>العودة للوحة التحكم الرئيسية</span>
            </a>

            <form action="/Identity/Account/Logout?returnUrl=%2F" method="post" id="logoutForm" class="w-full m-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="w-full flex items-center gap-3 px-4 py-2.5 text-xs font-black rounded-lg bg-red-50 hover:bg-red-100 text-red-600 dark:bg-red-950/20 dark:hover:bg-red-950/30 dark:text-red-400 transition-all justify-center">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>تسجيل الخروج</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- MAIN APP WRAPPER -->
    <div class="flex-1 flex flex-col h-full overflow-hidden min-w-0">

        <!-- HEADER -->
        <partial name="../Admin/Partials/_Header" />

        <!-- CONTAINER FOR SCROLLABLE TABS -->
        <main class="flex-1 overflow-y-auto p-8 min-h-0 space-y-8 relative">

            <!-- TAB: INVENTORY STOCK MANAGEMENT -->
            <partial name="../Admin/Partials/_InventoryMgmtTab" />

            <!-- TAB: STOCK TRANSFERS WORKFLOW -->
            <partial name="../Admin/Partials/_StockTransfersTab" />

            <!-- TAB: MENU ITEM RECIPE MANAGEMENT -->
            <partial name="../Admin/Partials/_RecipeMgmtTab" />

            <!-- TAB: DAILY INVENTORY CONSUMPTION REPORT -->
            <partial name="../Admin/Partials/_DailyConsumptionTab" />

        </main>
    </div>

    <!-- MODALS -->
    <partial name="../Admin/Partials/_Modals" />

    <!-- JQUERY AND SIGNALR -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>

    <!-- CORE SCRIPTS -->
    <script>
        // State Management
        let currentTab = 'inventory-mgmt';
        let inventoryStockData = [];
        let recipeMenuItemsData = [];
        let selectedRecipeMenuItemId = null;
        let branchIngredientsCache = [];
        let suppliersListCache = [];
        let suppliersListCacheBranchId = null;
        let globalAllIngredientsList = [];
        let sourceBranchIngredientsMap = {};

        // Auto apply theme on load
        if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
            const icon = document.getElementById('theme-toggle-icon');
            if (icon) icon.className = 'bi bi-sun-fill text-sm';
        } else {
            document.documentElement.classList.remove('dark');
            const icon = document.getElementById('theme-toggle-icon');
            if (icon) icon.className = 'bi bi-moon-fill text-sm';
        }

        // Dark / Light Mode Toggle
        function toggleDarkMode() {
            const html = document.documentElement;
            const icon = document.getElementById('theme-toggle-icon');
            if (html.classList.contains('dark')) {
                html.classList.remove('dark');
                localStorage.setItem('theme', 'light');
                if (icon) icon.className = 'bi bi-moon-fill text-sm';
            } else {
                html.classList.add('dark');
                localStorage.setItem('theme', 'dark');
                if (icon) icon.className = 'bi bi-sun-fill text-sm';
            }
        }

        // Switch Branch Context Handler
        function onAdminBranchChanged(branchId) {
            $.post('/Admin/SwitchBranch', { branchId: branchId ? parseInt(branchId) : null })
             .done(function() {
                 location.reload();
             })
             .fail(function() {
                 alert("فشل تغيير الفرع.");
             });
        }

        // Tab Switcher
        function switchTab(tabId) {
            // Hide all tabs
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));

            // Remove active classes from all sidebar buttons
            document.querySelectorAll('aside nav button').forEach(btn => {
                btn.className = "w-full flex items-center gap-3 px-4 py-2.5 text-sm font-semibold rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all text-right justify-start";
            });

            // Show active tab
            const targetTab = document.getElementById(`tab-${tabId}`);
            if (targetTab) {
                targetTab.classList.remove('hidden');
            }

            // Apply active class to the button
            const activeBtn = document.getElementById(`btn-tab-${tabId}`);
            if (activeBtn) {
                activeBtn.className = "w-full flex items-center gap-3 px-4 py-3 text-sm font-bold rounded-xl transition-all duration-200 bg-brand-500 text-white shadow-md shadow-brand-500/10 text-right justify-start";
            }

            // Update Breadcrumb/Title
            const titles = {
                'inventory-mgmt': 'مخزون المواد الخام في الفروع',
                'stock-transfers': 'طلبات وتحويلات المخزون بين الفروع',
                'recipe-mgmt': 'مكونات الوصفات والريسبات للأطباق',
                'daily-consumption': 'تقرير الاستهلاك اليومي ومطابقة المخزن'
            };
            const activeTitleEl = document.getElementById('active-tab-title');
            if (activeTitleEl) {
                activeTitleEl.textContent = titles[tabId] || 'إدارة المخازن وسلاسل الإمداد';
            }

            currentTab = tabId;

            // Fetch tab data
            if (tabId === 'inventory-mgmt') {
                loadInventoryStockList();
            } else if (tabId === 'stock-transfers') {
                loadStockTransfersList();
            } else if (tabId === 'recipe-mgmt') {
                loadRecipeMenuItems();
                loadRecipeIngredientsDatalist();
            } else if (tabId === 'daily-consumption') {
                initDailyConsumptionTab();
            }
        }

        // ==============================================
        // INVENTORY MANAGEMENT SYSTEM CORE JAVASCRIPT
        // ==============================================

        // Toast alert helper
        function showToastAlert(message, type = 'success') {
            const container = document.getElementById('toast-container');
            if (!container) return;
            const bgClass = type === 'success' ? 'bg-emerald-500' : (type === 'error' ? 'bg-red-500' : 'bg-brand-500');
            const icon = type === 'success' ? 'bi-check-circle' : (type === 'error' ? 'bi-exclamation-triangle' : 'bi-info-circle');
            const toast = document.createElement('div');
            toast.className = `${bgClass} text-white px-4 py-3 rounded-xl shadow-lg flex items-center gap-3 text-xs font-bold transition-all duration-300 transform translate-y-2 opacity-0`;
            toast.innerHTML = `<i class="bi ${icon} text-base"></i> <span>${message}</span>`;
            container.appendChild(toast);
            setTimeout(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            }, 50);
            setTimeout(() => {
                toast.classList.add('translate-y-2', 'opacity-0');
                setTimeout(() => toast.remove(), 300);
            }, 4000);
        }

        // 1. Inventory Stock Actions
        function loadInventoryStockList() {
            const branchId = $('#header-branch-selector').val();
            const tbody = document.querySelector('#table-inventory-stock tbody');
            const alertList = document.getElementById('inventory-low-stock-list');
            if (tbody) {
                tbody.innerHTML = `<tr><td colspan="7" class="text-center py-8 text-slate-400 dark:text-slate-500">جاري تحميل سجلات المخزن الحية...</td></tr>`;
            }
            if (alertList) {
                alertList.innerHTML = `<div class="p-4 border border-slate-200 dark:border-darkBorder text-slate-400 text-xs rounded-xl text-center font-bold">جاري تحميل تنبيهات المخزون...</div>`;
            }
            $.get('/Inventory/GetStockLevels', { branchId: branchId ? parseInt(branchId) : null })
             .done(function(data) {
                 inventoryStockData = data;
                 renderInventoryTable();
                 updateInventoryKPIs();
             })
             .fail(function() {
                 inventoryStockData = [];
                 if (tbody) {
                     tbody.innerHTML = `<tr><td colspan="7" class="text-center py-8 text-red-500">تعذر تحميل سجلات المخزن الحية من قاعدة البيانات.</td></tr>`;
                 }
                 if (alertList) {
                     alertList.innerHTML = `<div class="p-4 border border-red-500/10 bg-red-500/5 text-red-500 text-xs rounded-xl text-center font-bold">تنبيهات المخزون غير متوفرة بسبب فشل تحميل بيانات المخزن الحية.</div>`;
                 }
                 showToastAlert("فشل تحميل مستويات مخزون المواد الخام.", "error");
             });
        }

        function renderInventoryTable() {
            const tbody = document.querySelector('#table-inventory-stock tbody');
            const alertList = document.getElementById('inventory-low-stock-list');
            if (!tbody) return;
            tbody.innerHTML = '';
            if (alertList) alertList.innerHTML = '';

            const searchTerm = $('#search-inventory').val().toLowerCase() || '';
            const filtered = inventoryStockData.filter(item => 
                item.name.toLowerCase().includes(searchTerm) || 
                (item.supplierName && item.supplierName.toLowerCase().includes(searchTerm))
            );

            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="text-center py-8 text-slate-400 dark:text-slate-500">No inventory materials matched the criteria.</td></tr>`;
            } else {
                filtered.forEach(item => {
                    const isLow = item.currentStock <= item.reorderLevel;
                    const valuation = item.currentStock * parseFloat(item.costPerUnit);
                    const stockClass = item.currentStock === 0 ? 'text-red-500 font-bold' : (isLow ? 'text-amber-500 font-semibold' : 'text-slate-700 dark:text-slate-350');
                    const minBadge = `<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-500">حد الطلب: ${item.reorderLevel} ${item.unit}</span>`;
                    
                    tbody.innerHTML += `
                        <tr class="border-b border-slate-50 dark:border-darkBorder/50 hover:bg-slate-50/50 dark:hover:bg-slate-800/20 transition-colors">
                            <td class="py-3.5 px-6 font-semibold text-slate-800 dark:text-white text-right">${item.name}</td>
                            <td class="py-3.5 text-slate-500 dark:text-slate-400 text-right">${item.supplierName || 'Unassigned'}</td>
                            <td class="py-3.5 text-center ${stockClass}">${item.currentStock.toFixed(2)} ${item.unit}</td>
                            <td class="py-3.5 text-center">${minBadge}</td>
                            <td class="py-3.5 text-center font-semibold text-slate-600 dark:text-slate-400">${parseFloat(item.costPerUnit).toFixed(2)} ج.م</td>
                            <td class="py-3.5 text-center font-bold text-slate-900 dark:text-white">${valuation.toFixed(2)} ج.م</td>
                            <td class="py-3.5 text-center">
                                <div class="flex items-center justify-center gap-1.5">
                                    <button onclick="openAddStockModal(${item.id}, '${item.name.replace(/'/g, "\\'")}', '${item.unit}', ${item.costPerUnit})" class="px-2 py-1 text-[10px] font-bold rounded-lg bg-amber-50 hover:bg-amber-100 dark:bg-amber-950/20 dark:hover:bg-amber-950/40 text-amber-500 border border-amber-500/10 transition-all flex items-center gap-0.5" title="Intake Stock"><i class="bi bi-plus-lg"></i> توريد</button>
                                    <button onclick="openAdjustStockModal(${item.id}, '${item.name.replace(/'/g, "\\'")}', '${item.unit}')" class="px-2 py-1 text-[10px] font-bold rounded-lg bg-rose-50 hover:bg-rose-100 dark:bg-rose-950/20 dark:hover:bg-rose-950/40 text-rose-500 border border-rose-500/10 transition-all flex items-center gap-0.5" title="Audit/Waste"><i class="bi bi-sliders"></i> جرد/تالف</button>
                                    <button onclick="openEditIngredientModal(${item.id}, '${item.name.replace(/'/g, "\\'")}', '${item.unit}', ${item.costPerUnit}, ${item.reorderLevel}, ${item.supplierId || 'null'})" class="px-2 py-1 text-[10px] font-bold rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-white transition-all" title="Edit Material Details"><i class="bi bi-pencil"></i></button>
                                    <button onclick="deleteIngredient(${item.id})" class="px-2 py-1 text-[10px] font-bold rounded-lg bg-red-50 hover:bg-red-100 dark:bg-red-950/20 dark:hover:bg-red-950/40 text-red-550 border border-red-500/10 transition-all" title="Delete Material"><i class="bi bi-trash"></i></button>
                                </div>
                            </td>
                        </tr>`;

                    if (isLow && alertList) {
                        const statusClass = item.currentStock === 0 ? 'bg-red-500/10 text-red-500 border-red-500/20' : 'bg-amber-500/10 text-amber-500 border-amber-500/20';
                        const textStatus = item.currentStock === 0 ? 'نفذ المخزون' : 'مخزون منخفض';
                        alertList.innerHTML += `
                            <div class="p-3 border rounded-xl flex justify-between items-center ${statusClass}">
                                <div>
                                    <h5 class="font-bold text-xs text-right">${item.name}</h5>
                                    <span class="text-[9px] font-semibold tracking-wide uppercase opacity-75 text-right block">${textStatus} • الحد: ${item.reorderLevel} ${item.unit}</span>
                                </div>
                                <span class="text-xs font-black">${item.currentStock.toFixed(1)} ${item.unit}</span>
                            </div>`;
                    }
                });
            }

            if (alertList && alertList.innerHTML === '') {
                alertList.innerHTML = `
                    <div class="p-4 border border-emerald-500/10 bg-emerald-500/5 text-emerald-600 dark:text-emerald-400 text-xs rounded-xl text-center font-bold">
                        <i class="bi bi-shield-check text-2xl block mb-1"></i> جميع مستويات المخزن جيدة! لا توجد تنبيهات.
                    </div>`;
            }
        }

        function filterInventoryTable() {
            renderInventoryTable();
        }

        async function updateInventoryKPIs() {
            try {
                const branchId = $('#header-branch-selector').val();
                const response = await fetch(`/api/analytics/inventory?branchId=${branchId || ''}`);
                if (response.ok) {
                    const data = await response.json();
                    document.getElementById('inv-kpi-valuation').textContent = `${parseFloat(data.totalInventoryValuation).toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})} ج.م`;
                    document.getElementById('inv-kpi-purchases').textContent = `${parseFloat(data.totalPurchasesAmount).toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})} ج.م`;
                    document.getElementById('inv-kpi-waste').textContent = `${parseFloat(data.totalWasteAmount).toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})} ج.م`;
                    document.getElementById('inv-kpi-foodcost').textContent = `${data.averageFoodCostPercentage}%`;
                } else {
                    document.getElementById('inv-kpi-valuation').textContent = '--';
                    document.getElementById('inv-kpi-purchases').textContent = '--';
                    document.getElementById('inv-kpi-waste').textContent = '--';
                    document.getElementById('inv-kpi-foodcost').textContent = '--';
                    showToastAlert("فشل تحميل مؤشرات الأداء لمخزون الفروع.", "error");
                }
            } catch (ex) {
                console.error("Failed to load inventory KPI valuation reports:", ex);
                document.getElementById('inv-kpi-valuation').textContent = '--';
                document.getElementById('inv-kpi-purchases').textContent = '--';
                document.getElementById('inv-kpi-waste').textContent = '--';
                document.getElementById('inv-kpi-foodcost').textContent = '--';
                showToastAlert("فشل تحميل مؤشرات الأداء لمخزون الفروع.", "error");
            }
        }

        // Ingredient CRUD Modal Actions
        function loadSuppliersList(callback) {
            const branchId = $('#header-branch-selector').val();
            const normalizedBranchId = branchId ? parseInt(branchId) : null;
            if (suppliersListCacheBranchId === normalizedBranchId && suppliersListCache.length > 0) {
                if (callback) callback(suppliersListCache);
                return;
            }
            $.get('/Inventory/GetSuppliers', { branchId: normalizedBranchId })
             .done(function(suppliers) {
                 suppliersListCache = suppliers;
                 suppliersListCacheBranchId = normalizedBranchId;
                 const select = document.getElementById('ingredient-crud-supplier');
                 if (select) {
                     select.innerHTML = '<option value="">No Assigned Supplier</option>';
                     suppliers.forEach(s => {
                         select.innerHTML += `<option value="${s.id}">${s.name}</option>`;
                     });
                 }
                 if (callback) callback(suppliers);
             })
             .fail(function() {
                 console.error("Failed to load suppliers list.");
             });
        }

        function openCreateIngredientModal() {
            document.getElementById('ingredient-modal-title').textContent = "إضافة صنف خام جديد";
            document.getElementById('ingredient-crud-id').value = "";
            document.getElementById('ingredient-crud-name').value = "";
            document.getElementById('ingredient-crud-initial-stock').value = "0";
            document.getElementById('ingredient-crud-reorder-level').value = "5";
            document.getElementById('ingredient-crud-unit').value = "Kg";
            document.getElementById('ingredient-crud-cost').value = "";
            document.getElementById('ingredient-crud-supplier').value = "";
            
            document.getElementById('initial-stock-container').classList.remove('hidden');

            loadSuppliersList();

            const modal = document.getElementById('ingredient-crud-modal');
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.add('opacity-100');
                document.getElementById('ingredient-crud-modal-content').classList.remove('scale-95');
            }, 50);
        }

        function openEditIngredientModal(id, name, unit, cost, reorderLevel, supplierId) {
            document.getElementById('ingredient-modal-title').textContent = "تعديل تفاصيل الصنف الخام";
            document.getElementById('ingredient-crud-id').value = id;
            document.getElementById('ingredient-crud-name').value = name;
            document.getElementById('ingredient-crud-reorder-level').value = reorderLevel;
            document.getElementById('ingredient-crud-unit').value = unit;
            document.getElementById('ingredient-crud-cost').value = cost;
            
            document.getElementById('initial-stock-container').classList.add('hidden');

            loadSuppliersList(function() {
                document.getElementById('ingredient-crud-supplier').value = supplierId || "";
            });

            const modal = document.getElementById('ingredient-crud-modal');
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.add('opacity-100');
                document.getElementById('ingredient-crud-modal-content').classList.remove('scale-95');
