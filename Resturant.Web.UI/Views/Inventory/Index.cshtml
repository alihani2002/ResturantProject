            tr.innerHTML = `
                <td class="py-2 px-3">
                    <select required onchange="handleTransferIngredientChange(this)" class="transfer-item-select w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-darkBorder rounded-lg px-2.5 py-1.5 text-xs text-slate-850 dark:text-white focus:outline-none cursor-pointer text-right" dir="rtl">
                        <option value="">-- اختر الخامة --</option>
                    </select>
                </td>
                <td class="py-2">
                    <input type="number" step="0.001" min="0.001" required placeholder="0.000" class="transfer-item-qty w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-darkBorder rounded-lg px-2.5 py-1.5 text-xs text-slate-850 dark:text-white focus:outline-none text-right">
                </td>
                <td class="py-2">
                    <input type="text" readonly class="transfer-item-unit w-full bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-darkBorder rounded-lg px-2.5 py-1.5 text-xs text-slate-500 dark:text-slate-400 focus:outline-none text-center" value="جم">
                </td>
                <td class="py-2 text-center">
                    <button type="button" onclick="removeTransferItemRow('${rowId}')" class="p-1 rounded bg-red-50 hover:bg-red-100 dark:bg-red-950/20 dark:hover:bg-red-950/40 text-red-550"><i class="bi bi-trash"></i></button>
                </td>`;
            
            tbody.appendChild(tr);
            
            const selectElement = tr.querySelector('.transfer-item-select');
            populateIngredientDropdown(selectElement);
        }

        function handleTransferIngredientChange(select) {
            const row = select.closest('tr');
            if (!row) return;
            const unitInput = row.querySelector('.transfer-item-unit');
            const selectedOption = select.options[select.selectedIndex];
            if (selectedOption && selectedOption.value) {
                const unit = selectedOption.getAttribute('data-unit');
                unitInput.value = unit || 'جم';
            } else {
                unitInput.value = 'جم';
            }
        }

        function removeTransferItemRow(rowId) {
            const row = document.getElementById(`tr-item-${rowId}`);
            if (row) row.remove();
        }

        function submitStockTransfer(e) {
            e.preventDefault();

            const srcBranch = parseInt(document.getElementById('transfer-source-branch').value);
            const destBranch = parseInt(document.getElementById('transfer-dest-branch').value);

            if (srcBranch === destBranch) {
                showToastAlert("لا يمكن أن يكون الفرع المرسل والمستلم متطابقين.", "error");
                return;
            }

            const items = [];
            const rows = document.querySelectorAll('#transfer-items-tbody tr');

            rows.forEach(row => {
                const select = row.querySelector('.transfer-item-select');
                const qtyInput = row.querySelector('.transfer-item-qty');
                const unitInput = row.querySelector('.transfer-item-unit');
                
                if (select && select.value) {
                    items.push({
                        ingredientName: select.value,
                        quantity: parseFloat(qtyInput.value),
                        unit: unitInput.value
                    });
                }
            });

            if (items.length === 0) {
                showToastAlert("يرجى اختيار صنف واحد على الأقل للتحويل.", "error");
                return;
            }

            const request = {
                sourceBranchId: srcBranch,
                destinationBranchId: destBranch,
                notes: document.getElementById('transfer-notes').value,
                items: items
            };

            $.ajax({
                url: '/Inventory/RequestTransfer',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(request),
                success: function() {
                    showToastAlert("تم إنشاء طلب التحويل المخزني وإرساله بنجاح.");
                    closeRequestTransferModal();
                    loadStockTransfersList();
                },
                error: function(err) {
                    showToastAlert(err.responseText || "Failed to dispatch transfer request.", "error");
                }
            });
        }

        // 3. Recipes Config Actions
        function loadRecipeMenuItems() {
            const branchId = $('#header-branch-selector').val();
            $.get('/Inventory/GetMenuItems', { branchId: branchId ? parseInt(branchId) : null })
             .done(function(items) {
                 recipeMenuItemsData = items;
                 filterRecipeMenuItems();
             })
             .fail(function() {
                 showToastAlert("Failed to load branch products.", "error");
             });
        }

        function filterRecipeMenuItems() {
            const container = document.getElementById('recipe-menu-list');
            if (!container) return;
            container.innerHTML = '';

            const searchTerm = $('#search-recipe-menu').val().toLowerCase() || '';
            const filtered = recipeMenuItemsData.filter(item => 
                item.name.toLowerCase().includes(searchTerm)
            );

            if (filtered.length === 0) {
                container.innerHTML = `<p class="text-center py-4 text-slate-400 dark:text-slate-500 text-xs">لا توجد أصناف تطابق البحث</p>`;
                return;
            }

            filtered.forEach(item => {
                const activeClass = selectedRecipeMenuItemId === item.id 
                    ? 'bg-rose-500/10 text-rose-500 font-bold border border-rose-500/25' 
                    : 'text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 border border-transparent';
                
                container.innerHTML += `
                    <button onclick="selectRecipeMenuItem(${item.id}, '${item.name.replace(/'/g, "\\'")}', ${item.price})" class="w-full text-right px-4 py-2.5 text-xs rounded-xl transition-all ${activeClass}">
                        <div class="flex justify-between items-center">
                            <span>${item.name}</span>
                            <span class="text-[10px] font-bold text-slate-450 dark:text-slate-500">${parseFloat(item.price).toFixed(2)} ج.م</span>
                        </div>
                    </button>`;
            });
        }

        function selectRecipeMenuItem(id, name, price) {
            selectedRecipeMenuItemId = id;
            filterRecipeMenuItems(); // Refreshes active sidebar state highlight

            document.getElementById('recipe-editor-empty').classList.add('hidden');
            const editor = document.getElementById('recipe-editor-container');
            editor.classList.remove('hidden');

            document.getElementById('recipe-editor-name').textContent = name;
            document.getElementById('recipe-editor-price').textContent = `سعر المنتج: ${parseFloat(price).toFixed(2)} ج.م`;

            const tbody = document.getElementById('recipe-ingredients-tbody');
            tbody.innerHTML = '<tr><td colspan="4" class="text-center py-8 text-slate-400">جاري تحميل خامات الريسب...</td></tr>';

            $.get('/Inventory/GetRecipes', { menuItemId: id })
             .done(function(recipes) {
                 tbody.innerHTML = '';
                 if (recipes.length === 0) {
                     tbody.innerHTML = `<tr id="recipe-no-items"><td colspan="4" class="text-center py-8 text-slate-400 dark:text-slate-500"><i class="bi bi-exclamation-circle text-lg d-block mb-1"></i> لا توجد خامات مضافة لوصفة هذا الطبق. أضف سطر لإعداد المكونات.</td></tr>`;
                 } else {
                     recipes.forEach(r => {
                         addRecipeIngredientRow(r.ingredientName, r.quantityRequired, r.unit);
                     });
                 }
             })
             .fail(function() {
                 showToastAlert("Failed to load recipe ingredients.", "error");
             });
        }

        function loadRecipeIngredientsDatalist() {
            const branchId = $('#header-branch-selector').val();
            $.get('/Inventory/GetStockLevels', { branchId: branchId ? parseInt(branchId) : null })
             .done(function(data) {
                 branchIngredientsCache = data;
             })
             .fail(function() {
                 console.error("Failed to load branch ingredients.");
             });
        }

        function onRecipeIngredientSelectChange(selectElement) {
            const tr = selectElement.closest('tr');
            if (!tr) return;

            const selectedOption = selectElement.options[selectElement.selectedIndex];
            if (selectedOption && selectedOption.value) {
                const unit = selectedOption.getAttribute('data-unit');
                const unitSelect = tr.querySelector('.recipe-ingredient-unit-select');
                if (unitSelect && unit) {
                    let matchUnit = unit;
                    if (matchUnit === 'Kilograms') matchUnit = 'Kg';
                    if (matchUnit === 'Liters') matchUnit = 'Ltr';
                    if (matchUnit === 'Pieces') matchUnit = 'Pcs';
                    unitSelect.value = matchUnit;
                }
            }
        }

        function addRecipeIngredientRow(name = '', quantity = '', unit = 'Grams') {
            const tbody = document.getElementById('recipe-ingredients-tbody');
            if (!tbody) return;
            const noItemsRow = document.getElementById('recipe-no-items');
            if (noItemsRow) noItemsRow.remove();

            const rowId = Date.now() + Math.random().toString(36).substr(2, 9);

            const tr = document.createElement('tr');
            tr.id = `tr-rec-${rowId}`;
            tr.className = "border-b border-slate-50 dark:border-darkBorder/30";

            let ingredientOptions = '<option value="">-- اختر الخامة --</option>';
            let nameExistsInCache = false;

            branchIngredientsCache.forEach(item => {
                const isSelected = item.name.trim().toLowerCase() === name.trim().toLowerCase() ? 'selected' : '';
                if (isSelected) nameExistsInCache = true;
                ingredientOptions += `<option value="${item.name.replace(/"/g, '&quot;')}" ${isSelected} data-unit="${item.unit}">${item.name} (المخزون: ${item.currentStock.toFixed(2)} ${item.unit})</option>`;
            });

            if (name && !nameExistsInCache) {
                ingredientOptions += `<option value="${name.replace(/"/g, '&quot;')}" selected data-unit="${unit}">${name} (غير مدرج بالمخزن حالياً)</option>`;
            }

            tr.innerHTML = `
                <td class="py-2.5 px-3">
                    <select required onchange="onRecipeIngredientSelectChange(this)" class="recipe-ingredient-select w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-darkBorder rounded-lg px-2.5 py-1.5 text-xs text-slate-850 dark:text-white focus:outline-none cursor-pointer">
                        ${ingredientOptions}
                    </select>
                </td>
                <td class="py-2.5 text-center">
                    <input type="number" step="0.001" min="0.001" required value="${quantity}" placeholder="0.000" class="w-full text-center bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-darkBorder rounded-lg px-2.5 py-1.5 text-xs text-slate-850 dark:text-white focus:outline-none">
                </td>
                <td class="py-2.5">
                    <select required class="recipe-ingredient-unit-select w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-darkBorder rounded-lg px-2.5 py-1.5 text-xs text-slate-850 dark:text-white focus:outline-none cursor-pointer">
                        <option value="Grams" ${unit === 'Grams' ? 'selected' : ''}>Grams</option>
                        <option value="Kg" ${unit === 'Kg' ? 'selected' : ''}>Kg (Kilograms)</option>
                        <option value="Ltr" ${unit === 'Ltr' ? 'selected' : ''}>Ltr (Liters)</option>
                        <option value="Pcs" ${unit === 'Pcs' ? 'selected' : ''}>Pcs (Pieces)</option>
                        <option value="Box" ${unit === 'Box' ? 'selected' : ''}>Box</option>
                    </select>
                </td>
                <td class="py-2.5 text-center">
                    <button type="button" onclick="removeRecipeIngredientRow('${rowId}')" class="p-1 rounded bg-red-50 hover:bg-red-100 dark:bg-red-950/20 dark:hover:bg-red-950/40 text-red-550"><i class="bi bi-trash"></i></button>
                </td>
            `;

            tbody.appendChild(tr);
        }

        function removeRecipeIngredientRow(rowId) {
            const row = document.getElementById(`tr-rec-${rowId}`);
            if (row) row.remove();

            const tbody = document.getElementById('recipe-ingredients-tbody');
            if (tbody && tbody.querySelectorAll('tr').length === 0) {
                tbody.innerHTML = `<tr id="recipe-no-items"><td colspan="4" class="text-center py-8 text-slate-400 dark:text-slate-500"><i class="bi bi-exclamation-circle text-lg d-block mb-1"></i> لا توجد خامات مضافة لوصفة هذا الطبق. أضف سطر لإعداد المكونات.</td></tr>`;
            }
        }

        function cancelRecipeEdit() {
            selectedRecipeMenuItemId = null;
            filterRecipeMenuItems();
            document.getElementById('recipe-editor-container').classList.add('hidden');
            document.getElementById('recipe-editor-empty').classList.remove('hidden');
        }

        function saveRecipeChanges(e) {
            e.preventDefault();
            if (!selectedRecipeMenuItemId) return;

            const items = [];
            const rows = document.querySelectorAll('#recipe-ingredients-tbody tr');

            if (rows.length === 1 && rows[0].id === 'recipe-no-items') {
                // Empty recipe
            } else {
                rows.forEach(row => {
                    const selects = row.querySelectorAll('select');
                    const inputs = row.querySelectorAll('input');
                    if (selects.length >= 2 && inputs.length >= 1) {
                        const ingredientName = selects[0].value;
                        const quantityRequired = parseFloat(inputs[0].value);
                        const unit = selects[1].value;

                        if (ingredientName) {
                            items.push({
                                ingredientName: ingredientName,
                                quantityRequired: quantityRequired,
                                unit: unit
                            });
                        }
                    }
                });
            }

            const request = {
                menuItemId: selectedRecipeMenuItemId,
                items: items
            };

            $.ajax({
                url: '/Inventory/SaveRecipe',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(request),
                success: function() {
                    showToastAlert("تم حفظ خريطة مكونات وصفة الطبق بنجاح!");
                },
                error: function(err) {
                    showToastAlert(err.responseText || "Failed to save recipe map.", "error");
                }
            });
        }

        // 4. Daily Consumption
        function initDailyConsumptionTab() {
            const dateInput = document.getElementById('daily-consumption-date');
            if (dateInput && !dateInput.value) {
                const today = new Date();
                const yyyy = today.getFullYear();
                let mm = today.getMonth() + 1;
                let dd = today.getDate();
                if (mm < 10) mm = '0' + mm;
                if (dd < 10) dd = '0' + dd;
                dateInput.value = `${yyyy}-${mm}-${dd}`;
            }
            loadDailyConsumptionReport();
        }

        function loadDailyConsumptionReport() {
            const dateInput = document.getElementById('daily-consumption-date');
            if (!dateInput) return;
            const selectedDate = dateInput.value;
            const branchId = $('#header-branch-selector').val();

            const salesList = document.getElementById('daily-consumption-sales-list');
            const wasteList = document.getElementById('daily-consumption-waste-list');
            const tbody = document.getElementById('daily-consumption-tbody');

            if (salesList) salesList.innerHTML = '<div class="text-center py-8 text-slate-400">جاري تحميل المبيعات...</div>';
            if (wasteList) wasteList.innerHTML = '<div class="text-center py-8 text-slate-400">جاري تحميل التالف...</div>';
            if (tbody) tbody.innerHTML = '<tr><td colspan="5" class="text-center py-8 text-slate-400">جاري تحميل بيانات استهلاك المخزن...</td></tr>';

            $.get('/Inventory/GetDailyConsumptionReport', { date: selectedDate, branchId: branchId ? parseInt(branchId) : null })
             .done(function(data) {
                 dailyConsumptionReportData = data;
                 renderDailyConsumptionTables();
             })
             .fail(function() {
                 if (salesList) salesList.innerHTML = '<div class="text-center py-8 text-red-500">فشل في تحميل المبيعات.</div>';
                 if (wasteList) wasteList.innerHTML = '<div class="text-center py-8 text-red-500">فشل في تحميل التالف.</div>';
                 if (tbody) tbody.innerHTML = '<tr><td colspan="5" class="text-center py-8 text-red-500">فشل في تحميل تقرير مطابقة المخزن.</td></tr>';
             });
        }

        function renderDailyConsumptionTables() {
            if (!dailyConsumptionReportData) return;
            const data = dailyConsumptionReportData;
            const salesList = document.getElementById('daily-consumption-sales-list');
            const wasteList = document.getElementById('daily-consumption-waste-list');
            const tbody = document.getElementById('daily-consumption-tbody');

            // 1. Render Sold Items
            if (salesList) {
                salesList.innerHTML = '';
                if (!data.soldItems || data.soldItems.length === 0) {
                    salesList.innerHTML = `
                        <div class="flex flex-col items-center justify-center text-center py-12 text-slate-400 dark:text-slate-500">
                            <i class="bi bi-cart-x text-3xl mb-2 text-slate-350 dark:text-slate-650"></i>
                            <p class="text-xs font-semibold">لم يتم بيع أي منتجات في هذا اليوم</p>
                        </div>`;
                } else {
                    data.soldItems.forEach(item => {
                        salesList.innerHTML += `
                            <div class="flex justify-between items-center bg-slate-50 dark:bg-slate-900/50 border border-slate-100 dark:border-darkBorder/40 rounded-xl p-3.5 hover:scale-[1.01] transition-transform">
                                <div class="text-right">
                                    <h5 class="text-xs font-bold text-slate-800 dark:text-white">${item.name}</h5>
                                    <p class="text-[10px] text-slate-450 mt-0.5">الكمية المباعة: <strong class="text-brand-500">${item.quantitySold} حبات</strong></p>
                                </div>
                                <div class="text-left font-semibold text-xs text-emerald-500">
                                    ${item.totalRevenue.toFixed(2)} ج.م
                                </div>
                            </div>`;
                    });
                }
            }

            // 2. Render Waste Logs
            if (wasteList) {
                wasteList.innerHTML = '';
                if (!data.waste || data.waste.length === 0) {
                    wasteList.innerHTML = `
                        <div class="flex flex-col items-center justify-center text-center py-12 text-slate-400 dark:text-slate-500">
                            <i class="bi bi-shield-check text-3xl mb-2 text-slate-350 dark:text-slate-650"></i>
                            <p class="text-xs font-semibold">لا يوجد تالف مسجل لهذا اليوم</p>
                        </div>`;
                } else {
                    data.waste.forEach(item => {
                        let typeText = 'تالف';
                        if (item.type === 'Expired') typeText = 'منتهي الصلاحية';
                        else if (item.type === 'Damage') typeText = 'ضرر/كسر';
                        else if (item.type === 'Theft') typeText = 'عجز/سرقة';
                        else if (item.type === 'Waste') typeText = 'هالك مطبخ';

                        wasteList.innerHTML += `
                            <div class="flex justify-between items-center bg-rose-500/5 dark:bg-rose-950/10 border border-rose-500/10 dark:border-rose-500/20 rounded-xl p-3.5 hover:scale-[1.01] transition-transform">
                                <div class="text-right">
                                    <h5 class="text-xs font-bold text-slate-800 dark:text-white">${item.ingredientName}</h5>
                                    <p class="text-[10px] text-slate-450 mt-0.5">الكمية: <strong class="text-rose-500">${item.quantity} ${item.unit}</strong> • ${typeText}</p>
                                    <p class="text-[9px] text-slate-400 mt-0.5">${item.notes || 'لا توجد ملاحظات'}</p>
                                </div>
                                <div class="text-left">
                                    <span class="font-bold text-xs text-rose-500 block text-left">${item.cost.toFixed(2)} ج.م</span>
                                    <span class="text-[9px] text-slate-400 block text-left">${item.time} • ${item.adjustedBy}</span>
                                </div>
                            </div>`;
                    });
                }
            }

            // 3. Render Consumption & Discrepancies Table
            if (tbody) {
                tbody.innerHTML = '';
                if (!data.consumption || data.consumption.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="5" class="text-center py-8 text-slate-400 dark:text-slate-500">لا يوجد استهلاك مسجل للمواد الخام في هذا اليوم.</td></tr>';
                } else {
                    const searchTerm = ($('#search-daily-consumption').val() || '').toLowerCase();
                    const filtered = (data.consumption || []).filter(item => 
                        item.name.toLowerCase().includes(searchTerm) ||
                        (item.portionReference && item.portionReference.toLowerCase().includes(searchTerm))
                    );
                    filtered.forEach(item => {
                        const variance = item.variance;
                        let varianceBadge = '';
                        if (Math.abs(variance) < 0.001) {
                            varianceBadge = '<span class="px-2.5 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-500">مطابق</span>';
                        } else if (variance > 0) {
                            varianceBadge = `<span class="px-2.5 py-0.5 rounded text-[10px] font-bold bg-amber-500/10 text-amber-500">عجز: ${variance.toFixed(2)} ${item.unit}</span>`;
                        } else {
                            varianceBadge = `<span class="px-2.5 py-0.5 rounded text-[10px] font-bold bg-blue-500/10 text-blue-500">زيادة: ${Math.abs(variance).toFixed(2)} ${item.unit}</span>`;
                        }

                        tbody.innerHTML += `
                            <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-900/20 transition-all border-b border-slate-50 dark:border-darkBorder/30">
                                <td class="py-3 px-3 text-right">
                                    <div class="font-bold text-slate-850 dark:text-white">${item.name}</div>
                                    <div class="text-[10px] text-slate-450 dark:text-slate-500 mt-0.5">${item.portionReference}</div>
                                </td>
                                <td class="py-3 text-center text-slate-600 dark:text-slate-350 font-semibold">
                                    ${item.theoreticalConsumption.toFixed(2)} ${item.unit}
                                </td>
                                <td class="py-3 text-center text-slate-600 dark:text-slate-350 font-semibold">
                                    ${item.actualDeducted.toFixed(2)} ${item.unit}
                                </td>
                                <td class="py-3 text-center text-slate-800 dark:text-white font-bold">
                                    ${item.currentStock.toFixed(2)} ${item.unit}
                                </td>
                                <td class="py-3 text-center">
                                    ${varianceBadge}
                                </td>
                            </tr>`;
                    });
                }
            }
        }

        // 5. Inventory Extension Modules
        let movementPage = 1;
        let suppliersPanelCache = [];
        let productPriceCache = [];

        function activeBranchIdValue() {
            const branchId = $('#header-branch-selector').val();
            return branchId ? parseInt(branchId) : null;
        }

        function openModal(modalId) {
            const modal = document.getElementById(modalId);
            if (!modal) return;
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.add('opacity-100');
                const content = document.getElementById(`${modalId}-content`);
                if (content) content.classList.remove('scale-95');
            }, 20);
        }

        function closeModal(modalId) {
            const modal = document.getElementById(modalId);
            if (!modal) return;
            modal.classList.remove('opacity-100');
            const content = document.getElementById(`${modalId}-content`);
            if (content) content.classList.add('scale-95');
            setTimeout(() => modal.classList.add('hidden'), 220);
        }

        function formatLocalDateTime(date) {
            const pad = n => String(n).padStart(2, '0');
            return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`;
        }

        function populateBranchSelect(selectId, includeAllOption = false) {
            const select = document.getElementById(selectId);
            if (!select) return;
            $.get('/Inventory/GetBranches')
             .done(function(branches) {
                 select.innerHTML = includeAllOption ? '<option value="">All branches</option>' : '';
                 branches.forEach(b => select.innerHTML += `<option value="${b.id}">${b.name}</option>`);
                 const activeBranch = activeBranchIdValue();
                 if (activeBranch && !includeAllOption) select.value = activeBranch;
             });
        }

        function loadSuppliersPanel() {
            const branchId = activeBranchIdValue();
            $.get('/Inventory/GetSuppliers', { branchId })
             .done(function(data) {
                 suppliersPanelCache = data;
                 const list = document.getElementById('supplier-list');
                 if (!list) return;
                 list.innerHTML = data.length ? '' : '<div class="text-xs text-slate-400">No suppliers yet.</div>';
                 data.forEach(s => {
                     list.innerHTML += `<div class="p-3 rounded-xl border dark:border-darkBorder text-right">
                        <div class="flex justify-between gap-2"><button onclick="openSupplierModal(${s.id})" class="text-[10px] text-sky-500 font-bold"><i class="bi bi-pencil"></i> Edit</button><div class="font-bold text-xs">${s.name}</div></div>
                        <div class="text-[10px] text-slate-400">${s.phone || ''} ${s.email || ''}</div>
                        <div class="text-[10px] text-amber-500">Lead ${s.leadTimeDays}d / Rating ${s.qualityRating}</div>
                    </div>`;
                 });
             });
        }

        function openSupplierModal(id) {
            const branchId = activeBranchIdValue();
            if (!branchId) return showToastAlert('Select a branch first.', 'error');
            const supplier = id ? suppliersPanelCache.find(s => s.id === id) : null;
            $('#supplier-id').val(supplier?.id || '');
            $('#supplier-name').val(supplier?.name || '');
            $('#supplier-phone').val(supplier?.phone || '');
            $('#supplier-email').val(supplier?.email || '');
            $('#supplier-contact').val('');
            $('#supplier-notes').val('');
            $('#supplier-address').val(supplier?.address || '');
            openModal('supplier-modal');
        }

        function submitSupplierForm(event) {
            event.preventDefault();
            const branchId = activeBranchIdValue();
            if (!branchId) return showToastAlert('Select a branch first.', 'error');
            const contact = $('#supplier-contact').val().trim();
            const notes = $('#supplier-notes').val().trim();
            const addressParts = [$('#supplier-address').val().trim()];
            if (contact) addressParts.push(`Contact: ${contact}`);
            if (notes) addressParts.push(`Notes: ${notes}`);
            const payload = {
                id: parseInt($('#supplier-id').val() || '0'),
                branchId,
                name: $('#supplier-name').val().trim(),
                phone: $('#supplier-phone').val().trim(),
                email: $('#supplier-email').val().trim(),
                address: addressParts.filter(Boolean).join(' | '),
                leadTimeDays: 2.5,
                qualityRating: 4.5
            };
            if (!payload.name) return showToastAlert('Supplier name is required.', 'error');
            $.ajax({ url: '/Inventory/SaveSupplier', type: 'POST', contentType: 'application/json', data: JSON.stringify(payload) })
             .done(function() { showToastAlert('Supplier saved.'); loadSuppliersPanel(); loadSuppliersList(); })
             .fail(function(e) { showToastAlert(e.responseText || 'Failed to save supplier.', 'error'); });
            closeModal('supplier-modal');
        }

        function loadPurchaseOrders() {
            const branchId = activeBranchIdValue();
            $.get('/Inventory/GetPurchaseOrders', { branchId })
             .done(function(data) {
                 const tbody = document.getElementById('po-list');
                 if (!tbody) return;
                 tbody.innerHTML = data.length ? '' : '<tr><td colspan="6" class="p-6 text-center text-slate-400">No purchase orders.</td></tr>';
                 data.forEach(po => {
                     const actions = po.status === 'Received' || po.status === 'Cancelled'
                         ? ''
                         : `<button onclick="setPurchaseOrderStatus(${po.id}, 'Pending')" class="px-2 py-1 rounded bg-slate-100 text-[10px]">Pending</button>
                            <button onclick="setPurchaseOrderStatus(${po.id}, 'Approved')" class="px-2 py-1 rounded bg-sky-500 text-white text-[10px]">Approve</button>
                            <button onclick="receivePurchaseOrder(${po.id})" class="px-2 py-1 rounded bg-emerald-500 text-white text-[10px]">Receive</button>
                            <button onclick="setPurchaseOrderStatus(${po.id}, 'Cancelled')" class="px-2 py-1 rounded bg-red-500 text-white text-[10px]">Cancel</button>`;
                     tbody.innerHTML += `<tr class="border-b dark:border-darkBorder"><td class="p-3 font-bold">${po.orderNumber}</td><td>${po.supplierName || ''}</td><td>${po.status}</td><td>${parseFloat(po.totalAmount).toFixed(2)}</td><td>${po.orderDate}</td><td class="flex gap-1 py-2">${actions}</td></tr>`;
                 });
             });
        }

        function openPurchaseOrderModal() {
            const branchId = activeBranchIdValue();
            if (!branchId) return showToastAlert('Select a branch first.', 'error');
            if (!inventoryStockData.length) loadInventoryStockList();
            $.get('/Inventory/GetSuppliers', { branchId }).done(function(suppliers) {
                const select = document.getElementById('po-supplier');
                select.innerHTML = suppliers.map(s => `<option value="${s.id}">${s.name}</option>`).join('');
                $('#po-expected-date').val('');
                $('#po-notes').val('');
                $('#po-items-body').html('');
                addPurchaseOrderItemRow();
                calculatePurchaseOrderTotal();
                openModal('purchase-order-modal');
            });
        }

        function ingredientOptions(selectedId) {
            return inventoryStockData.map(i => `<option value="${i.id}" data-cost="${i.costPerUnit}" ${selectedId === i.id ? 'selected' : ''}>${i.name} (${i.unit})</option>`).join('');
        }

        function addPurchaseOrderItemRow() {
            const tbody = document.getElementById('po-items-body');
            if (!tbody) return;
            const rowId = Date.now();
            tbody.insertAdjacentHTML('beforeend', `<tr class="border-b dark:border-darkBorder" data-po-row="${rowId}">
                <td class="p-2"><select onchange="syncPoItemCost(this); calculatePurchaseOrderTotal()" class="po-ingredient w-full px-3 py-2 rounded-lg border dark:border-darkBorder bg-slate-50 dark:bg-slate-900 dark:text-white">${ingredientOptions()}</select></td>
                <td class="p-2"><input oninput="calculatePurchaseOrderTotal()" type="number" min="0.001" step="0.001" required class="po-quantity w-full px-3 py-2 rounded-lg border dark:border-darkBorder bg-slate-50 dark:bg-slate-900 dark:text-white"></td>
                <td class="p-2"><input oninput="calculatePurchaseOrderTotal()" type="number" min="0.01" step="0.01" required class="po-unit-cost w-full px-3 py-2 rounded-lg border dark:border-darkBorder bg-slate-50 dark:bg-slate-900 dark:text-white"></td>
                <td class="p-2 font-bold po-line-total">0.00</td>
                <td class="p-2"><button type="button" onclick="this.closest('tr').remove(); calculatePurchaseOrderTotal()" class="px-2 py-1 rounded bg-red-500/10 text-red-500"><i class="bi bi-trash"></i></button></td>
            </tr>`);
            const lastSelect = tbody.querySelector(`[data-po-row="${rowId}"] .po-ingredient`);
            syncPoItemCost(lastSelect);
        }

        function syncPoItemCost(select) {
            const option = select.options[select.selectedIndex];
            const costInput = select.closest('tr').querySelector('.po-unit-cost');
            if (option && costInput && !costInput.value) costInput.value = parseFloat(option.dataset.cost || '0').toFixed(2);
        }

        function calculatePurchaseOrderTotal() {
            let total = 0;
            document.querySelectorAll('#po-items-body tr').forEach(row => {
                const quantity = parseFloat(row.querySelector('.po-quantity')?.value || '0');
                const cost = parseFloat(row.querySelector('.po-unit-cost')?.value || '0');
                const lineTotal = quantity * cost;
                total += lineTotal;
                const lineEl = row.querySelector('.po-line-total');
                if (lineEl) lineEl.textContent = Number.isFinite(lineTotal) ? lineTotal.toFixed(2) : '0.00';
            });
            $('#po-total').text(total.toFixed(2));
        }

        function submitPurchaseOrderForm(event) {
            event.preventDefault();
            const branchId = activeBranchIdValue();
            const supplierId = parseInt($('#po-supplier').val());
            const items = Array.from(document.querySelectorAll('#po-items-body tr')).map(row => ({
                ingredientId: parseInt(row.querySelector('.po-ingredient').value),
                quantity: parseFloat(row.querySelector('.po-quantity').value),
                unitCost: parseFloat(row.querySelector('.po-unit-cost').value)
            })).filter(i => i.ingredientId && i.quantity > 0 && i.unitCost > 0);
            if (!branchId || !supplierId || items.length === 0) return showToastAlert('Supplier and at least one valid item are required.', 'error');
            $.ajax({ url: '/Inventory/CreatePurchaseOrder', type: 'POST', contentType: 'application/json', data: JSON.stringify({ branchId, supplierId, expectedDate: $('#po-expected-date').val() || null, notes: $('#po-notes').val(), items }) })
             .done(function() { showToastAlert('Purchase order created.'); loadPurchaseOrders(); })
             .fail(function(e) { showToastAlert(e.responseText || 'Failed to create purchase order.', 'error'); });
            closeModal('purchase-order-modal');
        }

        function setPurchaseOrderStatus(id, status) {
            $.post('/Inventory/UpdatePurchaseOrderStatus', { id, status })
             .done(function() { showToastAlert('Purchase order updated.'); loadPurchaseOrders(); })
             .fail(function(e) { showToastAlert(e.responseText || 'Failed to update PO.', 'error'); });
        }

        function receivePurchaseOrder(id) {
            $.ajax({ url: '/Inventory/ReceivePurchaseOrder', type: 'POST', contentType: 'application/json', data: JSON.stringify({ id }) })
             .done(function() { showToastAlert('Purchase received and stock increased.'); loadPurchaseOrders(); loadInventoryStockList(); loadMovementHistory(1); })
             .fail(function(e) { showToastAlert(e.responseText || 'Failed to receive PO.', 'error'); });
        }

        function loadMovementHistory(page) {
            movementPage = page || 1;
            const branchId = activeBranchIdValue();
            const movementType = $('#movement-type-filter').val();
            const search = $('#movement-search').val();
            $.get('/Inventory/GetMovements', { branchId, movementType, search, page: movementPage, pageSize: 25 })
             .done(function(data) {
                 const tbody = document.getElementById('movement-list');
                 if (!tbody) return;
                 tbody.innerHTML = data.items.length ? '' : '<tr><td colspan="9" class="p-6 text-center text-slate-400">No movements found.</td></tr>';
                 data.items.forEach(m => {
                     tbody.innerHTML += `<tr class="border-b dark:border-darkBorder"><td class="p-3 font-bold">${m.movementType}</td><td>${m.ingredientName || ''}</td><td>${Number(m.quantity).toFixed(3)} ${m.unit || ''}</td><td>${Number(m.stockBefore).toFixed(3)}</td><td>${Number(m.stockAfter).toFixed(3)}</td><td>${m.branchName || ''}</td><td>${m.userName || ''}</td><td>${m.referenceNumber || ''}</td><td>${m.movementDate}</td></tr>`;
                 });
                 $('#movement-page-label').text(`Page ${data.page} / ${Math.max(1, Math.ceil(data.totalCount / data.pageSize))}`);
             });
        }

        function exportMovementHistory(kind) {
            const branchId = activeBranchIdValue() || '';
            const movementType = $('#movement-type-filter').val() || '';
            const search = encodeURIComponent($('#movement-search').val() || '');
            const action = kind === 'pdf' ? 'ExportMovementsPdf' : 'ExportMovementsExcel';
            window.location.href = `/Inventory/${action}?branchId=${branchId}&movementType=${movementType}&search=${search}`;
        }

        function loadStockCountGrid() {
            const grid = document.getElementById('stock-count-grid');
            if (!grid) return;
            if (!inventoryStockData.length) loadInventoryStockList();
            setTimeout(function() {
                grid.innerHTML = inventoryStockData.map(i => `<label class="p-3 rounded-xl border dark:border-darkBorder text-right"><span class="block text-xs font-bold">${i.name}</span><span class="text-[10px] text-slate-400">Expected ${Number(i.currentStock).toFixed(3)} ${i.unit}</span><input data-ingredient-id="${i.id}" data-current="${i.currentStock}" type="number" step="0.001" value="${i.currentStock}" class="count-actual mt-2 w-full px-3 py-2 rounded-lg border dark:border-darkBorder bg-slate-50 dark:bg-slate-900 text-xs dark:text-white"><input data-reason-for="${i.id}" value="Physical count variance" class="count-reason mt-2 w-full px-3 py-2 rounded-lg border dark:border-darkBorder bg-slate-50 dark:bg-slate-900 text-xs dark:text-white"></label>`).join('');
            }, 300);
        }

        function createQuickInventoryCount() {
            const branchId = activeBranchIdValue();
            if (!branchId) return showToastAlert('Select a branch first.', 'error');
            const items = Array.from(document.querySelectorAll('.count-actual')).map(input => ({
                ingredientId: parseInt(input.dataset.ingredientId),
                actualQuantity: parseFloat(input.value),
                reason: document.querySelector(`[data-reason-for="${input.dataset.ingredientId}"]`).value || 'Physical count variance'
            })).filter(i => Number.isFinite(i.actualQuantity));
            $.ajax({ url: '/Inventory/CreateInventoryCount', type: 'POST', contentType: 'application/json', data: JSON.stringify({ branchId, requiresApproval: false, notes: 'Physical count', items }) })
             .done(function() { showToastAlert('Inventory count applied.'); loadInventoryStockList(); loadMovementHistory(1); })
             .fail(function(e) { showToastAlert(e.responseText || 'Failed to apply count.', 'error'); });
        }

        function openWasteModal() {
            const branchId = activeBranchIdValue();
            if (!branchId) return showToastAlert('Select a branch first.', 'error');
            if (!inventoryStockData.length) loadInventoryStockList();
            setTimeout(function() {
                $('#waste-ingredient').html(inventoryStockData.map(i => `<option value="${i.id}" data-unit="${i.unit}">${i.name}</option>`).join(''));
                $('#waste-quantity').val('');
                $('#waste-reason').val('Expired');
                $('#waste-notes').val('');
                $('#waste-date-time').val(formatLocalDateTime(new Date()));
                syncWasteUnit();
                openModal('waste-modal');
            }, 200);
        }

        function syncWasteUnit() {
            const selected = $('#waste-ingredient option:selected');
            const unit = selected.data('unit');
            if (unit) $('#waste-unit').val(unit);
        }

        function submitWasteForm(event) {
            event.preventDefault();
            const branchId = activeBranchIdValue();
            const ingredientId = parseInt($('#waste-ingredient').val());
            const quantity = parseFloat($('#waste-quantity').val());
            const reason = $('#waste-reason').val();
            const notes = [$('#waste-notes').val(), $('#waste-date-time').val() ? `Recorded time: ${$('#waste-date-time').val()}` : ''].filter(Boolean).join(' | ');
            if (!branchId || !ingredientId || !quantity || quantity <= 0 || !reason) return showToastAlert('Ingredient, quantity and reason are required.', 'error');
            $.ajax({ url: '/Inventory/RecordWaste', type: 'POST', contentType: 'application/json', data: JSON.stringify({ branchId, ingredientId, quantity, reason, notes }) })
             .done(function() { showToastAlert('Waste recorded and stock deducted.'); loadWasteReport(); loadInventoryStockList(); })
             .fail(function(e) { showToastAlert(e.responseText || 'Failed to record waste.', 'error'); });
            closeModal('waste-modal');
        }

        function loadWasteReport() {
            const branchId = activeBranchIdValue();
            $.get('/Inventory/GetWasteReport', { branchId })
             .done(function(data) {
                 $('#waste-total').text(parseFloat(data.totalLoss).toFixed(2));
                 const list = document.getElementById('waste-report-list');
                 if (!list) return;
                 list.innerHTML = data.items.length ? '' : '<div class="text-xs text-slate-400">No waste records.</div>';
                 data.items.forEach(w => list.innerHTML += `<div class="p-3 rounded-xl border border-red-500/20 bg-red-500/5"><div class="font-bold text-xs">${w.ingredientName}</div><div class="text-[10px] text-slate-400">${w.quantityWasted} ${w.unit} / ${w.reason}</div><div class="text-xs font-black text-red-500">${parseFloat(w.cost).toFixed(2)}</div><div class="text-[10px] text-slate-400">${w.wasteDate}</div></div>`);
             });
        }

        function loadInventoryAnalyticsDashboard() {
            const branchId = activeBranchIdValue();
            $.get('/Inventory/GetInventoryAnalytics', { branchId })
             .done(function(data) {
                 $('#ana-valuation').text(parseFloat(data.totalInventoryValuation).toFixed(2));
                 $('#ana-purchases').text(parseFloat(data.totalPurchaseAmount).toFixed(2));
                 $('#ana-waste').text(parseFloat(data.totalWasteAmount).toFixed(2));
                 $('#ana-movements').text(data.movementCount);
                 $('#ana-lowstock').text(data.lowStockCount);
                 $('#ana-low-list').html(data.lowStock.map(i => `<div class="text-xs p-2 rounded-lg bg-amber-500/10">${i.name}: ${i.currentStock} / ${i.reorderLevel} ${i.unit}</div>`).join('') || '<div class="text-xs text-slate-400">No alerts.</div>');
                 $('#ana-po-list').html(data.purchaseHistory.map(p => `<div class="text-xs p-2 rounded-lg border dark:border-darkBorder">${p.orderNumber} - ${p.supplierName || ''} - ${parseFloat(p.totalAmount).toFixed(2)}</div>`).join('') || '<div class="text-xs text-slate-400">No purchases.</div>');
                 $('#ana-waste-list').html(data.wasteAnalysis.map(w => `<div class="text-xs p-2 rounded-lg bg-red-500/10">${w.reason}: ${parseFloat(w.loss).toFixed(2)}</div>`).join('') || '<div class="text-xs text-slate-400">No waste.</div>');
             });
        }

        function loadPricingMenuItems() {
            const branchId = activeBranchIdValue();
            $.get('/Inventory/GetMenuItems', { branchId })
             .done(function(items) {
                 const select = document.getElementById('pricing-menu-item');
                 if (!select) return;
                 select.innerHTML = items.map(i => `<option value="${i.id}">${i.name} - ${parseFloat(i.price).toFixed(2)}</option>`).join('');
                 loadProductPrices();
             });
        }

        function loadProductPrices() {
            const menuItemId = parseInt($('#pricing-menu-item').val());
            if (!menuItemId) return;
            $.get('/Inventory/GetProductPrices', { menuItemId })
             .done(function(data) {
                 productPriceCache = data;
                 const list = document.getElementById('pricing-list');
                 if (!list) return;
                 list.innerHTML = data.length ? '' : '<div class="text-xs text-slate-400">No configured price levels.</div>';
                 data.forEach(p => list.innerHTML += `<div class="p-3 rounded-xl border dark:border-darkBorder text-xs">
                    <div class="flex justify-between gap-3">
                        <div class="flex gap-1">
                            <button onclick="openProductPriceModal(${p.id})" class="px-2 py-1 rounded bg-indigo-500/10 text-indigo-500 font-bold"><i class="bi bi-pencil"></i> Edit</button>
                            <button onclick="confirmDeleteProductPrice(${p.id})" class="px-2 py-1 rounded bg-red-500/10 text-red-500 font-bold"><i class="bi bi-trash"></i> Delete</button>
                        </div>
                        <div class="text-right"><strong>${p.priceType}</strong> ${p.priceListName || ''}</div>
                    </div>
                    <span class="block text-left font-black text-base">${parseFloat(p.price).toFixed(2)}</span>
                    <div class="text-[10px] text-slate-400">${p.branchName || 'All branches'} / Priority ${p.priority} / ${p.allowOverride ? 'Override allowed' : 'Override locked'}</div>
                </div>`);
             });
        }

        function openProductPriceModal(id) {
            const menuItemId = parseInt($('#pricing-menu-item').val());
            if (!menuItemId) return showToastAlert('Select a product first.', 'error');
            populateBranchSelect('price-branch', true);
            const price = id ? productPriceCache.find(p => p.id === id) : null;
            $('#price-modal-title').text(price ? 'Edit Product Price' : 'Add Product Price');
            $('#price-id').val(price?.id || '');
            $('#price-type').val(price?.priceType || '');
            $('#price-value').val(price?.price || '');
            $('#price-priority').val(price?.priority ?? 100);
            $('#price-description').val(price?.priceListName || '');
            $('#price-allow-override').prop('checked', price?.allowOverride ?? true);
            setTimeout(() => $('#price-branch').val(price?.branchId || ''), 150);
            openModal('product-price-modal');
        }

        function submitProductPriceForm(event) {
            event.preventDefault();
            const menuItemId = parseInt($('#pricing-menu-item').val());
            const payload = {
                id: parseInt($('#price-id').val() || '0'),
                menuItemId,
                branchId: $('#price-branch').val() ? parseInt($('#price-branch').val()) : null,
                priceType: $('#price-type').val().trim(),
                priceListName: $('#price-description').val().trim(),
                price: parseFloat($('#price-value').val()),
                priority: parseInt($('#price-priority').val() || '100'),
                isActive: true,
                allowOverride: $('#price-allow-override').is(':checked')
            };
            if (!payload.menuItemId || !payload.priceType || !payload.price || payload.price <= 0) return showToastAlert('Price type and valid price are required.', 'error');
            $.ajax({ url: '/Inventory/SaveProductPrice', type: 'POST', contentType: 'application/json', data: JSON.stringify(payload) })
             .done(function() { showToastAlert('Product price saved.'); loadProductPrices(); })
             .fail(function(e) { showToastAlert(e.responseText || 'Failed to save product price.', 'error'); });
            closeModal('product-price-modal');
        }

        function confirmDeleteProductPrice(id) {
            $('#confirm-title').text('Delete price type');
            $('#confirm-message').text('This price type will be removed from active product pricing. Continue?');
            $('#confirm-action-btn').off('click').on('click', function() {
                $.post('/Inventory/DeleteProductPrice', { id })
                 .done(function() { showToastAlert('Product price deleted.'); closeModal('confirm-modal'); loadProductPrices(); })
                 .fail(function(e) { showToastAlert(e.responseText || 'Failed to delete product price.', 'error'); });
            });
            openModal('confirm-modal');
        }

        function exportTableToExcel(tableId, filename = 'report.xlsx') {
            const table = document.getElementById(tableId);
            if (!table) return;
            const wb = XLSX.utils.table_to_book(table, { sheet: "Sheet1" });
            XLSX.writeFile(wb, filename);
        }

        function exportTableToPdf(tableId, title, filename = 'report.pdf') {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF('p', 'pt', 'a4');
            doc.setFontSize(16);
            // Since we're in an RTL context, we'll draw the title aligned or simply draw text
            doc.text(title, 40, 40);
            doc.autoTable({
                html: `#${tableId}`,
                startY: 60,
                styles: { fontSize: 9, halign: 'right' },
                headStyles: { fillColor: [14, 165, 233] },
                useCss: true
            });
            doc.save(filename);
        }

        function filterTable(tableId, searchInputId) {
            const searchTerm = ($(`#${searchInputId}`).val() || '').toLowerCase();
            $(`#${tableId} tbody tr`).each(function() {
                const text = $(this).text().toLowerCase();
                $(this).toggle(text.indexOf(searchTerm) > -1);
            });
        }

        // Close on escape key
        document.addEventListener('keydown', function(event) {
            if (event.key === "Escape") {
                closeAddStockModal();
                closeAdjustStockModal();
                closeRequestTransferModal();
                closeIngredientCrudModal();
                closeModal('supplier-modal');
                closeModal('purchase-order-modal');
                closeModal('waste-modal');
                closeModal('product-price-modal');
                closeModal('confirm-modal');
            }
        });

        // Initialize default tab without depending on jQuery/CDN availability.
        document.addEventListener('DOMContentLoaded', function() {
            switchTab('inventory-mgmt');
        });
    </script>
</body>
</html>
