        // 2. Stock Transfers Actions
        function loadStockTransfersList() {
            const branchId = $('#header-branch-selector').val();
            $.get('/Inventory/GetTransfers', { branchId: branchId ? parseInt(branchId) : null })
             .done(function(transfers) {
                 renderTransfersTable(transfers);
             })
             .fail(function() {
                 showToastAlert("Failed to load supply transfers.", "error");
             });
        }

        function renderTransfersTable(transfers) {
            const tbody = document.querySelector('#table-stock-transfers-list tbody');
            if (!tbody) return;
            tbody.innerHTML = '';

            if (transfers.length === 0) {
                tbody.innerHTML = `<tr><td colspan="8" class="text-center py-8 text-slate-400 dark:text-slate-500">لا توجد أي طلبات تحويل مسجلة.</td></tr>`;
                return;
            }

            transfers.forEach(t => {
                let statusBadge = '';
                let actionHtml = '';

                switch (t.status) {
                    case 'Pending':
                        statusBadge = `<span class="px-2.5 py-1 rounded-xl text-[10px] font-bold bg-amber-500/10 text-amber-500 border border-amber-500/20">قيد المراجعة</span>`;
                        actionHtml = `
                            <div class="flex gap-1.5 justify-center">
                                <button onclick="approveTransfer(${t.id})" class="px-2 py-1 text-[10px] font-bold rounded-lg bg-emerald-500 text-white hover:bg-emerald-600 transition-all">موافقة وإرسال</button>
                                <button onclick="cancelTransfer(${t.id})" class="px-2 py-1 text-[10px] font-bold rounded-lg border dark:border-darkBorder hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-white transition-all">إلغاء</button>
                            </div>`;
                        break;
                    case 'InTransit':
                        statusBadge = `<span class="px-2.5 py-1 rounded-xl text-[10px] font-bold bg-indigo-500/10 text-indigo-500 border border-indigo-500/20">في الطريق</span>`;
                        actionHtml = `
                            <div class="flex gap-1.5 justify-center">
                                <button onclick="receiveTransfer(${t.id})" class="px-2 py-1 text-[10px] font-bold rounded-lg bg-brand-500 text-white hover:bg-brand-600 transition-all">استلام وتأكيد</button>
                                <button onclick="cancelTransfer(${t.id})" class="px-2 py-1 text-[10px] font-bold rounded-lg border dark:border-darkBorder hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-white transition-all">إلغاء</button>
                            </div>`;
                        break;
                    case 'Received':
                        statusBadge = `<span class="px-2.5 py-1 rounded-xl text-[10px] font-bold bg-emerald-500/10 text-emerald-600 border border-emerald-500/20">تم الاستلام</span>`;
                        actionHtml = `<span class="text-[10px] text-slate-400 font-semibold">تاريخ الاستلام: ${t.receivedDate || '-'}</span>`;
                        break;
                    case 'Cancelled':
                        statusBadge = `<span class="px-2.5 py-1 rounded-xl text-[10px] font-bold bg-rose-500/10 text-rose-500 border border-rose-500/20">ملغى</span>`;
                        actionHtml = `<span class="text-[10px] text-slate-400 font-semibold">ملغى</span>`;
                        break;
                }

                const itemsList = t.items.map(i => `${i.ingredientName} (${i.quantity} ${i.unit})`).join(', ');

                tbody.innerHTML += `
                    <tr class="border-b border-slate-50 dark:border-darkBorder/50 hover:bg-slate-50/50 dark:hover:bg-slate-800/20 transition-colors">
                        <td class="py-3.5 px-6 font-bold text-slate-800 dark:text-white text-right">#TR-${t.id}</td>
                        <td class="py-3.5 font-semibold text-slate-750 dark:text-slate-350 text-right">${t.sourceBranchName}</td>
                        <td class="py-3.5 font-semibold text-slate-750 dark:text-slate-350 text-right">${t.destinationBranchName}</td>
                        <td class="py-3.5 text-slate-500 dark:text-slate-450 max-w-xs truncate text-right" title="${itemsList}">${itemsList}</td>
                        <td class="py-3.5 text-center">${statusBadge}</td>
                        <td class="py-3.5 text-center text-slate-500 dark:text-slate-400">${t.createdBy}</td>
                        <td class="py-3.5 text-center text-slate-500 dark:text-slate-400">${t.createdOn}</td>
                        <td class="py-3.5 text-center">${actionHtml}</td>
                    </tr>`;
            });
        }

