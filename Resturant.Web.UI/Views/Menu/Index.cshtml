@model IEnumerable<Resturant.Core.Entities.MenuCategory>

@{
    ViewData["Title"] = "Menu";
}

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar - Category Navigation -->
        <div class="col-md-3 d-none d-md-block">
            <div class="sticky-top" style="top: 100px; z-index: 1020;">
                <h5 class="fw-bold mb-3 px-3 text-black-pure text-uppercase ls-1">Menu Categories</h5>
                <div class="list-group list-group-flush shadow-sm rounded-3 overflow-hidden bg-white">
                    @foreach (var category in Model)
                    {
                        <a href="#" class="list-group-item list-group-item-action category-link py-3 px-4 border-0 d-flex justify-content-between align-items-center" 
                           data-category-id="@category.Id"
                           style="transition: all 0.2s;">
                            <span class="fw-bold">@category.Name</span>
                            <i class="bi bi-chevron-right small opacity-50"></i>
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- Main Content - Menu Items -->
        <div class="col-md-9">
            <!-- Table Number Display -->
            <div id="table-info" class="card mb-3 border-dark">
                <div class="card-body py-2 d-flex justify-content-between align-items-center">
                    <div>
                        <i class="bi bi-hash text-black-pure me-2"></i>
                        <strong class="text-black-pure">Table: </strong>
                        <span id="current-table-number" class="badge bg-dark fs-6">Not Set</span>
                    </div>
                    <button id="change-table-btn" class="btn btn-outline-dark btn-sm">
                        <i class="bi bi-pencil me-1"></i>Change
                    </button>
                </div>
            </div>

            <!-- Cart Summary -->
            <div id="cart-summary" class="card mb-4">
                <div class="card-header bg-black text-white" style="background-color: #000 !important;">
                    <h4 class="mb-0">Your Cart (<span id="cart-count">0</span>)</h4>
                </div>
                <div class="card-body">
                    <div id="cart-items">
                        <p class="text-black-pure">Your cart is empty</p>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between">
                        <strong class="text-black-pure">Total:</strong>
                        <strong id="cart-total" class="text-black-pure">$0.00</strong>
                    </div>
                    <button id="checkout-btn" class="btn btn-dark-primary btn-block mt-3 w-100" disabled>
                        Checkout
                    </button>
                </div>
            </div>

            <!-- Menu Items -->
            <div id="menu-items-container">
                <h3>Select a category to view menu items</h3>
            </div>
        </div>
    </div>
</div>

<!-- Table Number Modal -->
<div class="modal fade" id="tableNumberModal" tabindex="-1" aria-labelledby="tableNumberModalLabel" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-black text-white" style="background-color: #000 !important;">
                <h5 class="modal-title" id="tableNumberModalLabel">
                    <i class="bi bi-grid-3x3-gap-fill me-2"></i>Enter Your Table Number
                </h5>
            </div>
            <div class="modal-body">
                <p class="text-muted mb-3">Please enter your table number to continue with your order.</p>
                <div class="form-group">
                    <label for="tableNumberInput" class="form-label fw-bold">Table Number</label>
                    <input type="number" class="form-control form-control-lg text-center" id="tableNumberInput"
                           min="1" placeholder="e.g., 5" autofocus>
                    <div class="invalid-feedback" id="tableNumberError">Please enter a valid table number.</div>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-dark-primary btn-lg w-100" id="confirmTableBtn">
                    <i class="bi bi-check-lg me-2"></i>Confirm Table
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Checkout Modal with Note -->
<div class="modal fade" id="checkoutModal" tabindex="-1" aria-labelledby="checkoutModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-black text-white" style="background-color: #000 !important;">
                <h5 class="modal-title" id="checkoutModalLabel">
                    <i class="bi bi-cart-check-fill me-2"></i>Confirm Order
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="checkout-summary" class="mb-3">
                    <!-- Summary will be injected here -->
                </div>
                <div class="form-group">
                    <label for="orderNote" class="form-label fw-bold">Note to Chef (Optional)</label>
                    <textarea class="form-control" id="orderNote" rows="2" placeholder="e.g., No onions, extra spicy..."></textarea>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-dark" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-dark-primary" id="confirmCheckoutBtn">
                    <i class="bi bi-check-lg me-2"></i>Place Order
                </button>
            </div>
        </div>
    </div>
</div>



<!-- Image Preview Modal -->
<div class="modal fade" id="imagePreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-transparent border-0">
            <div class="modal-body text-center p-0">
                <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3 z-3" data-bs-dismiss="modal" aria-label="Close"></button>
                <img id="previewImage" src="" class="img-fluid rounded shadow-lg" style="max-height: 85vh;" alt="Preview">
            </div>
        </div>
    </div>
</div>



<!-- Toast Notification -->
<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="cartToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                <i class="bi bi-check-circle-fill me-2"></i> Item added to cart!
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script>
        // Table number handling
        let tableNumber = @(ViewData["TableNumber"] ?? "null");
        let selectedCategoryId = @(ViewData["SelectedCategoryId"] ?? "null");
        
        const TABLE_STORAGE_KEY = 'tableNumber';
        const TABLE_EXPIRY_KEY = 'tableNumberExpiry';
        const ORDER_HISTORY_KEY = 'guestOrderHistory';
        const EXPIRY_MINUTES = 480; // 8 Hours to match order history
        const ORDER_EXPIRY_HOURS = 8;

        // Check if table number is stored locally
        function getStoredTableNumber() {
            try {
                const storedNumber = localStorage.getItem(TABLE_STORAGE_KEY);
                const expiryTime = localStorage.getItem(TABLE_EXPIRY_KEY);
                
                if (storedNumber && expiryTime) {
                    const now = new Date().getTime();
                    if (now < parseInt(expiryTime)) {
                        return parseInt(storedNumber);
                    }
                }
            } catch(e) { console.error(e); }
            return null;
        }

        // Store table number with expiry
        function storeTableNumber(number) {
            const expiryTime = new Date().getTime() + (EXPIRY_MINUTES * 60 * 1000);
            localStorage.setItem(TABLE_STORAGE_KEY, number.toString());
            localStorage.setItem(TABLE_EXPIRY_KEY, expiryTime.toString());
        }

        // Table number modal elements
        let tableNumberModal = null;
        let tableNumberResolve = null;

        // Prompt user for table number using modal
        async function promptForTableNumber(forceShow = false) {
            const storedNumber = getStoredTableNumber();
            if (storedNumber && !forceShow) {
                // Verify stored table is still available
                try {
                    const response = await fetch(`/Order/CheckTable?tableNumber=${storedNumber}`);
                    if (response.ok) {
                        const result = await response.json();
                        if (result.available) {
                            tableNumber = storedNumber;
                            updateTableNumberUI();
                            return Promise.resolve(tableNumber);
                        }
                    }
                    localStorage.removeItem(TABLE_STORAGE_KEY);
                    localStorage.removeItem(TABLE_EXPIRY_KEY);
                } catch (e) {
                    tableNumber = storedNumber;
                    updateTableNumberUI();
                    return Promise.resolve(tableNumber);
                }
            }

            return new Promise((resolve) => {
                tableNumberResolve = resolve;
                const modalEl = document.getElementById('tableNumberModal');
                const bsRequest = window.bootstrap || bootstrap;
                tableNumberModal = new bsRequest.Modal(modalEl, { backdrop: 'static', keyboard: false });

                // Pre-fill with current table number if changing
                const input = document.getElementById('tableNumberInput');
                if (tableNumber && tableNumber > 0) {
                    input.value = tableNumber;
                } else {
                    input.value = '';
                }
                input.classList.remove('is-invalid');

                tableNumberModal.show();
                setTimeout(() => input.focus(), 500);
            });
        }

        // Confirm table number from modal
        async function confirmTableNumber() {
            const input = document.getElementById('tableNumberInput');
            const errorDiv = document.getElementById('tableNumberError');
            const confirmBtn = document.getElementById('confirmTableBtn');
            const value = parseInt(input.value);

            if (!value || value <= 0) {
                input.classList.add('is-invalid');
                errorDiv.textContent = 'Please enter a valid table number.';
                return;
            }

            confirmBtn.disabled = true;
            confirmBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Checking...';

            try {
                const response = await fetch(`/Order/CheckTable?tableNumber=${value}`);
                const result = await response.json();

                if (!result.available) {
                    input.classList.add('is-invalid');
                    errorDiv.textContent = result.message;
                    confirmBtn.disabled = false;
                    confirmBtn.innerHTML = '<i class="bi bi-check-lg me-2"></i>Confirm Table';
                    return;
                }

                tableNumber = value;
                storeTableNumber(tableNumber);
                updateTableNumberUI();

                if (tableNumberModal) {
                    tableNumberModal.hide();
                }

                if (tableNumberResolve) {
                    tableNumberResolve(tableNumber);
                    tableNumberResolve = null;
                }
            } catch (error) {
                input.classList.add('is-invalid');
                errorDiv.textContent = 'Could not verify table. Please try again.';
            } finally {
                confirmBtn.disabled = false;
                confirmBtn.innerHTML = '<i class="bi bi-check-lg me-2"></i>Confirm Table';
            }
        }

        // Update table number display in UI
        function updateTableNumberUI() {
            const tableDisplay = document.getElementById('current-table-number');
            if (tableDisplay) {
                if (tableNumber && tableNumber > 0) {
                    tableDisplay.textContent = tableNumber;
                    tableDisplay.className = 'badge bg-primary fs-6';
                } else {
                    tableDisplay.textContent = 'Not Set';
                    tableDisplay.className = 'badge bg-secondary fs-6';
                }
            }
        }

        // If table number provided in URL or storage, use it
        if (tableNumber) {
            storeTableNumber(tableNumber);
        } else {
            tableNumber = getStoredTableNumber();
        }





        // --- CART & MENU ---
        let cart = [];

        // Load cart from local storage
        function loadCart() {
            const savedCart = localStorage.getItem('cart');
            if (savedCart) {
                cart = JSON.parse(savedCart);
                updateCartUI();
            }
        }

        // Save cart to local storage
        function saveCart() {
            localStorage.setItem('cart', JSON.stringify(cart));
        }

        // Add item to cart
        function addToCart(menuItem) {
            const existingItem = cart.find(item => item.id === menuItem.id);
            if (existingItem) {
                existingItem.quantity += 1;
            } else {
                cart.push({
                    id: menuItem.id,
                    name: menuItem.name,
                    price: menuItem.price,
                    quantity: 1
                });
            }
            saveCart();
            updateCartUI();
            showToast();
        }

        // Show toast notification
        function showToast() {
            const toastEl = document.getElementById('cartToast');
            const bsRequest = window.bootstrap || bootstrap;
            const toast = new bsRequest.Toast(toastEl);
            toast.show();
        }

        // Open image preview
        function openImagePreview(imageUrl) {
            const bsRequest = window.bootstrap || bootstrap;
            const modal = new bsRequest.Modal(document.getElementById('imagePreviewModal'));
            document.getElementById('previewImage').src = imageUrl;
            modal.show();
        }

        // Remove item from cart
        function removeFromCart(itemId) {
            cart = cart.filter(item => item.id !== itemId);
            saveCart();
            updateCartUI();
        }

        // Update cart quantity
        function updateQuantity(itemId, change) {
            const item = cart.find(item => item.id === itemId);
            if (item) {
                item.quantity += change;
                if (item.quantity <= 0) {
                    removeFromCart(itemId);
                } else {
                    saveCart();
                    updateCartUI();
                }
            }
        }

        // Update cart UI
        function updateCartUI() {
            const cartItemsContainer = document.getElementById('cart-items');
            const cartCount = document.getElementById('cart-count');
            const cartTotal = document.getElementById('cart-total');
            const checkoutBtn = document.getElementById('checkout-btn');

            if (cart.length === 0) {
                cartItemsContainer.innerHTML = '<p class="text-muted">Your cart is empty</p>';
                cartCount.textContent = '0';
                cartTotal.textContent = '$0.00';
                checkoutBtn.disabled = true;
            } else {
                let cartHtml = '<ul class="list-group">';
                let total = 0;
                
                cart.forEach(item => {
                    const itemTotal = item.price * item.quantity;
                    total += itemTotal;
                    cartHtml += `
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <h6>${item.name}</h6>
                                <p class="mb-0">$${item.price.toFixed(2)} x ${item.quantity}</p>
                            </div>
                            <div>
                                <button class="btn btn-sm btn-outline-secondary mr-1" onclick="updateQuantity(${item.id}, -1)">-</button>
                                <button class="btn btn-sm btn-outline-secondary mr-1" onclick="updateQuantity(${item.id}, 1)">+</button>
                                <button class="btn btn-sm btn-danger" onclick="removeFromCart(${item.id})">Remove</button>
                            </div>
                        </li>
                    `;
                });
                
                cartHtml += '</ul>';
                cartItemsContainer.innerHTML = cartHtml;
                cartCount.textContent = cart.reduce((sum, item) => sum + item.quantity, 0);
                cartTotal.textContent = '$' + total.toFixed(2);
                checkoutBtn.disabled = false;
            }
        }

        // Load menu items by category
        function loadMenuItems(categoryId) {
            fetch(`/Menu/GetMenuItemsByCategory?categoryId=${categoryId}`)
                .then(response => response.json())
                .then(menuItems => {
                    const container = document.getElementById('menu-items-container');
                    
                    if (menuItems.length === 0) {
                        container.innerHTML = '<h3>No items available in this category</h3>';
                        return;
                    }

                    let html = '<div class="row">';
                    menuItems.forEach(item => {
                        html += `
                            <div class="col-md-6 mb-4">
                                <div class="card h-100 shadow-sm border-0">
                                    <div class="row g-0 h-100">
                                        ${item.imageUrl ? `
                                        <div class="col-md-4">
                                            <img src="${item.imageUrl}" class="img-fluid rounded-start h-100 w-100" 
                                                 style="object-fit: cover; cursor: pointer;" 
                                                 alt="${item.name}"
                                                 onclick="openImagePreview('${item.imageUrl}')">
                                        </div>
                                        ` : ''}
                                        <div class="${item.imageUrl ? 'col-md-8' : 'col-12'}">
                                            <div class="card-body d-flex flex-column h-100">
                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                    <h5 class="card-title fw-bold text-dark mb-0">${item.name}</h5>
                                                    <span class="badge bg-dark rounded-pill">$${item.price.toFixed(2)}</span>
                                                </div>
                                                <p class="card-text text-muted small flex-grow-1">${item.description || ''}</p>
                                                <div class="mt-3 text-end">
                                                    <button class="btn btn-sm btn-dark-primary rounded-pill px-4" 
                                                            onclick="addToCart(${JSON.stringify(item).replace(/"/g, '&quot;')})">
                                                        <i class="bi bi-plus-lg me-1"></i> Add
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        `;
                    });
                    
                    html += '</div>';
                    container.innerHTML = html;
                })
                .catch(error => {
                    console.error('Error loading menu items:', error);
                });
        }

        // Checkout - Step 1: Open Modal
        async function checkout() {
            if (cart.length === 0) {
                alert('Your cart is empty');
                return;
            }

            // Ensure table number is present
            if (!tableNumber || tableNumber <= 0) {
                await promptForTableNumber();
                if (!tableNumber || tableNumber <= 0) {
                     alert("Table number is required to place an order.");
                     return;
                }
            }

             // Populate summary in modal
            let summaryHtml = '<ul class="list-group mb-2">';
            let total = 0;
            cart.forEach(item => {
                total += item.price * item.quantity;
                summaryHtml += `
                    <li class="list-group-item d-flex justify-content-between lh-sm">
                        <div>
                            <h6 class="my-0">${item.name}</h6>
                            <small class="text-muted">x ${item.quantity}</small>
                        </div>
                        <span class="text-muted">$${(item.price * item.quantity).toFixed(2)}</span>
                    </li>
                `;
            });
            summaryHtml += `
                <li class="list-group-item d-flex justify-content-between bg-light">
                    <span>Total (USD)</span>
                    <strong>$${total.toFixed(2)}</strong>
                </li>
            </ul>`;
            
            document.getElementById('checkout-summary').innerHTML = summaryHtml;
            document.getElementById('orderNote').value = ''; // Clean previous note

            const bsRequest = window.bootstrap || bootstrap;
            const checkoutModal = new bsRequest.Modal(document.getElementById('checkoutModal'));
            checkoutModal.show();
        }

        // Checkout - Step 2: Confirm Order
        async function confirmCheckout() {
            const note = document.getElementById('orderNote').value;
            const confirmBtn = document.getElementById('confirmCheckoutBtn');
            const bsRequest = window.bootstrap || bootstrap;
            const checkoutModal = bsRequest.Modal.getInstance(document.getElementById('checkoutModal'));

            confirmBtn.disabled = true;
            confirmBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Placing Order...';

            const orderItems = cart.map(item => ({
                menuItemId: item.id,
                quantity: item.quantity
            }));

            fetch('/Order/Create', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    tableNumber: tableNumber,
                    note: note,
                    orderItems: orderItems
                })
            })
            .then(async response => {
                if (response.ok) {
                    return response.json();
                } else {
                    const errorText = await response.text();
                    // If table is occupied or doesn't exist, clear stored table and prompt again
                    if (errorText.includes('occupied') || errorText.includes('does not exist')) {
                        localStorage.removeItem(TABLE_STORAGE_KEY);
                        localStorage.removeItem(TABLE_EXPIRY_KEY);
                        tableNumber = null;
                        updateTableNumberUI();
                    }
                    throw new Error(errorText || 'Failed to place order');
                }
            })
            .then(data => {
                // Success
                checkoutModal.hide();
                
                // Save to local Order History
                let orderTotal = 0;
                cart.forEach(i => orderTotal += (i.price * i.quantity));
                saveOrderToHistory(data.orderId, orderTotal, cart, note);

                alert(`Order placed successfully! Order ID: ${data.orderId}`);
                cart = [];
                saveCart();
                updateCartUI();

                // Show orders immediately to confirm? or just let them check
                // showOrderHistory(); 
            })
            .catch(error => {
                console.error('Error placing order:', error);
                alert(error.message);
                
                if (error.message.includes('occupied') || error.message.includes('does not exist')) {
                    checkoutModal.hide();
                    promptForTableNumber(true);
                }
            })
            .finally(() => {
                confirmBtn.disabled = false;
                confirmBtn.innerHTML = '<i class="bi bi-check-lg me-2"></i>Place Order';
            });
        }

        // Event listeners
        document.addEventListener('DOMContentLoaded', function() {
            // Load cart from local storage
            loadCart();

            // Update table number UI
            updateTableNumberUI();

            // If no table number, prompt for it
            if (!tableNumber || tableNumber <= 0) {
                // Short delay to ensure Bootstrap is ready
                setTimeout(() => promptForTableNumber(), 500);
            }

            // Auto-load category if selected
            if (typeof selectedCategoryId !== 'undefined' && selectedCategoryId !== null) {
                loadMenuItems(selectedCategoryId);
            }

            // Category navigation
            document.querySelectorAll('.category-link').forEach(link => {
                link.addEventListener('click', function(e) {
                    e.preventDefault();
                    // Basic active state toggling
                    document.querySelectorAll('.category-link').forEach(l => l.classList.remove('active', 'bg-primary', 'text-white'));
                    this.classList.add('active', 'bg-dark', 'text-white');

                    const categoryId = parseInt(this.getAttribute('data-category-id'));
                    loadMenuItems(categoryId);
                });
            });

            // Button Events
            document.getElementById('checkout-btn').addEventListener('click', checkout);
            document.getElementById('change-table-btn').addEventListener('click', () => promptForTableNumber(true));
            document.getElementById('confirmTableBtn').addEventListener('click', confirmTableNumber);
            document.getElementById('confirmCheckoutBtn').addEventListener('click', confirmCheckout);
            
            // "الطلبات" Button


            // Inputs
            document.getElementById('tableNumberInput').addEventListener('keypress', function(e) {
                if (e.key === 'Enter') confirmTableNumber();
            });
        });
    </script>
}