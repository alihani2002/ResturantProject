@model Resturant.Core.Entities.MenuItem

@{
    ViewData["Title"] = "Edit Menu Item";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="main-content">
    <div class="row">
        <div class="col-lg-12">
            <div class="card stretch stretch-full">
                <div class="card-header">
                    <h5 class="card-title">Edit Menu Item</h5>
                    <a asp-action="Index" class="btn btn-secondary btn-sm float-end">
                        <i class="feather-arrow-left"></i> Back to List
                    </a>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="ImageUrl" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        
                        <div class="form-group mb-3">
                            <label asp-for="Name" class="form-label">Item Name</label>
                            <input asp-for="Name" class="form-control" required />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        
                        <div class="form-group mb-3">
                            <label asp-for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                        
                        <div class="form-group mb-3">
                            <label asp-for="Price" class="form-label">Price</label>
                            <input asp-for="Price" class="form-control" type="number" step="0.01" min="0.01" required />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>
                        
                        <div class="form-group mb-3">
                            <label asp-for="MenuCategoryId" class="form-label">Category</label>
                            <select asp-for="MenuCategoryId" class="form-control" required>
                                <option value="">-- Select Category --</option>
                                @if (ViewBag.MenuCategories != null)
                                {
                                    @foreach (var category in ViewBag.MenuCategories)
                                    {
                                        <option value="@category.Id" selected="@category.Id == Model.MenuCategoryId">@category.Name</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="MenuCategoryId" class="text-danger"></span>
                        </div>
                        
                        <div class="form-group mb-3">
                            <label class="form-label">Image</label>
                            <input name="imageFile" type="file" class="form-control" accept="image/*" />
                            @if (string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <small class="text-muted">No image uploaded</small>
                            }
                            else
                            {
                                <div class="mt-2">
                                    <img src="@Model.ImageUrl" alt="@Model.Name" style="max-width: 200px; max-height: 200px; object-fit: cover;" />
                                </div>
                            }
                        </div>
                        
                        <div class="form-check mb-3">
                            <input asp-for="IsAvailable" class="form-check-input" />
                            <label asp-for="IsAvailable" class="form-check-label">Available</label>
                        </div>
                        
                        <div class="form-group">
                            <button type="submit" class="btn btn-primary">
                                <i class="feather-save"></i> Save Changes
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="feather-x"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}