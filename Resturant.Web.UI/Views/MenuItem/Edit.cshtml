@* 
 * NOTE: didn't create migration or database
 *@
@model Resturant.Core.Entities.MenuItem

@{
    ViewData["Title"] = "Edit Menu Item";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="main-content">
    <div class="row">
        <div class="col-lg-12">
            <div class="card stretch stretch-full">
                <div class="card-header">
                    <h5 class="card-title">
                        <i class="feather-edit-2 text-warning me-2"></i>Edit Menu Item
                    </h5>
                    <a asp-action="Index" class="btn btn-secondary btn-sm float-end">
                        <i class="feather-arrow-left"></i> Back to List
                    </a>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data" id="editMenuItemForm">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="ImageUrl" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row">
                            <div class="col-md-8">
                                <!-- Item Name -->
                                <div class="form-group mb-3">
                                    <label asp-for="Name" class="form-label fw-semibold">Item Name / اسم الصنف</label>
                                    <input asp-for="Name" class="form-control" required />
                                    <span asp-validation-for="Name" class="text-danger small"></span>
                                </div>

                                <!-- Description -->
                                <div class="form-group mb-3">
                                    <label class="form-label fw-semibold">Description / الوصف <span class="text-muted small fw-normal">(Optional - plain text description)</span></label>
                                    <textarea id="DescriptionTextarea" class="form-control" rows="2" placeholder="Item description..."></textarea>
                                    <!-- Hidden field holds the full serialized value sent to server -->
                                    <input type="hidden" asp-for="Description" id="ActualDescription" />
                                </div>

                                <!-- ===== SIZES SECTION ===== -->
                                <div class="card border-warning mb-3 shadow-sm" id="sizesCard">
                                    <div class="card-header bg-warning bg-opacity-10 border-warning d-flex justify-content-between align-items-center py-2 px-3">
                                        <h6 class="mb-0 fw-bold text-dark">
                                            <i class="feather-maximize-2 text-warning me-1"></i>
                                            Size Variants &amp; Pricing / أحجام وأسعار مختلفة
                                        </h6>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge bg-secondary small" id="sizeCountBadge" style="display:none;"></span>
                                            <div class="form-check form-switch m-0">
                                                <input class="form-check-input" type="checkbox" id="hasSizesToggle" role="switch">
                                                <label class="form-check-label fw-semibold text-muted small ms-1" for="hasSizesToggle">
                                                    Enable Sizes
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card-body p-3" id="sizesContainer" style="display: none;">
                                        <p class="text-muted small mb-2">
                                            <i class="feather-info me-1"></i>
                                            Define each size and its price. The <strong>Base Price</strong> below will be used as the default if no size is selected.
                                        </p>

                                        <div class="row fw-semibold small text-muted mb-1 px-1">
                                            <div class="col-5">Size Name / اسم الحجم</div>
                                            <div class="col-5">Price / السعر</div>
                                            <div class="col-2"></div>
                                        </div>

                                        <div id="sizesList" class="mb-2">
                                            <!-- Dynamic Size Rows inserted by JS on DOMContentLoaded -->
                                        </div>

                                        <button type="button" class="btn btn-outline-warning btn-sm rounded-pill fw-bold" onclick="addSizeRow()">
                                            <i class="feather-plus me-1"></i> Add Size / إضافة حجم
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <!-- Image Upload -->
                                <div class="form-group mb-3">
                                    <label class="form-label fw-semibold">Image / الصورة</label>
                                    <input name="imageFile" type="file" class="form-control" accept="image/*" />
                                    @if (string.IsNullOrEmpty(Model.ImageUrl))
                                    {
                                        <small class="text-muted">No image uploaded</small>
                                    }
                                    else
                                    {
                                        <div class="mt-2 position-relative d-inline-block">
                                            <img src="@Model.ImageUrl" alt="@Model.Name"
                                                 class="rounded border"
                                                 style="max-width: 200px; max-height: 150px; object-fit: cover;" />
                                            <span class="badge bg-success position-absolute bottom-0 end-0 m-1">Current</span>
                                        </div>
                                    }
                                </div>

                                <!-- Base Price -->
                                <div class="form-group mb-3">
                                    <label asp-for="Price" class="form-label fw-semibold">Base Price / السعر الأساسي <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <input asp-for="Price" class="form-control" type="number" step="0.01" min="0.01" required />
                                        <span class="input-group-text">EGP</span>
                                    </div>
                                    <span asp-validation-for="Price" class="text-danger small"></span>
                                    <small class="text-muted" id="basePriceNote" style="display:none;">
                                        This is the fallback price when no size is chosen.
                                    </small>
                                </div>

                                <!-- Category -->
                                <div class="form-group mb-3">
                                    <label asp-for="MenuCategoryId" class="form-label fw-semibold">Category / الفئة <span class="text-danger">*</span></label>
                                    <select asp-for="MenuCategoryId" class="form-control" required>
                                        <option value="">-- Select Category --</option>
                                        @if (ViewBag.MenuCategories != null)
                                        {
                                            @foreach (var category in ViewBag.MenuCategories)
                                            {
                                                var isSelected = category.Id == Model.MenuCategoryId;
                                                <option value="@category.Id" selected="@isSelected">@category.Name</option>
                                            }
                                        }
                                    </select>
                                    <span asp-validation-for="MenuCategoryId" class="text-danger small"></span>
                                </div>

                                <!-- Sort Order -->
                                <div class="form-group mb-3">
                                    <label asp-for="OrderNumber" class="form-label fw-semibold">Sort Order</label>
                                    <input asp-for="OrderNumber" class="form-control" type="number" min="0" />
                                    <span asp-validation-for="OrderNumber" class="text-danger small"></span>
                                </div>

                                <!-- Flags -->
                                <div class="card bg-light border-0 p-3 mb-3">
                                    <label class="form-label fw-semibold small text-muted mb-2">Item Flags</label>
                                    <div class="d-flex flex-column gap-2">
                                        <div class="form-check">
                                            <input asp-for="IsAvailable" class="form-check-input" id="IsAvailable" />
                                            <label for="IsAvailable" class="form-check-label">Available</label>
                                        </div>
                                        <div class="form-check">
                                            <input asp-for="IsPopular" class="form-check-input" id="IsPopular" />
                                            <label for="IsPopular" class="form-check-label text-danger fw-bold">🔥 Best Seller</label>
                                        </div>
                                        <div class="form-check">
                                            <input asp-for="IsTrending" class="form-check-input" id="IsTrending" />
                                            <label for="IsTrending" class="form-check-label text-warning fw-bold">⚡ Trending</label>
                                        </div>
                                        <div class="form-check">
                                            <input asp-for="IsRecommended" class="form-check-input" id="IsRecommended" />
                                            <label for="IsRecommended" class="form-check-label text-info fw-bold">⭐ Recommended</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2 pt-2 border-top">
                            <button type="submit" class="btn btn-warning px-4 fw-bold">
                                <i class="feather-save me-1"></i> Save Changes
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="feather-x me-1"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // ──────────────────────────────────────────────
        //  Size Row Management
        // ──────────────────────────────────────────────
        function addSizeRow(name = '', price = '') {
            const list = document.getElementById('sizesList');
            const rowId = 'size-row-' + Date.now() + '-' + Math.random().toString(36).substr(2, 4);

            const row = document.createElement('div');
            row.className = 'row g-2 mb-2 align-items-center size-row';
            row.id = rowId;
            row.innerHTML = `
                <div class="col-5">
                    <input type="text"
                           class="form-control size-name-input"
                           placeholder="e.g. Small / صغير"
                           value="${name.replace(/"/g, '&quot;')}" />
                </div>
                <div class="col-5">
                    <div class="input-group">
                        <input type="number" step="0.01" min="0.01"
                               class="form-control size-price-input"
                               placeholder="0.00"
                               value="${price}" />
                        <span class="input-group-text fw-semibold">EGP</span>
                    </div>
                </div>
                <div class="col-2 text-end">
                    <button type="button" class="btn btn-outline-danger btn-sm px-2"
                            onclick="removeSizeRow('${rowId}')"
                            title="Remove this size">
                        <i class="feather-trash-2"></i>
                    </button>
                </div>
            `;
            list.appendChild(row);
            updateSizeCount();
        }

        function removeSizeRow(rowId) {
            const row = document.getElementById(rowId);
            if (row) row.remove();
            updateSizeCount();
        }

        function updateSizeCount() {
            const count = document.querySelectorAll('.size-row').length;
            const badge = document.getElementById('sizeCountBadge');
            if (count > 0) {
                badge.textContent = count + ' size' + (count > 1 ? 's' : '');
                badge.style.display = 'inline-block';
            } else {
                badge.style.display = 'none';
            }
        }

        // ──────────────────────────────────────────────
        //  Toggle sizes section
        // ──────────────────────────────────────────────
        document.getElementById('hasSizesToggle').addEventListener('change', function () {
            const container = document.getElementById('sizesContainer');
            const basePriceNote = document.getElementById('basePriceNote');
            if (this.checked) {
                container.style.display = 'block';
                basePriceNote.style.display = 'block';
                if (document.querySelectorAll('.size-row').length === 0) {
                    addSizeRow();
                }
            } else {
                container.style.display = 'none';
                basePriceNote.style.display = 'none';
            }
        });

        // ──────────────────────────────────────────────
        //  On Page Load: parse existing Description and populate UI
        // ──────────────────────────────────────────────
        document.addEventListener('DOMContentLoaded', function () {
            // The full raw description is already bound to ActualDescription via asp-for
            // We read it from the hidden field's current value
            const rawDescription = document.getElementById('ActualDescription').value || '';

            // ─── Parse sizes from description ───
            // Expected pattern: "Sizes: Small - 25.00, Medium - 35.00, Large - 45.00"
            // The sizes block may appear at the end after a newline or inline
            const sizesRegex = /(?:^|\n|\r)\s*(?:sizes?|الاحجام|الحجم|الأحجام)\s*:\s*([\s\S]+)$/i;
            const sizesMatch = rawDescription.match(sizesRegex);

            let parsedSizes = [];
            let cleanDescription = rawDescription;

            if (sizesMatch) {
                // Extract the clean description without the sizes block
                cleanDescription = rawDescription
                    .replace(/(?:\n|\r)*\s*(?:sizes?|الاحجام|الحجم|الأحجام)\s*:\s*[\s\S]+$/i, '')
                    .trim();

                // Parse each size entry: "Name - price" or "Name: price" etc.
                const sizesPart = sizesMatch[1];
                const parts = sizesPart.split(/[,;]+/);
                parts.forEach(part => {
                    const trimmed = part.trim();
                    if (!trimmed) return;
                    // Match patterns: "Small - 25.00", "Small: 25", "Small 25.00"
                    const m = trimmed.match(/^([a-zA-Z\s\u0600-\u06FF]+?)[\s:=\-]+([0-9]+(?:\.[0-9]+)?)/i);
                    if (m) {
                        const name = m[1].trim();
                        const price = parseFloat(m[2]);
                        if (name && price > 0) {
                            parsedSizes.push({ name, price });
                        }
                    }
                });
            }

            // Populate the description textarea (cleaned of sizes block)
            document.getElementById('DescriptionTextarea').value = cleanDescription;

            // Populate sizes UI if any were found
            if (parsedSizes.length > 0) {
                document.getElementById('hasSizesToggle').checked = true;
                document.getElementById('sizesContainer').style.display = 'block';
                document.getElementById('basePriceNote').style.display = 'block';
                parsedSizes.forEach(sz => addSizeRow(sz.name, sz.price.toFixed(2)));
            }
        });

        // ──────────────────────────────────────────────
        //  Form submission: serialize sizes into Description hidden field
        // ──────────────────────────────────────────────
        document.getElementById('editMenuItemForm').addEventListener('submit', function (e) {
            const hasSizes = document.getElementById('hasSizesToggle').checked;
            const actualDescriptionInput = document.getElementById('ActualDescription');
            const rawDescription = document.getElementById('DescriptionTextarea').value.trim();

            if (hasSizes) {
                const rows = document.querySelectorAll('.size-row');
                const sizeStrings = [];
                rows.forEach(row => {
                    const name = row.querySelector('.size-name-input').value.trim();
                    const price = parseFloat(row.querySelector('.size-price-input').value) || 0;
                    if (name && price > 0) {
                        sizeStrings.push(`${name} - ${price.toFixed(2)}`);
                    }
                });

                if (sizeStrings.length > 0) {
                    const sizesString = 'Sizes: ' + sizeStrings.join(', ');
                    actualDescriptionInput.value = rawDescription
                        ? rawDescription + '\n' + sizesString
                        : sizesString;
                } else {
                    // User enabled sizes toggle but added no valid rows
                    actualDescriptionInput.value = rawDescription;
                }
            } else {
                // No sizes — just store plain description
                actualDescriptionInput.value = rawDescription;
            }
        });
    </script>
}