@model Resturant.Core.Entities.QrCode

@{
    ViewData["Title"] = "Generate Custom QR";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row">
    <div class="col-lg-6 offset-lg-3">
        <div class="card stretch stretch-full">
            <div class="card-body">
                <h4 class="card-title mb-4">Generate Custom QR</h4>
                <form asp-action="Create" enctype="multipart/form-data">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    
                    <div class="form-group mb-3">
                        <label class="control-label mb-2">Website Link (Required)</label>
                        <input type="url" name="WebsiteUrl" class="form-control" placeholder="e.g. https://my-restaurant.com/menu" value="@ViewData["WebsiteUrl"]" required />
                        <small class="text-muted">Enter the URL where the QR code should redirect.</small>
                    </div>

                    <div class="form-group mb-3">
                        <label class="control-label mb-2">Brand Name (Optional)</label>
                        <input type="text" name="BrandName" class="form-control" placeholder="e.g. Suntushi" value="@ViewData["BrandName"]" />
                    </div>

                    <div class="form-group mb-3">
                        <label class="control-label mb-2">Logo Image (Optional)</label>
                        <input type="file" name="LogoImage" class="form-control" accept="image/*" />
                        <small class="text-muted">Image to be displayed at the top of the QR code.</small>
                    </div>

                    <div class="form-group mb-3">
                        <label class="control-label mb-2">Bottom Image / Ads (Optional)</label>
                        <input type="file" name="BottomImage" class="form-control" accept="image/*" />
                        <small class="text-muted">Image/Ad to be displayed at the bottom of the QR code.</small>
                    </div>
                    <div class="form-group d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                        <input type="submit" value="Generate QR" class="btn btn-primary" />
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
