@model IEnumerable<Resturant.Core.Entities.Branch>
@{
    Layout = null;
    string terminalName = ViewBag.TerminalName ?? "اللوحة";
    // Map terminalName to Arabic if it's English
    if (terminalName == "Cashier") terminalName = "الكاشير";
    else if (terminalName == "Chef") terminalName = "المطبخ";
    else if (terminalName == "Waiter") terminalName = "الويتر";
    
    string targetAction = ViewBag.TargetAction ?? "Index";
    string targetController = ViewBag.TargetController ?? "Home";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>اختر الفرع - @terminalName</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f5f7ff',
                            100: '#ebf0ff',
                            200: '#d6e0ff',
                            300: '#adc2ff',
                            400: '#85a4ff',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            800: '#1e40af',
                            900: '#1e3a8a',
                            950: '#172554',
                        }
                    }
                }
            }
        }
    </script>
    <!-- Google Fonts Cairo -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background-color: #0f172a;
            background-image: radial-gradient(circle at 10% 20%, rgba(59, 130, 246, 0.08) 0%, transparent 40%), radial-gradient(circle at 90% 80%, rgba(99, 102, 241, 0.08) 0%, transparent 40%);
        }
    </style>
</head>
<body class="text-slate-100 min-h-screen flex items-center justify-center p-6 text-right" style="direction: rtl;">
    <div class="max-w-4xl w-full space-y-8">
        <!-- Header -->
        <div class="text-center space-y-4">
            <div class="inline-flex p-4 bg-blue-500/10 rounded-3xl border border-blue-500/20 text-blue-400 mb-2">
                <i class="bi bi-geo-alt-fill text-4xl animate-pulse"></i>
            </div>
            <h1 class="text-4xl font-extrabold tracking-tight bg-gradient-to-r from-blue-400 via-indigo-400 to-purple-400 bg-clip-text text-transparent">
                بوابة الفروع المتعددة
            </h1>
            <p class="text-slate-400 text-sm max-w-md mx-auto">
                مرحباً بك. يرجى اختيار موقع الفرع الفعلي لتشغيل لوحة <span class="text-blue-400 font-bold">@terminalName</span>.
            </p>
        </div>

        <!-- Branches Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var branch in Model)
            {
                <a href="@Url.Action(targetAction, targetController, new { branchId = branch.Id })" 
                   class="group block bg-slate-900/60 hover:bg-slate-800/80 border border-slate-800 hover:border-blue-500/40 rounded-3xl p-6 transition-all duration-300 transform hover:-translate-y-1 hover:shadow-2xl hover:shadow-blue-500/5 relative overflow-hidden">
                    
                    <!-- Decorative glowing corner -->
                    <div class="absolute -left-16 -top-16 w-32 h-32 bg-blue-500/10 rounded-full blur-2xl group-hover:bg-blue-500/20 transition-all duration-300"></div>
                    
                    <div class="space-y-4">
                        <div class="flex items-center justify-between">
                            <div class="p-3 bg-blue-500/10 text-blue-400 rounded-2xl group-hover:bg-blue-500 group-hover:text-white transition-all duration-300">
                                <i class="bi bi-shop text-xl"></i>
                            </div>
                            <span class="text-[10px] uppercase tracking-wider font-extrabold px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                                نشط
                            </span>
                        </div>
                        
                        <div>
                            <h3 class="font-bold text-lg text-slate-100 group-hover:text-blue-400 transition-colors duration-200">
                                @branch.Name
                            </h3>
                            <p class="text-xs text-slate-400 mt-1.5 flex items-center gap-1.5 justify-end">
                                <span>@(string.IsNullOrEmpty(branch.Address) ? "العنوان الافتراضي" : branch.Address)</span>
                                <i class="bi bi-geo-alt"></i>
                            </p>
                        </div>
                        
                        <div class="pt-4 border-t border-slate-800/50 flex items-center justify-between text-xs text-slate-500 group-hover:text-slate-300 transition-colors duration-200">
                            <span>دخول إلى @terminalName</span>
                            <i class="bi bi-arrow-left-short text-lg group-hover:-translate-x-1 transition-transform duration-200"></i>
                        </div>
                    </div>
                </a>
            }
        </div>

        <!-- Footer -->
        <div class="text-center">
            <a href="/Admin" class="inline-flex items-center gap-2 text-xs text-slate-500 hover:text-slate-300 transition-colors">
                <i class="bi bi-arrow-right"></i>
                <span>العودة إلى لوحة الإدارة العامة</span>
            </a>
        </div>
    </div>
</body>
</html>
