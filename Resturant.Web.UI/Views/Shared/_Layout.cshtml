<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Resturant.Web.UI</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Resturant.Web.UI.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/assets/images/q.png">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

</head>
<body>
    @if (ViewData["Title"]?.ToString() != "Qore Menu")
    {
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white sticky-top shadow-sm mb-4 py-3">
            <div class="container d-flex flex-column align-items-center">
                <!-- Brand Centered -->
                <div class="navbar-brand-centered">
                    <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                        <img src="~/assets/images/Qore.png" alt="QoreSystem" class="me-2" style="height: 32px; width: auto;" onerror="this.src='~/assets/images/logo-abbr.png'" />
                        <span class="text-black-pure fw-bold fs-2" style="letter-spacing: 1px;">QoreSystem</span> <!-- Brand -->
                    </a>
                </div>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Links Centered Below Brand -->
                <div class="navbar-collapse collapse w-100 justify-content-center">
<ul class="navbar-nav mb-2 mb-lg-0 gap-4"> <!-- Added gap for spacing -->
                        <li class="nav-item">
                            <a class="nav-link text-black-pure fw-bold text-uppercase" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                    </ul>
                    <!-- Login Partial (Absolute right on desktop, or stacked on mobile) -->
                    <div class="d-lg-flex position-lg-absolute end-0 top-50 translate-middle-y-lg mt-3 mt-lg-0"> 
                         <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>
    }
    <main role="main" class="pb-0">
        @RenderBody()
    </main>
    
    <partial name="_OrderHistoryPartial" />

    @if (ViewData["Title"]?.ToString() != "Qore Menu")
    {
    <footer class="footer-custom mt-5 border-top" id="contact">
        <div class="container">
            <div class="row">
               
                
            </div>
            <div class="footer-bottom border-top pt-4 mt-4">
                    <p class="text-muted">&copy; @DateTime.Now.Year QORE || Powered by CORVENT . All Rights Reserved.</p>
            </div>
        </div>
    </footer>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
