<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Resturant.Web.UI</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Resturant.Web.UI.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/assets/images/q.png">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

</head>
<body>
    @if (ViewData["Title"]?.ToString() != "Qore Menu")
    {
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white sticky-top shadow-sm mb-4 py-3">
            <div class="container d-flex flex-column align-items-center">
                <!-- Brand Centered -->
                <div class="navbar-brand-centered">
                    <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-egg-fried text-warning fs-2"></i> <!-- Slightly larger icon -->
                        <span class="text-black-pure fw-bold fs-2" style="letter-spacing: 1px;">TEST RESTAURANT</span> <!-- Uppercase for brand -->
                    </a>
                </div>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Links Centered Below Brand -->
                <div class="navbar-collapse collapse w-100 justify-content-center">
                     <ul class="navbar-nav mb-2 mb-lg-0 gap-4"> <!-- Added gap for spacing -->
                        <li class="nav-item">
                            <a class="nav-link text-black-pure fw-bold text-uppercase" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-black-pure fw-bold text-uppercase" href="#menu">Menu</a>
                        </li>
                         <li class="nav-item">
                            <a class="nav-link text-black-pure fw-bold text-uppercase" href="#about">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-black-pure fw-bold text-uppercase" href="#contact">Contact</a>
                        </li>
                        <!-- Privacy removed from main nav for cleaner look, can stay in footer -->
                    </ul>
                    <!-- Login Partial (Absolute right on desktop, or stacked on mobile) -->
                    <div class="d-lg-flex position-lg-absolute end-0 top-50 translate-middle-y-lg mt-3 mt-lg-0"> 
                         <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>
    }
    <main role="main" class="pb-0">
        @RenderBody()
    </main>
    
    <partial name="_OrderHistoryPartial" />

    @if (ViewData["Title"]?.ToString() != "Qore Menu")
    {
    <footer class="footer-custom mt-5 border-top" id="contact">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 col-md-6 mb-4">
                    <h5 class="text-dark">TestResturant</h5>
                    <p class="text-black-pure">Experience the best culinary delights with our exquisite menu and exceptional service. Fresh ingredients, passionate chefs, and a warm atmosphere.</p>
                    <div class="d-flex gap-3 mt-3">
                        <a href="#" class="text-dark"><i class="bi bi-facebook fs-5"></i></a>
                        <a href="#" class="text-dark"><i class="bi bi-instagram fs-5"></i></a>
                        <a href="#" class="text-dark"><i class="bi bi-twitter fs-5"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-6 mb-4">
                    <h5 class="text-dark">Quick Links</h5>
                    <a href="#">Home</a>
                    <a href="#menu">Menu</a>
                    <a href="#about">About Us</a>
                    <a href="#contact">Contact</a>
                    <a asp-area="Identity" asp-page="/Account/Login">Login</a>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <h5 class="text-dark">Opening Hours</h5>
                    <p class="mb-1 text-black-pure">Mon - Fri: 09:00 - 22:00</p>
                    <p class="mb-1 text-black-pure">Sat: 10:00 - 23:00</p>
                    <p class="text-black-pure">Sun: Closed</p>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <h5 class="text-dark">Contact Us</h5>
                    <p class="mb-1 text-muted"><i class="bi bi-geo-alt-fill me-2 text-warning"></i> 123 Restaurant Street, Food City</p>
                    <p class="mb-1 text-muted"><i class="bi bi-telephone-fill me-2 text-warning"></i> +1 234 567 890</p>
                    <p class="text-muted"><i class="bi bi-envelope-fill me-2 text-warning"></i> info@testresturant.com</p>
                </div>
            </div>
            <div class="footer-bottom border-top pt-4 mt-4">
                <p class="text-muted">&copy; @DateTime.Now.Year TestResturant. All Rights Reserved.</p>
            </div>
        </div>
    </footer>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
