<!-- Order History Modal -->
<div class="modal fade" id="orderHistoryModal" tabindex="-1" aria-labelledby="orderHistoryModalLabel" aria-hidden="true" style="font-family: 'Cairo', sans-serif;">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-black text-white" style="background-color: #000 !important; direction: rtl;">
                <h5 class="modal-title" id="orderHistoryModalLabel">
                    <i class="bi bi-clock-history ms-2"></i>طلباتي
                </h5>
                <button type="button" class="btn-close btn-close-white ms-0 me-auto" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body text-right" style="direction: rtl;">
                <div id="order-history-list">
                    <p class="text-center text-muted my-4">لا توجد طلبات حديثة.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Floating "الطلبات" Button -->
<button id="floatingOrdersBtn" class="btn btn-dark shadow-lg position-fixed bottom-0 start-0 m-4 rounded-pill px-4 py-2 z-3" 
        style="border: 2px solid #fff; font-weight: bold; background-color: #000; color: #fff; z-index: 1050; font-family: 'Cairo', sans-serif;">
    <i class="bi bi-receipt ms-2"></i>الطلبات
</button>

<script>
    (function() {
        const ORDER_HISTORY_KEY = 'guestOrderHistory';
        const TABLE_STORAGE_KEY_SHARED = 'tableNumber';
        const TABLE_EXPIRY_KEY_SHARED = 'tableNumberExpiry';
        const ORDER_EXPIRY_HOURS = 8;

        window.getOrderHistory = function() {
            const historyJson = localStorage.getItem(ORDER_HISTORY_KEY);
            if (!historyJson) return [];

            let history = JSON.parse(historyJson);
            const now = new Date().getTime();
            const expiryTime = ORDER_EXPIRY_HOURS * 60 * 60 * 1000;

            const validHistory = history.filter(order => (now - order.timestamp) < expiryTime);
            
            if (validHistory.length !== history.length) {
                localStorage.setItem(ORDER_HISTORY_KEY, JSON.stringify(validHistory));
            }

            return validHistory;
        };

        window.saveOrderToHistory = function(orderId, total, items, note) {
            const now = new Date().getTime();
            
            let currentTable = null;
            try {
                const storedNumber = localStorage.getItem(TABLE_STORAGE_KEY_SHARED);
                const expiryTime = localStorage.getItem(TABLE_EXPIRY_KEY_SHARED);
                if (storedNumber && expiryTime && new Date().getTime() < parseInt(expiryTime)) {
                    currentTable = storedNumber;
                }
            } catch(e) {}

            const order = {
                id: orderId,
                total: total,
                items: items,
                note: note,
                timestamp: now,
                table: currentTable
            };

            let history = window.getOrderHistory();
            history.push(order);
            localStorage.setItem(ORDER_HISTORY_KEY, JSON.stringify(history));
        };

        window.showOrderHistory = function() {
            const history = window.getOrderHistory();
            const listContainer = document.getElementById('order-history-list');

            if (history.length === 0) {
                 listContainer.innerHTML = '<div class="text-center py-5"><i class="bi bi-receipt text-muted" style="font-size: 3rem;"></i><p class="mt-3 text-muted">لا توجد طلبات سابقة.</p></div>';
            } else {
                let html = '<div class="list-group list-group-flush" style="direction: rtl; text-align: right;">';
                history.reverse().forEach(order => {
                    const date = new Date(order.timestamp);
                    const timeString = date.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
                    
                    html += `
                        <div class="list-group-item">
                            <div class="d-flex w-100 justify-content-between align-items-center mb-2">
                                <h6 class="mb-0 fw-bold">طلب رقم #${order.id}</h6>
                                <small class="text-black-pure">${timeString}</small>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-dark">طاولة ${order.table || '?'}</span>
                                <span class="fw-bold text-success">${order.total.toFixed(2)} ج.م</span>
                            </div>
                            <div class="small text-black-pure mb-2">
                                ${order.items.map(i => `<span class="d-block">&bull; ${i.quantity}x ${i.name}</span>`).join('')}
                            </div>
                            ${order.note ? `<div class="alert alert-light p-2 mb-0 small"><i class="bi bi-chat-quote-fill ms-1 text-info"></i> ${order.note}</div>` : ''}
                        </div>
                    `;
                });
                html += '</div>';
                listContainer.innerHTML = html;
            }

            const bsRequest = window.bootstrap || bootstrap;
            const modal = new bsRequest.Modal(document.getElementById('orderHistoryModal'));
            modal.show();
        };

        document.addEventListener('DOMContentLoaded', function() {
            const btn = document.getElementById('floatingOrdersBtn');
            if (btn) {
                btn.addEventListener('click', window.showOrderHistory);
            }
        });
    })();
</script>
