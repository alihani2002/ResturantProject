@model Resturant.Core.Entities.GuestTable

@{
    ViewData["Title"] = "Create Table";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row">
    <div class="col-lg-6 offset-lg-3">
        <div class="card stretch stretch-full">
            <div class="card-body">
                <h4 class="card-title mb-4">Add New Table</h4>
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group mb-3">
                        <label asp-for="TableNumber" class="control-label mb-2"></label>
                        <input asp-for="TableNumber" class="form-control" placeholder="Enter Table Number (Leave empty for General QR)" />
                        <span asp-validation-for="TableNumber" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label class="control-label mb-2">Website Link (Optional)</label>
                        <input type="url" name="WebsiteUrl" class="form-control" placeholder="e.g. https://my-restaurant.com (Defaults to current site)" />
                        <small class="text-muted">Enter the base URL of the website. The table number will be appended automatically.</small>
                    </div>
                    <div class="form-group d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                        <input type="submit" value="Generate QR & Create" class="btn btn-primary" />
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
