@model IEnumerable<Resturant.Core.Entities.RestaurantTable>

@{
    ViewData["Title"] = "Restaurant Tables";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row">
    <div class="col-lg-12">
        <div class="card stretch stretch-full">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <div class="d-flex justify-content-between align-items-center p-3">
                        <h3>Restaurant Tables</h3>
                        <div>
                            <a asp-action="Create" class="btn btn-primary me-2">Add New Table</a>
                        </div>
                    </div>
                    <table class="table table-hover" id="tablesTable" style="width:100%">
                        <thead>
                            <tr>
                                <th>Table Number</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>
    <link href="https://cdn.datatables.net/1.11.5/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

    <script>
        $(document).ready(function () {
            $("#tablesTable").DataTable({
                "processing": true,
                "serverSide": true,
                "filter": true,
                "ajax": {
                    "url": "/Tables/LoadData",
                    "type": "POST",
                    "datatype": "json"
                },
                "columnDefs": [{
                    "targets": [0],
                    "visible": true,
                    "searchable": true
                }],
                "columns": [
                    { 
                        "data": "tableNumber", 
                        "name": "TableNumber", 
                        "autoWidth": true,
                        "render": function (data, type, row) {
                            return `<span class="fw-bold fs-16">Table ${data}</span>`;
                        }
                    }
                ]
            });
        });
    </script>
}
