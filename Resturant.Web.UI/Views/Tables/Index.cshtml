@model IEnumerable<Resturant.Core.Entities.GuestTable>

@{
    ViewData["Title"] = "Generate QR code";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row">
    <div class="col-lg-12">
        <div class="card stretch stretch-full">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <div class="d-flex justify-content-between align-items-center p-3">
                        <h3>Generate QR code</h3>
                        <a asp-action="Create" class="btn btn-primary">Add New Table</a>
                    </div>
                    <table class="table table-hover" id="tablesTable" style="width:100%">
                        <thead>
                            <tr>
                                <th>Table Number</th>
                                <th>QR Code</th>
                                <th>URL</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>
    <link href="https://cdn.datatables.net/1.11.5/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

    <script>
        $(document).ready(function () {
            $("#tablesTable").DataTable({
                "processing": true,
                "serverSide": true,
                "filter": true,
                "ajax": {
                    "url": "/Tables/LoadData",
                    "type": "POST",
                    "datatype": "json"
                },
                "columnDefs": [{
                    "targets": [0],
                    "visible": true,
                    "searchable": true
                }],
                "columns": [
                    { 
                        "data": "tableNumber", 
                        "name": "TableNumber", 
                        "autoWidth": true,
                        "render": function (data, type, row) {
                            return data ? `<span class="fw-bold fs-16">Table ${data}</span>` : '<span class="fw-bold fs-16">General QR</span>';
                        }
                    },
                    { 
                        "data": "qrCodeUrl", 
                        "name": "QrCodeUrl", 
                        "autoWidth": true,
                        "render": function (data, type, row) {
                            if (data) {
                                var tableName = row.tableNumber ? row.tableNumber : "General";
                                return `<img src="${data}" alt="QR Code" style="width: 100px; height: 100px;" /><br/>
                                        <a href="${data}" download="Table_${tableName}_QR.png" class="btn btn-sm btn-outline-secondary mt-2">Download QR</a>`;
                            }
                            return '<span class="text-muted">No QR Code</span>';
                        }
                    },
                    { 
                        "data": "url", 
                        "name": "Url", 
                        "autoWidth": true,
                        "render": function (data, type, row) {
                             return `<a href="${data}" target="_blank">${data}</a>`;
                        }
                    }
                ]
            });
        });
    </script>
}
