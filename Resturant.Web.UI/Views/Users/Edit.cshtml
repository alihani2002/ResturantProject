@model Resturant.Web.UI.ViewModels.UserViewModel
@using Resturant.Core.Common

@{
    ViewData["Title"] = "تعديل المستخدم";
    bool isIframe = Context.Request.Query["iframe"] == "true" || (Context.Request.HasFormContentType && Context.Request.Form["iframe"] == "true");
    Layout = isIframe ? "~/Views/Shared/_IframeLayout.cshtml" : "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row">
    <div class="col-md-6 mx-auto">
        <div class="card border-top border-0 border-4 border-info">
            <div class="card-header bg-transparent py-3">
                <h4 class="mb-0 text-info fw-bold"><i class="feather-edit me-2"></i>تعديل المستخدم</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger text-start"></div>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" name="iframe" value="@(isIframe ? "true" : "")" />
                    
                    <div class="form-group mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold">الاسم الكامل</label>
                        <input asp-for="FullName" class="form-control" required />
                        <span asp-validation-for="FullName" class="text-danger text-start d-block"></span>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">البريد الإلكتروني</label>
                        <input asp-for="Email" class="form-control text-start" required />
                        <span asp-validation-for="Email" class="text-danger text-start d-block"></span>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="Password" class="form-label fw-semibold">كلمة المرور (اتركه فارغاً للاحتفاظ بكلمة المرور الحالية)</label>
                        <input asp-for="Password" class="form-control text-start" placeholder="أدخل كلمة مرور جديدة أو اتركه فارغاً" />
                        <span asp-validation-for="Password" class="text-danger text-start d-block"></span>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="Role" class="form-label fw-semibold">الدور / الصلاحية</label>
                        <select asp-for="Role" class="form-select" required>
                            <option value="">اختر الدور / الصلاحية</option>
                            <option value="@AppRoles.Admin">مدير النظام (Admin)</option>
                            <option value="@AppRoles.Manager">مدير فرع (Manager)</option>
                            <option value="@AppRoles.Chief">شيف / مطبخ (Chief)</option>
                            <option value="@AppRoles.Waiter">ويتر / نادل (Waiter)</option>
                            <option value="@AppRoles.Accountant">محاسب (Accountant)</option>
                            <option value="@AppRoles.User">مستخدم عادي (User)</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger text-start d-block"></span>
                    </div>
                    
                    <div class="form-group mb-3" id="branchSelectGroup">
                        <label asp-for="BranchId" class="form-label fw-semibold">الفرع المتاح</label>
                        <select asp-for="BranchId" class="form-select" asp-items="@(new SelectList(ViewBag.Branches, "Id", "Name"))">
                            <option value="">اختر الفرع</option>
                        </select>
                        <span asp-validation-for="BranchId" class="text-danger text-start d-block"></span>
                    </div>
                    
                    <div class="form-group form-check mb-3 text-start">
                        <div class="form-check form-switch d-inline-block">
                            <input class="form-check-input ms-0 me-2" asp-for="IsActive" type="checkbox" role="switch" />
                            <label class="form-check-label mr-4 fw-semibold" asp-for="IsActive">
                                الحساب نشط وصالح للعمليات
                            </label>
                        </div>
                    </div>
                    
                    <div class="form-group form-check mb-3 text-start">
                        <div class="form-check form-switch d-inline-block">
                            <input class="form-check-input ms-0 me-2" asp-for="IsDeleted" type="checkbox" role="switch" />
                            <label class="form-check-label mr-4 fw-semibold text-danger" asp-for="IsDeleted">
                                تم حذف الحساب (تعطيل الحساب نهائياً)
                            </label>
                        </div>
                    </div>
                    
                    <hr class="my-4 border-dashed" />
                    
                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" asp-route-iframe="@(isIframe ? "true" : "")" class="btn btn-light text-muted rounded-pill px-3">
                            <i class="feather-arrow-left me-1"></i>العودة للقائمة
                        </a>
                        <button type="submit" class="btn btn-info text-white rounded-pill px-4" style="background-color: #0dcaf0 !important; border-color: #0dcaf0 !important;">
                            <i class="feather-check-circle me-1"></i>حفظ التغييرات
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            function toggleBranchVisibility() {
                var selectedRole = $('#Role').val();
                if (selectedRole === 'Admin') {
                    $('#branchSelectGroup').hide();
                    $('#BranchId').val(''); // Clear selection
                } else {
                    $('#branchSelectGroup').show();
                }
            }
            
            $('#Role').change(toggleBranchVisibility);
            toggleBranchVisibility(); // Run on load
        });
    </script>
}
