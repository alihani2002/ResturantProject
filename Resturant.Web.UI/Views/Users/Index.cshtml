@model IEnumerable<Resturant.Web.UI.ViewModels.UserViewModel>

@{
    ViewData["Title"] = "إدارة المستخدمين";
    Layout = Context.Request.Query["iframe"] == "true" ? "~/Views/Shared/_IframeLayout.cshtml" : "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4 class="mb-0 text-primary fw-bold"><i class="feather-users me-2"></i>قائمة المستخدمين</h4>
                <a asp-action="Create" asp-route-iframe="@(Context.Request.Query["iframe"] == "true" ? "true" : "")" class="btn btn-primary px-3 rounded-pill">
                    <i class="feather-plus me-1"></i>إنشاء مستخدم جديد
                </a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover" id="usersTable">
                        <thead>
                            <tr>
                                <th>الاسم الكامل</th>
                                <th>البريد الإلكتروني</th>
                                <th>الصلاحية / الدور</th>
                                <th>الفرع</th>
                                <th>الحالة</th>
                                <th class="text-center">الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr class="@(item.IsDeleted ? "table-danger" : "")">
                                    <td>@Html.DisplayFor(modelItem => item.FullName)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Email)</td>
                                    <td>
                                        @if (item.Role == "Admin") { <span class="badge bg-light-danger text-danger">مدير النظام</span> }
                                        else if (item.Role == "Cashier") { <span class="badge bg-light-info text-info">كاشير</span> }
                                        else if (item.Role == "Waiter") { <span class="badge bg-light-success text-success">ويتر / نادل</span> }
                                        else if (item.Role == "Chef") { <span class="badge bg-light-primary text-primary">شيف / مطبخ</span> }
                                        else { <span class="badge bg-light-secondary text-secondary">@item.Role</span> }
                                    </td>
                                    <td>
                                        @if (item.BranchId.HasValue)
                                        {
                                            <span class="badge bg-secondary">@item.BranchName</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-dark">جميع الفروع</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.IsDeleted)
                                        {
                                            <span class="badge bg-danger">محذوف</span>
                                        }
                                        else if (item.IsActive)
                                        {
                                            <span class="badge bg-success">نشط</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">غير نشط</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="d-inline-flex gap-2">
                                            <a asp-action="Edit" asp-route-id="@item.Id" asp-route-iframe="@(Context.Request.Query["iframe"] == "true" ? "true" : "")" class="btn btn-sm btn-outline-info rounded-pill px-3">
                                                <i class="feather-edit-2 me-1"></i>تعديل
                                            </a>
                                            <a asp-action="ToggleActive" asp-route-id="@item.Id" asp-route-iframe="@(Context.Request.Query["iframe"] == "true" ? "true" : "")" class="btn btn-sm rounded-pill px-3 @(item.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                                                <i class="feather-power me-1"></i>@(item.IsActive ? "تعطيل" : "تفعيل")
                                            </a>
                                            @if (!item.IsDeleted)
                                            {
                                                <a asp-action="Delete" asp-route-id="@item.Id" asp-route-iframe="@(Context.Request.Query["iframe"] == "true" ? "true" : "")" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="return confirm('هل أنت متأكد من حذف هذا المستخدم نهائياً؟');">
                                                    <i class="feather-trash-2 me-1"></i>حذف
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Vendors CSS -->
    <link rel="stylesheet" type="text/css" href="/assets/vendors/css/dataTables.bs5.min.css">
    <!-- Vendors JS -->
    <script src="/assets/vendors/js/dataTables.min.js"></script>
    <script src="/assets/vendors/js/dataTables.bs5.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#usersTable').DataTable({
                "paging": true,
                "lengthChange": true,
                "searching": true,
                "ordering": true,
                "info": true,
                "autoWidth": false,
                "responsive": true,
                "language": {
                    "search": "البحث عن المستخدمين:",
                    "lengthMenu": "عرض _MENU_ مستخدمين لكل صفحة",
                    "info": "عرض من _START_ إلى _END_ من إجمالي _TOTAL_ مستخدم",
                    "infoEmpty": "عرض 0 إلى 0 من 0 مستخدم",
                    "infoFiltered": "(تصفية من إجمالي _MAX_ مستخدم)",
                    "emptyTable": "لا يوجد مستخدمون مسجلون بعد",
                    "paginate": {
                        "first": "الأول",
                        "previous": "السابق",
                        "next": "التالي",
                        "last": "الأخير"
                    }
                }
            });
        });
    </script>
}
