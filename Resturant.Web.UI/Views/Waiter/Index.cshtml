        function submitStartSession() {
            const customerName = document.getElementById('waiterCustomerName').value.trim();
            const phoneNumber = document.getElementById('waiterCustomerPhone').value.trim();

            if (!customerName || !phoneNumber) {
                alert("اسم العميل ورقم الهاتف مطلوبان!");
                return;
            }

            safeFetch('/Waiter/StartSession', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `tableNumber=${currentWaiterTable}&customerName=${encodeURIComponent(customerName)}&phoneNumber=${encodeURIComponent(phoneNumber)}`
            })
            .then(res => {
                if (res.ok) {
                    showNotification(`تم بدء جلسة طاولة ${currentWaiterTable} بنجاح!`, 'success');
                    document.getElementById('waiterSessionStep').style.display = 'none';
                    document.getElementById('waiterMenuStep').style.display = 'block';
                    loadWaiterMenuData();
                } else {
                    alert("فشل في بدء الجلسة.");
                }
            })
            .catch(err => console.error(err));
        }

        function submitWaiterOrder() {
            const items = cart.map(i => ({
                menuItemId: i.id,
                quantity: i.quantity,
                addOnIds: i.addOns ? i.addOns.map(a => a.id) : [],
                price: i.price,
                size: i.size || ''
            }));

            const payload = {
                tableNumber: currentWaiterTable,
                note: document.getElementById('orderNotesInput').value.trim(),
                orderItems: items,
                branchId: activeBranchId
            };

            const btn = document.getElementById('btnCartCheckout');
            const originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm ms-2"></span>جاري إرسال الطلب...';

            safeFetch('/Order/Create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(async res => {
                if (res.ok) {
                    if (waiterOrderModalInstance) waiterOrderModalInstance.hide();
                    showNotification('تم إرسال الطلب بنجاح!', 'success');
                    fetchAndRefreshTables();
                } else {
                    const errMsg = await res.text();
                    showNotification(errMsg || 'فشل في إرسال الطلب', 'danger');
                }
            })
            .catch(err => {
                console.error(err);
                showNotification(err.message || 'حدث خطأ في الاتصال بالخادم', 'danger');
            })
            .finally(() => {
                btn.disabled = false;
                btn.innerHTML = originalText;
            });
        }
        
        let activeCustomItem = null;
        let customizationQty = 1;

        function openCustomizationModal(menuItemId) {
            let item = null;
            for (const cat of fullMenuData) {
                const found = cat.items.find(i => i.id === menuItemId);
                if (found) {
                    item = found;
                    break;
                }
            }
            if (!item) return;

            activeCustomItem = item;
            customizationQty = 1;
            
            document.getElementById('customization-item-name').textContent = item.name;
            document.getElementById('customization-item-price').textContent = `${item.price.toFixed(2)} ج.م`;
            document.getElementById('customization-item-description').textContent = item.description || '';
            document.getElementById('customization-qty-val').textContent = customizationQty;

            const sizesSection = document.getElementById('sizes-section');
            const sizesList = document.getElementById('sizes-list');
            if (item.sizes && item.sizes.length > 0) {
                sizesSection.style.display = 'block';
                sizesList.innerHTML = item.sizes.map((size, idx) => `
                    <div class="flex-grow-1" style="min-width: 120px;">
