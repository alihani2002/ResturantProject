        function renderCategories() {
            const container = document.getElementById('categoriesSlider');
            let html = `<button class="btn btn-sm ${selectedCategory === 0 ? "btn-warning" : "btn-outline-dark"} rounded-pill px-3" onclick="selectCategory(0)">الكل</button>`;
            
            fullMenuData.forEach(cat => {
