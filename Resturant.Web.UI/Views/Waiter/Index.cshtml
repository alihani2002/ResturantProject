@* 
 * NOTE: didn't create migration or database
 *@
@model IEnumerable<Resturant.Web.UI.ViewModels.WaiterTableViewModel>

@{
    ViewData["Title"] = "إدارة الطاولات";
}

<div class="container-fluid mt-4" style="font-family: 'Cairo', 'Segoe UI', Tahoma, Geneva, sans-serif; direction: rtl; text-align: right;">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h2>
            <i class="bi bi-grid-3x3-gap-fill text-warning ms-2"></i>إدارة الطاولات 
            <span id="connection-status" class="badge bg-secondary ms-2"><i class="bi bi-wifi"></i> جاري الاتصال...</span>
        </h2>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            @if (User.IsInRole(Resturant.Core.Common.AppRoles.Admin) || User.IsInRole(Resturant.Core.Common.AppRoles.Manager))
            {
                <a href="@Url.Action("SelectBranch", "Waiter")" class="btn btn-warning btn-sm fw-bold rounded-pill px-3">
                    <i class="bi bi-arrow-left-right ms-1"></i> تبديل الفرع
                </a>
            }
            <button class="btn btn-outline-dark btn-sm rounded-pill" onclick="fetchAndRefreshTables()">
                <i class="bi bi-arrow-clockwise"></i> تحديث
            </button>
           <span class="badge bg-white text-dark border"><i class="bi bi-circle-fill text-secondary ms-1"></i> فارغة</span>
           <span class="badge bg-warning text-dark"><i class="bi bi-clock-fill ms-1"></i> طلب معلق</span>
           <span class="badge bg-success"><i class="bi bi-check-circle-fill ms-1"></i> نشط / تم التقديم</span>
        </div>
    </div>

    <div class="row g-4" id="tables-container">
        @foreach (var table in Model)
        {
            <div class="col-lg-3 col-md-4 col-sm-6" id="table-card-@table.TableNumber">
                <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden @(table.AggregateStatus == "Pending" ? "bg-warning bg-opacity-25" : (table.AggregateStatus == "Active" ? "bg-success bg-opacity-25" : (table.ActiveSessionId.HasValue ? "bg-info bg-opacity-10 border border-info border-opacity-25" : "bg-white")))">
                    <div class="card-body text-center d-flex flex-column p-3">
                        <div class="d-flex justify-content-between align-items-start border-bottom pb-2 mb-2">
                            <h3 class="card-title h4 fw-bold mb-0">طاولة @table.TableNumber</h3>
                            @if (table.ActiveSessionId.HasValue)
                            {
                                <button class="btn btn-xs btn-outline-danger border-0 rounded-circle" onclick="closeSession(@table.ActiveSessionId)" title="إغلاق الجلسة">
                                    <i class="bi bi-x-circle"></i>
                                </button>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(table.CustomerName))
                        {
                            <div class="small text-start mb-2 px-2 py-1 bg-white bg-opacity-50 rounded text-right" style="direction: rtl;">
                                <div><i class="bi bi-person-fill text-secondary ms-1"></i><strong>@table.CustomerName</strong></div>
                                <div class="text-muted"><i class="bi bi-telephone-fill ms-1"></i>@table.PhoneNumber</div>
                            </div>
                        }
                        
                        <div class="orders-container flex-grow-1" style="max-height: 400px; overflow-y: auto;">
                            @if (table.Orders != null && table.Orders.Any())
                            {
                                foreach (var order in table.Orders)
                                {
                                    <div class="card mb-2 shadow-sm order-card border-@((order.Status == "Pending") ? "warning" : "success") rounded-3 overflow-hidden">
                                        <div class="card-header py-1 @((order.Status == "Pending") ? "bg-warning text-dark" : (order.Status == "Ready" ? "bg-info text-white" : "bg-success text-white")) d-flex justify-content-between align-items-center">
                                            <small class="fw-bold">طلب #@order.OrderId</small>
                                            @if (order.Status == "Ready")
                                            {
                                                <span class="badge bg-white text-info fw-bold pulse-green">جاهز</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-white text-dark small">
                                                    @(order.Status == "Pending" ? "معلق" : (order.Status == "InPreparation" ? "تحضير" : (order.Status == "Confirmed" ? "مؤكد" : order.Status)))
                                                </span>
                                            }
                                        </div>
                                        <div class="card-body p-2 text-right" style="direction: rtl;">
                                            <div class="d-flex justify-content-between align-items-center mt-1 pb-2 border-bottom">
                                                <small class="text-muted">الإجمالي:</small>
                                                <small class="fw-bold text-dark">@(order.OrderItems.Where(i => !i.IsCancelled).Sum(i => i.EffectiveTotal).ToString("N2")) ج.م</small>
                                            </div>

                                            @if (order.OrderItems != null && order.OrderItems.Any())
                                            {
                                                <ul class="list-unstyled mb-2 small bg-light p-2 rounded-3 mt-2">
                                                    @foreach (var item in order.OrderItems)
                                                    {
                                                        <li class="d-flex align-items-center justify-content-between gap-1 mb-1" id="waiter-item-@order.OrderId-@item.Name.Replace(" ","-")">
                                                            <div>
                                                                <strong>@item.Quantity x @item.Name</strong>
                                                                @if (!string.IsNullOrEmpty(item.AddOns))
                                                                {
                                                                    <div class="ps-2 text-muted small" style="font-size: 0.75rem; line-height: 1.1;">+ @item.AddOns</div>
                                                                }
                                                            </div>
                                                        </li>
                                                    }
                                                </ul>
                                            }

                                            @if (!string.IsNullOrEmpty(order.Note))
                                            {
                                                <div class="alert alert-warning py-1 px-2 mb-2">
                                                    <small class="d-block fst-italic"><i class="bi bi-pencil-fill ms-1"></i>@order.Note</small>
                                                </div>
                                            }
                                            
                                            <div class="d-flex gap-1 mt-2">
                                                @if (order.Status == "Pending")
                                                {
                                                    <button class="btn btn-sm btn-success flex-grow-1 rounded-pill" onclick="acceptOrder(@order.OrderId)" title="قبول الطلب">
                                                        <i class="bi bi-check2"></i> قبول
                                                    </button>
                                                    <button class="btn btn-sm btn-danger rounded-pill" onclick="cancelOrder(@order.OrderId, @table.TableNumber)" title="إلغاء">
                                                        <i class="bi bi-x"></i> 
                                                    </button>
                                                }
                                                else if (order.Status == "Ready")
                                                {
                                                    <button class="btn btn-sm btn-success flex-grow-1 fw-bold rounded-pill" onclick="serveOrder(@order.OrderId)" title="تقديم الطلب">
                                                        <i class="bi bi-cup-hot-fill ms-1"></i> تقديم
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-danger rounded-pill" onclick="cancelOrder(@order.OrderId, @table.TableNumber)" title="إلغاء">
                                                        <i class="bi bi-x"></i> 
                                                    </button>
                                                }
                                                else
                                                {
                                                     <button class="btn btn-sm btn-outline-danger flex-grow-1 rounded-pill" onclick="cancelOrder(@order.OrderId, @table.TableNumber)" title="حذف الطلب">
                                                        <i class="bi bi-trash"></i> حذف الطلب
                                                     </button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                @if (table.ActiveSessionId.HasValue)
                                {
                                    <div class="text-primary small mt-4 py-3 bg-light rounded-3 border border-primary border-opacity-10">
                                        <i class="bi bi-person-check-fill display-5 d-block mb-2 text-primary opacity-50"></i>
                                        في انتظار الطلب
                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted small mt-4">
                                        <i class="bi bi-cup-hot display-4 d-block mb-2 text-secondary opacity-25"></i>
                                        متاحة
                                    </div>
                                }
                            }
                        </div>

                        <div class="mt-auto pt-2 border-top">
                            @if (table.ActiveSessionId.HasValue)
                            {
                                <button class="btn btn-warning btn-sm w-100 fw-bold rounded-pill" onclick="openWaiterOrderModal(@table.TableNumber, true)">
                                    <i class="bi bi-cart-plus ms-1"></i> إضافة طلب
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-outline-primary btn-sm w-100 fw-bold rounded-pill" onclick="openWaiterOrderModal(@table.TableNumber, false)">
                                    <i class="bi bi-plus-circle ms-1"></i> فتح وطلب
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- ================================================================ -->
<!-- [START] MODAL: WAITER MENU & ORDER CREATOR                        -->
<!-- ================================================================ -->
<div class="modal fade modal-xl" id="waiterOrderModal" tabindex="-1" aria-hidden="true" style="font-family: 'Cairo', sans-serif;">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 text-dark" style="background: #ffffff; border-radius: 24px; border: 1px solid rgba(0, 0, 0, 0.05) !important;">
            <div style="height: 6px; background: linear-gradient(90deg, #d4af37, #f3e5ab, #d4af37); border-radius: 24px 24px 0 0;"></div>
            
            <div class="modal-header border-0 pb-0 px-4 pt-4 d-flex justify-content-between align-items-center">
                <h5 class="modal-title fw-bold text-dark"><i class="bi bi-cart-plus-fill text-warning ms-2"></i>إضافة طلب - طاولة <span id="waiterOrderModalTitleTable"></span></h5>
                <button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <div class="modal-body px-4 py-3">
                <!-- Step 1: Start Table Session (if not active) -->
                <div id="waiterSessionStep" class="py-4" style="display: none;">
                    <div class="row justify-content-center">
                        <div class="col-md-6 text-center">
                            <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle mb-4" style="width: 80px; height: 80px; border: 2px solid #d4af37;">
                                <i class="bi bi-person-plus text-warning" style="font-size: 2.2rem;"></i>
                            </div>
                            <h4 class="fw-bold mb-2">فتح جلسة للطاولة</h4>
                            <p class="text-muted small mb-4">يرجى تسجيل اسم الضيف ورقم الهاتف لبدء الطلب.</p>
                            
                            <div class="text-right mb-3" style="direction: rtl;">
                                <label class="form-label small fw-bold text-dark">اسم العميل</label>
                                <input type="text" id="waiterCustomerName" class="form-control py-2.5 rounded-3 bg-white text-dark text-right" placeholder="مثال: علي هاني" />
                            </div>
                            <div class="text-right mb-4" style="direction: rtl;">
                                <label class="form-label small fw-bold text-dark">رقم الهاتف</label>
                                <input type="tel" id="waiterCustomerPhone" class="form-control py-2.5 rounded-3 bg-white text-dark text-right" placeholder="مثال: 0123456789" />
                            </div>
                            
                            <div class="d-flex gap-2">
                                <button class="btn btn-outline-secondary w-50 py-2.5 rounded-pill fw-bold" onclick="quickStartSession()">فتح سريع</button>
                                <button class="btn btn-warning w-50 py-2.5 rounded-pill fw-bold" onclick="submitStartSession()">بدء وطلب</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Step 2: Menu Selection (when session is active) -->
                <div id="waiterMenuStep" style="display: none;">
                    <div class="row g-4" style="height: 60vh;">
                        
                        <!-- Right: Menu Explorer (Categories and Items) -->
                        <div class="col-lg-8 d-flex flex-column h-100 border-start ps-3">
                            <div class="input-group mb-3 shadow-sm" style="direction: ltr;">
                                <input type="text" id="menuSearchInput" class="form-control bg-white text-dark border-1 text-right" style="border-radius: 0 12px 12px 0; border-color: #ddd; border-left: 0; direction: rtl;" placeholder="البحث عن صنف..." oninput="filterMenuItems()" />
                                <span class="input-group-text bg-light border-1 text-dark" style="border-radius: 12px 0 0 12px; border-color: #ddd;"><i class="bi bi-search"></i></span>
                            </div>
                            
                            <!-- Categories slider -->
                            <div class="d-flex gap-2 overflow-auto pb-2 mb-3" id="categoriesSlider" style="scrollbar-width: thin; direction: rtl;">
                                <!-- Dynamically loaded -->
                            </div>

                            <!-- Menu items grid -->
                            <div class="row g-3 overflow-auto flex-grow-1" id="menuItemsGrid" style="scrollbar-width: thin; max-height: calc(60vh - 120px); direction: rtl;">
                                <!-- Dynamically loaded -->
                            </div>
                        </div>
                        
                        <!-- Left: Active Cart Pane -->
                        <div class="col-lg-4 d-flex flex-column h-100 p-3 rounded-4 bg-light border">
                            <h5 class="fw-bold text-warning border-bottom pb-2 mb-3"><i class="bi bi-cart3 ms-2"></i>سلة الطلبات</h5>
                            
                            <!-- Cart list -->
                            <div class="flex-grow-1 overflow-auto mb-3" id="cartItemsList" style="scrollbar-width: thin; max-height: calc(60vh - 240px); direction: rtl;">
                                <div class="text-center py-5 text-muted" id="cartEmptyState">
                                    <i class="bi bi-cart-x display-4 mb-3 d-block text-secondary"></i>
                                    السلة فارغة
                                </div>
                            </div>

                            <!-- Note field -->
                            <div class="mb-3 text-right" style="direction: rtl;">
                                <label class="form-label small fw-bold text-muted">ملاحظات خاصة / تعليمات المطبخ</label>
                                <textarea id="orderNotesInput" class="form-control bg-white text-dark small text-right" rows="2" placeholder="مثال: صلصة إضافية، بدون بصل..."></textarea>
                            </div>
                            
                            <!-- Summary and Checkout -->
                            <div class="border-top pt-3" style="border-color: rgba(0,0,0,0.08) !important; direction: rtl;">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">المجموع الفرعي:</span>
                                    <span class="fw-bold text-dark" id="cartSubtotal">0.00 ج.م</span>
                                </div>
                                
                                <button class="btn btn-warning w-100 py-3 fw-bold rounded-pill mt-2 shadow" id="btnCartCheckout" disabled onclick="submitWaiterOrder()">
                                    <i class="bi bi-send-fill ms-2"></i> إرسال الطلب
                                </button>
                            </div>
                        </div>
                        
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .pulse-green {
        animation: pulse-green-animation 2s infinite;
        border: 2px solid #0dcaf0 !important;
    }

    @@keyframes pulse-green-animation {
        0% { box-shadow: 0 0 0 0px rgba(13, 202, 240, 0.4); }
        70% { box-shadow: 0 0 0 10px rgba(13, 202, 240, 0); }
        100% { box-shadow: 0 0 0 0px rgba(13, 202, 240, 0); }
    }
    
    .order-card {
        transition: all 0.3s ease;
    }
</style>

@section Scripts {
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script>
        const activeBranchId = @(ViewBag.ActiveBranchId ?? "null");
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/orderHub", {
                transport: signalR.HttpTransportType.WebSockets | signalR.HttpTransportType.LongPolling
            })
            .withAutomaticReconnect([0, 1000, 3000, 5000, 10000])
            .configureLogging(signalR.LogLevel.Information)
            .build();
            
        console.log("SignalR Connection object created");

        function updateConnectionStatus(connected) {
            const badge = document.getElementById('connection-status');
            if (badge) {
                badge.className = connected ? 'badge bg-success ms-2 shadow-sm' : 'badge bg-danger ms-2';
                badge.innerHTML = connected 
                    ? '<i class="bi bi-wifi"></i> مباشر' 
                    : '<i class="bi bi-wifi-off"></i> غير متصل <button class="btn btn-xs btn-light ms-2 py-0 px-1 text-danger fw-bold" onclick="startConnection()">اتصل الآن</button>';
            }
        }

        function updateTableCard(tableData) {
            const tableNumber = tableData.tableNumber;
            const card = document.getElementById(`table-card-${tableNumber}`);
            if (!card) return;

            const cardInner = card.querySelector('.card');
            const ordersContainer = card.querySelector('.orders-container');

            cardInner.className = 'card h-100 shadow-sm border-0 rounded-4 overflow-hidden';
            if (tableData.status === 'Pending') {
                cardInner.classList.add('bg-warning', 'bg-opacity-25');
            } else if (tableData.status === 'Active') {
                cardInner.classList.add('bg-success', 'bg-opacity-25');
            } else if (tableData.sessionId) {
                cardInner.classList.add('bg-info', 'bg-opacity-10', 'border', 'border-info', 'border-opacity-25');
            } else {
                cardInner.classList.add('bg-white');
            }

            let headerHtml = `
                <div class="d-flex justify-content-between align-items-start border-bottom pb-2 mb-2">
                    <h3 class="card-title h4 fw-bold mb-0">طاولة ${tableNumber}</h3>
                    ${tableData.sessionId ? `
                        <button class="btn btn-xs btn-outline-danger border-0 rounded-circle" onclick="closeSession(${tableData.sessionId})" title="إغلاق الجلسة">
                            <i class="bi bi-x-circle"></i>
                        </button>
                    ` : ''}
                </div>
            `;
            
            let sessionHtml = '';
            if (tableData.customerName) {
                sessionHtml = `
                    <div class="small text-start mb-2 px-2 py-1 bg-white bg-opacity-50 rounded text-right" style="direction: rtl;">
                        <div><i class="bi bi-person-fill text-secondary ms-1"></i><strong>${tableData.customerName}</strong></div>
                        <div class="text-muted"><i class="bi bi-telephone-fill ms-1"></i>${tableData.phoneNumber}</div>
                    </div>
                `;
            }

            let ordersHtml = '';
            if (tableData.orders && tableData.orders.length > 0) {
                tableData.orders.forEach(order => {
                    const isPending = order.status === 'Pending' || order.status === 0;
                    const isReady = order.status === 'Ready' || order.status === 3;
                    const isConfirmed = order.status === 'Confirmed' || order.status === 1;
                    const isInPrep = order.status === 'InPreparation' || order.status === 2;
                    
                    let statusText = 'نشط';
                    let themeColor = 'success';
                    let badgeHtml = `<span class="badge bg-white text-dark small">نشط</span>`;

                    if (isPending) {
                        statusText = 'معلق';
                        themeColor = 'warning';
                        badgeHtml = `<span class="badge bg-white text-dark small">معلق</span>`;
                    } else if (isReady) {
                        statusText = 'جاهز';
                        themeColor = 'info';
                        badgeHtml = `<span class="badge bg-white text-info fw-bold pulse-green shadow-sm">جاهز</span>`;
                    } else if (isInPrep) {
                         statusText = 'تحضير';
                         themeColor = 'primary';
                         badgeHtml = `<span class="badge bg-white text-primary small">تحضير</span>`;
                    } else if (isConfirmed) {
                         statusText = 'مؤكد';
                         themeColor = 'success';
                         badgeHtml = `<span class="badge bg-white text-success small">مؤكد</span>`;
                    }

                    const time = order.orderTime ? new Date(order.orderTime).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) : '';

                    let itemsHtml = '';
                    if (order.items && order.items.length > 0) {
                        itemsHtml = `
                            <ul class="list-unstyled mb-2 small bg-light p-2 rounded-3 mt-2">
                                ${order.items.map(i => {
                                    const itemName = i.name || i.menuItemName || 'صنف';
                                    const isCancelled = i.isCancelled === true;
                                    let addonsList = '';
                                    if (!isCancelled && i.addOns && i.addOns.length > 0) {
                                        addonsList = `<div class="ps-2 text-muted small" style="font-size: 0.75rem; line-height: 1.1;">+ ${i.addOns.map(a => a.name).join(', ')}</div>`;
                                    }
                                    const cancelBtn = !isCancelled && i.id
                                        ? `<button class="btn btn-xs btn-outline-danger py-0 px-1 ms-1 border-0" style="font-size:0.65rem;" onclick="cancelOrderItem(${i.id})" title="إلغاء الصنف"><i class="bi bi-x"></i></button>`
                                        : (isCancelled ? `<span class="badge bg-danger ms-1" style="font-size:0.6rem;">ملغي</span>` : '');
                                    const lineStyle = isCancelled ? 'text-decoration: line-through; color: #ef4444; opacity:0.7;' : '';
                                    return `<li class="d-flex align-items-start justify-content-between gap-1 mb-1" style="${lineStyle}">
                                        <div><strong>${i.quantity} x ${itemName}</strong>${addonsList}</div>
                                        ${cancelBtn}
                                    </li>`;
                                }).join('')}
                            </ul>
                        `;
                    }
                    
                     let noteHtml = '';
                    if (order.note) {
                        noteHtml = `
                            <div class="alert alert-warning py-1 px-2 mb-2">
                                <small class="d-block fst-italic"><i class="bi bi-pencil-fill ms-1"></i>${order.note}</small>
                            </div>
                        `;
                    }

                    let actionsHtml = '';
                    if (isPending) {
                        actionsHtml = `
                             <button class="btn btn-sm btn-success flex-grow-1 rounded-pill" onclick="acceptOrder(${order.id})" title="قبول الطلب">
                                <i class="bi bi-check2"> قبول</i> 
                            </button>
                            <button class="btn btn-sm btn-danger rounded-pill" onclick="cancelOrder(${order.id}, ${tableNumber})" title="إلغاء">
                                <i class="bi bi-x"></i> 
                            </button>
                        `;
                    } else if (isReady) {
                        actionsHtml = `
                             <button class="btn btn-sm btn-success flex-grow-1 fw-bold rounded-pill" onclick="serveOrder(${order.id})" title="تقديم الطلب">
                                <i class="bi bi-cup-hot-fill ms-1"></i> تقديم
                            </button>
                             <button class="btn btn-sm btn-outline-danger rounded-pill" onclick="cancelOrder(${order.id}, ${tableNumber})" title="إلغاء">
                                <i class="bi bi-x"></i> 
                            </button>
                        `;
                    } else {
                         actionsHtml = `
                             <button class="btn btn-sm btn-outline-danger flex-grow-1 rounded-pill" onclick="cancelOrder(${order.id}, ${tableNumber})" title="حذف الطلب">
                                <i class="bi bi-trash"></i> حذف الطلب
                            </button>
                        `;
                    }

                    ordersHtml += `
                        <div class="card mb-2 shadow-sm order-card border-${themeColor} ${isReady ? 'border-3' : ''} rounded-3 overflow-hidden">
                            <div class="card-header py-1 bg-${themeColor} ${isPending ? 'text-dark' : 'text-white'} d-flex justify-content-between align-items-center">
                                <small class="fw-bold">طلب #${order.id}</small>
                                ${badgeHtml}
                            </div>
                            <div class="card-body p-2 text-right" style="direction: rtl;">
                                <div class="d-flex justify-content-between align-items-center mt-1 pb-2 border-bottom">
                                    <small class="text-muted">${time}</small>
                                    <small class="fw-bold text-dark">${(order.totalAmount || 0).toFixed(2)} ج.م</small>
                                </div>
                                ${itemsHtml}
                                ${noteHtml}
                                <div class="d-flex gap-1 mt-2">
                                    ${actionsHtml}
                                </div>
                            </div>
                        </div>
                    `;
                });
            } else {
                if (tableData.sessionId) {
                    ordersHtml = `
                        <div class="text-primary small mt-4 py-3 bg-light rounded-3 border border-primary border-opacity-10">
                            <i class="bi bi-person-check-fill display-5 d-block mb-2 text-primary opacity-50"></i>
                            في انتظار الطلب
                        </div>
                    `;
