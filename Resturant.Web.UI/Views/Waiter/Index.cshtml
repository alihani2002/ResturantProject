                        <label class="btn btn-outline-warning w-100 py-2.5 rounded-3 fw-bold text-dark d-flex flex-column align-items-center justify-content-center size-card cursor-pointer" for="size-${idx}">
                            <span class="size-name small text-muted">${size.name}</span>
                            <span class="size-price fw-extrabold text-dark mt-1" style="font-size: 0.95rem;">${size.price.toFixed(2)} ج.م</span>
                        </label>
                    </div>
                `).join('');
            } else {
                sizesSection.style.display = 'none';
                sizesList.innerHTML = '';
            }

            const addonsSection = document.getElementById('addons-section');
            const addonsList = document.getElementById('addons-list');
            if (item.addOns && item.addOns.length > 0) {
                addonsSection.style.display = 'block';
                addonsList.innerHTML = item.addOns.map(addon => `
                    <div class="col-12">
                        <div class="card border p-2.5 px-3 rounded-3 d-flex flex-row align-items-center justify-content-between cursor-pointer addon-card mb-2" 
                             id="addon-card-${addon.id}"
                             onclick="toggleAddonCard(${addon.id})">
                            <div class="form-check m-0" style="pointer-events: none;">
                                <input class="form-check-input" type="checkbox" id="addon-${addon.id}" value="${addon.id}" data-price="${addon.price}" data-name="${addon.name}" onclick="event.stopPropagation()">
                                <label class="form-check-label fw-bold text-dark mr-2" for="addon-${addon.id}">
                                    ${addon.name}
                                </label>
                            </div>
                            <span class="fw-bold text-warning small">+ ${addon.price.toFixed(2)} ج.م</span>
                        </div>
                    </div>
                `).join('');
            } else {
                addonsSection.style.display = 'none';
                addonsList.innerHTML = '';
            }

            updateCustomizationTotal();

            const bsRequest = window.bootstrap || bootstrap;
            const customModal = new bsRequest.Modal(document.getElementById('customizationModal'));
            customModal.show();
        }

        function toggleAddonCard(addonId) {
            const checkbox = document.getElementById(`addon-${addonId}`);
            if (checkbox) {
                checkbox.checked = !checkbox.checked;
                const card = document.getElementById(`addon-card-${addonId}`);
                if (checkbox.checked) {
                    card.classList.add('border-warning', 'bg-warning-subtle');
                } else {
                    card.classList.remove('border-warning', 'bg-warning-subtle');
                }
                updateCustomizationTotal();
            }
        }

        function adjustCustomQty(delta) {
            if (customizationQty + delta >= 1) {
                customizationQty += delta;
                document.getElementById('customization-qty-val').textContent = customizationQty;
                updateCustomizationTotal();
            }
        }

        function updateCustomizationTotal() {
            if (!activeCustomItem) return;
            
            const selectedSizeRadio = document.querySelector('input[name="size-option"]:checked');
            const basePrice = selectedSizeRadio ? parseFloat(selectedSizeRadio.getAttribute('data-price')) : activeCustomItem.price;
            let total = basePrice;
            
            const checkboxes = document.querySelectorAll('#addons-list input[type="checkbox"]:checked');
            checkboxes.forEach(cb => {
                total += parseFloat(cb.getAttribute('data-price'));
            });

            total = total * customizationQty;

            document.getElementById('customization-total-price').textContent = `${total.toFixed(2)} ج.م`;
        }

        function addCustomizedToCart() {
            if (!activeCustomItem) return;

            const selectedAddOnsList = [];
            const checkboxes = document.querySelectorAll('#addons-list input[type="checkbox"]:checked');
            checkboxes.forEach(cb => {
                selectedAddOnsList.push({
                    id: parseInt(cb.value),
                    name: cb.getAttribute('data-name'),
                    price: parseFloat(cb.getAttribute('data-price'))
                });
            });

            const selectedSizeRadio = document.querySelector('input[name="size-option"]:checked');
            const sizeName = selectedSizeRadio ? selectedSizeRadio.value : '';
            const sizePrice = selectedSizeRadio ? parseFloat(selectedSizeRadio.getAttribute('data-price')) : activeCustomItem.price;

            const addonIdsStr = selectedAddOnsList.map(a => a.id).sort().join(',');
            const cartItemId = `${activeCustomItem.id}_${sizeName}_${addonIdsStr}`;

            const existingItem = cart.find(item => item.cartItemId === cartItemId);
            if (existingItem) {
                existingItem.quantity += customizationQty;
            } else {
                cart.push({
                    cartItemId: cartItemId,
                    id: activeCustomItem.id,
                    name: activeCustomItem.name + (sizeName ? ` (${sizeName})` : ''),
                    price: sizePrice,
                    quantity: customizationQty,
                    addOns: selectedAddOnsList,
                    size: sizeName
                });
            }

            updateCartUI();

            const bsRequest = window.bootstrap || bootstrap;
            const customModalElement = document.getElementById('customizationModal');
            const customModal = bsRequest.Modal.getInstance(customModalElement);
            if (customModal) customModal.hide();
        }
    </script>

    <!-- Customization Modal HTML -->
    <div class="modal fade" id="customizationModal" tabindex="-1" aria-labelledby="customizationModalLabel" aria-hidden="true" style="font-family: 'Cairo', sans-serif;">
        <div class="modal-dialog modal-dialog-centered modal-md">
            <div class="modal-content shadow-lg border-0 rounded-4 bg-white text-dark">
                <div class="modal-header border-0 pb-0 pt-3 px-3 d-flex align-items-center justify-content-between">
                    <div class="flex-grow-1 text-right" style="direction: rtl;">
                        <h4 class="modal-title fw-bold text-dark mb-0" id="customization-item-name">اسم الصنف</h4>
                        <span class="badge bg-secondary rounded-pill fs-6 mt-1" id="customization-item-price">0.00 ج.م</span>
                    </div>
                    <button type="button" class="btn-close shadow-none ms-0" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                
                <div class="modal-body px-3 py-3 text-right" style="max-height: 50vh; overflow-y: auto; direction: rtl;">
                    <p class="text-muted small mb-3" id="customization-item-description">الوصف هنا.</p>
                    
                    <!-- Sizes Section -->
                    <div id="sizes-section" class="mb-4" style="display: none;">
                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                            <i class="bi bi-arrows-angle-expand text-warning ms-2"></i>اختر الحجم
                        </h6>
                        <div id="sizes-list" class="d-flex flex-wrap gap-2">
                            <!-- Dynamic sizes -->
                        </div>
                    </div>

                    <!-- Add-Ons Section -->
                    <div id="addons-section" class="mb-4" style="display: none;">
                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                            <i class="bi bi-gear-wide-connected text-warning ms-2"></i>تخصيص الطلب / الإضافات
                        </h6>
                        <div id="addons-list" class="row g-2">
                            <!-- Custom options -->
                        </div>
                    </div>
                </div>
                
                <div class="modal-footer bg-light border-0 py-3 px-3 d-flex justify-content-between align-items-center" style="direction: rtl;">
                    <!-- Quantity selector -->
                    <div class="d-flex align-items-center border border-2 border-dark rounded-pill bg-white px-2 py-1 shadow-sm">
                        <button class="btn btn-link btn-sm text-dark p-0 px-2 fw-bold" style="text-decoration: none;" onclick="adjustCustomQty(-1)">-</button>
                        <span class="px-2 fw-bold text-dark fs-5" id="customization-qty-val">1</span>
                        <button class="btn btn-link btn-sm text-dark p-0 px-2 fw-bold" style="text-decoration: none;" onclick="adjustCustomQty(1)">+</button>
                    </div>
                    
                    <!-- Action Button -->
                    <button type="button" class="btn btn-warning rounded-pill px-4 py-2 fw-bold text-dark d-flex align-items-center shadow-sm" id="add-customized-to-cart-btn" onclick="addCustomizedToCart()">
                        <span class="ms-2">إضافة للسلة</span>
                        <span class="badge bg-dark rounded-pill" id="customization-total-price">0.00 ج.م</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}
