        function renderMenuItems() {
            const grid = document.getElementById('menuItemsGrid');
            const search = document.getElementById('menuSearchInput').value.toLowerCase();
            let html = '';

            fullMenuData.forEach(cat => {
                if (selectedCategory !== 0 && cat.categoryId !== selectedCategory) return;

                cat.items.forEach(item => {
                    if (search && !item.name.toLowerCase().includes(search)) return;

                    html += `
                        <div class="col-sm-6 col-md-4">
                            <div class="card h-100 border-0 shadow-sm p-3 bg-light text-dark text-right" style="direction: rtl;">
