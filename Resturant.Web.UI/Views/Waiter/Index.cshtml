@model IEnumerable<Resturant.Web.UI.ViewModels.WaiterTableViewModel>

@{
    ViewData["Title"] = "Table Management";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-grid-3x3-gap-fill text-warning me-2"></i>Table Management <span id="connection-status" class="badge bg-secondary ms-2"><i class="bi bi-wifi"></i> Connecting...</span></h2>
        <div>
           <span class="badge bg-white text-dark border me-2"><i class="bi bi-circle-fill text-secondary me-1"></i> Empty</span>
           <span class="badge bg-warning text-dark me-2"><i class="bi bi-clock-fill me-1"></i> Pending Order</span>
           <span class="badge bg-success"><i class="bi bi-check-circle-fill me-1"></i> Active/Served</span>
        </div>
    </div>

    <div class="row g-4" id="tables-container">
        @foreach (var table in Model)
        {
            <div class="col-lg-3 col-md-4 col-sm-6" id="table-card-@table.TableNumber">
                <div class="card h-100 shadow-sm border-0 @(table.AggregateStatus == "Pending" ? "bg-warning bg-opacity-25" : (table.AggregateStatus == "Active" ? "bg-success bg-opacity-25" : "bg-white"))">
                    <div class="card-body text-center d-flex flex-column p-2">
                        <h3 class="card-title display-6 fw-bold mb-3 border-bottom pb-2">
                            Table @table.TableNumber
                        </h3>
                        
                        <div class="orders-container flex-grow-1" style="max-height: 400px; overflow-y: auto;">
                            @if (table.Orders != null && table.Orders.Any())
                            {
                                foreach (var order in table.Orders)
                                {
                                    <div class="card mb-2 shadow-sm order-card border-@((order.Status == "Pending") ? "warning" : "success")">
                                        <div class="card-header py-1 @((order.Status == "Pending") ? "bg-warning text-dark" : "bg-success text-white") d-flex justify-content-between align-items-center">
                                            <small class="fw-bold">Order #@order.OrderId</small>
                                            <span class="badge bg-white text-dark small">@order.Status</span>
                                        </div>
                                        <div class="card-body p-2 text-start">
                                            <div class="d-flex justify-content-between mb-1">
                                                <small class="text-muted">@order.OrderTime?.ToShortTimeString()</small>
                                                <small class="fw-bold">$@order.TotalAmount.ToString("0.00")</small>
                                            </div>

                                            @if (order.OrderItems != null && order.OrderItems.Any())
                                            {
                                                <ul class="list-unstyled mb-2 small bg-light p-1 rounded">
                                                    @foreach (var item in order.OrderItems)
                                                    {
                                                        <li>@item.Quantity x @item.Name</li>
                                                    }
                                                </ul>
                                            }

                                            @if (!string.IsNullOrEmpty(order.Note))
                                            {
                                                <div class="alert alert-warning py-1 px-2 mb-2">
                                                    <small class="d-block fst-italic"><i class="bi bi-pencil-fill me-1"></i>@order.Note</small>
                                                </div>
                                            }
                                            
                                            <div class="d-flex gap-1 mt-2">
                                                @if (order.Status == "Pending")
                                                {
                                                    <button class="btn btn-sm btn-success flex-grow-1" onclick="acceptOrder(@order.OrderId)">
                                                        <i class="bi bi-check2"></i> 
                                                    </button>
                                                    <button class="btn btn-sm btn-danger flex-grow-1" onclick="cancelOrder(@order.OrderId, @table.TableNumber)">
                                                        <i class="bi bi-x"></i> 
                                                    </button>
                                                }
                                                else
                                                {
                                                     <button class="btn btn-sm btn-outline-danger flex-grow-1" onclick="cancelOrder(@order.OrderId, @table.TableNumber)">
                                                        <i class="bi bi-x"></i> 
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-secondary flex-grow-1" onclick="clearTable(@order.OrderId)">
                                                        <i class="bi bi-check-circle"></i> Clear
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-muted small mt-4">
                                    <i class="bi bi-cup-hot display-4 d-block mb-2 text-secondary opacity-25"></i>
                                    Available
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script>
        // SignalR Connection with auto-reconnect
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/orderHub")
            .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
            .configureLogging(signalR.LogLevel.Warning)
            .build();

        // Connection state indicator
        function updateConnectionStatus(connected) {
            const badge = document.getElementById('connection-status');
            if (badge) {
                badge.className = connected ? 'badge bg-success ms-2' : 'badge bg-danger ms-2';
                badge.innerHTML = connected ? '<i class="bi bi-wifi"></i> Live' : '<i class="bi bi-wifi-off"></i> Offline';
            }
        }

        // Update table card UI dynamically
        function updateTableCard(tableNumber, status, orders) {
            const card = document.getElementById(`table-card-${tableNumber}`);
            if (!card) return;

            const cardInner = card.querySelector('.card');
            const ordersContainer = card.querySelector('.orders-container');

            // Update card background based on aggregate status
            cardInner.className = 'card h-100 shadow-sm border-0'; // Reset
            if (status === 'Pending') {
                cardInner.classList.add('bg-warning', 'bg-opacity-25');
            } else if (status === 'Active') {
                cardInner.classList.add('bg-success', 'bg-opacity-25');
            } else {
                cardInner.classList.add('bg-white');
            }

            let html = '';
            if (orders && orders.length > 0) {
                orders.forEach(order => {
                    const isPending = order.status === 'Pending' || order.status === 0;
                    const statusText = isPending ? 'Pending' : 'Active';
                    const themeColor = isPending ? 'warning' : 'success';
                    const time = order.orderTime ? new Date(order.orderTime).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) : '';

                    let itemsHtml = '';
                    if (order.items && order.items.length > 0) {
                        itemsHtml = `
                            <ul class="list-unstyled mb-2 small bg-light p-1 rounded">
                                ${order.items.map(i => `<li>${i.quantity} x ${i.name || i.menuItemName}</li>`).join('')}
                            </ul>
                        `;
                    }
                    
                     let noteHtml = '';
                    if (order.note) {
                        noteHtml = `
                            <div class="alert alert-warning py-1 px-2 mb-2">
                                <small class="d-block fst-italic"><i class="bi bi-pencil-fill me-1"></i>${order.note}</small>
                            </div>
                        `;
                    }

                    let actionsHtml = '';
                    if (isPending) {
                        actionsHtml = `
                             <button class="btn btn-sm btn-success flex-grow-1" onclick="acceptOrder(${order.id})">
                                <i class="bi bi-check2"></i> 
                            </button>
                            <button class="btn btn-sm btn-danger flex-grow-1" onclick="cancelOrder(${order.id}, ${tableNumber})">
                                <i class="bi bi-x"></i> 
                            </button>
                        `;
                    } else {
                         actionsHtml = `
                             <button class="btn btn-sm btn-outline-danger flex-grow-1" onclick="cancelOrder(${order.id}, ${tableNumber})">
                                <i class="bi bi-x"></i> 
                            </button>
                            <button class="btn btn-sm btn-outline-secondary flex-grow-1" onclick="clearTable(${order.id})">
                                <i class="bi bi-check-circle"></i> Clear
                            </button>
                        `;
                    }

                     html += `
                        <div class="card mb-2 shadow-sm order-card border-${themeColor}">
                            <div class="card-header py-1 bg-${themeColor} ${isPending ? 'text-dark' : 'text-white'} d-flex justify-content-between align-items-center">
                                <small class="fw-bold">Order #${order.id}</small>
                                <span class="badge bg-white text-dark small">${statusText}</span>
                            </div>
                            <div class="card-body p-2 text-start">
                                <div class="d-flex justify-content-between mb-1">
                                    <small class="text-muted">${time}</small>
                                    <small class="fw-bold">$${(order.totalAmount || 0).toFixed(2)}</small>
                                </div>
                                ${itemsHtml}
                                ${noteHtml}
                                <div class="d-flex gap-1 mt-2">
                                    ${actionsHtml}
                                </div>
                            </div>
                        </div>
                    `;
                });
            } else {
                 html = `
                    <div class="text-muted small mt-4">
                        <i class="bi bi-cup-hot display-4 d-block mb-2 text-secondary opacity-25"></i>
                        Available
                    </div>
                `;
            }

            ordersContainer.innerHTML = html;

            // Flash animation
            cardInner.style.transition = 'transform 0.2s';
            cardInner.style.transform = 'scale(1.02)';
            setTimeout(() => { cardInner.style.transform = 'scale(1)'; }, 200);
        }

        // Play notification sound
        function playNotificationSound() {
            try {
                const audioContext = new (window.AudioContext || window.webkitAudioContext)();
                if (audioContext.state === 'suspended') audioContext.resume();
                const oscillator = audioContext.createOscillator();
                const gainNode = audioContext.createGain();
                oscillator.connect(gainNode);
                gainNode.connect(audioContext.destination);
                oscillator.frequency.value = 800;
                oscillator.type = 'sine';
                gainNode.gain.setValueAtTime(0.3, audioContext.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.3);
                oscillator.start(audioContext.currentTime);
                oscillator.stop(audioContext.currentTime + 0.3);
            } catch (e) { console.error(e); }
        }

        // Show toast notification
        function showNotification(message, type = 'info') {
            const container = document.querySelector('.toast-container') || createToastContainer();
            const toastId = 'toast-' + Date.now();
            const bgColor = type === 'success' ? 'bg-success' : type === 'warning' ? 'bg-warning' : 'bg-info';

            const toastHtml = `
                <div id="${toastId}" class="toast align-items-center text-white ${bgColor} border-0" role="alert">
                    <div class="d-flex">
                        <div class="toast-body">${message}</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>
            `;
            container.insertAdjacentHTML('beforeend', toastHtml);
            const toastEl = document.getElementById(toastId);
            const toast = new bootstrap.Toast(toastEl, { delay: 4000 });
            toast.show();
            toastEl.addEventListener('hidden.bs.toast', () => toastEl.remove());
        }

        function createToastContainer() {
            const container = document.createElement('div');
            container.className = 'toast-container position-fixed bottom-0 end-0 p-3';
            document.body.appendChild(container);
            return container;
        }

        // SignalR event handlers
        // We now refresh the whole table data on any event because the incremental updates logic
        // is too complex with multiple orders (need to know which table, etc. cleanly).
        // Since we have a robust FetchAndRefreshTables, let's use it for sync.
        
        connection.on("NewOrderReceived", function (order) {
            playNotificationSound();
            showNotification(`New order on Table ${order.tableNumber}!`, 'warning');
            fetchAndRefreshTables();
        });

        connection.on("OrderStatusChanged", function (order) {
            fetchAndRefreshTables();
        });

        connection.on("OrderReady", function (order) {
             showNotification(`Order for Table ${order.tableNumber} is ready!`, 'success');
             fetchAndRefreshTables();
        });

        connection.on("PaymentProcessed", function (order) {
            showNotification(`Payment received for Table ${order.tableNumber}`, 'success');
            fetchAndRefreshTables();
        });

        connection.on("TableCleared", function (order) {
            fetchAndRefreshTables();
        });
        
         // Legacy event handlers
        connection.on("ReceiveOrderDetails", function (order) {
            playNotificationSound();
             fetchAndRefreshTables();
        });

        connection.on("ReceiveWaiterUpdate", function (message) {
            fetchAndRefreshTables();
        });
        
        connection.on("ReceiveAccountantUpdate", function (message) {
            fetchAndRefreshTables();
        });


        // Fetch and refresh tables data
        async function fetchAndRefreshTables() {
            try {
                const response = await fetch('/Waiter/GetTablesData');
                if (response.ok) {
                    const tables = await response.json();
                    tables.forEach(table => {
                        updateTableCard(table.tableNumber, table.status, table.orders);
                    });
                }
            } catch (error) {
                console.error('Error fetching tables:', error);
            }
        }

        // Start connection and join dashboard group
        async function startConnection() {
            try {
                await connection.start();
                console.log("SignalR Connected");
                await connection.invoke("JoinDashboard", "waiter");
                updateConnectionStatus(true);
            } catch (err) {
                console.error("SignalR Connection Error:", err);
                updateConnectionStatus(false);
                setTimeout(startConnection, 5000);
            }
        }

        connection.onreconnecting(() => {
            updateConnectionStatus(false);
        });

        connection.onreconnected(() => {
            connection.invoke("JoinDashboard", "waiter");
            updateConnectionStatus(true);
            fetchAndRefreshTables();
        });

        connection.onclose(() => {
            updateConnectionStatus(false);
        });

        startConnection();

        function acceptOrder(orderId) {
            // if (!confirm('Are you sure you want to accept this order?')) return; // Removed confirm for speed

            fetch('/Waiter/AcceptOrder', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `orderId=${orderId}`
            })
            .then(response => {
                if (!response.ok) {
                    alert('Error accepting order');
                } else {
                    // Optimistic UI update or wait for signalR
                    fetchAndRefreshTables();
                }
            });
        }

        function cancelOrder(orderId, tableNumber) {
            if (!confirm('Are you sure you want to cancel this order?')) return;

            fetch('/Waiter/CancelOrder', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `orderId=${orderId}`
            })
            .then(response => {
                if (response.ok) {
                     showNotification(`Order cancelled - ${tableNumber}`, 'warning');
                     fetchAndRefreshTables();
                } else {
                    alert('Error cancelling order');
                }
            });
        }

        function clearTable(orderId) {
            if (!confirm('Is this order/table empty and ready to be cleared?')) return;

            fetch('/Waiter/CompleteOrder', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `orderId=${orderId}`
            })
            .then(response => {
                if (!response.ok) {
                    alert('Error clearing table');
                } else {
                    fetchAndRefreshTables();
                }
            });
        }
    </script>
}