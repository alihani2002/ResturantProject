        function handleMenuAddClick(itemId) {
            let foundItem = null;
            for (const cat of fullMenuData) {
                const item = cat.items.find(i => i.id === itemId);
                if (item) {
                    foundItem = item;
                    break;
                }
            }
            if (!foundItem) return;

            const hasCustomization = (foundItem.sizes && foundItem.sizes.length > 0) || (foundItem.addOns && foundItem.addOns.length > 0);
            if (hasCustomization) {
                openCustomizationModal(itemId);
            } else {
                addItemToCartDirect(foundItem.id, foundItem.name, foundItem.price);
            }
        }

        function addItemToCartDirect(id, name, price) {
            const cartItemId = `${id}__`;
            const existing = cart.find(i => i.cartItemId === cartItemId);
            if (existing) {
                existing.quantity++;
            } else {
                cart.push({
                    cartItemId: cartItemId,
                    id: id,
                    name: name,
                    price: price,
                    quantity: 1,
                    addOns: []
                });
            }
            updateCartUI();
        }

        function updateQuantity(cartItemId, delta) {
            const existing = cart.find(i => i.cartItemId === cartItemId);
            if (existing) {
                existing.quantity += delta;
                if (existing.quantity <= 0) {
                    cart = cart.filter(i => i.cartItemId !== cartItemId);
                }
            }
            updateCartUI();
        }

        function updateCartUI() {
            const container = document.getElementById('cartItemsList');
            const checkoutBtn = document.getElementById('btnCartCheckout');
            
            if (cart.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-5 text-muted" id="cartEmptyState">
                        <i class="bi bi-cart-x display-4 mb-3 d-block text-secondary"></i>
                        السلة فارغة
                    </div>
                `;
                document.getElementById('cartSubtotal').textContent = "0.00 ج.م";
                checkoutBtn.disabled = true;
                return;
            }

            let html = '';
            let subtotal = 0;

            cart.forEach(item => {
                const addonsTotal = item.addOns ? item.addOns.reduce((sum, a) => sum + a.price, 0) : 0;
                const total = (item.price + addonsTotal) * item.quantity;
                subtotal += total;

                let addonsText = '';
                if (item.addOns && item.addOns.length > 0) {
                    addonsText = `<div class="text-muted small pr-2 border-right border-2 border-warning mt-1" style="font-size: 0.75rem;">+ ${item.addOns.map(a => a.name).join(', ')}</div>`;
                }

                html += `
                    <div class="d-flex justify-content-between align-items-center mb-3 p-2 rounded-3 bg-white border border-light shadow-sm text-right" style="direction: rtl;">
                        <div style="max-width: 65%;">
                            <span class="fw-bold d-block text-dark" style="font-size: 0.9rem;">${item.name}</span>
                            ${addonsText}
                            <span class="text-muted small" style="font-size: 0.8rem;">${(item.price + addonsTotal).toFixed(2)} ج.م</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button class="btn btn-outline-warning btn-xs rounded-circle" style="width: 26px; height: 26px; padding:0; display:flex; align-items:center; justify-content:center;" onclick="updateQuantity('${item.cartItemId}', -1)"><i class="bi bi-dash"></i></button>
                            <span class="fw-bold text-dark">${item.quantity}</span>
                            <button class="btn btn-outline-warning btn-xs rounded-circle" style="width: 26px; height: 26px; padding:0; display:flex; align-items:center; justify-content:center;" onclick="updateQuantity('${item.cartItemId}', 1)"><i class="bi bi-plus"></i></button>
                        </div>
                    </div>
                `;
            });

            container.innerHTML = html;
            document.getElementById('cartSubtotal').textContent = `${subtotal.toFixed(2)} ج.م`;
            checkoutBtn.disabled = false;
        }

        function quickStartSession() {
            document.getElementById('waiterCustomerName').value = `ضيف طاولة ${currentWaiterTable}`;
            document.getElementById('waiterCustomerPhone').value = '0000000000';
