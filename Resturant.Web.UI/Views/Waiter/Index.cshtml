@model IEnumerable<Resturant.Web.UI.ViewModels.WaiterTableViewModel>

@{
    ViewData["Title"] = "Table Management";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-grid-3x3-gap-fill text-warning me-2"></i>Table Management <span id="connection-status" class="badge bg-secondary ms-2"><i class="bi bi-wifi"></i> Connecting...</span></h2>
        <div>
           <span class="badge bg-white text-dark border me-2"><i class="bi bi-circle-fill text-secondary me-1"></i> Empty</span>
           <span class="badge bg-warning text-dark me-2"><i class="bi bi-clock-fill me-1"></i> Pending Order</span>
           <span class="badge bg-success"><i class="bi bi-check-circle-fill me-1"></i> Active/Served</span>
        </div>
    </div>

    <div class="row g-4" id="tables-container">
        @foreach (var table in Model)
        {
            <div class="col-lg-3 col-md-4 col-sm-6" id="table-card-@table.TableNumber">
                <div class="card h-100 shadow-sm border-0 @(table.Status == "Pending" ? "bg-warning bg-opacity-25" : (table.Status == "Active" ? "bg-success bg-opacity-25" : "bg-white"))">
                    <div class="card-body text-center d-flex flex-column">
                        <h3 class="card-title display-6 fw-bold mb-3">
                            Table @table.TableNumber
                        </h3>
                        
                        <div class="mt-auto">
                        @if (table.Status == "Pending")
                        {
                            <div class="status-content">
                                <span class="badge bg-warning text-dark mb-3 fs-6">New Order!</span>
                                <p class="mb-1 fw-bold">Amount: $@table.TotalAmount.ToString("0.00")</p>
                                <p class="small text-muted mb-3">@table.OrderTime?.ToShortTimeString()</p>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-success flex-grow-1" onclick="acceptOrder(@table.CurrentOrderId)">
                                        <i class="bi bi-check2-circle me-1"></i> Confirm
                                    </button>
                                    <button class="btn btn-danger flex-grow-1" onclick="cancelOrder(@table.CurrentOrderId, @table.TableNumber)">
                                        <i class="bi bi-x-lg me-1"></i> Cancel
                                    </button>
                                </div>
                            </div>
                        }
                        else if (table.Status == "Active")
                        {
                            <div class="status-content">
                                <span class="badge bg-success mb-3 fs-6">Active</span>
                                <p class="mb-1 fw-bold">Amount: $@table.TotalAmount.ToString("0.00")</p>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-outline-danger flex-grow-1 bg-white" onclick="cancelOrder(@table.CurrentOrderId, @table.TableNumber)">
                                        <i class="bi bi-x-lg me-1"></i> Cancel
                                    </button>
                                    <button class="btn btn-outline-secondary flex-grow-1 bg-white" onclick="clearTable(@table.CurrentOrderId)">
                                        <i class="bi bi-check-circle me-1"></i> Clear
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="status-content">
                                <span class="badge bg-secondary mb-3 fs-6">Empty</span>
                                <p class="text-muted small">Available for guests</p>
                            </div>
                        }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script>
        // SignalR Connection with auto-reconnect
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/orderHub")
            .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
            .configureLogging(signalR.LogLevel.Warning)
            .build();

        // Connection state indicator
        function updateConnectionStatus(connected) {
            const badge = document.getElementById('connection-status');
            if (badge) {
                badge.className = connected ? 'badge bg-success ms-2' : 'badge bg-danger ms-2';
                badge.innerHTML = connected ? '<i class="bi bi-wifi"></i> Live' : '<i class="bi bi-wifi-off"></i> Offline';
            }
        }

        // Update table card UI dynamically
        function updateTableCard(tableNumber, status, orderId, totalAmount, orderTime) {
            const card = document.getElementById(`table-card-${tableNumber}`);
            if (!card) return;

            const cardInner = card.querySelector('.card');
            const statusContent = card.querySelector('.status-content');

            // Update card background
            cardInner.classList.remove('bg-warning', 'bg-opacity-25', 'bg-success', 'bg-white');

            let html = '';
            if (status === 'Pending') {
                cardInner.classList.add('bg-warning', 'bg-opacity-25');
                const time = orderTime ? new Date(orderTime).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) : '';
                html = `
                    <span class="badge bg-warning text-dark mb-3 fs-6">New Order!</span>
                    <p class="mb-1 fw-bold">Amount: $${totalAmount.toFixed(2)}</p>
                    <p class="small text-muted mb-3">${time}</p>
                    <div class="d-flex gap-2">
                        <button class="btn btn-success flex-grow-1" onclick="acceptOrder(${orderId})">
                            <i class="bi bi-check2-circle me-1"></i> Confirm
                        </button>
                        <button class="btn btn-danger flex-grow-1" onclick="cancelOrder(${orderId}, ${tableNumber})">
                            <i class="bi bi-x-lg me-1"></i> Cancel
                        </button>
                    </div>
                `;
            } else if (status === 'Active') {
                cardInner.classList.add('bg-success', 'bg-opacity-25');
                html = `
                    <span class="badge bg-success mb-3 fs-6">Active</span>
                    <p class="mb-1 fw-bold">Amount: $${totalAmount.toFixed(2)}</p>
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-danger flex-grow-1 bg-white" onclick="cancelOrder(${orderId}, ${tableNumber})">
                            <i class="bi bi-x-lg me-1"></i> Cancel
                        </button>
                        <button class="btn btn-outline-secondary flex-grow-1 bg-white" onclick="clearTable(${orderId})">
                            <i class="bi bi-check-circle me-1"></i> Clear
                        </button>
                    </div>
                `;
            } else {
                cardInner.classList.add('bg-white');
                html = `
                    <span class="badge bg-secondary mb-3 fs-6">Empty</span>
                    <p class="text-muted small">Available for guests</p>
                `;
            }

            if (statusContent) {
                statusContent.innerHTML = html;
            }

            // Flash animation to highlight change
            cardInner.style.transition = 'transform 0.2s';
            cardInner.style.transform = 'scale(1.02)';
            setTimeout(() => { cardInner.style.transform = 'scale(1)'; }, 200);
        }

        // Play notification sound
        function playNotificationSound() {
            try {
                const audioContext = new (window.AudioContext || window.webkitAudioContext)();
                const oscillator = audioContext.createOscillator();
                const gainNode = audioContext.createGain();
                oscillator.connect(gainNode);
                gainNode.connect(audioContext.destination);
                oscillator.frequency.value = 800;
                oscillator.type = 'sine';
                gainNode.gain.setValueAtTime(0.3, audioContext.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.3);
                oscillator.start(audioContext.currentTime);
                oscillator.stop(audioContext.currentTime + 0.3);
            } catch (e) { }
        }

        // Show toast notification
        function showNotification(message, type = 'info') {
            const container = document.querySelector('.toast-container') || createToastContainer();
            const toastId = 'toast-' + Date.now();
            const bgColor = type === 'success' ? 'bg-success' : type === 'warning' ? 'bg-warning' : 'bg-info';

            const toastHtml = `
                <div id="${toastId}" class="toast align-items-center text-white ${bgColor} border-0" role="alert">
                    <div class="d-flex">
                        <div class="toast-body">${message}</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>
            `;
            container.insertAdjacentHTML('beforeend', toastHtml);
            const toastEl = document.getElementById(toastId);
            const toast = new bootstrap.Toast(toastEl, { delay: 4000 });
            toast.show();
            toastEl.addEventListener('hidden.bs.toast', () => toastEl.remove());
        }

        function createToastContainer() {
            const container = document.createElement('div');
            container.className = 'toast-container position-fixed bottom-0 end-0 p-3';
            document.body.appendChild(container);
            return container;
        }

        // SignalR event handlers
        connection.on("NewOrderReceived", function (order) {
            updateTableCard(order.tableNumber, 'Pending', order.id, order.totalAmount, order.orderDate);
            playNotificationSound();
            showNotification(`New order on Table ${order.tableNumber}!`, 'warning');
        });

        connection.on("OrderStatusChanged", function (order) {
            const status = order.status === 1 ? 'Active' : order.status === 6 ? 'Empty' : 'Active';
            updateTableCard(order.tableNumber, status, order.id, order.totalAmount, order.orderDate);
        });

        connection.on("OrderReady", function (order) {
            showNotification(`Order for Table ${order.tableNumber} is ready!`, 'success');
        });

        connection.on("PaymentProcessed", function (order) {
            updateTableCard(order.tableNumber, 'Empty', null, 0, null);
            showNotification(`Payment received for Table ${order.tableNumber}`, 'success');
        });

        connection.on("TableCleared", function (order) {
            updateTableCard(order.tableNumber, 'Empty', null, 0, null);
        });

        // Legacy event handlers (backward compatibility)
        connection.on("ReceiveOrderDetails", function (order) {
            updateTableCard(order.tableNumber, 'Pending', order.id, order.totalAmount, order.orderDate);
            playNotificationSound();
            showNotification(`New order on Table ${order.tableNumber}!`, 'warning');
        });

        connection.on("ReceiveWaiterUpdate", function (message) {
            fetchAndRefreshTables();
        });

        connection.on("ReceiveChefUpdate", function (message) {
            // Chef updates may affect table status
        });

        connection.on("ReceiveAccountantUpdate", function (message) {
            fetchAndRefreshTables();
        });

        // Fetch and refresh tables data
        async function fetchAndRefreshTables() {
            try {
                const response = await fetch('/Waiter/GetTablesData');
                if (response.ok) {
                    const tables = await response.json();
                    tables.forEach(table => {
                        updateTableCard(table.tableNumber, table.status, table.currentOrderId, table.totalAmount || 0, table.orderTime);
                    });
                }
            } catch (error) {
                console.error('Error fetching tables:', error);
            }
        }

        // Start connection and join dashboard group
        async function startConnection() {
            try {
                await connection.start();
                console.log("SignalR Connected");
                await connection.invoke("JoinDashboard", "waiter");
                updateConnectionStatus(true);
            } catch (err) {
                console.error("SignalR Connection Error:", err);
                updateConnectionStatus(false);
                setTimeout(startConnection, 5000);
            }
        }

        connection.onreconnecting(() => {
            updateConnectionStatus(false);
        });

        connection.onreconnected(() => {
            connection.invoke("JoinDashboard", "waiter");
            updateConnectionStatus(true);
            fetchAndRefreshTables();
        });

        connection.onclose(() => {
            updateConnectionStatus(false);
        });

        startConnection();

        function acceptOrder(orderId) {
            if (!confirm('Are you sure you want to accept this order?')) return;

            fetch('/Waiter/AcceptOrder', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `orderId=${orderId}`
            })
            .then(response => {
                if (!response.ok) {
                    alert('Error accepting order');
                }
            });
        }

        function cancelOrder(orderId, tableNumber) {
            if (!confirm('Are you sure you want to cancel this order?')) return;

            fetch('/Waiter/CancelOrder', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `orderId=${orderId}`
            })
            .then(response => {
                if (response.ok) {
                    updateTableCard(tableNumber, 'Empty', null, 0, null);
                    showNotification(`Order cancelled - Table ${tableNumber} is now empty`, 'warning');
                } else {
                    alert('Error cancelling order');
                }
            });
        }

        function clearTable(orderId) {
            if (!confirm('Is this table empty and ready to be cleared?')) return;

            fetch('/Waiter/CompleteOrder', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `orderId=${orderId}`
            })
            .then(response => {
                if (!response.ok) {
                    alert('Error clearing table');
                }
            });
        }
    </script>
}