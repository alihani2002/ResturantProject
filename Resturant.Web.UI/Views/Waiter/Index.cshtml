        let isConnecting = false;
        async function startConnection() {
            if (isConnecting || connection.state === signalR.HubConnectionState.Connected) return;
            isConnecting = true;
            
            try {
                await connection.start();
                console.log("SignalR Connected");
                await connection.invoke("JoinDashboard", "waiter", activeBranchId);
                updateConnectionStatus(true);
            } catch (err) {
                console.error("SignalR Connection Error:", err);
                updateConnectionStatus(false);
                setTimeout(startConnection, 5000);
            } finally {
                isConnecting = false;
            }
        }

        connection.onreconnecting(() => updateConnectionStatus(false));
        connection.onreconnected(async () => {
            console.log("SignalR Reconnected");
            try {
                await connection.invoke("JoinDashboard", "waiter", activeBranchId);
                updateConnectionStatus(true);
                fetchAndRefreshTables();
