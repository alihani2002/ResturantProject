@{
    ViewData["Title"] = "Waiter Dashboard";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h2>Waiter Dashboard</h2>
            <p>View and confirm orders from customers</p>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h4>Pending Orders</h4>
                </div>
                <div class="card-body">
                    <div id="orders-container">
                        <p class="text-muted">Loading orders...</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/signalr/7.0.2/signalr.min.js"></script>
    <script>
        // SignalR connection
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/orderHub")
            .build();

        // Load pending orders
        function loadPendingOrders() {
            fetch('/Order/GetOrdersByStatus?status=0') // 0 = Pending
                .then(response => response.json())
                .then(orders => {
                    const container = document.getElementById('orders-container');
                    
                    if (orders.length === 0) {
                        container.innerHTML = '<p class="text-muted">No pending orders</p>';
                        return;
                    }

                    let html = '<div class="row">';
                    orders.forEach(order => {
                        const orderDate = new Date(order.orderDate).toLocaleString();
                        let itemsHtml = '<ul class="list-group list-group-flush">';
                        
                        order.orderItems.forEach(item => {
                            itemsHtml += `
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>${item.menuItem.name} x ${item.quantity}</span>
                                    <span>$${(item.price * item.quantity).toFixed(2)}</span>
                                </li>
                            `;
                        });
                        
                        itemsHtml += '</ul>';

                        html += `
                            <div class="col-md-6 mb-4">
                                <div class="card">
                                    <div class="card-header">
                                        <h5>Order #${order.id} - Table ${order.tableNumber}</h5>
                                        <small>${orderDate}</small>
                                    </div>
                                    <div class="card-body">
                                        ${itemsHtml}
                                        <hr>
                                        <div class="d-flex justify-content-between">
                                            <strong>Total:</strong>
                                            <strong>$${order.totalAmount.toFixed(2)}</strong>
                                        </div>
                                    </div>
                                    <div class="card-footer">
                                        <button class="btn btn-success btn-block" onclick="confirmOrder(${order.id})">
                                            Confirm Order
                                        </button>
                                    </div>
                                </div>
                            </div>
                        `;
                    });
                    
                    html += '</div>';
                    container.innerHTML = html;
                })
                .catch(error => {
                    console.error('Error loading orders:', error);
                });
        }

        // Confirm order
        function confirmOrder(orderId) {
            if (!confirm('Are you sure you want to confirm this order?')) {
                return;
            }

            fetch('/Order/UpdateStatus', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: `orderId=${orderId}&status=1` // 1 = Confirmed
            })
            .then(response => {
                if (response.ok) {
                    alert('Order confirmed successfully');
                    loadPendingOrders();
                } else {
                    alert('Error confirming order');
                }
            })
            .catch(error => {
                console.error('Error confirming order:', error);
                alert('Error confirming order');
            });
        }

        // SignalR event handlers
        connection.on("ReceiveOrderUpdate", function(message) {
            console.log("Order update received:", message);
            loadPendingOrders();
        });

        connection.on("ReceiveOrderDetails", function(order) {
            console.log("Order details received:", order);
            loadPendingOrders();
        });

        connection.on("ReceiveWaiterUpdate", function(message) {
            console.log("Waiter update received:", message);
            loadPendingOrders();
        });

        // Start SignalR connection
        connection.start()
            .then(function() {
                console.log("SignalR connected");
                loadPendingOrders();
            })
            .catch(function(err) {
                console.error("SignalR connection error:", err);
            });

        // Load orders on page load
        document.addEventListener('DOMContentLoaded', function() {
            loadPendingOrders();
        });
    </script>
}